# EventQR backend environment variables. Copy to .env for local use (never commit .env);
# on Render, set these in the service's Environment tab. All values below are placeholders.

# --- Runtime ---
# Activates application-prod.properties (pool sizing, graceful shutdown, virtual threads). REQUIRED in production.
SPRING_PROFILES_ACTIVE=prod
# HTTP port; Render injects this automatically (default 10000).
PORT=10000
# JVM flags; overrides the Dockerfile defaults entirely, so repeat any you still want.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65 -XX:+UseSerialGC -XX:+ExitOnOutOfMemoryError -XX:ReservedCodeCacheSize=64m -Xss512k

# --- Database (Supabase) ---
# Full JDBC URL; takes precedence over the PG*/DB_HOST parts below. Use the session pooler with SSL.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Database user (pooler format is postgres.<project_ref>); PGUSER is the fallback.
DB_USERNAME=postgres.<project_ref>
# Database password; PGPASSWORD is the fallback.
DB_PASSWORD=change-me
# Only used when DB_URL is unset: host (PGHOST is checked first).
DB_HOST=localhost
# Only used when DB_URL is unset: port (PGPORT is checked first).
DB_PORT=5432
# Only used when DB_URL is unset: database name (PGDATABASE is checked first).
DB_NAME=eventqr
# libpq-style aliases, checked before DB_HOST/DB_PORT/DB_NAME and after DB_USERNAME/DB_PASSWORD.
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=eventqr
# PGUSER=postgres
# PGPASSWORD=change-me
# Hikari max pool size (prod profile). Keep small: Supabase free tier allows 60 connections total.
DB_POOL_MAX=5
# Hikari minimum idle connections (prod profile).
DB_POOL_MIN=1

# --- Auth ---
# HMAC signing key for access tokens; at least 32 random bytes (e.g. `openssl rand -base64 48`). REQUIRED.
JWT_SECRET=replace-with-a-long-random-secret
# Access token lifetime in milliseconds (default 3600000 = 1 hour).
JWT_EXPIRATION_MS=3600000
# Refresh token lifetime in days (default 30).
JWT_REFRESH_EXPIRATION_DAYS=30

# --- Email (Brevo) ---
# Brevo transactional email API key. REQUIRED.
BREVO_API_KEY=xkeysib-placeholder
# Verified sender address used for outgoing mail. REQUIRED.
BREVO_SENDER_EMAIL=no-reply@example.com

# --- File storage ---
# "db" stores uploads in Postgres (default); "s3" stores new uploads in an S3-compatible bucket.
STORAGE_TYPE=db
# Bucket name (only when STORAGE_TYPE=s3).
S3_BUCKET=
# Bucket region (default us-east-1).
S3_REGION=us-east-1
# Custom endpoint for R2/MinIO/Spaces; leave empty for AWS S3.
S3_ENDPOINT=
# Access key; leave empty with S3_SECRET_KEY to use the default AWS credential chain.
S3_ACCESS_KEY=
# Secret key; see S3_ACCESS_KEY.
S3_SECRET_KEY=
# Path-style addressing (usually true for MinIO/R2).
S3_PATH_STYLE=false

# --- App ---
# Base URL used in links sent to users (default https://eventqr.app).
FRONTEND_BASE_URL=https://eventqr.app
# IANA timezone for "today" boundaries (default Asia/Manila).
APP_TIMEZONE=Asia/Manila
# Header carrying the real client IP. Default CF-Connecting-IP is only safe behind Render's edge; set empty elsewhere.
CLIENT_IP_TRUSTED_HEADER=CF-Connecting-IP
# Tomcat trusted proxy CIDRs; leave empty on Render (it publishes no inbound ranges).
RENDER_PROXY_CIDRS=

# --- Local tooling (not read by the app) ---
# NVD API key for `./mvnw org.owasp:dependency-check-maven:check`; avoids NVD rate limiting.
NVD_API_KEY=
