<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_primary"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/space_24">

    <ImageView
        android:layout_width="@dimen/mark_preview_16"
        android:layout_height="@dimen/mark_preview_16"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_mark_on_dark" />

    <ImageView
        android:layout_width="@dimen/ui_mark_bar_landing"
        android:layout_height="@dimen/ui_mark_bar_landing"
        android:layout_marginTop="@dimen/space_24"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_mark_on_dark" />

    <ImageView
        android:layout_width="@dimen/mark_preview_32"
        android:layout_height="@dimen/mark_preview_32"
        android:layout_marginTop="@dimen/space_24"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_mark_on_dark" />

    <ImageView
        android:layout_width="@dimen/mark_preview_48"
        android:layout_height="@dimen/mark_preview_48"
        android:layout_marginTop="@dimen/space_24"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_mark_on_dark" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_24"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_mark_on_dark" />

    <!-- The adaptive launcher icon through the system's own mask, at 96dp visible (144dp of canvas). -->
    <ImageView
        android:layout_width="@dimen/mark_preview_launcher"
        android:layout_height="@dimen/mark_preview_launcher"
        android:layout_marginTop="@dimen/space_24"
        android:importantForAccessibility="no"
        android:src="@mipmap/ic_launcher" />
</LinearLayout>
