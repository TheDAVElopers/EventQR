<?xml version="1.0" encoding="utf-8"?>
<!-- TextInputLayout outline: brand when focused, divider when disabled, strong outline otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/divider" android:state_enabled="false" />
    <item android:color="@color/primary" android:state_focused="true" />
    <item android:color="@color/outline_strong" />
</selector>
