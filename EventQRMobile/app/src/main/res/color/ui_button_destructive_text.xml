<?xml version="1.0" encoding="utf-8"?>
<!-- Destructive trigger label (§5.1): ui_error, ui_text_disabled when the action is
     unavailable. Never white-on-red outside a confirm dialog. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/ui_text_disabled" />
    <item android:color="@color/ui_error" />
</selector>
