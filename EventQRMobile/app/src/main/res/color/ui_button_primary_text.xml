<?xml version="1.0" encoding="utf-8"?>
<!-- Primary button label: white on ui_primary, ui_outline_interactive when disabled.
     Disabled label: #87829B on ui_disabled_fill #DAD7E4 is 2.60:1 - disabled text is exempt
     from WCAG 1.4.3, and this is a label, not a border, so the 3.34:1 control-boundary floor
     does not apply here. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/ui_outline_interactive" />
    <item android:color="@color/ui_on_primary" />
</selector>
