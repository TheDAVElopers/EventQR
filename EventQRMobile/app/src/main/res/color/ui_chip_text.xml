<?xml version="1.0" encoding="utf-8"?>
<!-- Filter chip label (§5.6). Selected = white on primary; disabled = ui_text_disabled;
     resting = ui_text_primary. The fill carries the state, so the label never adds a glyph. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/ui_text_disabled" />
    <item android:state_selected="true" android:color="@color/ui_on_primary" />
    <item android:color="@color/ui_text_primary" />
</selector>
