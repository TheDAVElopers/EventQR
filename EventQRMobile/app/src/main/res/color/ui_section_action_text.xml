<?xml version="1.0" encoding="utf-8"?>
<!-- Section action label (§5.1): ui_primary at rest, ui_text_disabled while the action is
     disabled (the bulk Generate all run). State, never an alpha. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false" android:color="@color/ui_text_disabled" />
    <item android:color="@color/ui_primary" />

</selector>
