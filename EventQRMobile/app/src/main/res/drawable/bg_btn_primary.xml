<?xml version="1.0" encoding="utf-8"?>
<!--
    Primary CTA background: brand -> secondary gradient, reversed while pressed, flat brand tint when disabled.
    Used by Widget.EventQR.Button.Primary. Role colours + radius token only.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_disabled" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/secondary"
                android:endColor="@color/primary" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/primary"
                android:endColor="@color/secondary" />
            <corners android:radius="@dimen/radius_button" />
        </shape>
    </item>
</selector>
