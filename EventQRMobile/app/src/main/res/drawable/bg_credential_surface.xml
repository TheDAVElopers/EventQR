<?xml version="1.0" encoding="utf-8"?>
<!--
    THE credential surface (§3.4). The only gradient in the EventQR app.

    315 degrees, two stops, no centre colour, no radial, no sweep, 16dp radius, one 1dp inner
    hairline at 12% white. Used by activity_qr_display, the printed/PDF
    ID card and the mini-pass on scan result - four call sites, one file.

    If you are about to add a second gradient, read §10 of the plan first: the answer is a flat
    tone or a hairline.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/ui_radius_sheet" />
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="@color/deco_credential_gradient_start"
        android:endColor="@color/deco_credential_gradient_end" />
    <stroke
        android:width="@dimen/stroke_hairline"
        android:color="@color/deco_credential_inner_hairline" />
</shape>
