<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base background color -->
    <item>
        <color android:color="@color/background" />
    </item>
    <!-- Top-right soft purple gradient glow -->
    <item
        android:width="@dimen/glow_diameter"
        android:height="@dimen/glow_diameter"
        android:gravity="top|end"
        android:top="@dimen/glow_offset"
        android:end="@dimen/glow_offset">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="@dimen/glow_radius"
                android:startColor="@color/deco_glow_secondary"
                android:endColor="@color/background_clear" />
        </shape>
    </item>
</layer-list>
