<?xml version="1.0" encoding="utf-8"?>
<!-- One L-shaped corner bracket of the scan frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="@dimen/scan_corner_length" android:height="@dimen/scan_corner_thickness" android:gravity="bottom|end">
        <shape android:shape="rectangle"><solid android:color="@color/deco_scan_corner" /><corners android:radius="@dimen/radius_2" /></shape>
    </item>
    <item android:width="@dimen/scan_corner_thickness" android:height="@dimen/scan_corner_length" android:gravity="bottom|end">
        <shape android:shape="rectangle"><solid android:color="@color/deco_scan_corner" /><corners android:radius="@dimen/radius_2" /></shape>
    </item>
</layer-list>
