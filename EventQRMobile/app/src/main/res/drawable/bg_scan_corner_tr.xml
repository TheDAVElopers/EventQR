<?xml version="1.0" encoding="utf-8"?>
<!-- One L-shaped corner bracket of the scan frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="36dp" android:height="4dp" android:gravity="top|end">
        <shape android:shape="rectangle"><solid android:color="#C4B5FD" /><corners android:radius="2dp" /></shape>
    </item>
    <item android:width="4dp" android:height="36dp" android:gravity="top|end">
        <shape android:shape="rectangle"><solid android:color="#C4B5FD" /><corners android:radius="2dp" /></shape>
    </item>
</layer-list>
