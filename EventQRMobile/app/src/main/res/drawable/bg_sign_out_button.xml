<?xml version="1.0" encoding="utf-8"?>
<!-- Sign Out row in the portal switcher: same shape as the portal rows, with a soft red tint at rest (error_container_soft), full error_container while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/error_container" />
            <corners android:radius="@dimen/radius_md" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/error_outline" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/error_container_soft" />
            <corners android:radius="@dimen/radius_md" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/error_outline" />
        </shape>
    </item>
</selector>
