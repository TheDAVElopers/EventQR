<?xml version="1.0" encoding="utf-8"?>
<!-- Destructive TRIGGER button (§5.1): surface fill, 1dp ui_error boundary, ui_error label.
     The filled red commit button lives only inside a confirm dialog, never in normal flow. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/ui_disabled_fill" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_error_container" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/ui_error" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface" />
            <stroke
                android:width="@dimen/stroke_focus"
                android:color="@color/ui_error" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/ui_error" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

</selector>
