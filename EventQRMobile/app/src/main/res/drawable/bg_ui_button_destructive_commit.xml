<?xml version="1.0" encoding="utf-8"?>
<!-- Destructive COMMIT (§5.1): the only filled red button, and only inside a confirm dialog.
     ui_error fill, white label, radius 4, no elevation. Press darkens to
     ui_on_error_container so the commit still reads as a press, not a state change. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_disabled_fill" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_on_error_container" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_error" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

</selector>
