<?xml version="1.0" encoding="utf-8"?>
<!-- Primary button (§5.1). Flat fill, radius 4, elevation 0.
     Pressed = fill moves to ui_primary_pressed (no scale, no ripple circle).
     Focused = the same fill plus a 2dp ui_primary_focus_ring drawn inside the shape, so a
     keyboard/D-pad user can see where they are. Disabled = neutral fill, never a faded brand. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_disabled_fill" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_primary_pressed" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ui_primary" />
                    <corners android:radius="@dimen/ui_radius_button" />
                </shape>
            </item>
            <item android:inset="@dimen/stroke_hairline">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="@dimen/stroke_focus"
                        android:color="@color/ui_primary_focus_ring" />
                    <corners android:radius="@dimen/ui_radius_button" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_primary" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

</selector>
