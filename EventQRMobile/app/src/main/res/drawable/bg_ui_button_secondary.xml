<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary button (§5.1): ui_primary_container fill, ui_primary label, radius 4, no border,
     no elevation. Press darkens one tonal step; disabled is neutral. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_disabled_fill" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_primary_focus_ring" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ui_primary_container" />
                    <corners android:radius="@dimen/ui_radius_button" />
                </shape>
            </item>
            <item android:inset="@dimen/stroke_hairline">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="@dimen/stroke_focus"
                        android:color="@color/ui_primary" />
                    <corners android:radius="@dimen/ui_radius_button" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_primary_container" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

</selector>
