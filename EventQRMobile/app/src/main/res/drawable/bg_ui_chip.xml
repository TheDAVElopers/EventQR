<?xml version="1.0" encoding="utf-8"?>
<!-- Filter chip, all states (§5.6). A chip is a choice: selected -> primary fill,
     pressed -> surface wash, disabled -> sunken fill with the control boundary dropped,
     keyboard focus -> 2dp ui_primary ring inside the boundary (an on-primary ring when the chip
     is also selected, so it stays visible on the primary fill).
     State is carried by fill, never by an icon, so the label stays the whole content. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface_sunken" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

    <item
        android:state_focused="true"
        android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ui_primary" />
                    <corners android:radius="@dimen/ui_radius_button" />
                </shape>
            </item>
            <item android:inset="@dimen/stroke_hairline">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="@dimen/stroke_focus"
                        android:color="@color/ui_on_primary" />
                    <corners android:radius="@dimen/ui_radius_button" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_primary" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_primary_wash" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/ui_outline_interactive" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ui_surface" />
                    <stroke
                        android:width="@dimen/stroke_hairline"
                        android:color="@color/ui_outline_interactive" />
                    <corners android:radius="@dimen/ui_radius_button" />
                </shape>
            </item>
            <item android:inset="@dimen/stroke_hairline">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <stroke
                        android:width="@dimen/stroke_focus"
                        android:color="@color/ui_primary" />
                    <corners android:radius="@dimen/ui_radius_button" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface" />
            <stroke
                android:width="@dimen/stroke_hairline"
                android:color="@color/ui_outline_interactive" />
            <corners android:radius="@dimen/ui_radius_button" />
        </shape>
    </item>

</selector>
