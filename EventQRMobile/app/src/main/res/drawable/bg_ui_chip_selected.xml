<?xml version="1.0" encoding="utf-8"?>
<!-- Filter chip selected (§5.6): primary fill, transparent boundary, radius 4dp. The fill IS
     the state - no check icon, no extra glyph. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ui_primary" />
    <stroke
        android:width="@dimen/stroke_hairline"
        android:color="@android:color/transparent" />
    <corners android:radius="@dimen/ui_radius_button" />
</shape>
