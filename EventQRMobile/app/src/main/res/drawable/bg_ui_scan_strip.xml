<?xml version="1.0" encoding="utf-8"?>
<!-- Inline result strip under the scanner panel (§5.13): 56dp, error tone. Decode failures are
     never a toast - they land here, in place, and disappear on the next scan. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ui_error_container" />
    <stroke
        android:width="@dimen/stroke_hairline"
        android:color="@color/ui_error_outline" />
    <corners android:radius="@dimen/ui_radius_card" />
</shape>
