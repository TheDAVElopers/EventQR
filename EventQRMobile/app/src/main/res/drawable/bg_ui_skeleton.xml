<?xml version="1.0" encoding="utf-8"?>
<!-- Skeleton block (§5.11). Flat ui_surface_sunken, 10dp radius. The shimmer is an alpha
     animation applied to the VIEW (Skeleton.kt), never a second drawable, so the geometry is
     identical whether or not motion is running. Reduced motion = this block, static. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ui_surface_sunken" />
    <corners android:radius="@dimen/ui_radius_card" />
</shape>
