<?xml version="1.0" encoding="utf-8"?>
<!-- Fully transparent splash icon. The Android 12+ system splash must have an icon, and an EMPTY drawable makes it
     fall back to the app's launcher icon, so this draws a real shape in a transparent color instead. The branded
     splash (activity_splash_modern: logo + EventQR wordmark) is the only one users should see. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h24v24h-24z" />
</vector>
