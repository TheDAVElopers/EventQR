<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash icon: the EventQR icon mark only (no wordmark). The system masks the 288dp icon canvas
     to a 192dp circle, so the square mark is sized 128dp (diagonal 181dp) to sit fully inside it. Keep this size in
     sync with splashLogo in activity_splash_modern.xml and bg_splash_legacy.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="128dp"
        android:height="128dp"
        android:gravity="center"
        android:drawable="@drawable/white_logo" />
</layer-list>
