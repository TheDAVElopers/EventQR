<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ system splash icon: the mark on dark, alone and centred, inside a canvas large enough
    that the system's circular icon mask never reaches its corners (04-logo-direction.md §4).
    A layer-list's intrinsic size comes from its child drawables, so the canvas here is the mark's own
    96dp; the item is inset to 64dp, which keeps the mark's 45.3dp half-diagonal inside the mask
    circle. A 96dp item would be inscribed in that same circle and get its four corners cut.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="@dimen/ui_mark_splash"
        android:height="@dimen/ui_mark_splash"
        android:gravity="center"
        android:drawable="@drawable/ic_mark_on_dark" />
</layer-list>
