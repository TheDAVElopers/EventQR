<?xml version="1.0" encoding="utf-8"?>
<!-- Pass-head role tab underline (§4.6): active tab only, width = the label's own width, 6dp
     below the text block (the TextView's paddingBottom) and 2dp @color/ui_on_primary.
     A selector on state_selected so the binder only has to flip isSelected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <layer-list>
            <item android:gravity="bottom">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ui_on_primary" />
                    <size android:height="@dimen/ui_pass_head_tab_underline" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</selector>
