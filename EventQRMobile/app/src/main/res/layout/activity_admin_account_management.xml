<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_organizer_events_screen"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrTabHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/admin_account_management_account_management"
        app:subtitle="@string/admin_account_management_manage_user_accounts" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_14">

        <LinearLayout
            android:id="@+id/buttonCreateAdminAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            android:background="@drawable/bg_admin_surface_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_14"
            android:visibility="gone">

            <FrameLayout
                style="@style/Widget.EventQR.IconTile.R10.AccentStrong"
                android:layout_width="@dimen/tile_38"
                android:layout_height="@dimen/tile_38">

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_admin_users"
                    android:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_14"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_create_admin_account"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBody.Strong" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_account_management_super_admin_only_action"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/icon_18"
                android:layout_height="@dimen/icon_18"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/neutral" />
        </LinearLayout>

        <EditText
            android:id="@+id/inputAccountSearch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_admin_search_field"
            android:drawableEnd="@drawable/ic_action_search"
            android:drawablePadding="@dimen/space_sm"
            android:hint="@string/admin_account_management_search_accounts"
            android:paddingHorizontal="@dimen/space_14"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"/>

        <HorizontalScrollView
            android:id="@+id/filterChipsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:paddingHorizontal="@dimen/space_xs"
            android:paddingBottom="@dimen/space_xs">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filterChipsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_xs"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <ProgressBar
            android:id="@+id/progressAccountsLoading"
            android:layout_width="@dimen/icon_32"
            android:layout_height="@dimen/icon_32"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_lg"
            android:visibility="gone" />

        <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
            android:id="@+id/textAccountsPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"
            app:icon="@drawable/ic_admin_users"
            app:title="@string/admin_account_management_no_accounts_found_yet_2"
            app:subtitle="@string/admin_account_management_created_accounts_will_show_up_here" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAdminAccounts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_14"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_md" />
    </LinearLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
