<?xml version="1.0" encoding="utf-8"?>
<!--
    ADMIN ACCOUNT MANAGEMENT (§6.5, shared form pattern §6.6) - retires Gen A.

        Compact pass head (eyebrow ADMIN, title Accounts)
        Create admin account row - super admins only, a list row rather than a raised card
        48dp search field, then the shared chip row hosted as Compose (FilterChipRow)
        Hairline account rows; first load is skeleton rows at the loaded geometry, empty state is
        the shared one

    Deleted: the EventQrTabHeader, `bg_organizer_events_screen`, `bg_admin_surface_card`, the
    IconTile matrix tile, `bg_admin_search_field` + `ic_ui_search`, the Material ChipGroup
    (replaced by the shared FilterChipRow) and the elevation-bearing MaterialChip styling.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <include
            android:id="@+id/rowCreateAccount"
            layout="@layout/list_row_icon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_gutter"
            android:paddingTop="@dimen/space_8"
            android:paddingEnd="@dimen/ui_gutter">

            <EditText
                android:id="@+id/inputAccountSearch"
                style="@style/Widget.EventQR.Ui.TextField.Search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:drawableStart="@drawable/ic_ui_search"
                android:drawablePadding="@dimen/space_sm"
                android:hint="@string/ui_admin_accounts_search"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1" />
        </LinearLayout>

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeAccountFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/skeletonAccountsLoading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/ui_skeleton_loading"
            android:focusable="true"
            android:orientation="vertical"
            android:visibility="gone">

            <include
                layout="@layout/include_skeleton_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_row_height_tall" />

            <include
                layout="@layout/include_skeleton_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_row_height_tall" />

            <include
                layout="@layout/include_skeleton_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_row_height_tall" />

            <include
                layout="@layout/include_skeleton_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_row_height_tall" />

            <include
                layout="@layout/include_skeleton_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_row_height_tall" />

            <include
                layout="@layout/include_skeleton_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_row_height_tall" />
        </LinearLayout>

        <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
            android:id="@+id/textAccountsPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"
            app:icon="@drawable/ic_ui_group"
            app:subtitle="@string/ui_admin_accounts_empty_body"
            app:title="@string/ui_admin_accounts_empty_title" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAdminAccounts"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_16" />
    </LinearLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
