<?xml version="1.0" encoding="utf-8"?>
<!--
    ADMIN AUDIT LOGS (§6.5) - retires Gen A.

        Compact pass head (eyebrow ADMIN, title Audit logs)
        Shared FilterChipRow (Compose) for the category filter, outside the RecyclerView so the
        sticky day headers pin directly under it
        Action-led 64dp rows with a 96dp time column and sticky day headers (ItemDecoration)
        First load: six audit skeleton rows, not a centred spinner

    Deleted: the EventQrTabHeader, `bg_organizer_events_screen`, the card-per-entry rows with
    elevation, the 38dp tinted icon tiles, the per-category badge drawables and the centred
    ProgressBar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeAuditFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshAuditLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerAuditLogs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/space_24" />

            <LinearLayout
                android:id="@+id/skeletonAuditLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/ui_skeleton_loading"
                    android:focusable="true"
                android:orientation="vertical"
                android:visibility="gone">

                <include layout="@layout/include_skeleton_row_audit" />

                <include layout="@layout/include_skeleton_row_audit" />

                <include layout="@layout/include_skeleton_row_audit" />

                <include layout="@layout/include_skeleton_row_audit" />

                <include layout="@layout/include_skeleton_row_audit" />

                <include layout="@layout/include_skeleton_row_audit" />
            </LinearLayout>

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/textAuditPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:icon="@drawable/ic_ui_receipt_long"
                app:subtitle="@string/ui_admin_logs_empty_body"
                app:title="@string/ui_admin_logs_empty_title" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
