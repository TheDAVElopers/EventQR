<?xml version="1.0" encoding="utf-8"?>
<!--
    ADMIN DASHBOARD (§6.5 of MyFiles/EventQR-Redesign-Plan.md) - retires Gen A.

        Pass head   role tabs, title Admin, stub PENDING / ACCOUNTS / AUDIT
        alert row   ONE 56dp row inside the content flow - warning badge, copy, chevron.
                    It is a list row, never a full-width banner living in the header.
        OVERVIEW    metric rows for the numbers that do not fit the stub (max three)
        MANAGE      list rows; audit logs is the last row

    Deleted: the "Admin Portal" gradient header, the alert banner inside it, the 2x2 white
    cards with 42dp tinted icon tiles, the yellow bell tile, the red shield tile, the
    rainbow status drawables and the MANAGE placeholder skeleton (static rows, no load).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <!-- ═════════ Pass head: identity + tear + stub, max three stats ═════════ -->
    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_24">

                <!-- ═════════ The one actionable row: pending review ═════════ -->
                <LinearLayout
                    android:id="@+id/rowPendingAlert"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_metric_row_height"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingEnd="@dimen/ui_row_end"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/textPendingBadge"
                        style="@style/Widget.EventQR.Ui.StatusBadge.Warning"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/ui_badge_height"
                        android:text="@string/ui_admin_filter_pending" />

                    <TextView
                        android:id="@+id/textPendingAlert"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
                        android:textColor="@color/ui_text_primary"
                        tools:text="1 event request pending review" />

                    <ImageView
                        android:layout_width="@dimen/ui_chevron"
                        android:layout_height="@dimen/ui_chevron"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ui_chevron_right"
                        android:tint="@color/ui_text_secondary" />
                </LinearLayout>

                <!-- ═════════ OVERVIEW: metric rows, no cards ═════════ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_24"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:text="@string/ui_admin_eyebrow_overview"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                <include
                    android:id="@+id/metricActiveEvents"
                    layout="@layout/widget_metric_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8" />

                <include
                    android:id="@+id/metricTotalAccounts"
                    layout="@layout/widget_metric_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- ═════════ MANAGE ═════════ -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_32"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:text="@string/ui_admin_eyebrow_manage"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                <!--
                    MANAGE is a static navigation list, not a loaded list: nothing here waits on the
                    network, so there is no skeleton. The placeholder skeleton that used to sit
                    stacked on top of these rows (and was never hidden) is gone.
                -->
                <include
                    android:id="@+id/rowEventRequests"
                    layout="@layout/list_row_icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowAccountManagement"
                    layout="@layout/list_row_icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/rowAuditLogs"
                    layout="@layout/list_row_icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ProgressBar
                    android:id="@+id/progressDashboardLoading"
                    android:layout_width="@dimen/ui_loading_indicator"
                    android:layout_height="@dimen/ui_loading_indicator"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_16"
                    android:indeterminateTint="@color/ui_primary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/textDashboardLoadHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_8"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
