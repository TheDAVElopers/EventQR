<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_gradient"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_18"
        android:paddingTop="@dimen/space_22"
        android:paddingEnd="@dimen/space_18"
        android:paddingBottom="@dimen/space_20">

        <TextView
            android:id="@+id/textAdminPortalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_dashboard_admin_portal"
            android:textColor="@color/accent_container_strong"
            android:textAppearance="@style/TextAppearance.EventQR.TextBodyLarge" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textAdminName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/admin_dashboard_admin_user"
                android:textColor="@color/on_primary"
                android:textAppearance="@style/TextAppearance.EventQR.TitleMedium" />

            <TextView
                android:id="@+id/textAdminPortalDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/glyph_bullet"
                android:textColor="@color/outline_strong"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyLarge" />

            <TextView
                android:id="@+id/portalSwitcherChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/bg_portal_chip"
                android:paddingHorizontal="@dimen/space_10"
                android:paddingVertical="@dimen/space_xs"
                android:text="@string/admin_dashboard_admin"
                android:textColor="@color/on_primary"
                android:textAppearance="@style/TextAppearance.EventQR.TextOverline.Strong" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardPendingAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_admin_alert_banner"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_14"
            android:paddingVertical="@dimen/space_md">

            <ImageView
                android:layout_width="@dimen/icon_18"
                android:layout_height="@dimen/icon_18"
                android:src="@drawable/notification_bell"
                android:tint="@color/error_container" />

            <TextView
                android:id="@+id/textPendingAlert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_10"
                android:layout_weight="1"
                android:text="@string/admin_dashboard_1_event_request_pending_review"
                android:textColor="@color/error_container"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium.Strong" />

            <ImageView
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:src="@drawable/ic_chevron_right"
                android:tint="@color/deco_pink_light" />
        </LinearLayout>
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_14"
            android:paddingTop="@dimen/space_14"
            android:paddingEnd="@dimen/space_14">

            <ProgressBar
                android:id="@+id/progressDashboardLoading"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_horizontal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textDashboardLoadHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_admin_surface_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_14">

                    <FrameLayout
                        style="@style/Widget.EventQR.IconTile.R10.Warning"
                        android:layout_width="@dimen/tile_34"
                        android:layout_height="@dimen/tile_34">

                        <ImageView
                            android:layout_width="@dimen/icon_18"
                            android:layout_height="@dimen/icon_18"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_admin_bell"
                            android:tint="@color/warning" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/textPendingRequestsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/placeholder_zero"
                        android:textAppearance="@style/TextAppearance.EventQR.TitleLarge" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_dashboard_pending_requests"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/space_10"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_admin_surface_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_14">

                    <FrameLayout
                        style="@style/Widget.EventQR.IconTile.R10.AccentStrong"
                        android:layout_width="@dimen/tile_34"
                        android:layout_height="@dimen/tile_34">

                        <ImageView
                            android:layout_width="@dimen/icon_18"
                            android:layout_height="@dimen/icon_18"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_admin_users"
                            android:tint="@color/primary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/textTotalAccountsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/placeholder_zero"
                        android:textAppearance="@style/TextAppearance.EventQR.TitleLarge" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_dashboard_total_accounts"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_admin_surface_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_14">

                    <FrameLayout
                        style="@style/Widget.EventQR.IconTile.R10.Success"
                        android:layout_width="@dimen/tile_34"
                        android:layout_height="@dimen/tile_34">

                        <ImageView
                            android:layout_width="@dimen/icon_18"
                            android:layout_height="@dimen/icon_18"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_calendar"
                            android:tint="@color/success" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/textActiveEventsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/placeholder_zero"
                        android:textAppearance="@style/TextAppearance.EventQR.TitleLarge" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_active_events"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
                </LinearLayout>

                <Space
                    android:layout_width="@dimen/space_10"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_admin_surface_card"
                    android:orientation="vertical"
                    android:padding="@dimen/space_14">

                    <FrameLayout
                        style="@style/Widget.EventQR.IconTile.R10"
                        android:layout_width="@dimen/tile_34"
                        android:layout_height="@dimen/tile_34"
                        android:backgroundTint="@color/tile_pink">

                        <ImageView
                            android:layout_width="@dimen/icon_18"
                            android:layout_height="@dimen/icon_18"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_admin_shield"
                            android:tint="@color/danger" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/textAuditLogsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/placeholder_zero"
                        android:textAppearance="@style/TextAppearance.EventQR.TitleLarge" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/admin_dashboard_audit_logs"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
                </LinearLayout>
            </LinearLayout>


        </LinearLayout>
        </ScrollView>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>