<?xml version="1.0" encoding="utf-8"?>
<!--
    ADMIN DASHBOARD (§6.5 of MyFiles/EventQR-Redesign-Plan.md) - retires the menu build.

        Pass head   role tabs, title Admin (Super admin for SUPER_ADMIN),
                    stub PENDING / ACTIVE / ACCOUNTS - all three from GET /admin/stats
        WAITING ON YOU  up to three pending requests (requester, event + submitted, Pending review).
                        View all requests only beyond three; zero renders one No requests waiting row.
        RECENT ACTIVITY up to three read-only audit rows. Supplementary: hidden when the call fails.

    Deleted: OVERVIEW and its two metric rows, MANAGE and its three nav rows (they duplicated the
    bottom nav), the pending alert row, the bottom load hint and the bottom spinner. The bottom nav
    is the only entry point to Requests, Accounts and Logs.

    A dashboard block is never a bare entry point to a bottom-nav destination (§6.5).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <!-- ═════════ Pass head: identity + tear + stub, max three stats ═════════ -->
    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!--
        First load: the head's only unknown part is the three counts, but the skeleton keeps the
        loaded geometry so nothing jumps when the numbers arrive. Same three-block anatomy, bars
        from the shared skeleton component.
    -->
    <LinearLayout
        android:id="@+id/passHeadSkeleton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/ui_skeleton_loading"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/passHeadSkeletonIdentity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pass_head"
            android:minHeight="@dimen/ui_pass_head_identity_height"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_gutter"
            android:paddingEnd="@dimen/ui_gutter">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_pass_head_row_tabs"
                android:gravity="center_vertical"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal">

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="@dimen/ui_skeleton_meta_width"
                    android:layout_height="@dimen/ui_skeleton_bar_height" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:importantForAccessibility="noHideDescendants"
                android:minHeight="@dimen/ui_pass_head_title_min"
                android:orientation="horizontal">

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="@dimen/ui_skeleton_title_width"
                    android:layout_height="@dimen/ui_skeleton_bar_height" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_hairline"
            android:background="@drawable/divider_perforation_dark"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pass_stub"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:importantForAccessibility="noHideDescendants"
            android:minHeight="@dimen/ui_pass_head_stub_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ui_gutter">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="@dimen/ui_pass_head_stub_pad_v"
                android:paddingEnd="@dimen/ui_pass_head_stat_cell_pad"
                android:paddingBottom="@dimen/ui_pass_head_stub_pad_v">

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_skeleton_bar_height" />

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_skeleton_bar_height"
                    android:layout_marginTop="@dimen/ui_pass_head_stat_label_gap" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/stroke_hairline"
                android:layout_height="match_parent"
                android:background="@color/ui_on_dark_hairline"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_pass_head_stat_cell_pad"
                android:paddingTop="@dimen/ui_pass_head_stub_pad_v"
                android:paddingEnd="@dimen/ui_pass_head_stat_cell_pad"
                android:paddingBottom="@dimen/ui_pass_head_stub_pad_v">

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_skeleton_bar_height" />

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_skeleton_bar_height"
                    android:layout_marginTop="@dimen/ui_pass_head_stat_label_gap" />
            </LinearLayout>

            <View
                android:layout_width="@dimen/stroke_hairline"
                android:layout_height="match_parent"
                android:background="@color/ui_on_dark_hairline"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_pass_head_stat_cell_pad"
                android:paddingTop="@dimen/ui_pass_head_stub_pad_v"
                android:paddingBottom="@dimen/ui_pass_head_stub_pad_v">

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_skeleton_bar_height" />

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_skeleton_bar_height"
                    android:layout_marginTop="@dimen/ui_pass_head_stat_label_gap" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_32">

                <!-- ═════════ WAITING ON YOU - the primary block ═════════ -->
                <TextView
                    android:id="@+id/textWaitingEyebrow"
                    style="@style/TextAppearance.EventQR.Type.Eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_24"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:text="@string/ui_admin_eyebrow_waiting" />

                <!-- First load: skeleton rows at the loaded 72dp geometry, no spinner. -->
                <LinearLayout
                    android:id="@+id/skeletonDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical">

                    <include
                        layout="@layout/include_skeleton_row"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ui_skeleton_row_height" />

                    <include
                        layout="@layout/include_skeleton_row"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ui_skeleton_row_height" />

                    <include
                        layout="@layout/include_skeleton_row"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ui_skeleton_row_height" />
                </LinearLayout>

                <!-- Stats failed: in-flow error block where the queue was, one Retry. -->
                <LinearLayout
                    android:id="@+id/layoutDashboardError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_4"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:background="@drawable/bg_ui_card"
                    android:orientation="vertical"
                    android:padding="@dimen/ui_card_padding"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/txtDashboardError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/ui_admin_dashboard_error"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                        android:textColor="@color/ui_text_secondary" />

                    <Button
                        android:id="@+id/btnDashboardRetry"
                        style="@style/Widget.EventQR.Ui.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/ui_button_height_inline"
                        android:layout_marginTop="@dimen/space_8"
                        android:minWidth="@dimen/ui_touch_min"
                        android:text="@string/common_retry" />
                </LinearLayout>

                <!-- The preview rows are inflated at bind time (list_row_icon + ListRowBinder). -->
                <LinearLayout
                    android:id="@+id/pendingRowsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical" />

                <!-- Loaded, genuinely zero: one 56dp row, no chevron, no click action. -->
                <TextView
                    android:id="@+id/textNoPending"
                    style="@style/Widget.EventQR.Ui.ListRow.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_8"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:text="@string/ui_admin_pending_empty"
                    android:textColor="@color/ui_text_primary"
                    android:visibility="gone" />

                <!-- Truncated preview only: extends the queue, never a second nav entry. -->
                <TextView
                    android:id="@+id/btnViewAllRequests"
                    style="@style/TextAppearance.EventQR.Type.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ui_touch_min"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_2"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minWidth="@dimen/ui_touch_min"
                    android:text="@string/ui_admin_view_all_requests"
                    android:textColor="@color/ui_primary"
                    android:visibility="gone" />

                <!-- ═════════ RECENT ACTIVITY - read-only, supplementary ═════════ -->
                <LinearLayout
                    android:id="@+id/recentActivityBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/TextAppearance.EventQR.Type.Eyebrow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ui_gutter"
                        android:layout_marginTop="@dimen/space_32"
                        android:layout_marginEnd="@dimen/ui_gutter"
                        android:text="@string/ui_admin_eyebrow_recent" />

                    <LinearLayout
                        android:id="@+id/auditRowsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
