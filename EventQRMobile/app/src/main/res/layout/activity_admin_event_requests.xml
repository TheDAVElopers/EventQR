<?xml version="1.0" encoding="utf-8"?>
<!--
    ADMIN EVENT REQUESTS (§6.5 of MyFiles/EventQR-Redesign-Plan.md) - retires Gen A.

        Compact pass head (eyebrow ADMIN, title Event requests, count in the trailing slot)
        Chip row: All / Pending / Approved / Rejected - 36dp, radius 4, no check icon
        Rows: the shared EventRequestCard (hairline, one status badge), no per-status drawables

    Deleted: the EventQrTabHeader, `bg_organizer_events_screen`, the hand-styled 32dp chips with
    per-state drawables, the card-per-request tinted badge family and the elevation-bearing
    error box.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- ═════════ Chip row: the filter is the fill, never a check icon ═════════ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/ui_gutter"
        android:paddingBottom="@dimen/space_8"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_height"
                android:text="@string/ui_admin_filter_all" />

            <TextView
                android:id="@+id/chipPending"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_height"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:text="@string/ui_admin_filter_pending" />

            <TextView
                android:id="@+id/chipApproved"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_height"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:text="@string/ui_admin_filter_approved" />

            <TextView
                android:id="@+id/chipRejected"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_height"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:text="@string/ui_admin_filter_rejected" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshRequests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRequests"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_8"
                android:paddingEnd="@dimen/ui_gutter"
                android:paddingBottom="@dimen/space_24" />

            <ProgressBar
                android:id="@+id/loadingRequests"
                android:layout_width="@dimen/ui_loading_indicator"
                android:layout_height="@dimen/ui_loading_indicator"
                android:layout_gravity="center"
                android:indeterminateTint="@color/ui_primary"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_8"
                android:paddingEnd="@dimen/ui_gutter">

                <TextView
                    android:id="@+id/textError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_error"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/buttonRetry"
                    style="@style/Widget.EventQR.Ui.Button.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ui_button_height_inline"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/common_retry"
                    android:visibility="gone" />
            </LinearLayout>

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/textEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:icon="@drawable/ic_ui_pending_actions"
                app:subtitle="@string/ui_admin_requests_empty_body"
                app:title="@string/ui_admin_requests_empty_title" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
