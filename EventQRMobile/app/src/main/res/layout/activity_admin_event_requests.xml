<?xml version="1.0" encoding="utf-8"?>
<!--
    ADMIN EVENT REQUESTS (§6.5 of MyFiles/EventQR-Redesign-Plan.md) - retires Gen A.

        Compact pass head (eyebrow ADMIN, title Event requests, count in the trailing slot)
        Chip row: All / Pending / Approved / Rejected - 36dp, radius 4, no check icon
        Rows: flat 88dp page rows (requester tile, event name, requester + submitted, one badge)

    Deleted: the EventQrTabHeader, `bg_organizer_events_screen`, the hand-styled 32dp chips with
    per-state drawables, the card-per-request tinted badge family and the elevation-bearing
    error box.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- ═════════ Chip row: the filter is the fill, never a check icon ═════════ -->
    <!-- §5.6: the filter row wraps on a Flow, it never scrolls. Three chips per line; 36dp fill
         inside a 48dp touch target, wrap height so a grown label is not clipped. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/ui_gutter"
        android:paddingBottom="@dimen/space_8">

        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/chipFlow"
            style="@style/Widget.EventQR.Ui.ChipFlow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="chipAll,chipPending,chipApproved,chipRejected"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/chipAll"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/ui_admin_filter_all" />

        <TextView
            android:id="@+id/chipPending"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/ui_admin_filter_pending" />

        <TextView
            android:id="@+id/chipApproved"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/ui_admin_filter_approved" />

        <TextView
            android:id="@+id/chipRejected"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/ui_admin_filter_rejected" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshRequests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRequests"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="@dimen/space_8"
                android:paddingBottom="@dimen/space_24" />

            <LinearLayout
                android:id="@+id/skeletonRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/ui_skeleton_loading"
                android:focusable="true"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_tall" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_tall" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_tall" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_tall" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_tall" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_tall" />
            </LinearLayout>

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/textEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:icon="@drawable/ic_ui_pending_actions"
                app:subtitle="@string/ui_admin_requests_empty_body"
                app:title="@string/ui_admin_requests_empty_title" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
