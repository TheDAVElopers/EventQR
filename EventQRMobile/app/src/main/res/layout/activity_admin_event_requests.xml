<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_organizer_events_screen"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrTabHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/admin_event_requests_event_requests"
        app:subtitle="@string/admin_event_requests_review_event_creation_requests" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_sm">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/control_height_32"
                    android:gravity="center"
                    android:minWidth="46dp"
                    android:paddingHorizontal="@dimen/space_14"
                    android:text="@string/common_all"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium.Strong" />

                <TextView
                    android:id="@+id/chipPending"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/control_height_32"
                    android:layout_marginStart="@dimen/space_sm"
                    android:gravity="center"
                    android:minWidth="82dp"
                    android:paddingHorizontal="@dimen/space_14"
                    android:text="@string/admin_event_requests_pending"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium.Strong" />

                <TextView
                    android:id="@+id/chipApproved"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/control_height_32"
                    android:layout_marginStart="@dimen/space_sm"
                    android:gravity="center"
                    android:minWidth="88dp"
                    android:paddingHorizontal="@dimen/space_14"
                    android:text="@string/common_approved"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium.Strong" />

                <TextView
                    android:id="@+id/chipRejected"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/control_height_32"
                    android:layout_marginStart="@dimen/space_sm"
                    android:gravity="center"
                    android:minWidth="86dp"
                    android:paddingHorizontal="@dimen/space_14"
                    android:text="@string/common_rejected"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium.Strong" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshRequests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRequests"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_18" />

            <ProgressBar
                android:id="@+id/loadingRequests"
                android:layout_width="@dimen/icon_tile_sm"
                android:layout_height="@dimen/icon_tile_sm"
                android:layout_gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingTop="@dimen/space_md">

                <TextView
                    android:id="@+id/textError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_error_box"
                    android:padding="@dimen/space_md"
                    android:textColor="@color/danger"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium"
                    android:visibility="gone" />

                <Button
                    style="@style/Widget.EventQR.Button.Outline"
                    android:id="@+id/buttonRetry"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/space_10"
                    android:text="@string/common_retry"
                    android:visibility="gone" />
            </LinearLayout>

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
            android:id="@+id/textEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:icon="@drawable/ic_event_request"
            app:title="@string/common_no_event_requests_yet"
            app:subtitle="@string/admin_event_requests_requests_from_organizers_will_show_u" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>