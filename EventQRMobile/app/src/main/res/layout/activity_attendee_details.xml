<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - ATTENDEE DETAILS (6.4).

        Top bar      56dp, back + title
        Identity     left-aligned avatar tile, name title_l, email/phone body_s - no centred column
        Spec table   overline label left / body value right, 1dp hairlines, no icons
        Transactions grouped rows, one hairline divider inset
        Footer       ghost "View full log"

    Deleted: the centred profile card, the two-column icon row blocks, the GradientDrawable status
    pills, the card-per-section stack and the centred error block.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/attendee_details_attendee_details" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_32">

            <!-- Identity -->
            <LinearLayout
                android:id="@+id/cardAttendeeProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_24"
                android:paddingEnd="@dimen/ui_gutter"
                android:paddingBottom="@dimen/space_16">

                <TextView
                    android:id="@+id/txtDetailInitial"
                    android:layout_width="@dimen/tile_44"
                    android:layout_height="@dimen/tile_44"
                    android:background="@drawable/bg_ui_icon_tile"
                    android:gravity="center"
                    android:textColor="@color/ui_primary"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.TitleLarge"
                    tools:text="J" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtDetailName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.TitleLarge"
                        android:textColor="@color/ui_text_primary"
                        tools:text="Juan Dela Cruz" />

                    <TextView
                        android:id="@+id/txtDetailEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                        android:textColor="@color/ui_text_secondary"
                        tools:text="juan@example.com" />

                    <TextView
                        android:id="@+id/txtDetailPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                        android:textColor="@color/ui_text_secondary"
                        tools:text="+63 912 000 0000" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:background="@color/ui_hairline"
                android:importantForAccessibility="no" />

            <!-- Spec table: overline label left, value right, hairline under. No icons, no cards. -->
            <LinearLayout
                android:id="@+id/cardAttendeeDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingEnd="@dimen/ui_gutter">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_detail_event"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <TextView
                        android:id="@+id/txtDetailEventValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <View style="@style/Widget.EventQR.Ui.ListRow.Divider" android:layout_marginStart="0dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingEnd="@dimen/ui_gutter">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_detail_registration_id"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <TextView
                        android:id="@+id/txtDetailRegistrationIdValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericS"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <View style="@style/Widget.EventQR.Ui.ListRow.Divider" android:layout_marginStart="0dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingEnd="@dimen/ui_gutter">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_detail_status"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <TextView
                        android:id="@+id/txtDetailStatusValue"
                        style="@style/Widget.EventQR.Ui.StatusBadge.Neutral"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/ui_badge_height" />
                </LinearLayout>

                <View style="@style/Widget.EventQR.Ui.ListRow.Divider" android:layout_marginStart="0dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingEnd="@dimen/ui_gutter">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_detail_id_status"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <TextView
                        android:id="@+id/txtDetailIdStatusValue"
                        style="@style/Widget.EventQR.Ui.StatusBadge.Neutral"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/ui_badge_height" />
                </LinearLayout>

                <View style="@style/Widget.EventQR.Ui.ListRow.Divider" android:layout_marginStart="0dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingEnd="@dimen/ui_gutter">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_detail_registered"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <TextView
                        android:id="@+id/txtDetailRegisteredValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericS"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <View style="@style/Widget.EventQR.Ui.ListRow.Divider" android:layout_marginStart="0dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingEnd="@dimen/ui_gutter">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_detail_last_activity"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <TextView
                        android:id="@+id/txtDetailLastActivityValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericS"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <View style="@style/Widget.EventQR.Ui.ListRow.Divider" android:layout_marginStart="0dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingEnd="@dimen/ui_gutter">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_detail_points"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <TextView
                        android:id="@+id/txtDetailPointsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericS"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- Transactions -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:text="@string/ui_organizer_detail_transactions"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

            <LinearLayout
                android:id="@+id/cardTransactionHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/transactionHistoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txtNoTransactions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_16"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:text="@string/ui_organizer_no_transactions"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnViewFullLog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_button_height_inline"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_8"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="@dimen/ui_touch_min"
                android:paddingStart="@dimen/space_12"
                android:paddingEnd="@dimen/space_12"
                android:text="@string/ui_organizer_detail_view_log"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Label"
                android:textColor="@color/ui_primary" />

            <!-- Error: the shared empty state with Retry, never a hand-rolled card. -->
            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/layoutAttendeeError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:icon="@drawable/ic_ui_notifications_none"
                app:title="@string/attendee_details_record_load_failed" />

            <!-- Skeleton mirrors the loaded geometry: 44dp identity tile, then six 56dp spec rows. -->
            <LinearLayout
                android:id="@+id/skeletonLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_16">

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/tile_44"
                        android:layout_height="@dimen/tile_44" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <include
                            layout="@layout/include_skeleton_block"
                            android:layout_width="@dimen/ui_skeleton_title_width"
                            android:layout_height="@dimen/ui_skeleton_bar_height" />

                        <include
                            layout="@layout/include_skeleton_block"
                            android:layout_width="@dimen/ui_skeleton_meta_width"
                            android:layout_height="@dimen/ui_skeleton_bar_height"
                            android:layout_marginTop="@dimen/space_sm" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingEnd="@dimen/ui_gutter">

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_meta_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_meta_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height" />
                </LinearLayout>

                <View style="@style/Widget.EventQR.Ui.ListRow.Divider" android:layout_marginStart="0dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingEnd="@dimen/ui_gutter">

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_meta_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_meta_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height" />
                </LinearLayout>

                <View style="@style/Widget.EventQR.Ui.ListRow.Divider" android:layout_marginStart="0dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingEnd="@dimen/ui_gutter">

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_meta_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_meta_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height" />
                </LinearLayout>

                <View style="@style/Widget.EventQR.Ui.ListRow.Divider" android:layout_marginStart="0dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingEnd="@dimen/ui_gutter">

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_meta_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_meta_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height" />
                </LinearLayout>

                <View style="@style/Widget.EventQR.Ui.ListRow.Divider" android:layout_marginStart="0dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingEnd="@dimen/ui_gutter">

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_meta_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_meta_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height" />
                </LinearLayout>

                <View style="@style/Widget.EventQR.Ui.ListRow.Divider" android:layout_marginStart="0dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingEnd="@dimen/ui_gutter">

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_meta_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_meta_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
