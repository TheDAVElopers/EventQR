<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - ATTENDEES (6.4).

        Pass head        ORGANIZER tab, title Attendees, stub REGISTERED / CHECKED IN / EXITED
        Event selector   56dp field row (not a card wrapping a hidden spinner)
        Grouped rows     avatar + name + email, one status badge, hairline divider inset 76dp
        Search           44dp icon action that opens the search screen (which owns the filters)

    Deleted: the 44 raw dp literals, per-card attendee blocks, the tinted stat card, the centred
    empty block and the PopupWindow built from a GradientDrawable.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Event selector: one field row. -->
    <LinearLayout
        android:id="@+id/layoutEventSelectorHost"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_organizer_selector_height"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:background="@drawable/bg_ui_field"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_12">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                android:textColor="@color/ui_text_primary" />

            <TextView
                android:id="@+id/txtEventSelectorDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_text_secondary" />
        </LinearLayout>

        <ImageView
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:layout_marginStart="@dimen/space_8"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ui_chevron_right"
            android:tint="@color/ui_text_secondary" />
    </LinearLayout>

    <!-- Section row: eyebrow + the one search action. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_touch_min"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_24"
        android:layout_marginEnd="@dimen/space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtCurrentEventLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ui_organizer_attendees"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

        <ImageView
            android:id="@+id/btnFilter"
            style="@style/Widget.EventQR.Ui.Button.Icon"
            android:layout_width="@dimen/ui_touch_min"
            android:layout_height="@dimen/ui_touch_min"
            android:contentDescription="@string/ui_organizer_search_attendees"
            android:src="@drawable/ic_ui_search"
            android:tint="@color/ui_text_primary" />
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshAttendeeManagement"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerAttendees"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/space_24" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/layoutAttendeesEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:icon="@drawable/ic_ui_person"
                app:subtitle="@string/attendee_management_attendees_will_appear_here_once_they"
                app:title="@string/attendee_management_no_attendees_registered_yet" />

            <include
                android:id="@+id/skeletonLoading"
                layout="@layout/include_skeleton_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:visibility="gone" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/layoutBottomNavHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
