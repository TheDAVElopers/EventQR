<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAttendeeManagement"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_organizer_events_screen"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrTabHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/attendee_management_attendees"
        app:subtitle="@string/attendee_management_view_and_manage_event_attendees">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnFilterCard"
            android:layout_width="@dimen/tile_42"
            android:layout_height="@dimen/tile_42"
            style="@style/Widget.EventQR.Card.Compact">

            <ImageButton
                android:id="@+id/btnFilter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/attendee_management_search_attendees"
                android:padding="@dimen/space_10"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search"
                app:tint="@color/primary" />
        </com.google.android.material.card.MaterialCardView>
    </com.thedavelopers.eventqr.ui.components.EventQrTabHeader>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingTop="@dimen/space_sm">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCurrentEvent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/accent_container"
            style="@style/Widget.EventQR.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_14">

                <TextView
                    android:id="@+id/txtCurrentEventLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/common_current_event"
                    android:textColor="@color/text_label"
                    android:textAppearance="@style/TextAppearance.EventQR.TextOverline.Strong" />

                <LinearLayout
                    android:id="@+id/layoutEventSelectorHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/tile_38"
                        android:layout_height="@dimen/tile_38"
                        style="@style/Widget.EventQR.IconTile.Secondary">

                        <ImageView
                            android:layout_width="@dimen/icon_18"
                            android:layout_height="@dimen/icon_18"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_10"
                        android:layout_marginEnd="@dimen/space_sm"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtEventTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/attendee_management_choose_an_event"
                            android:textAppearance="@style/TextAppearance.EventQR.TextBody.Strong" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/neutral_label" />

                            <TextView
                                android:id="@+id/txtEventSelectorDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_xs"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/placeholder_dash"
                                android:textColor="@color/text_label"
                                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="@color/primary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAttendeeStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            style="@style/Widget.EventQR.Card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="@dimen/tile_38"
                        android:layout_height="@dimen/tile_38"
                        android:layout_marginBottom="@dimen/space_sm"
                        style="@style/Widget.EventQR.IconTile.Secondary">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_group"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtTotalCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:text="@string/placeholder_zero"
                        android:textAppearance="@style/TextAppearance.EventQR.TextHeadline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:gravity="center_horizontal"
                        android:maxLines="1"
                        android:text="@string/common_total"
                        android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/surface_muted" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="@dimen/tile_38"
                        android:layout_height="@dimen/tile_38"
                        android:layout_marginBottom="@dimen/space_sm"
                        style="@style/Widget.EventQR.IconTile.Success">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_check_circle_green"
                            app:tint="@color/success" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtCheckedInCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:text="@string/placeholder_zero"
                        android:textAppearance="@style/TextAppearance.EventQR.TextHeadline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:gravity="center_horizontal"
                        android:maxLines="1"
                        android:text="@string/common_checked_in"
                        android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/surface_muted" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="@dimen/tile_38"
                        android:layout_height="@dimen/tile_38"
                        android:layout_marginBottom="@dimen/space_sm"
                        style="@style/Widget.EventQR.IconTile.Round.Muted">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/outline_block_24"
                            app:tint="@color/text_secondary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtExitedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:text="@string/placeholder_zero"
                        android:textAppearance="@style/TextAppearance.EventQR.TextHeadline" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:gravity="center_horizontal"
                        android:maxLines="1"
                        android:text="@string/search_attendees_exited"
                        android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshAttendeeManagement"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/space_20"
            android:paddingTop="@dimen/space_md">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerAttendees"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:paddingBottom="@dimen/space_xl" />

            <ProgressBar
                android:id="@+id/progressAttendees"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutAttendeesEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_xxl"
                android:paddingVertical="@dimen/space_xl"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgAttendeesEmptyIcon"
                    android:layout_width="@dimen/tile_72"
                    android:layout_height="@dimen/tile_72"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_group"
                    app:tint="@color/deco_empty_icon" />

                <TextView
                    android:id="@+id/txtAttendeesEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:gravity="center"
                    android:text="@string/attendee_management_no_attendees_registered_yet"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.EventQR.TitleMedium" />

                <TextView
                    android:id="@+id/txtAttendeesEmptySub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:gravity="center"
                    android:text="@string/attendee_management_attendees_will_appear_here_once_they"
                    android:textColor="@color/text_label"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/skeletonLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_10"
                    android:background="@drawable/bg_staff_skeleton_card"
                    android:gravity="center_vertical"
                    android:minHeight="82dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_14">

                    <View
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_staff_skeleton_date_block" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_14"
                        android:layout_marginEnd="@dimen/space_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_staff_skeleton_bar" />

                        <View
                            android:layout_width="140dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="@dimen/space_sm"
                            android:background="@drawable/bg_staff_skeleton_bar" />

                        <View
                            android:layout_width="80dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="@dimen/space_6"
                            android:background="@drawable/bg_staff_skeleton_bar" />
                    </LinearLayout>

                    <View
                        android:layout_width="64dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_staff_skeleton_bar" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_10"
                    android:background="@drawable/bg_staff_skeleton_card"
                    android:gravity="center_vertical"
                    android:minHeight="82dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_14">

                    <View
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_staff_skeleton_date_block" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_14"
                        android:layout_marginEnd="@dimen/space_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_staff_skeleton_bar" />

                        <View
                            android:layout_width="150dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="@dimen/space_sm"
                            android:background="@drawable/bg_staff_skeleton_bar" />

                        <View
                            android:layout_width="90dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="@dimen/space_6"
                            android:background="@drawable/bg_staff_skeleton_bar" />
                    </LinearLayout>

                    <View
                        android:layout_width="72dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_staff_skeleton_bar" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_staff_skeleton_card"
                    android:gravity="center_vertical"
                    android:minHeight="82dp"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_14">

                    <View
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_staff_skeleton_date_block" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_14"
                        android:layout_marginEnd="@dimen/space_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="14dp"
                            android:background="@drawable/bg_staff_skeleton_bar" />

                        <View
                            android:layout_width="120dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="@dimen/space_sm"
                            android:background="@drawable/bg_staff_skeleton_bar" />

                        <View
                            android:layout_width="100dp"
                            android:layout_height="10dp"
                            android:layout_marginTop="@dimen/space_6"
                            android:background="@drawable/bg_staff_skeleton_bar" />
                    </LinearLayout>

                    <View
                        android:layout_width="56dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_staff_skeleton_bar" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/layoutBottomNavHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
