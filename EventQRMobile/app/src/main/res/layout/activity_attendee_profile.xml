<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_gradient"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingTop="@dimen/space_xxl"
        android:paddingBottom="@dimen/space_28">

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_profile_initial_avatar">

            <TextView
                android:id="@+id/txtProfileInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/on_primary"
                android:textAppearance="@style/TextAppearance.EventQR.Display.Medium"
                tools:text="J" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtProfileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_14"
            android:gravity="center"
            android:textColor="@color/on_primary"
            android:textAppearance="@style/TextAppearance.EventQR.TitleMedium"
            tools:text="Juan Dela Cruz" />

        <TextView
            android:id="@+id/txtProfileRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:background="@drawable/bg_profile_role_badge"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingVertical="@dimen/space_xs"
            android:textColor="@color/on_primary"
            android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Strong"
            tools:text="Attendee" />
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ==================== HEADER ==================== -->
                

                <!-- ==================== ERROR / RETRY ==================== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_lg">

                    <TextView
                        android:id="@+id/txtProfileError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:gravity="center"
                        android:textColor="@color/error"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium"
                        android:visibility="gone"
                        tools:text="Unable to load profile. Please check your connection." />

                    <Button
                        android:id="@+id/btnProfileRetry"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_marginTop="@dimen/space_sm"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="@string/common_retry"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        app:cornerRadius="@dimen/radius_sm"
                        app:strokeColor="@color/primary"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- ==================== SKELETON LOADING ==================== -->
                <include
                    android:id="@+id/skeletonLoading"
                    layout="@layout/include_skeleton_profile" />

                <!-- ==================== PROFILE MENU CONTENT ==================== -->
                <LinearLayout
                    android:id="@+id/layoutProfileMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_lg"
                    android:paddingTop="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_xl">

                    <Button
                        android:id="@+id/btnEditProfile"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <!-- ==================== SECTION 1: PROFILE INFORMATION ==================== -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_6"
                        android:text="@string/attendee_profile_profile_information"
                        android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Strong"
                        android:letterSpacing="@dimen/tracking_label_05" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardProfileDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        style="@style/Widget.EventQR.Card.Compact">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Name row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/button_primary_height"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/space_lg">

                                <FrameLayout
                                    android:layout_width="@dimen/icon_tile_sm"
                                    android:layout_height="@dimen/icon_tile_sm">

                                    <ImageView
                                        android:layout_width="@dimen/icon_md"
                                        android:layout_height="@dimen/icon_md"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_profile_person"
                                        app:tint="@color/text_secondary" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:text="@string/attendee_profile_name"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

                                <TextView
                                    android:id="@+id/txtProfileDetailName"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium.Strong"
                                    tools:text="Juan Dela Cruz" />
                            </LinearLayout>

                            <View
                                style="@style/Widget.EventQR.Divider"
                                android:layout_marginStart="@dimen/row_text_inset"
                                android:layout_marginEnd="@dimen/space_lg" />

                            <!-- Email row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/button_primary_height"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/space_lg">

                                <FrameLayout
                                    android:layout_width="@dimen/icon_tile_sm"
                                    android:layout_height="@dimen/icon_tile_sm">

                                    <ImageView
                                        android:layout_width="@dimen/icon_md"
                                        android:layout_height="@dimen/icon_md"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_profile_mail"
                                        app:tint="@color/text_secondary" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:text="@string/common_email"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

                                <TextView
                                    android:id="@+id/txtProfileDetailEmail"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium"
                                    tools:text="juan.delacruz@example.com" />
                            </LinearLayout>

                            <View
                                style="@style/Widget.EventQR.Divider"
                                android:layout_marginStart="@dimen/row_text_inset"
                                android:layout_marginEnd="@dimen/space_lg" />

                            <!-- Phone row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/button_primary_height"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/space_lg">

                                <FrameLayout
                                    android:layout_width="@dimen/icon_tile_sm"
                                    android:layout_height="@dimen/icon_tile_sm">

                                    <ImageView
                                        android:layout_width="@dimen/icon_md"
                                        android:layout_height="@dimen/icon_md"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_profile_phone"
                                        app:tint="@color/text_secondary" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:text="@string/attendee_profile_phone"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

                                <TextView
                                    android:id="@+id/txtProfileDetailPhone"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:layout_weight="1"
                                    android:gravity="end"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium"
                                    tools:text="+63 912 345 6789" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ==================== SECTION 2: ACCOUNT & ACTIVITY ==================== -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_20"
                        android:paddingHorizontal="@dimen/space_xs"
                        android:paddingBottom="@dimen/space_6"
                        android:text="@string/attendee_profile_account_activity"
                        android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Strong"
                        android:letterSpacing="@dimen/tracking_label_05" />

                    <!-- Unified Navigation Container -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAccountMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        style="@style/Widget.EventQR.Card.Compact">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- 1. Edit Profile Row -->
                            <LinearLayout
                                android:id="@+id/cardEditProfile"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/button_primary_height"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/space_lg">

                                <FrameLayout
                                    android:layout_width="@dimen/icon_tile_sm"
                                    android:layout_height="@dimen/icon_tile_sm">

                                    <ImageView
                                        android:layout_width="@dimen/icon_md"
                                        android:layout_height="@dimen/icon_md"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_edit_pencil"
                                        app:tint="@color/text_primary" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:layout_weight="1"
                                    android:text="@string/attendee_profile_edit_profile"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextBody.Strong" />

                                <ImageView
                                    android:layout_width="@dimen/icon_sm"
                                    android:layout_height="@dimen/icon_sm"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="@color/neutral" />
                            </LinearLayout>

                            <View
                                style="@style/Widget.EventQR.Divider"
                                android:layout_marginStart="@dimen/row_text_inset"
                                android:layout_marginEnd="@dimen/space_lg" />

                            <!-- 2. Transaction History Row -->
                            <LinearLayout
                                android:id="@+id/cardTransactionHistory"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/button_primary_height"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/space_lg">

                                <FrameLayout
                                    android:layout_width="@dimen/icon_tile_sm"
                                    android:layout_height="@dimen/icon_tile_sm">

                                    <ImageView
                                        android:layout_width="@dimen/icon_md"
                                        android:layout_height="@dimen/icon_md"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_history"
                                        app:tint="@color/text_primary" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:layout_weight="1"
                                    android:text="@string/common_transaction_history"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextBody.Strong" />

                                <ImageView
                                    android:layout_width="@dimen/icon_sm"
                                    android:layout_height="@dimen/icon_sm"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="@color/neutral" />
                            </LinearLayout>

                            <View
                                style="@style/Widget.EventQR.Divider"
                                android:layout_marginStart="@dimen/row_text_inset"
                                android:layout_marginEnd="@dimen/space_lg" />

                            <!-- 3. Claimed Rewards Row -->
                            <LinearLayout
                                android:id="@+id/cardClaimedRewards"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/button_primary_height"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/space_lg">

                                <FrameLayout
                                    android:layout_width="@dimen/icon_tile_sm"
                                    android:layout_height="@dimen/icon_tile_sm">

                                    <ImageView
                                        android:layout_width="@dimen/icon_md"
                                        android:layout_height="@dimen/icon_md"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_nav_gift"
                                        app:tint="@color/text_primary" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:layout_weight="1"
                                    android:text="@string/attendee_profile_claimed_rewards"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextBody.Strong" />

                                <ImageView
                                    android:layout_width="@dimen/icon_sm"
                                    android:layout_height="@dimen/icon_sm"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="@color/neutral" />
                            </LinearLayout>

                            <View
                                style="@style/Widget.EventQR.Divider"
                                android:layout_marginStart="@dimen/row_text_inset"
                                android:layout_marginEnd="@dimen/space_lg" />

                            <!-- 4. My Event Requests Row -->
                            <LinearLayout
                                android:id="@+id/cardMyEventRequests"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/button_primary_height"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="@dimen/space_lg">

                                <FrameLayout
                                    android:layout_width="@dimen/icon_tile_sm"
                                    android:layout_height="@dimen/icon_tile_sm">

                                    <ImageView
                                        android:layout_width="@dimen/icon_md"
                                        android:layout_height="@dimen/icon_md"
                                        android:layout_gravity="center"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_event_request"
                                        app:tint="@color/text_primary" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_md"
                                    android:layout_weight="1"
                                    android:text="@string/attendee_profile_my_event_requests"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextBody.Strong" />

                                <ImageView
                                    android:layout_width="@dimen/icon_sm"
                                    android:layout_height="@dimen/icon_sm"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_chevron_right"
                                    app:tint="@color/neutral" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ==================== SECTION 3: SIGN OUT ACTION ==================== -->
                    <LinearLayout
                        android:id="@+id/cardSignOut"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/space_20"
                        android:background="@drawable/bg_sign_out_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_lg">

                        <FrameLayout
                            android:layout_width="@dimen/icon_tile_sm"
                            android:layout_height="@dimen/icon_tile_sm">

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_logout"
                                app:tint="@color/error" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:text="@string/common_sign_out"
                            android:textColor="@color/error"
                            android:textAppearance="@style/TextAppearance.EventQR.TextBody.Medium" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
