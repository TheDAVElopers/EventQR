<?xml version="1.0" encoding="utf-8"?>
<!--
    Attendee profile (§6.2 of MyFiles/EventQR-Redesign-Plan.md, v1.34; head added in v1.41).

        Compact pass head (title Profile) pinned above the scroll: the same flat ui_primary band,
        tear and status-bar inset the attendee Rewards screen and the admin Accounts / Requests
        screens carry, so this page opens on brand ink like every other secondary screen instead
        of on a bare bright page. `passHeadIdentity` takes `applyEventQrTopInsetPadding()`; the
        role eyebrow stays retired (BindCompact is called without one, v1.40), there is no count
        (a profile has no result set) and no back arrow (a top-level nav destination).

        Everything else scrolls: identity block, ACCOUNT, ACTIVITY, Sign out, version. The
        identity block is inside the ScrollView so the whole page moves as one surface below the
        band and the pull-to-refresh gesture is the page's (v1.31).

        Identity block: 64dp primary_container avatar square, name in title_l (2 lines), email in
        body_s secondary at the full width. The role pill is deleted: every role reaches this
        screen, so a badge that always read "Attendee" described the portal, not the person.

        ACCOUNT leads: ACTIVITY sits between the person and their own account row, so the row that
        belongs to them comes first. One Card.Grouped with Edit profile only; the row always
        carries a meta line - the real phone number, else "Name and phone number" - so its height
        never changes with the data. 72dp rows / 88dp with a two-line meta, 40dp tile, 20dp icon,
        stock ListRow.Divider inset 76dp to the title edge (hidden here: it is the only row).
        ACTIVITY: one Card.Grouped with three list_row_icon rows (Transaction history, Claimed
        rewards, My event requests), each with a meta line and a trailing chevron. Transaction
        history prints no points balance: PointBalanceResponse is per event, so the row keeps its
        chevron rather than printing another event's number.

        Then Sign out - the full-width 52dp Button.Destructive, space_32 under the Activity card -
        and the version footer (space_16 under it, space_32 page padding). First load skeletons the
        two sections only; the identity block renders from the session, so it stays.

    Deleted: the outside-the-ScrollView identity band, the white-outline role pill, the four
    copy-pasted LinearLayout rows, the personal-details card, the dead btnEditProfile stub, the
    Switch portal row (the dashboard role tabs still reach the other portal) and the label-width
    Sign out that orphaned itself under the cards.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <!-- ═════════ Pass head: the brand band, flat, no gradient, no back arrow ═════════ -->
    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_32">

                <!-- ═════════ Identity: one left edge, one TalkBack node ═════════ -->
                <!-- screenReaderFocusable + a contentDescription set from the bound name and
                     email make the avatar, the name and the email one stop; the block is marked
                     as a heading so it appears in heading navigation (§9.5). -->
                <LinearLayout
                    android:id="@+id/headerProfile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:background="@color/ui_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_24"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_32"
                    android:screenReaderFocusable="true"
                    tools:targetApi="28">

                    <FrameLayout
                        android:layout_width="@dimen/ui_attendee_avatar"
                        android:layout_height="@dimen/ui_attendee_avatar"
                        android:background="@drawable/bg_ui_icon_tile"
                        android:importantForAccessibility="noHideDescendants">

                        <TextView
                            android:id="@+id/txtProfileInitial"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/archivo_bold"
                            android:gravity="center"
                            android:importantForAccessibility="no"
                            android:includeFontPadding="false"
                            android:textColor="@color/ui_primary"
                            android:textSize="@dimen/ui_attendee_avatar_initial"
                            tools:text="J" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtProfileName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:importantForAccessibility="no"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.TitleLarge"
                            android:textColor="@color/ui_text_primary"
                            tools:text="Name" />

                        <!-- maxLines is 1 at the default scale and 2 above fontScale 1.3
                             (set in code); the row takes the full width, not the pill's leftover. -->
                        <TextView
                            android:id="@+id/txtProfileEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:ellipsize="end"
                            android:importantForAccessibility="no"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                            android:textColor="@color/ui_text_secondary"
                            tools:text="name@example.com" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Refresh failure with readable rows: the sections stay and the error is in the
                     flow, directly under the identity block, with Retry beside the sentence (§5.7). -->
                <LinearLayout
                    android:id="@+id/errorProfileBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:layout_marginBottom="@dimen/space_16"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_ui_block_r4"
                    android:backgroundTint="@color/ui_error_container"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_touch_min"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_16"
                    android:paddingTop="@dimen/space_8"
                    android:paddingEnd="@dimen/space_8"
                    android:paddingBottom="@dimen/space_8"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtProfileError"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                        android:textColor="@color/ui_on_error_container" />

                    <TextView
                        android:id="@+id/btnProfileRetry"
                        style="@style/Widget.EventQR.Ui.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:minHeight="@dimen/ui_button_height_inline"
                        android:text="@string/ui_attendee_retry"
                        android:textColor="@color/ui_on_error_container" />
                </LinearLayout>

                <!-- Sections-shaped skeleton: the identity block stays on screen (cached session
                     values, never empty), so the skeleton mirrors the region it replaces in the
                     loaded order - ACCOUNT's eyebrow bar and its single row, then ACTIVITY's
                     eyebrow bar and its three rows (§5.11). A loaded row with its one-line meta
                     lands on 76dp (14 + 26 title + 2 + 20 meta), so each 72dp
                     ui_skeleton_row_height row carries one space_xs grid step and the ACTIVITY
                     card keeps its two hairlines: 3 x 72 + 3 x 4 + 2 x 1 = 230dp, the loaded
                     card's height; the ACCOUNT card is the single 76dp row. -->
                <LinearLayout
                    android:id="@+id/skeletonLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/ui_skeleton_loading"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_label_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height"
                        android:layout_marginStart="@dimen/ui_gutter" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ui_gutter"
                        android:layout_marginTop="@dimen/space_8"
                        android:layout_marginEnd="@dimen/ui_gutter"
                        android:background="@drawable/bg_ui_card"
                        android:orientation="vertical">

                        <include
                            layout="@layout/include_skeleton_row"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ui_skeleton_row_height"
                            android:layout_marginBottom="@dimen/space_xs" />
                    </LinearLayout>

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_label_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height"
                        android:layout_marginStart="@dimen/ui_gutter"
                        android:layout_marginTop="@dimen/space_24" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ui_gutter"
                        android:layout_marginTop="@dimen/space_8"
                        android:layout_marginEnd="@dimen/ui_gutter"
                        android:background="@drawable/bg_ui_card"
                        android:orientation="vertical">

                        <include
                            layout="@layout/include_skeleton_row"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ui_skeleton_row_height"
                            android:layout_marginBottom="@dimen/space_xs" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/stroke_hairline"
                            android:layout_marginStart="@dimen/ui_divider_inset"
                            android:background="@color/ui_hairline"
                            android:importantForAccessibility="no" />

                        <include
                            layout="@layout/include_skeleton_row"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ui_skeleton_row_height"
                            android:layout_marginBottom="@dimen/space_xs" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/stroke_hairline"
                            android:layout_marginStart="@dimen/ui_divider_inset"
                            android:background="@color/ui_hairline"
                            android:importantForAccessibility="no" />

                        <include
                            layout="@layout/include_skeleton_row"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ui_skeleton_row_height"
                            android:layout_marginBottom="@dimen/space_xs" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutProfileSections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ═════════ ACCOUNT: the person's own row, first ═════════ -->
                    <TextView
                        android:id="@+id/eyebrowAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ui_gutter"
                        android:layout_marginEnd="@dimen/ui_gutter"
                        android:accessibilityHeading="true"
                        android:text="@string/ui_attendee_account"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow"
                        tools:targetApi="28" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAccountMenu"
                        style="@style/Widget.EventQR.Ui.Card.Grouped"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ui_gutter"
                        android:layout_marginTop="@dimen/space_8"
                        android:layout_marginEnd="@dimen/ui_gutter"
                        android:clipToOutline="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/rowEditProfile"
                                layout="@layout/list_row_icon"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- ═════════ ACTIVITY: three rows, one card ═════════ -->
                    <TextView
                        android:id="@+id/eyebrowActivity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ui_gutter"
                        android:layout_marginTop="@dimen/space_24"
                        android:layout_marginEnd="@dimen/ui_gutter"
                        android:accessibilityHeading="true"
                        android:text="@string/ui_attendee_activity"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow"
                        tools:targetApi="28" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardActivityMenu"
                        style="@style/Widget.EventQR.Ui.Card.Grouped"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ui_gutter"
                        android:layout_marginTop="@dimen/space_8"
                        android:layout_marginEnd="@dimen/ui_gutter"
                        android:clipToOutline="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <include
                                android:id="@+id/rowTransactionHistory"
                                layout="@layout/list_row_icon"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <include
                                android:id="@+id/rowClaimedRewards"
                                layout="@layout/list_row_icon"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <include
                                android:id="@+id/rowMyEventRequests"
                                layout="@layout/list_row_icon"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Static chrome, outside the skeleton region: Sign out and the build version are
                     on screen from the first frame, so they never pop in after the load. -->
                <TextView
                    android:id="@+id/cardSignOut"
                    style="@style/Widget.EventQR.Ui.Button.Destructive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_32"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:focusable="true"
                    android:text="@string/ui_attendee_sign_out" />

                <TextView
                    android:id="@+id/txtProfileVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary"
                    tools:text="Version 1.0 (1)" />
            </LinearLayout>
        </ScrollView>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
