<?xml version="1.0" encoding="utf-8"?>
<!--
    Attendee profile (§6.2 of MyFiles/EventQR-Redesign-Plan.md).

        One left-aligned identity block: 64dp primary_container avatar square, name in title_l,
        email beside the role as the one status badge. The badge is the attendee portal context,
        not a claim about the account: every role reaches this screen, so it reads the localized
        Attendee label and the raw global role never appears here. Below it one grouped settings
        card, then sign out as an outlined destructive action.

    Deleted: the personal-details card and its label/value rows (name and email now live in the
    identity block), the dead zero-size btnEditProfile stub, and every fixed row height.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <!-- ═════════ Identity block: one left edge, no centring ═════════ -->
    <LinearLayout
        android:id="@+id/headerProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingTop="@dimen/space_24"
        android:paddingEnd="@dimen/ui_gutter"
        android:paddingBottom="@dimen/space_32">

        <FrameLayout
            android:layout_width="@dimen/ui_attendee_avatar"
            android:layout_height="@dimen/ui_attendee_avatar"
            android:background="@drawable/bg_ui_icon_tile">

            <TextView
                android:id="@+id/txtProfileInitial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/archivo_bold"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:textColor="@color/ui_primary"
                android:textSize="@dimen/ui_attendee_avatar_initial"
                android:layout_gravity="center"
                tools:text="J" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtProfileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.EventQR.Type.TitleLarge"
                android:textColor="@color/ui_text_primary"
                tools:text="Name" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtProfileEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary"
                    tools:text="name@example.com" />

                <TextView
                    android:id="@+id/txtProfileRole"
                    style="@style/Widget.EventQR.Ui.StatusBadge.Neutral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:minHeight="@dimen/ui_badge_height"
                    android:text="@string/ui_attendee_role" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingEnd="@dimen/ui_gutter"
                android:paddingBottom="@dimen/space_32">

                <!-- Refresh failure with readable rows: the menu stays and the error is in the flow,
                     directly under the identity block, with Retry beside the sentence (§5.7). -->
                <LinearLayout
                    android:id="@+id/errorProfileBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_16"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_ui_block_r4"
                    android:backgroundTint="@color/ui_error_container"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_touch_min"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_16"
                    android:paddingTop="@dimen/space_8"
                    android:paddingEnd="@dimen/space_8"
                    android:paddingBottom="@dimen/space_8"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtProfileError"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                        android:textColor="@color/ui_on_error_container" />

                    <TextView
                        android:id="@+id/btnProfileRetry"
                        style="@style/Widget.EventQR.Ui.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:minHeight="@dimen/ui_button_height_inline"
                        android:text="@string/ui_attendee_retry"
                        android:textColor="@color/ui_on_error_container" />
                </LinearLayout>

                <!-- Settings-shaped skeleton: an eyebrow bar, then four 64dp rows inside one card,
                     matching the loaded geometry within 4dp (§5.11). -->
                <LinearLayout
                    android:id="@+id/skeletonLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/ui_skeleton_loading"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_meta_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height"
                        android:layout_marginBottom="@dimen/space_12" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ui_card"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/ui_row_height_value"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/ui_card_padding">

                            <include
                                layout="@layout/include_skeleton_block"
                                android:layout_width="@dimen/ui_skeleton_title_width"
                                android:layout_height="@dimen/ui_skeleton_bar_height" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/ui_row_height_value"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/ui_card_padding">

                            <include
                                layout="@layout/include_skeleton_block"
                                android:layout_width="@dimen/ui_skeleton_title_width"
                                android:layout_height="@dimen/ui_skeleton_bar_height" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/ui_row_height_value"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/ui_card_padding">

                            <include
                                layout="@layout/include_skeleton_block"
                                android:layout_width="@dimen/ui_skeleton_title_width"
                                android:layout_height="@dimen/ui_skeleton_bar_height" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/ui_row_height_value"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/ui_card_padding">

                            <include
                                layout="@layout/include_skeleton_block"
                                android:layout_width="@dimen/ui_skeleton_title_width"
                                android:layout_height="@dimen/ui_skeleton_bar_height" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutProfileMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_8"
                        android:text="@string/ui_attendee_account"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAccountMenu"
                        style="@style/Widget.EventQR.Ui.Card.Grouped"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToOutline="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:id="@+id/cardEditProfile"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="@dimen/ui_row_height_value"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/ui_card_padding"
                                android:paddingEnd="@dimen/ui_card_padding">

                                <TextView
                                    style="@style/Widget.EventQR.Ui.ListRow.Title"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/ui_attendee_edit_profile" />

                                <ImageView
                                    android:layout_width="@dimen/ui_chevron"
                                    android:layout_height="@dimen/ui_chevron"
                                    android:layout_marginStart="@dimen/space_8"
                                    android:importantForAccessibility="no"
                                    android:tint="@color/ui_text_secondary"
                                    app:srcCompat="@drawable/ic_ui_chevron_right" />
                            </LinearLayout>

                            <!-- 16dp inset, not ListRow.Divider's 76dp: these rows have no leading
                                 icon tile, so the rule starts at the card's own text edge. -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/stroke_hairline"
                                android:layout_marginStart="@dimen/ui_card_padding"
                                android:background="@color/ui_hairline" />

                            <LinearLayout
                                android:id="@+id/cardTransactionHistory"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="@dimen/ui_row_height_value"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/ui_card_padding"
                                android:paddingEnd="@dimen/ui_card_padding">

                                <TextView
                                    style="@style/Widget.EventQR.Ui.ListRow.Title"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/ui_attendee_transaction_history" />

                                <ImageView
                                    android:layout_width="@dimen/ui_chevron"
                                    android:layout_height="@dimen/ui_chevron"
                                    android:layout_marginStart="@dimen/space_8"
                                    android:importantForAccessibility="no"
                                    android:tint="@color/ui_text_secondary"
                                    app:srcCompat="@drawable/ic_ui_chevron_right" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/stroke_hairline"
                                android:layout_marginStart="@dimen/ui_card_padding"
                                android:background="@color/ui_hairline" />

                            <LinearLayout
                                android:id="@+id/cardClaimedRewards"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="@dimen/ui_row_height_value"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/ui_card_padding"
                                android:paddingEnd="@dimen/ui_card_padding">

                                <TextView
                                    style="@style/Widget.EventQR.Ui.ListRow.Title"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/ui_attendee_claimed_rewards" />

                                <ImageView
                                    android:layout_width="@dimen/ui_chevron"
                                    android:layout_height="@dimen/ui_chevron"
                                    android:layout_marginStart="@dimen/space_8"
                                    android:importantForAccessibility="no"
                                    android:tint="@color/ui_text_secondary"
                                    app:srcCompat="@drawable/ic_ui_chevron_right" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/stroke_hairline"
                                android:layout_marginStart="@dimen/ui_card_padding"
                                android:background="@color/ui_hairline" />

                            <LinearLayout
                                android:id="@+id/cardMyEventRequests"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_vertical"
                                android:minHeight="@dimen/ui_row_height_value"
                                android:orientation="horizontal"
                                android:paddingStart="@dimen/ui_card_padding"
                                android:paddingEnd="@dimen/ui_card_padding">

                                <TextView
                                    style="@style/Widget.EventQR.Ui.ListRow.Title"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/ui_attendee_my_event_requests" />

                                <ImageView
                                    android:layout_width="@dimen/ui_chevron"
                                    android:layout_height="@dimen/ui_chevron"
                                    android:layout_marginStart="@dimen/space_8"
                                    android:importantForAccessibility="no"
                                    android:tint="@color/ui_text_secondary"
                                    app:srcCompat="@drawable/ic_ui_chevron_right" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- ═════════ Sign out: outlined destructive action ═════════ -->
                <TextView
                    android:id="@+id/cardSignOut"
                    style="@style/Widget.EventQR.Ui.Button.Destructive.Inline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_32"
                    android:minHeight="@dimen/ui_touch_min"
                    android:text="@string/ui_attendee_sign_out" />
            </LinearLayout>
        </ScrollView>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
