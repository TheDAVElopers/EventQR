<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/toolbarChangePassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/common_change_password" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingTop="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xxl">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xs"
                android:text="@string/common_security"
                android:textAppearance="@style/TextAppearance.EventQR.SectionTitle" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.EventQR.Card.Compact.Raised">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCurrentPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/change_password_current_password"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
                        app:boxCornerRadiusBottomStart="@dimen/radius_sm"
                        app:boxCornerRadiusTopEnd="@dimen/radius_sm"
                        app:boxCornerRadiusTopStart="@dimen/radius_sm"
                        app:boxStrokeColor="@color/outline"
                        app:endIconMode="password_toggle"
                        app:hintTextColor="@color/text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtCurrentPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textAppearance="@style/TextAppearance.EventQR.InputBodyMedium" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNewPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:hint="@string/change_password_new_password"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
                        app:boxCornerRadiusBottomStart="@dimen/radius_sm"
                        app:boxCornerRadiusTopEnd="@dimen/radius_sm"
                        app:boxCornerRadiusTopStart="@dimen/radius_sm"
                        app:boxStrokeColor="@color/outline"
                        app:endIconMode="password_toggle"
                        app:hintTextColor="@color/text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtNewPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textAppearance="@style/TextAppearance.EventQR.InputBodyMedium" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/layoutPasswordRequirements"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/txtPasswordLengthRequirement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/password_req_length"
                            android:textColor="@color/text_disabled"
                            android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />

                        <TextView
                            android:id="@+id/txtPasswordCapitalRequirement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/password_req_uppercase"
                            android:textColor="@color/text_disabled"
                            android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />

                        <TextView
                            android:id="@+id/txtPasswordLowercaseRequirement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/password_req_lowercase"
                            android:textColor="@color/text_disabled"
                            android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />

                        <TextView
                            android:id="@+id/txtPasswordNumberRequirement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/password_req_number"
                            android:textColor="@color/text_disabled"
                            android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />

                        <TextView
                            android:id="@+id/txtPasswordSpecialRequirement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/password_req_special"
                            android:textColor="@color/text_disabled"
                            android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilConfirmPassword"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:hint="@string/common_confirm_new_password"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
                        app:boxCornerRadiusBottomStart="@dimen/radius_sm"
                        app:boxCornerRadiusTopEnd="@dimen/radius_sm"
                        app:boxCornerRadiusTopStart="@dimen/radius_sm"
                        app:boxStrokeColor="@color/outline"
                        app:endIconMode="password_toggle"
                        app:hintTextColor="@color/text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edtConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:textAppearance="@style/TextAppearance.EventQR.InputBodyMedium" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/progressChange"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_xl"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_min"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/common_change_password"
                android:textAllCaps="false"
                android:textColor="@color/on_primary"
                android:textAppearance="@style/TextAppearance.EventQR.ButtonBodyMedium"
                android:letterSpacing="@dimen/tracking_button_tight"
                app:backgroundTint="@color/primary"
                app:cornerRadius="@dimen/radius_sm"
                app:rippleColor="@color/primary_dark" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
