<?xml version="1.0" encoding="utf-8"?>
<!--
    CHANGE PASSWORD (§6.6 shared form) - retires Gen A.

        Top bar, then SECURITY as an `overline` eyebrow, three filled 56dp fields and the
        checklist, then a 72dp sticky footer with the only primary action.

    Deleted: `EventQrTabHeader`-era SectionTitle, the raised `Widget.EventQR.Card.Compact.Raised`
    (a card inside a card), the outlined `TextInputLayout` boxes with `password_toggle` end icons,
    the outlined focus colour and the elevation.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/toolbarChangePassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/common_change_password" />

    <ScrollView
        android:id="@+id/formScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ui_gutter"
            android:paddingTop="@dimen/space_24"
            android:paddingBottom="@dimen/space_24">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/common_security"
                style="@style/Widget.EventQR.Ui.SectionHeading" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:labelFor="@id/edtCurrentPassword"
                android:text="@string/change_password_current_password"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <com.thedavelopers.eventqr.ui.components.PasswordTextInputLayout
                style="@style/Widget.EventQR.Ui.TextField.Password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <EditText
                    android:id="@+id/edtCurrentPassword"
                    style="@style/Widget.EventQR.Ui.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoText="false"
                    android:drawableStart="@drawable/ic_ui_lock"
                    android:hint="@string/change_password_current_password"
                    android:inputType="textPassword"
                    android:maxLength="128"
                    android:maxLines="1" />
            </com.thedavelopers.eventqr.ui.components.PasswordTextInputLayout>

            <TextView
                android:id="@+id/txtCurrentPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:labelFor="@id/edtNewPassword"
                android:text="@string/change_password_new_password"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <com.thedavelopers.eventqr.ui.components.PasswordTextInputLayout
                style="@style/Widget.EventQR.Ui.TextField.Password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <EditText
                    android:id="@+id/edtNewPassword"
                    style="@style/Widget.EventQR.Ui.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoText="false"
                    android:drawableStart="@drawable/ic_ui_lock"
                    android:hint="@string/change_password_new_password"
                    android:inputType="textPassword"
                    android:maxLength="128"
                    android:maxLines="1" />
            </com.thedavelopers.eventqr.ui.components.PasswordTextInputLayout>

            <TextView
                android:id="@+id/txtNewPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <!-- Rules: five rows, one per Validators rule. The 16dp leading slot is ic_ui_check
                 in accent_deep when met and empty at rest; the mark and the row's "met"/"not met"
                 description carry the state, never colour alone. -->
            <LinearLayout
                android:id="@+id/layoutPasswordRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:accessibilityLiveRegion="polite"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtPasswordLengthRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_length"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordCapitalRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_uppercase"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordLowercaseRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_lowercase"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordNumberRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_number"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordSpecialRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_special"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:labelFor="@id/edtConfirmPassword"
                android:text="@string/common_confirm_new_password"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <com.thedavelopers.eventqr.ui.components.PasswordTextInputLayout
                style="@style/Widget.EventQR.Ui.TextField.Password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <EditText
                    android:id="@+id/edtConfirmPassword"
                    style="@style/Widget.EventQR.Ui.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoText="false"
                    android:drawableStart="@drawable/ic_ui_lock"
                    android:hint="@string/common_confirm_new_password"
                    android:inputType="textPassword"
                    android:maxLength="128"
                    android:maxLines="1" />
            </com.thedavelopers.eventqr.ui.components.PasswordTextInputLayout>

            <TextView
                android:id="@+id/txtConfirmPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressChange"
                android:layout_width="@dimen/ui_loading_indicator"
                android:layout_height="@dimen/ui_loading_indicator"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_16"
                android:indeterminateTint="@color/ui_primary"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- §5.16 form failure strip, between the form and the sticky footer so it never scrolls away;
         hidden until a failure, and without Retry (a password change is not safe to repeat). -->
    <include
        android:id="@+id/errorChangePassword"
        layout="@layout/include_error_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:layout_marginBottom="@dimen/space_md" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline" />

    <LinearLayout
        android:id="@+id/authFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:minHeight="@dimen/ui_footer_height"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ui_gutter"
        android:paddingVertical="@dimen/space_md">

        <Button
            android:id="@+id/btnChangePassword"
            style="@style/Widget.EventQR.Ui.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_button_height"
            android:text="@string/common_change_password" />
    </LinearLayout>
</LinearLayout>
