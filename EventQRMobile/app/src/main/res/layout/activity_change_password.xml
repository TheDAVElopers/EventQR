<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <!-- Standard Top Bar (§7.7) — 56dp, paper bg, no border -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarChangePassword"
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:background="@color/paper"
        android:elevation="0dp"
        app:navigationIcon="@drawable/ic_back_chevron"
        app:navigationIconTint="@color/text_on_paper"
        app:title="Change Password"
        app:titleTextAppearance="@style/TextAppearance.EventQR.TextTitle"
        app:titleTextColor="@color/text_on_paper" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_xl"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:paddingTop="@dimen/space_lg">

            <!-- Loading Indicator (§7.11) — 28dp, accent_signal -->
            <ProgressBar
                android:id="@+id/progressChange"
                android:layout_width="@dimen/progress_circular_size"
                android:layout_height="@dimen/progress_circular_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/space_md"
                android:indeterminateTint="@color/accent_signal"
                android:visibility="gone" />

            <!-- ═══ Current Password ═══ -->
            <TextView
                android:id="@+id/labelCurrentPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Current password"
                android:textAppearance="@style/TextAppearance.EventQR.TextLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCurrentPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                app:hintEnabled="false"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusBottomEnd="@dimen/radius_sharp"
                app:boxCornerRadiusBottomStart="@dimen/radius_sharp"
                app:boxCornerRadiusTopEnd="@dimen/radius_sharp"
                app:boxCornerRadiusTopStart="@dimen/radius_sharp"
                app:boxStrokeColor="@color/input_stroke"
                app:boxStrokeErrorColor="@color/status_rejected"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/text_on_paper_muted"
                app:errorTextAppearance="@style/TextAppearance.EventQR.InputError"
                app:hintTextColor="@color/text_on_paper_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtCurrentPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/archivo_regular"
                    android:inputType="textPassword"
                    android:textColor="@color/text_on_paper"
                    android:textSize="@dimen/type_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_sm" />

            <!-- ═══ New Password ═══ -->
            <TextView
                android:id="@+id/labelNewPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="New password"
                android:textAppearance="@style/TextAppearance.EventQR.TextLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNewPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                app:hintEnabled="false"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusBottomEnd="@dimen/radius_sharp"
                app:boxCornerRadiusBottomStart="@dimen/radius_sharp"
                app:boxCornerRadiusTopEnd="@dimen/radius_sharp"
                app:boxCornerRadiusTopStart="@dimen/radius_sharp"
                app:boxStrokeColor="@color/input_stroke"
                app:boxStrokeErrorColor="@color/status_rejected"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/text_on_paper_muted"
                app:errorTextAppearance="@style/TextAppearance.EventQR.InputError"
                app:hintTextColor="@color/text_on_paper_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/archivo_regular"
                    android:inputType="textPassword"
                    android:textColor="@color/text_on_paper"
                    android:textSize="@dimen/type_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password Requirements — on paper, no card -->
            <LinearLayout
                android:id="@+id/layoutPasswordRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtPasswordLengthRequirement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/archivo_regular"
                    android:text="○ At least 8 characters"
                    android:textColor="@color/ink_muted"
                    android:textSize="@dimen/type_caption" />

                <TextView
                    android:id="@+id/txtPasswordCapitalRequirement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/archivo_regular"
                    android:text="○ One uppercase letter"
                    android:textColor="@color/ink_muted"
                    android:textSize="@dimen/type_caption" />

                <TextView
                    android:id="@+id/txtPasswordNumberRequirement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/archivo_regular"
                    android:text="○ One number"
                    android:textColor="@color/ink_muted"
                    android:textSize="@dimen/type_caption" />

                <TextView
                    android:id="@+id/txtPasswordSpecialRequirement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/archivo_regular"
                    android:text="○ One special character"
                    android:textColor="@color/ink_muted"
                    android:textSize="@dimen/type_caption" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_sm" />

            <!-- ═══ Confirm New Password ═══ -->
            <TextView
                android:id="@+id/labelConfirmPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Confirm new password"
                android:textAppearance="@style/TextAppearance.EventQR.TextLabel" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                app:hintEnabled="false"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusBottomEnd="@dimen/radius_sharp"
                app:boxCornerRadiusBottomStart="@dimen/radius_sharp"
                app:boxCornerRadiusTopEnd="@dimen/radius_sharp"
                app:boxCornerRadiusTopStart="@dimen/radius_sharp"
                app:boxStrokeColor="@color/input_stroke"
                app:boxStrokeErrorColor="@color/status_rejected"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2dp"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/text_on_paper_muted"
                app:errorTextAppearance="@style/TextAppearance.EventQR.InputError"
                app:hintTextColor="@color/text_on_paper_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/archivo_regular"
                    android:inputType="textPassword"
                    android:textColor="@color/text_on_paper"
                    android:textSize="@dimen/type_body" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 40dp before primary CTA (§7.2, §8.3) -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_xl" />

            <!-- Primary CTA (§7.1) — 56dp, accent_signal, 4dp radius -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangePassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_primary_height"
                android:fontFamily="@font/archivo_semibold"
                android:letterSpacing="0"
                android:text="Change Password"
                android:textAllCaps="false"
                android:textColor="@color/btn_primary_text"
                android:textSize="@dimen/type_title"
                app:backgroundTint="@color/btn_primary_bg"
                app:cornerRadius="@dimen/radius_sharp"
                app:elevation="0dp"
                app:rippleColor="@color/accent_signal_pressed"
                app:strokeWidth="0dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
