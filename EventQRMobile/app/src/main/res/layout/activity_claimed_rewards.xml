<?xml version="1.0" encoding="utf-8"?>
<!--
    Claimed rewards (§6.2) - the same list language as the transaction history: rows on the flat
    page, a shared skeleton, and the shared empty state. No card-per-row, no tinted icon tiles.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/ui_attendee_claimed_rewards" />

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshClaimedRewards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/ui_gutter"
            android:paddingEnd="@dimen/ui_gutter">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerClaimedRewards"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:paddingBottom="@dimen/space_sm" />

            <include
                android:id="@+id/skeletonLoading"
                layout="@layout/include_skeleton_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/txtClaimedRewardsEmpty"
                android:layout_width="@dimen/ui_empty_max_width"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:gutter="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtClaimedRewardsError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_error"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnClaimedRewardsRetry"
                    style="@style/Widget.EventQR.Ui.Button.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ui_button_height_inline"
                    android:text="@string/ui_attendee_retry"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>
</LinearLayout>
