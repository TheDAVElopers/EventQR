<?xml version="1.0" encoding="utf-8"?>
<!--
    Claimed rewards (§6.2) - the same list language as the transaction history: rows on the flat
    page, a shared skeleton, and the shared empty state. No card-per-row, no tinted icon tiles.

    Rows carry the 20dp gutter themselves, so the list host does not pad. The empty state keeps its
    own gutter, sits on the same left edge as the rows, and doubles as the zero-row error surface.
    A refresh failure with rows on screen keeps the rows and reports in the in-flow error strip
    under the header (§5.7 line 642), never a Snackbar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/ui_attendee_claimed_rewards" />

    <!-- Refresh failure with readable rows: the rows stay and the error is in the flow, directly
         under the header, with the control beside the sentence (§5.7 line 642). The strip carries
         no live region: its message never changes, so a repeated failure would stay silent. The
         activity announces the message instead (see showError). -->
    <LinearLayout
        android:id="@+id/errorClaimedRewards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:background="@drawable/bg_ui_block_r4"
        android:backgroundTint="@color/ui_error_container"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ui_touch_min"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtClaimedRewardsError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ui_attendee_claims_refresh_failed"
            android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
            android:textColor="@color/ui_on_error_container" />

        <TextView
            android:id="@+id/btnClaimedRewardsRetry"
            style="@style/Widget.EventQR.Ui.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:minHeight="@dimen/ui_button_height_inline"
            android:text="@string/ui_attendee_retry"
            android:textColor="@color/ui_on_error_container" />
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshClaimedRewards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerClaimedRewards"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:paddingBottom="@dimen/space_sm" />

            <!-- First load: six rows at the loaded one-line geometry (§5.11). The CLOSED container
                 announces "Loading"; every bar is hidden from TalkBack (§9.5). -->
            <LinearLayout
                android:id="@+id/skeletonLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/ui_skeleton_loading"
                android:focusable="true"
                android:orientation="vertical">

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_attendee_reward_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_attendee_reward_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_attendee_reward_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_attendee_reward_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_attendee_reward_row" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_attendee_reward_row" />
            </LinearLayout>

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/txtClaimedRewardsEmpty"
                android:layout_width="@dimen/ui_empty_max_width"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>
</LinearLayout>
