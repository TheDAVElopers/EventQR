<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eventqr_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/common_create_admin_account" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_admin_surface_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_admin_icon_tile_purple">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/create_admin_account_admin_account"
                            android:src="@drawable/ic_nav_profile"
                            android:tint="@color/eventqr_purple" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/create_admin_account_admin_details"
                            android:textColor="#111827"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/create_admin_account_the_new_account_will_receive_the_adm"
                            android:textColor="#6B7280"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_first_name"
                            android:textColor="#111827"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/inputAdminFirstName"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_auth_field"
                            android:hint="@string/common_john"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="14dp"
                            android:textColor="@color/eventqr_text"
                            android:textColorHint="#71717A"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_last_name"
                            android:textColor="#111827"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/inputAdminLastName"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_auth_field"
                            android:hint="@string/common_doe"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="14dp"
                            android:textColor="@color/eventqr_text"
                            android:textColorHint="#71717A"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/common_email_address"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputAdminEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_auth_field"
                    android:drawableStart="@drawable/email_icon"
                    android:drawablePadding="10dp"
                    android:hint="@string/common_johndoe_gmail_com"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/eventqr_text"
                    android:textColorHint="#71717A"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/common_phone_number"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputAdminPhone"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_auth_field"
                    android:drawableStart="@drawable/phone_icon"
                    android:drawablePadding="10dp"
                    android:hint="+63 912 345 6789"
                    android:inputType="phone"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/eventqr_text"
                    android:textColorHint="#71717A"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="#F3F4F6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/create_admin_account_temporary_password"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputAdminPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_auth_field"
                    android:drawableStart="@drawable/password_icon"
                    android:drawableEnd="@drawable/ic_visibility_on"
                    android:drawablePadding="10dp"
                    android:hint="@string/common_enter_password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/eventqr_text"
                    android:textColorHint="#71717A"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/layoutPasswordRequirements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_password_requirements"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/viewStrength1"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:layout_weight="1"
                            android:background="@color/eventqr_border" />

                        <View
                            android:id="@+id/viewStrength2"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@color/eventqr_border" />

                        <View
                            android:id="@+id/viewStrength3"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@color/eventqr_border" />

                        <View
                            android:id="@+id/viewStrength4"
                            android:layout_width="0dp"
                            android:layout_height="4dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@color/eventqr_border" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtPasswordLengthRequirement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
android:text="@string/password_req_length"
                                    android:textColor="@color/eventqr_muted"
                                    android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtPasswordCapitalRequirement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
android:text="@string/password_req_uppercase"
                                    android:textColor="@color/eventqr_muted"
                                    android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtPasswordLowercaseRequirement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
android:text="@string/password_req_lowercase"
                                    android:textColor="@color/eventqr_muted"
                                    android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtPasswordNumberRequirement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
android:text="@string/password_req_number"
                                    android:textColor="@color/eventqr_muted"
                                    android:textSize="12sp" />

                            <TextView
                                android:id="@+id/txtPasswordSpecialRequirement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
android:text="@string/password_req_special"
                                    android:textColor="@color/eventqr_muted"
                                    android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtPasswordStrength"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:textColor="@color/eventqr_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </RelativeLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/common_confirm_password"
                    android:textColor="#111827"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/inputAdminConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_auth_field"
                    android:drawableStart="@drawable/password_icon"
                    android:drawableEnd="@drawable/ic_visibility_on"
                    android:drawablePadding="10dp"
                    android:hint="@string/common_confirm_password_2"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/eventqr_text"
                    android:textColorHint="#71717A"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnCreateAdminAccount"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_primary_button"
                    android:text="@string/common_create_admin_account"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
