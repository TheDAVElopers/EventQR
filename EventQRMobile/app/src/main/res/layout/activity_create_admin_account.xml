<?xml version="1.0" encoding="utf-8"?>
<!--
    CREATE ADMIN ACCOUNT (§6.5 admin, §6.6 shared form pattern).

        Top bar (back at 4dp, title at 56dp), then three eyebrowed sections separated by 1dp
        perforations: IDENTITY / CONTACT / SECURITY. Filled 56dp fields at radius 4, a
        password checklist whose 16dp leading slot holds the `ic_ui_check` tick in `accent_deep`
        as each rule is satisfied, and a 72dp sticky footer so the primary action never scrolls
        away.

    Deleted: `bg_admin_surface_card`, the IconTile matrix, `bg_auth_field`, the raster envelope
    and padlock, the tinted requirement box, the `bg_password_requirements` block and the
    Unicode check/bullet glyphs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/include_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- §6.8 row 18: permission denied is an in-flow state, never a toast. -->
    <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
        android:id="@+id/layoutCreateAdminDenied"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:icon="@drawable/ic_ui_warning"
        app:title="@string/ui_admin_create_permission" />

    <ScrollView
        android:id="@+id/formScroll"        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_gutter"
            android:paddingTop="@dimen/space_24"
            android:paddingEnd="@dimen/ui_gutter"
            android:paddingBottom="@dimen/space_24">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_admin_create_body"
                android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall" />

            <!-- ═════════ IDENTITY ═════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/ui_admin_create_eyebrow_identity"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/inputAdminFirstName"
                        android:text="@string/ui_admin_create_first_name"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                    <EditText
                        android:id="@+id/inputAdminFirstName"
                        style="@style/Widget.EventQR.Ui.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:autoText="false"
                        android:inputType="textPersonName"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/txtAdminFirstNameError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                        android:textColor="@color/ui_error"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/inputAdminLastName"
                        android:text="@string/ui_admin_create_last_name"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                    <EditText
                        android:id="@+id/inputAdminLastName"
                        style="@style/Widget.EventQR.Ui.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:autoText="false"
                        android:inputType="textPersonName"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/txtAdminLastNameError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                        android:textColor="@color/ui_error"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/divider_perforation_light"
                android:layerType="software" />

            <!-- ═════════ CONTACT ═════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/ui_admin_create_eyebrow_contact"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:labelFor="@id/inputAdminEmail"
                android:text="@string/ui_admin_create_email"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/inputAdminEmail"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:autoText="false"
                android:drawableStart="@drawable/ic_ui_mail"
                android:inputType="textEmailAddress"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtAdminEmailError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:labelFor="@id/inputAdminPhone"
                android:text="@string/ui_admin_create_phone"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/inputAdminPhone"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:drawableStart="@drawable/ic_ui_call"
                android:inputType="phone"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtAdminPhoneError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/divider_perforation_light"
                android:layerType="software" />

            <!-- ═════════ SECURITY ═════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/ui_admin_create_eyebrow_security"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:labelFor="@id/inputAdminPassword"
                android:text="@string/ui_admin_create_password"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/inputAdminPassword"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:autoText="false"
                android:drawableStart="@drawable/ic_ui_lock"
                android:drawableEnd="@drawable/ic_ui_visibility"
                android:inputType="textPassword"
                android:maxLength="128"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtAdminPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <!-- Rules: five rows, one per Validators rule. The 16dp leading slot is ic_ui_check
                 in accent_deep when met and empty at rest; the mark and the row's "met"/"not met"
                 description carry the state, never colour alone. -->
            <LinearLayout
                android:id="@+id/layoutPasswordRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:accessibilityLiveRegion="polite"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtPasswordLengthRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_length"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordCapitalRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_uppercase"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordLowercaseRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_lowercase"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordNumberRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_number"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordSpecialRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_special"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:labelFor="@id/inputAdminConfirmPassword"
                android:text="@string/ui_admin_create_confirm"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/inputAdminConfirmPassword"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:autoText="false"
                android:drawableStart="@drawable/ic_ui_lock"
                android:drawableEnd="@drawable/ic_ui_visibility"
                android:inputType="textPassword"
                android:maxLength="128"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtAdminConfirmPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- ═════════ Page failure: in-flow strip above the footer, values kept (§6.8 row 6) ═════════ -->
    <LinearLayout
        android:id="@+id/layoutCreateAdminError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_ui_block_r4"
        android:backgroundTint="@color/ui_error_container"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ui_touch_min"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_16"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_8"
        android:paddingBottom="@dimen/space_8"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtCreateAdminError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
            android:textColor="@color/ui_on_error_container" />

        <TextView
            android:id="@+id/btnCreateAdminRetry"
            style="@style/Widget.EventQR.Ui.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:minHeight="@dimen/ui_button_height_inline"
            android:text="@string/common_retry"
            android:textColor="@color/ui_on_error_container" />
    </LinearLayout>

    <!-- ═════════ Sticky footer: the primary action never scrolls away ═════════ -->
    <View
        android:id="@+id/dividerCreateAdminFooter"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline" />

    <LinearLayout
        android:id="@+id/layoutCreateAdminFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:minHeight="@dimen/ui_footer_height"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ui_gutter"
        android:paddingVertical="@dimen/space_md">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnCreateAdminAccount"
                style="@style/Widget.EventQR.Ui.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_button_height"
                android:text="@string/ui_admin_create_submit" />

            <ProgressBar
                android:id="@+id/progressCreateAdmin"
                android:layout_width="@dimen/ui_progress_inline"
                android:layout_height="@dimen/ui_progress_inline"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/ui_on_primary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
