<?xml version="1.0" encoding="utf-8"?>
<!--
    CREATE ADMIN ACCOUNT (§6.5 admin, §6.6 shared form pattern).

        Top bar (back at 4dp, title at 56dp), then three eyebrowed sections separated by 1dp
        perforations: IDENTITY / CONTACT / SECURITY. Filled 56dp fields at radius 4, a
        password checklist whose marks turn lime as each rule is satisfied, and a 72dp sticky
        footer so the primary action never scrolls away.

    Deleted: `bg_admin_surface_card`, the IconTile matrix, `bg_auth_field`, the raster envelope
    and padlock, the tinted requirement box, the `bg_password_requirements` block and the
    Unicode check/bullet glyphs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/include_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:id="@+id/formScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_gutter"
            android:paddingTop="@dimen/space_24"
            android:paddingEnd="@dimen/ui_gutter"
            android:paddingBottom="@dimen/space_24">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_admin_create_body"
                android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall" />

            <!-- ═════════ IDENTITY ═════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/ui_admin_create_eyebrow_identity"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/inputAdminFirstName"
                        android:text="@string/ui_admin_create_first_name"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                    <EditText
                        android:id="@+id/inputAdminFirstName"
                        style="@style/Widget.EventQR.Ui.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ui_control_height"
                        android:layout_marginTop="@dimen/space_8"
                        android:autoText="false"
                        android:inputType="textPersonName"
                        android:maxLines="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/inputAdminLastName"
                        android:text="@string/ui_admin_create_last_name"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                    <EditText
                        android:id="@+id/inputAdminLastName"
                        style="@style/Widget.EventQR.Ui.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ui_control_height"
                        android:layout_marginTop="@dimen/space_8"
                        android:autoText="false"
                        android:inputType="textPersonName"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_focus"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/divider_perforation_light"
                android:layerType="software" />

            <!-- ═════════ CONTACT ═════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/ui_admin_create_eyebrow_contact"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:labelFor="@id/inputAdminEmail"
                android:text="@string/ui_admin_create_email"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/inputAdminEmail"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_control_height"
                android:layout_marginTop="@dimen/space_8"
                android:autoText="false"
                android:drawableStart="@drawable/ic_ui_mail"
                android:inputType="textEmailAddress"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:labelFor="@id/inputAdminPhone"
                android:text="@string/ui_admin_create_phone"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/inputAdminPhone"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_control_height"
                android:layout_marginTop="@dimen/space_8"
                android:drawableStart="@drawable/ic_ui_call"
                android:inputType="phone"
                android:maxLines="1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_focus"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/divider_perforation_light"
                android:layerType="software" />

            <!-- ═════════ SECURITY ═════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/ui_admin_create_eyebrow_security"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:labelFor="@id/inputAdminPassword"
                android:text="@string/ui_admin_create_password"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/inputAdminPassword"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_control_height"
                android:layout_marginTop="@dimen/space_8"
                android:autoText="false"
                android:drawableStart="@drawable/ic_ui_lock"
                android:drawableEnd="@drawable/ic_ui_visibility"
                android:inputType="textPassword"
                android:maxLength="128"
                android:maxLines="1" />

            <!-- Rules: the mark is a compound drawable the activity swaps, so no glyph stands
                 in for an affordance. Lime only when a rule is met. -->
            <LinearLayout
                android:id="@+id/layoutPasswordRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/viewStrength1"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/ui_strength_bar_height"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ui_strength_bar" />

                        <View
                            android:id="@+id/viewStrength2"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/ui_strength_bar_height"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ui_strength_bar" />

                        <View
                            android:id="@+id/viewStrength3"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/ui_strength_bar_height"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ui_strength_bar" />

                        <View
                            android:id="@+id/viewStrength4"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/ui_strength_bar_height"
                            android:layout_marginStart="@dimen/space_4"
                            android:layout_weight="1"
                            android:background="@drawable/bg_ui_strength_bar" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtPasswordStrength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_12"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Label"
                        android:textColor="@color/ui_text_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtPasswordLengthRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_length"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordCapitalRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_uppercase"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordLowercaseRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_lowercase"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordNumberRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_number"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordSpecialRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_special"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:labelFor="@id/inputAdminConfirmPassword"
                android:text="@string/ui_admin_create_confirm"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/inputAdminConfirmPassword"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_control_height"
                android:layout_marginTop="@dimen/space_8"
                android:autoText="false"
                android:drawableStart="@drawable/ic_ui_lock"
                android:drawableEnd="@drawable/ic_ui_visibility"
                android:inputType="textPassword"
                android:maxLength="128"
                android:maxLines="1" />
        </LinearLayout>
    </ScrollView>

    <!-- ═════════ Sticky footer: the primary action never scrolls away ═════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:minHeight="@dimen/ui_footer_height"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ui_gutter"
        android:paddingVertical="@dimen/space_10">

        <Button
            android:id="@+id/btnCreateAdminAccount"
            style="@style/Widget.EventQR.Ui.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_button_height"
            android:text="@string/ui_admin_create_submit" />
    </LinearLayout>
</LinearLayout>
