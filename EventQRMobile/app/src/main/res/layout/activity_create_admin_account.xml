<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/common_create_admin_account" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_admin_surface_card"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        style="@style/Widget.EventQR.IconTile.R10.Secondary"
                        android:layout_width="@dimen/icon_tile_md"
                        android:layout_height="@dimen/icon_tile_md">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:layout_gravity="center"
                            android:contentDescription="@string/create_admin_account_admin_account"
                            android:src="@drawable/ic_nav_profile"
                            android:tint="@color/primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/create_admin_account_admin_details"
                            android:textAppearance="@style/TextAppearance.EventQR.TitleMedium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/create_admin_account_the_new_account_will_receive_the_adm"
                            android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_18"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_first_name"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

                        <EditText
                            android:id="@+id/inputAdminFirstName"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height"
                            android:layout_marginTop="@dimen/space_6"
                            android:background="@drawable/bg_auth_field"
                            android:hint="@string/common_john"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="@dimen/space_14"
                            android:textColorHint="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_10"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_last_name"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

                        <EditText
                            android:id="@+id/inputAdminLastName"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/input_height"
                            android:layout_marginTop="@dimen/space_6"
                            android:background="@drawable/bg_auth_field"
                            android:hint="@string/common_doe"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="@dimen/space_14"
                            android:textColorHint="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_14"
                    android:text="@string/common_email_address"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

                <EditText
                    android:id="@+id/inputAdminEmail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/space_6"
                    android:background="@drawable/bg_auth_field"
                    android:drawableStart="@drawable/email_icon"
                    android:drawablePadding="@dimen/space_10"
                    android:hint="@string/common_johndoe_gmail_com"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="@dimen/space_14"
                    android:textColorHint="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_14"
                    android:text="@string/common_phone_number"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

                <EditText
                    android:id="@+id/inputAdminPhone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/space_6"
                    android:background="@drawable/bg_auth_field"
                    android:drawableStart="@drawable/phone_icon"
                    android:drawablePadding="@dimen/space_10"
                    android:hint="@string/phone_hint_example"
                    android:inputType="phone"
                    android:paddingHorizontal="@dimen/space_14"
                    android:textColorHint="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

                <View
                    style="@style/Widget.EventQR.Divider.Muted"
                    android:layout_marginTop="@dimen/space_20" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_18"
                    android:text="@string/create_admin_account_temporary_password"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

                <EditText
                    android:id="@+id/inputAdminPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/space_6"
                    android:background="@drawable/bg_auth_field"
                    android:drawableStart="@drawable/password_icon"
                    android:drawableEnd="@drawable/ic_visibility_on"
                    android:drawablePadding="@dimen/space_10"
                    android:hint="@string/common_enter_password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="@dimen/space_14"
                    android:textColorHint="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

                <LinearLayout
                    android:id="@+id/layoutPasswordRequirements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_10"
                    android:background="@drawable/bg_password_requirements"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/viewStrength1"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/bar_thin"
                            android:layout_weight="1"
                            android:background="@color/outline" />

                        <View
                            android:id="@+id/viewStrength2"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/bar_thin"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:background="@color/outline" />

                        <View
                            android:id="@+id/viewStrength3"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/bar_thin"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:background="@color/outline" />

                        <View
                            android:id="@+id/viewStrength4"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/bar_thin"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:background="@color/outline" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtPasswordLengthRequirement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/password_req_length"
                                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />

                            <TextView
                                android:id="@+id/txtPasswordCapitalRequirement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:text="@string/password_req_uppercase"
                                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />

                            <TextView
                                android:id="@+id/txtPasswordLowercaseRequirement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:text="@string/password_req_lowercase"
                                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />

                            <TextView
                                android:id="@+id/txtPasswordNumberRequirement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:text="@string/password_req_number"
                                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />

                            <TextView
                                android:id="@+id/txtPasswordSpecialRequirement"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:text="@string/password_req_special"
                                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtPasswordStrength"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Strong" />
                    </RelativeLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_14"
                    android:text="@string/common_confirm_password"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

                <EditText
                    android:id="@+id/inputAdminConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/space_6"
                    android:background="@drawable/bg_auth_field"
                    android:drawableStart="@drawable/password_icon"
                    android:drawableEnd="@drawable/ic_visibility_on"
                    android:drawablePadding="@dimen/space_10"
                    android:hint="@string/common_confirm_password_2"
                    android:inputType="textPassword"
                    android:paddingHorizontal="@dimen/space_14"
                    android:textColorHint="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

                <Button
                    style="@style/Widget.EventQR.Button.Primary"
                    android:id="@+id/btnCreateAdminAccount"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/space_20"
                    android:text="@string/common_create_admin_account"
                    android:textAppearance="@style/TextAppearance.EventQR.ButtonPlatformBodyMedium.Strong" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
