<?xml version="1.0" encoding="utf-8"?>
<!--
    Edit profile (§6.2, form pattern §6.7) - retires Gen A.

        Two eyebrowed sections (Personal details / Security) separated by a 1dp perforation
        56dp filled fields, static overline labels, inline error text under the field
        76dp sticky footer whose "Save changes" never scrolls away (space_12 block padding:
        12 + 52 + 12, four dp over the nominal 72dp because space_10 is banned, §6.7)

    Deleted: the outlined TextInputLayout tower with helper text in the box, the counter inside
    the phone box, the full-width Save button floating in the scroll and the CardView per section.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/ui_attendee_edit_profile" />

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshEditProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_24"
                android:paddingEnd="@dimen/ui_gutter"
                android:paddingBottom="@dimen/space_24">

                <!-- Form-shaped skeleton: a section bar, three label + field groups, a security bar
                     and the password card row, so the loaded geometry does not jump in (§5.11). -->
                <LinearLayout
                    android:id="@+id/skeletonLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/ui_skeleton_loading"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_meta_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height"
                        android:layout_marginBottom="@dimen/space_12" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_16"
                        android:orientation="vertical">

                        <include
                            layout="@layout/include_skeleton_block"
                            android:layout_width="@dimen/ui_skeleton_label_width"
                            android:layout_height="@dimen/ui_skeleton_bar_height" />

                        <include
                            layout="@layout/include_skeleton_block"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ui_control_height"
                            android:layout_marginTop="@dimen/space_8" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_16"
                        android:orientation="vertical">

                        <include
                            layout="@layout/include_skeleton_block"
                            android:layout_width="@dimen/ui_skeleton_label_width"
                            android:layout_height="@dimen/ui_skeleton_bar_height" />

                        <include
                            layout="@layout/include_skeleton_block"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ui_control_height"
                            android:layout_marginTop="@dimen/space_8" />

                        <!-- The locked-email helper line always renders under this field. -->
                        <include
                            layout="@layout/include_skeleton_block"
                            android:layout_width="@dimen/ui_skeleton_title_width"
                            android:layout_height="@dimen/ui_skeleton_bar_height"
                            android:layout_marginTop="@dimen/space_4" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <include
                            layout="@layout/include_skeleton_block"
                            android:layout_width="@dimen/ui_skeleton_label_width"
                            android:layout_height="@dimen/ui_skeleton_bar_height" />

                        <include
                            layout="@layout/include_skeleton_block"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ui_control_height"
                            android:layout_marginTop="@dimen/space_8" />
                    </LinearLayout>

                    <!-- Models the perforation between the field section and Security. -->
                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_hairline"
                        android:layout_marginTop="@dimen/space_16"
                        android:layout_marginBottom="@dimen/space_8" />

                    <include
                        layout="@layout/include_skeleton_block"
                        android:layout_width="@dimen/ui_skeleton_meta_width"
                        android:layout_height="@dimen/ui_skeleton_bar_height"
                        android:layout_marginTop="@dimen/space_8"
                        android:layout_marginBottom="@dimen/space_8" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ui_card"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/ui_row_height_value"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/ui_card_padding">

                        <include
                            layout="@layout/include_skeleton_block"
                            android:layout_width="@dimen/ui_skeleton_title_width"
                            android:layout_height="@dimen/ui_skeleton_bar_height" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ═════════ Error: what happened, then what to do ═════════ -->
                <LinearLayout
                    android:id="@+id/cardError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_16"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_ui_block_r4"
                    android:backgroundTint="@color/ui_error_container"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_touch_min"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_16"
                    android:paddingTop="@dimen/space_8"
                    android:paddingEnd="@dimen/space_8"
                    android:paddingBottom="@dimen/space_8"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtApiError"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                        android:textColor="@color/ui_on_error_container" />

                    <TextView
                        android:id="@+id/btnRetryProfileLoad"
                        style="@style/Widget.EventQR.Ui.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:minHeight="@dimen/ui_button_height_inline"
                        android:text="@string/ui_attendee_retry"
                        android:textColor="@color/ui_on_error_container" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtEmptyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_16"
                    android:text="@string/edit_profile_complete_your_profile_to_help_organi"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutEditProfileContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ═════════ Personal details ═════════ -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_attendee_personal_details"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:labelFor="@id/edtFullName"
                        android:text="@string/ui_attendee_full_name"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                    <EditText
                        android:id="@+id/edtFullName"
                        style="@style/Widget.EventQR.Ui.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:autoText="false"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="60"
                        android:maxLines="1" />

                    <TextView
                        android:id="@+id/txtNameError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/ui_attendee_name_required"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                        android:textColor="@color/ui_error"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:labelFor="@id/edtEmail"
                        android:text="@string/ui_attendee_email"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                    <EditText
                        android:id="@+id/edtEmail"
                        style="@style/Widget.EventQR.Ui.TextField.Display"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:enabled="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:inputType="textEmailAddress"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/ui_attendee_email_locked"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:labelFor="@id/edtPhone"
                        android:text="@string/ui_attendee_phone"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                    <!-- Prefix and digits share one filled box; addStatesFromChildren gives the box
                         the EditText's focus state so the 2dp focus stroke works. -->
                    <LinearLayout
                        android:id="@+id/layoutPhoneField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:addStatesFromChildren="true"
                        android:background="@drawable/bg_ui_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:minHeight="@dimen/ui_control_height">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:includeFontPadding="false"
                            android:paddingStart="@dimen/space_16"
                            android:paddingEnd="@dimen/space_8"
                            android:text="@string/phone_prefix"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                            android:textColor="@color/ui_text_primary" />

                        <EditText
                            android:id="@+id/edtPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/ui_attendee_phone_hint"
                            android:inputType="number"
                            android:maxLines="1"
                            android:paddingEnd="@dimen/space_16"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                            android:textColor="@color/ui_text_primary"
                            android:textColorHint="@color/ui_text_secondary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtPhoneError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:text="@string/ui_attendee_phone_required"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                        android:textColor="@color/ui_error"
                        android:visibility="gone" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_hairline"
                        android:layout_marginTop="@dimen/space_16"
                        android:background="@drawable/divider_perforation_light"
                        android:layerType="software" />

                    <!-- ═════════ Security ═════════ -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:text="@string/ui_attendee_security"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.EventQR.Ui.Card.Grouped"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:clipToOutline="true">

                        <LinearLayout
                            android:id="@+id/btnChangePassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="@dimen/ui_row_height_value"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/ui_card_padding"
                            android:paddingEnd="@dimen/ui_card_padding">

                            <TextView
                                style="@style/Widget.EventQR.Ui.ListRow.Title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/ui_attendee_change_password" />

                            <ImageView
                                android:layout_width="@dimen/ui_chevron"
                                android:layout_height="@dimen/ui_chevron"
                                android:layout_marginStart="@dimen/space_8"
                                android:importantForAccessibility="no"
                                android:tint="@color/ui_text_secondary"
                                app:srcCompat="@drawable/ic_ui_chevron_right" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <!-- ═════════ Sticky footer ═════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline" />

    <LinearLayout
        android:id="@+id/layoutSaveBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:minHeight="@dimen/ui_footer_height"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/ui_gutter"
        android:paddingBottom="@dimen/space_12">

        <Button
            android:id="@+id/btnSaveChanges"
            style="@style/Widget.EventQR.Ui.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_button_height"
            android:text="@string/ui_attendee_save_changes" />
    </LinearLayout>

</LinearLayout>
