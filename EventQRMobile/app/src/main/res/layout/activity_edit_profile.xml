<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top Action Bar / Header (56dp, 48dp Accessible Back Touch Target) -->
    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/attendee_profile_edit_profile" />

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshEditProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingTop="@dimen/space_xl"
                android:paddingBottom="@dimen/space_xxl">

                <!-- Skeleton Loading State (Zero Layout Shift) -->
                <include
                    android:id="@+id/skeletonLoading"
                    layout="@layout/include_skeleton_edit_profile" />

                <!-- Error Card (Positioned at Top for Immediate Visibility and Action) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_lg"
                    android:visibility="gone"
                    style="@style/Widget.EventQR.Card.Compact.Flat"
                    app:strokeColor="@color/error">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_lg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_error"
                                app:tint="@color/error" />

                            <TextView
                                android:id="@+id/txtApiError"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_sm"
                                android:layout_weight="1"
                                android:textColor="@color/error"
                                android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnRetryProfileLoad"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/touch_target_min"
                            android:layout_gravity="end"
                            android:layout_marginTop="@dimen/space_xs"
                            android:minWidth="64dp"
                            android:minHeight="@dimen/touch_target_min"
                            android:text="@string/common_retry"
                            android:textAllCaps="false"
                            android:textColor="@color/error"
                            android:textAppearance="@style/TextAppearance.EventQR.ButtonBodyCompact" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Informational Hint (Shown When Phone Number is Blank) -->
                <TextView
                    android:id="@+id/txtEmptyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_lg"
                    android:text="@string/edit_profile_complete_your_profile_to_help_organi"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium"
                    android:visibility="gone" />

                <!-- Main Form Content -->
                <LinearLayout
                    android:id="@+id/layoutEditProfileContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Section 1: Personal Information -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="@string/edit_profile_personal_information"
                        android:textAppearance="@style/TextAppearance.EventQR.SectionTitle" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_xl"
                        style="@style/Widget.EventQR.Card.Compact">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/space_lg">

                            <!-- Full Name -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilFullName"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/edit_profile_full_name"
                                app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
                                app:boxCornerRadiusBottomStart="@dimen/radius_sm"
                                app:boxCornerRadiusTopEnd="@dimen/radius_sm"
                                app:boxCornerRadiusTopStart="@dimen/radius_sm"
                                app:boxStrokeColor="@color/outline"
                                app:helperText="Name on your EventQR account"
                                app:hintTextColor="@color/text_secondary">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edtFullName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textPersonName|textCapWords"
                                    android:maxLength="60"
                                    android:textAppearance="@style/TextAppearance.EventQR.InputBodyMedium" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Email Address (Locked / Display-Only) -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilEmail"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_lg"
                                android:enabled="false"
                                android:hint="@string/common_email_address"
                                app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
                                app:boxCornerRadiusBottomStart="@dimen/radius_sm"
                                app:boxCornerRadiusTopEnd="@dimen/radius_sm"
                                app:boxCornerRadiusTopStart="@dimen/radius_sm"
                                app:boxStrokeColor="@color/outline"
                                app:endIconContentDescription="Field is locked"
                                app:endIconDrawable="@drawable/ic_lock"
                                app:endIconMode="custom"
                                app:endIconTint="@color/neutral"
                                app:hintTextColor="@color/text_secondary">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edtEmail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:enabled="false"
                                    android:focusable="false"
                                    android:focusableInTouchMode="false"
                                    android:inputType="textEmailAddress"
                                    android:textAppearance="@style/TextAppearance.EventQR.InputBodyMedium" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Phone Number (Sole Editable Field) -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilPhone"
                                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_lg"
                                android:hint="@string/common_phone_number"
                                app:boxCornerRadiusBottomEnd="@dimen/radius_sm"
                                app:boxCornerRadiusBottomStart="@dimen/radius_sm"
                                app:boxCornerRadiusTopEnd="@dimen/radius_sm"
                                app:boxCornerRadiusTopStart="@dimen/radius_sm"
                                app:boxStrokeColor="@color/outline"
                                app:counterEnabled="true"
                                app:counterMaxLength="10"
                                app:helperText="Enter your 10-digit mobile number"
                                app:hintTextColor="@color/text_secondary"
                                app:prefixText="+63 "
                                app:prefixTextColor="@color/text_primary">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/edtPhone"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="number"
                                    android:textAppearance="@style/TextAppearance.EventQR.InputBodyMedium" />
                            </com.google.android.material.textfield.TextInputLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Section 2: Security Navigation -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="@string/common_security"
                        android:textAppearance="@style/TextAppearance.EventQR.SectionTitle" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_xl"
                        style="@style/Widget.EventQR.Card.Compact">

                        <LinearLayout
                            android:id="@+id/btnChangePassword"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/button_primary_height"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/space_lg">

                            <FrameLayout
                                android:layout_width="@dimen/icon_tile_sm"
                                android:layout_height="@dimen/icon_tile_sm">

                                <ImageView
                                    android:layout_width="@dimen/icon_md"
                                    android:layout_height="@dimen/icon_md"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_lock"
                                    app:tint="@color/text_primary" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:text="@string/common_change_password"
                                android:textAppearance="@style/TextAppearance.EventQR.TextBody.Strong" />

                            <ImageView
                                android:layout_width="@dimen/icon_sm"
                                android:layout_height="@dimen/icon_sm"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/neutral" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Primary Action Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveChanges"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/touch_target_min"
                        android:letterSpacing="@dimen/tracking_button_tight"
                        android:text="@string/edit_profile_save_changes"
                        android:textAllCaps="false"
                        android:textColor="@color/on_primary"
                        android:textAppearance="@style/TextAppearance.EventQR.ButtonBodyMedium"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="@dimen/radius_sm"
                        app:rippleColor="@color/primary_dark" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>
</LinearLayout>
