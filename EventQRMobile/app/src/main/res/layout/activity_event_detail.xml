<?xml version="1.0" encoding="utf-8"?>
<!--
    Event detail (§6.2 of MyFiles/EventQR-Redesign-Plan.md) - retires Gen A.

        56dp top bar (shared spec)
        media head - two exclusive states (§5.15), one 34/38 title scale:
          no poster: 120dp flat ui_primary plate carrying the title in a 96dp band on its bottom edge
          poster: 240dp full-bleed image with nothing drawn over it; the band is GONE and the title
                  sits on the page background directly below the image (txtDetailTitlePoster)
        spec table: overline label left, body value right, 1dp hairlines, no icons
          STATUS is row 1: the badge is a trailing value, never a floating pill (§5.4)
        About body copy
        72dp sticky footer with a hairline top border

    Deleted: the 220dp gradient hero, the 28sp white title on the hero, the one-big-card icon-row
    block with 11sp caps labels, the gradient Register button and the red text Cancel button in
    the flow.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/ui_attendee_event_details" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_24">

            <!-- ═════════ Media head: exclusive no-poster plate or bare poster (§5.15) ═════════ -->
            <FrameLayout
                android:id="@+id/layoutEventHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_attendee_hero_min_height"
                android:background="@color/ui_primary">

                <ImageView
                    android:id="@+id/imgEventPosterHero"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_attendee_media_height"
                    android:contentDescription="@string/event_detail_event_poster"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutHeroBand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:minHeight="@dimen/ui_hero_band_height"
                    android:background="@color/ui_primary"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_24">

                    <TextView
                        android:id="@+id/txtDetailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.DisplayM"
                        android:textColor="@color/ui_on_primary" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/txtDetailTitlePoster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.EventQR.Type.DisplayM"
                android:textColor="@color/ui_text_primary"
                android:visibility="gone" />

            <!-- ═════════ Spec table ═════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:orientation="vertical">

                <!-- Status is derived from the date rows below it, so it sits with its evidence (§6.2). -->
                <LinearLayout
                    android:id="@+id/layoutStatusRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_row_height_value"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_attendee_status"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtDetailStatus"
                        style="@style/Widget.EventQR.Ui.StatusBadge.Info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <View
                    android:id="@+id/viewStatusDivider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:background="@color/ui_hairline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_row_height_value"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_attendee_date"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtDetailDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:background="@color/ui_hairline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_row_height_value"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_attendee_time"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtDetailTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:background="@color/ui_hairline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_row_height_value"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_attendee_venue"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtDetailVenue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <View
                    android:id="@+id/viewCategoryDivider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:background="@color/ui_hairline"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutCategoryRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_row_height_value"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_attendee_category"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtDetailCategory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <View
                    android:id="@+id/viewAudienceDivider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:background="@color/ui_hairline"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutAudienceRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_row_height_value"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_attendee_audience"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtDetailAudience"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <View
                    android:id="@+id/viewRegWindowDivider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:background="@color/ui_hairline"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutRegWindowRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_row_height_value"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_attendee_registration_window"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtDetailRegWindow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:background="@color/ui_hairline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_row_height_value"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_attendee_capacity"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtDetailCapacity"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <View
                    android:id="@+id/viewRewardsDivider"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:background="@color/ui_hairline"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutRewardsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_row_height_value"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_attendee_event_rewards"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtRewardsAvailable"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═════════ Registration fill ═════════ -->
            <LinearLayout
                android:id="@+id/layoutRegistrationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_32"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_attendee_registration"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtRegPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericS"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pbRegistrationDetail"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_strength_bar_height"
                    android:layout_marginTop="@dimen/space_sm"
                    android:importantForAccessibility="no"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/pb_event_upcoming" />

                <TextView
                    android:id="@+id/txtRemainingSpots"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />
            </LinearLayout>

            <!-- ═════════ About ═════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_32"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:layout_marginBottom="@dimen/space_sm"
                android:text="@string/ui_attendee_about"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

            <TextView
                android:id="@+id/txtDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                android:textColor="@color/ui_text_secondary" />
        </LinearLayout>
    </ScrollView>

    <!-- ═════════ Sticky footer: 1dp hairline on top, primary never scrolls away ═════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline" />

    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingTop="@dimen/space_10"
        android:paddingEnd="@dimen/ui_gutter"
        android:paddingBottom="@dimen/space_10">

        <Button
            android:id="@+id/btnRegisterForEvent"
            style="@style/Widget.EventQR.Ui.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_button_height"
            android:text="@string/event_detail_register" />

        <Button
            android:id="@+id/btnCancelRegistration"
            style="@style/Widget.EventQR.Ui.Button.Destructive.Inline"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_button_height_inline"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/event_detail_cancel_registration"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
