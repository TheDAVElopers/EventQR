<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/event_registration_register_for_event" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/size_120"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_18"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_event_banner_gradient"
                    android:orientation="vertical"
                    android:padding="@dimen/space_18">

                    <TextView
                        android:id="@+id/txtEventCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/event_registration_development"
                        android:textColor="@color/secondary_container"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

                    <TextView
                        android:id="@+id/txtEventTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/event_registration_devfest_manila_2026"
                        android:textColor="@color/on_primary_soft"
                        android:textAppearance="@style/TextAppearance.EventQR.TitleLarge" />

                    <TextView
                        android:id="@+id/txtEventDateTimeVenue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/event_registration_jul_20_2026_picc_pasay_city"
                        android:textColor="@color/secondary_container"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                app:cardCornerRadius="@dimen/radius_18"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_18">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/event_registration_registrant_information"
                        android:textAppearance="@style/TextAppearance.EventQR.TitleMedium" />

                    <TextView
                        style="@style/RequestEventLabel"
                        android:text="@string/event_registration_full_name" />

                    <!-- EventQR - registrant info display-only, pulled from account profile (edit profile handled separately, not here) -->
                    <EditText
                        android:id="@+id/edtRegistrationFullName"
                        style="@style/RequestEventInput"
                        android:enabled="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:hint="@string/common_full_name"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName"
                        android:maxLines="1"
                        android:textColor="@color/display_text_color" />

                    <TextView
                        style="@style/RequestEventLabel"
                        android:text="@string/event_registration_email_address" />

                    <EditText
                        android:id="@+id/edtRegistrationEmail"
                        style="@style/RequestEventInput"
                        android:drawableStart="@drawable/email_icon"
                        android:drawablePadding="@dimen/space_sm"
                        android:clickable="false"
                        android:longClickable="false"
                        android:enabled="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:hint="@string/event_registration_john_doe_university_edu"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:maxLines="1"
                        android:textColor="@color/display_text_color" />

                    <TextView
                        style="@style/RequestEventLabel"
                        android:text="@string/event_registration_phone_number" />

                    <EditText
                        android:id="@+id/edtRegistrationPhone"
                        style="@style/RequestEventInput"
                        android:drawableStart="@drawable/phone_icon"
                        android:drawablePadding="@dimen/space_sm"
                        android:enabled="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false"
                        android:hint="@string/phone_hint_example"
                        android:imeOptions="actionDone"
                        android:inputType="phone"
                        android:maxLines="1"
                        android:textColor="@color/display_text_color" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                app:cardCornerRadius="@dimen/radius_18"
                app:cardElevation="0dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_18">

                    <CheckBox
                        android:id="@+id/chkRegistrationTerms"
                        style="@style/RequestEventCheckbox"
                        android:layout_width="@dimen/icon_32"
                        android:layout_height="@dimen/icon_32"
                        android:buttonTint="@color/primary"
                        android:minHeight="0dp"
                        android:minWidth="0dp" />

                    <TextView
                        android:id="@+id/txtRegistrationTerms"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_10"
                        android:layout_weight="1"
                        android:text="@string/event_registration_i_agree_to_the_event_terms_and_condi"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium"
                        android:lineSpacingExtra="@dimen/line_spacing_2" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/on_primary_soft"
        android:elevation="@dimen/elevation_overlay"
        android:padding="@dimen/space_lg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubmitRegistration"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height_46"
            android:background="@drawable/bg_btn_primary"
            android:text="@string/event_registration_confirm_registration"
            android:textAllCaps="false"
            android:textColor="@color/on_primary_soft"
            android:textAppearance="@style/TextAppearance.EventQR.ButtonPlatformBody.Strong" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>