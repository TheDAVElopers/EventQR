<?xml version="1.0" encoding="utf-8"?>
<!--
    Registration (§6.2 of MyFiles/EventQR-Redesign-Plan.md, form pattern §6.6) - retires Gen A.

        64dp mini event row so the user sees what they are registering for
        eyebrowed section with an Edit in profile link and a display-only spec table
        1dp perforation, then the summary + terms
        72dp sticky footer whose primary never scrolls away

    Deleted: the 18dp-radius gradient event banner, three nested CardViews, the 54dp outlined
    RequestEventInput fields, the raster email/phone icons, the full-width Cancel competing with
    the primary, and the elevated footer.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/ui_attendee_register_for_event" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_gutter"
            android:paddingTop="@dimen/space_24"
            android:paddingEnd="@dimen/ui_gutter"
            android:paddingBottom="@dimen/space_24">

            <!-- ═════════ The event being registered for ═════════ -->
            <TextView
                android:id="@+id/txtEventCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

            <TextView
                android:id="@+id/txtEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
                android:textColor="@color/ui_text_primary" />

            <TextView
                android:id="@+id/txtEventDateTimeVenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                android:textColor="@color/ui_text_secondary" />

            <!-- ═════════ YOUR DETAILS ═════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_32"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ui_attendee_registrant_details"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                <TextView
                    android:id="@+id/btnEditDetailsInProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_touch_min"
                    android:layout_marginStart="@dimen/space_sm"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_sm"
                    android:text="@string/ui_attendee_edit_in_profile"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Label"
                    android:textColor="@color/ui_primary" />
            </LinearLayout>

            <!-- Display-only spec table (§6.2): no enabled=false control the user cannot change. -->
            <LinearLayout
                android:id="@+id/rowRegistrationFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_row_height_value"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_attendee_attendee"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                <TextView
                    android:id="@+id/txtRegistrationFullName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                    android:textColor="@color/ui_text_primary" />
            </LinearLayout>

            <View
                android:id="@+id/dividerRegistrationFullName"
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:background="@color/ui_hairline" />

            <LinearLayout
                android:id="@+id/rowRegistrationEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_row_height_value"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_attendee_email"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                <TextView
                    android:id="@+id/txtRegistrationEmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                    android:textColor="@color/ui_text_primary" />
            </LinearLayout>

            <View
                android:id="@+id/dividerRegistrationEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:background="@color/ui_hairline" />

            <LinearLayout
                android:id="@+id/rowRegistrationPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_row_height_value"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_attendee_phone"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                <TextView
                    android:id="@+id/txtRegistrationPhone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                    android:textColor="@color/ui_text_primary" />

                <TextView
                    android:id="@+id/txtRegistrationPhoneRequired"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:text="@string/ui_attendee_required"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                    android:textColor="@color/ui_error"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- ═════════ Perforation: details above, acknowledgement below ═════════ -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/divider_perforation_light"
                android:layerType="software" />

            <!-- One 48dp row: tapping the sentence or the row toggles the mark. The mark itself is
                 not a separate TalkBack stop; the activity puts the checkbox role and the checked
                 state on the row, and the sentence labels that row while keeping its own node so
                 the terms link stays reachable. -->
            <LinearLayout
                android:id="@+id/rowRegistrationTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_touch_min"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/chkRegistrationTerms"
                    style="@style/Widget.EventQR.Ui.CheckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/txtRegistrationTerms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/rowRegistrationTerms"
                    android:text="@string/event_registration_i_agree_to_the_event_terms_and_condi"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ═════════ Sticky footer ═════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline" />

    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/ui_gutter"
        android:paddingBottom="@dimen/space_12">

        <TextView
            android:id="@+id/txtRegistrationInlineError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
            android:textColor="@color/ui_error"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnSubmitRegistration"
            style="@style/Widget.EventQR.Ui.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_button_height"
            android:text="@string/ui_attendee_confirm_registration" />
    </LinearLayout>

</LinearLayout>
