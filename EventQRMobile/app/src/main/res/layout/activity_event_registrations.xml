<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/event_registrations_event_attendees">
        <TextView
            android:id="@+id/badgeSelectionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_badge_selection"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="22dp"
            android:minHeight="22dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <ImageButton
            android:id="@+id/btnSelectForPrint"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_light"
            android:contentDescription="@string/event_registrations_select_attendees_for_batch_printing"
            android:padding="8dp"
            android:src="@drawable/ic_select_multiple"
            app:tint="#111827" />
    </com.thedavelopers.eventqr.ui.components.EventQrDetailHeader>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshEventRegistrations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_staff_event_header_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="#FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_event"
                            android:textColor="#DAD7FF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtEventRegistrationsEventTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/common_assigned_event"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_staff_search_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="#9CA3AF" />

                    <EditText
                        android:id="@+id/edtRegistrationSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="@string/event_registrations_search_attendees"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="#111827"
                        android:textColorHint="#9CA3AF"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_staff_stat_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/common_total" android:textColor="#6B7280" android:textSize="12sp" />
                        <TextView android:id="@+id/txtAttendeeTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="0" android:textColor="#111827" android:textSize="22sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_staff_stat_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/common_checked_in" android:textColor="#6B7280" android:textSize="12sp" />
                        <TextView android:id="@+id/txtAttendeeCheckedIn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="0" android:textColor="#10B981" android:textSize="22sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_staff_stat_card"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/common_registered" android:textColor="#6B7280" android:textSize="12sp" />
                        <TextView android:id="@+id/txtAttendeeRegistered" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="0" android:textColor="#4F46E5" android:textSize="22sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerEventRegistrations"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp" />
            </LinearLayout>

            <include
                layout="@layout/include_skeleton_cards"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <EditText
                android:id="@+id/edtRegistrationsEventId"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnLoadEventRegistrations"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
            android:id="@+id/txtAssignedEventsEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:icon="@drawable/ic_group"
            app:title="@string/common_no_attendees_found"
            app:subtitle="@string/event_registrations_registered_attendees_will_show_up_he" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/batchPrintBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnSelectAllRegistrations"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#F3F4F6"
            android:text="@string/event_registrations_select_all"
            android:textColor="#4F46E5"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPrintSelectedIds"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:backgroundTint="#4F46E5"
            android:enabled="false"
            android:text="@string/event_registrations_print_selected"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>