<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/event_registrations_event_attendees">
        <TextView
            android:id="@+id/badgeSelectionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_6"
            android:background="@drawable/bg_badge_selection"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minWidth="@dimen/icon_22"
            android:minHeight="@dimen/icon_22"
            android:paddingStart="@dimen/space_6"
            android:paddingEnd="@dimen/space_6"
            android:text="@string/placeholder_zero"
            android:textColor="@color/on_primary"
            android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Strong"
            android:visibility="gone" />
        <ImageButton
            android:id="@+id/btnSelectForPrint"
            android:layout_width="@dimen/icon_tile_sm"
            android:layout_height="@dimen/icon_tile_sm"
            android:background="@drawable/bg_circle_muted"
            android:contentDescription="@string/event_registrations_select_attendees_for_batch_printing"
            android:padding="@dimen/space_sm"
            android:src="@drawable/ic_select_multiple"
            app:tint="@color/text_primary" />
    </com.thedavelopers.eventqr.ui.components.EventQrDetailHeader>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshEventRegistrations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_lg"
                android:paddingTop="@dimen/space_18"
                android:paddingEnd="@dimen/space_lg"
                android:paddingBottom="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:background="@drawable/bg_staff_event_header_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/on_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_event"
                            android:textColor="@color/primary_container"
                            android:textAppearance="@style/TextAppearance.EventQR.TextOverline.Strong" />

                        <TextView
                            android:id="@+id/txtEventRegistrationsEventTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/common_assigned_event"
                            android:textColor="@color/on_primary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextBodyLarge.Strong" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/control_height_50"
                    android:layout_marginTop="@dimen/space_lg"
                    android:background="@drawable/bg_staff_search_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_14">

                    <ImageView
                        android:layout_width="@dimen/icon_18"
                        android:layout_height="@dimen/icon_18"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="@color/neutral" />

                    <EditText
                        android:id="@+id/edtRegistrationSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/transparent"
                        android:hint="@string/event_registrations_search_attendees"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColorHint="@color/text_hint"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBody" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="74dp"
                    android:layout_marginTop="@dimen/space_lg"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_staff_stat_card"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/event_registrations_all_registrations" android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
                        <TextView android:id="@+id/txtAttendeeTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_6" android:text="@string/placeholder_zero" android:textAppearance="@style/TextAppearance.EventQR.TextHeadline" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_10"
                        android:layout_weight="1"
                        android:background="@drawable/bg_staff_stat_card"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/common_checked_in" android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
                        <TextView android:id="@+id/txtAttendeeCheckedIn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_6" android:text="@string/placeholder_zero" android:textColor="@color/success_dark" android:textAppearance="@style/TextAppearance.EventQR.TextHeadline" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_10"
                        android:layout_weight="1"
                        android:background="@drawable/bg_staff_stat_card"
                        android:orientation="vertical"
                        android:padding="@dimen/space_md">

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/common_registered" android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
                        <TextView android:id="@+id/txtAttendeeRegistered" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_6" android:text="@string/placeholder_zero" android:textColor="@color/primary" android:textAppearance="@style/TextAppearance.EventQR.TextHeadline" />
                    </LinearLayout>
                </LinearLayout>

                

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerEventRegistrations"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/space_lg"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="@dimen/space_sm" />
            </LinearLayout>

            <include
                layout="@layout/include_skeleton_cards"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <EditText
                android:id="@+id/edtRegistrationsEventId"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnLoadEventRegistrations"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
            android:id="@+id/txtAssignedEventsEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:icon="@drawable/ic_group"
            app:title="@string/common_no_attendees_found"
            app:subtitle="@string/event_registrations_registered_attendees_will_show_up_he" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/batchPrintBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="@dimen/elevation_overlay"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_10"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_10"
        android:visibility="gone">

        <Button
            android:id="@+id/btnSelectAllRegistrations"
            style="?attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/surface_muted"
            android:text="@string/event_registrations_select_all"
            android:textColor="@color/primary"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPrintSelectedIds"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"
            android:enabled="false"
            android:text="@string/event_registrations_print_selected"
            android:textColor="@color/on_primary"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>