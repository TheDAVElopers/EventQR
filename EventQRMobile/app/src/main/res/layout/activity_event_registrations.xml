<?xml version="1.0" encoding="utf-8"?>
<!--
    EVENT REGISTRATIONS (§6.3) - the staff attendee list.

        One 56dp top bar (already on the shared tokens) with the selection count + select action.
        Event name  -> search field -> a 56dp three-cell count strip -> grouped registration rows.
        Batch print is a 72dp sticky footer with a hairline on top, not a raised bar.

    Deleted: the 62dp gradient event banner, the 50dp outlined search box, the three 74dp stat
    cards (checked-in no longer gets a green number - colour does not carry hierarchy), the 8dp
    elevated batch bar and every raw dp literal.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/ui_staff_event_attendees">

        <TextView
            android:id="@+id/badgeSelectionCount"
            style="@style/Widget.EventQR.Ui.StatusBadge.Neutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_badge_height"
            android:layout_marginEnd="@dimen/space_sm"
            android:text="@string/placeholder_zero"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnSelectForPrint"
            style="@style/Widget.EventQR.Ui.Button.Icon"
            android:layout_width="@dimen/ui_top_bar_action"
            android:layout_height="@dimen/ui_top_bar_action"
            android:contentDescription="@string/ui_staff_select_for_print"
            android:src="@drawable/ic_ui_checklist" />
    </com.thedavelopers.eventqr.ui.components.EventQrDetailHeader>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshEventRegistrations"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- The header block owns the gutter. The list slot below it does not, so the empty
                     state keeps its own 20dp edge instead of double-insetting. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_16"
                    android:paddingEnd="@dimen/ui_gutter">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_staff_event"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <TextView
                        android:id="@+id/txtEventRegistrationsEventTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/common_assigned_event"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.TitleLarge"
                        android:textColor="@color/ui_text_primary" />

                    <EditText
                        android:id="@+id/edtRegistrationSearch"
                        style="@style/Widget.EventQR.Ui.TextField.Search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:drawableStart="@drawable/ic_ui_search"
                        android:drawablePadding="@dimen/space_md"
                        android:drawableTint="@color/ui_text_secondary"
                        android:hint="@string/ui_staff_search_attendees"
                        android:importantForAutofill="no"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:paddingStart="@dimen/space_lg"
                        android:singleLine="true" />

                    <!-- ═════════ Three counts, 56dp, one hairline card ═════════ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/ui_metric_row_height"
                        android:layout_marginTop="@dimen/space_16"
                        android:background="@drawable/bg_ui_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/space_lg"
                            android:paddingEnd="@dimen/space_md">

                            <TextView
                                android:id="@+id/txtAttendeeTotal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/placeholder_zero"
                                android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                                android:textColor="@color/ui_text_primary" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/ui_staff_total"
                                android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/stroke_hairline"
                            android:layout_height="match_parent"
                            android:background="@color/ui_hairline"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/space_md"
                            android:paddingEnd="@dimen/space_md">

                            <TextView
                                android:id="@+id/txtAttendeeCheckedIn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/placeholder_zero"
                                android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                                android:textColor="@color/ui_text_primary" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/ui_staff_checked_in"
                                android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />
                        </LinearLayout>

                        <View
                            android:layout_width="@dimen/stroke_hairline"
                            android:layout_height="match_parent"
                            android:background="@color/ui_hairline"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/space_md"
                            android:paddingEnd="@dimen/space_md">

                            <TextView
                                android:id="@+id/txtAttendeeRegistered"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/placeholder_zero"
                                android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                                android:textColor="@color/ui_text_primary" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/ui_staff_registered"
                                android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Events load failure reports in the flow above the list, with Retry (§5.7). -->
                <LinearLayout
                    android:id="@+id/errorRegistrations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_ui_block_r4"
                    android:backgroundTint="@color/ui_error_container"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_touch_min"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingEnd="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtRegistrationsError"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                        android:textColor="@color/ui_on_error_container" />

                    <TextView
                        android:id="@+id/btnRegistrationsRetry"
                        style="@style/Widget.EventQR.Ui.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="true"
                        android:minHeight="@dimen/ui_button_height_inline"
                        android:text="@string/common_retry"
                        android:textColor="@color/ui_on_error_container" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerEventRegistrations"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingBottom="@dimen/space_8" />

                <!-- Empty state lives in the list slot, under the search and count rows, never over them. -->
                <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                    android:id="@+id/txtAssignedEventsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:icon="@drawable/ic_ui_group"
                    app:subtitle="@string/ui_staff_no_attendees_body"
                    app:title="@string/ui_staff_no_attendees" />

                <EditText
                    android:id="@+id/edtRegistrationsEventId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnLoadEventRegistrations"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Loading mirrors the loaded rows: flat 72dp rows, not a card. -->
            <LinearLayout
                android:id="@+id/skeletonLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical">

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <!-- ===== Sticky batch bar: hairline on top, no shadow ===== -->
    <LinearLayout
        android:id="@+id/batchPrintBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_hairline"
            android:background="@color/ui_hairline"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_lg"
            android:paddingTop="@dimen/space_sm"
            android:paddingEnd="@dimen/space_lg"
            android:paddingBottom="@dimen/space_sm">

            <Button
                android:id="@+id/btnSelectAllRegistrations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_button_height_inline"
                android:background="@drawable/bg_ui_button_ghost"
                android:minWidth="@dimen/ui_touch_min"
                android:paddingStart="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg"
                android:stateListAnimator="@null"
                android:text="@string/ui_staff_select_all"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.EventQR.Type.ButtonLabelInline"
                android:textColor="@color/ui_primary" />

            <Button
                android:id="@+id/btnPrintSelectedIds"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_button_height_inline"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_button_primary"
                android:enabled="false"
                android:paddingStart="@dimen/space_lg"
                android:paddingEnd="@dimen/space_lg"
                android:stateListAnimator="@null"
                android:text="@string/ui_staff_print_selected"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.EventQR.Type.ButtonLabelInline"
                android:textColor="@color/ui_button_primary_text" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
