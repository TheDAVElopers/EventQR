<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/auth_header_height_238"
        android:background="@drawable/bg_signin_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_xl"
            android:paddingTop="@dimen/space_42">

            <ImageView
                android:layout_width="@dimen/tile_96"
                android:layout_height="@dimen/tile_96"
                android:contentDescription="@string/common_eventqr_logo"
                android:scaleType="fitCenter"
                android:src="@drawable/white_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:text="@string/forgot_password_forgot_password"
                android:textColor="@color/on_primary"
                android:textAppearance="@style/TextAppearance.EventQR.HeadlineXL" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center"
                android:lineSpacingExtra="@dimen/line_spacing_3"
                android:text="@string/forgot_password_reset_your_password_and_regain_acces"
                android:textColor="@color/accent_container"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_21"
            android:paddingTop="@dimen/space_33"
            android:paddingBottom="@dimen/space_30">

            <!-- Form state -->
            <LinearLayout
                android:id="@+id/layoutForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_email_address"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

                <EditText
                    style="@style/Widget.EventQR.EditText"
                    android:id="@+id/editEmail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/space_sm"
                    android:drawableStart="@drawable/email_icon"
                    android:drawablePadding="@dimen/space_md"
                    android:hint="@string/common_enter_email_address"
                    android:inputType="textEmailAddress"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:textColorHint="@color/text_secondary" />

                <Button
                    android:id="@+id/btnSendCode"
                    style="@style/Widget.EventQR.Button.Auth"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/control_height_54"
                    android:layout_marginTop="@dimen/space_22"
                    android:elevation="@dimen/elevation_4"
                    android:text="@string/forgot_password_send_code"
                    android:textAppearance="@style/TextAppearance.EventQR.ButtonPlatformBody.Strong" />

                <LinearLayout
                    android:id="@+id/tvBackToSignIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/space_20"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forgot_password_remembered_your_password"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forgot_password_sign_in"
                        android:textColor="@color/primary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
