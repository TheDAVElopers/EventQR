<?xml version="1.0" encoding="utf-8"?>
<!--
    FORGOT PASSWORD (§6.1, step 1 of the recovery pattern) - retires Gen A.

    The shipped auth shell verbatim: 56dp wordmark bar, hairline, then an `overline` step
    indicator, the `headline` title, one sentence of body copy, one 56dp filled field and one
    52dp primary. The reset flow keeps its own three-step rhythm, so the step label is the only
    thing that differs between Forgot / Reset / New password.

    Deleted: the 238dp gradient header, the 96dp centred raster logo, the raster envelope, the
    54dp outlined field, the 54dp gradient CTA with elevation and the centred helper copy.

    Wiring kept: editEmail, btnSendCode, tvBackToSignIn.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/authTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ui_gutter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_bar_height_auth"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Lockup (§3.1): mark 20dp + 12dp + wordmark 21sp, left aligned on the 20dp gutter. -->
            <ImageView
                android:layout_width="@dimen/ui_mark_bar_auth"
                android:layout_height="@dimen/ui_mark_bar_auth"
                android:layout_marginEnd="@dimen/ui_lockup_gap"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mark_on_light" />

            <TextView
                android:id="@+id/txtWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/auth_wordmark"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Wordmark"
                android:textSize="@dimen/ui_wordmark_size_auth"
                android:translationY="@dimen/ui_wordmark_nudge_auth" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline" />

    <ScrollView
        android:id="@+id/authScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layoutForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ui_gutter"
            android:paddingTop="@dimen/ui_auth_top_gap"
            android:paddingBottom="@dimen/space_24">

            <TextView
                android:id="@+id/txtStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_auth_step_1_of_3"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/forgot_password_forgot_password"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/forgot_password_reset_your_password_and_regain_acces"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Body" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:labelFor="@id/editEmail"
                android:text="@string/auth_label_email"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/editEmail"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:autoText="false"
                android:autofillHints="emailAddress"
                android:drawableStart="@drawable/ic_ui_mail"
                android:hint="@string/auth_hint_email"
                android:imeOptions="actionDone"
                android:inputType="textEmailAddress"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnSendCode"
                style="@style/Widget.EventQR.Ui.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_button_height"
                android:layout_marginTop="@dimen/space_24"
                android:text="@string/forgot_password_send_code" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_marginTop="@dimen/space_24"
                android:background="@color/ui_hairline" />

            <LinearLayout
                android:id="@+id/tvBackToSignIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_touch_min"
                android:layout_marginTop="@dimen/space_8"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forgot_password_remembered_your_password"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_4"
                    android:text="@string/forgot_password_sign_in"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
                    android:textColor="@color/ui_primary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

