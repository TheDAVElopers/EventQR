<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_eventqr_gradient"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/landing_header_padding_h"
            android:paddingTop="@dimen/landing_header_padding_top"
            android:paddingBottom="@dimen/landing_header_padding_bottom">

            <ImageView
                android:layout_width="@dimen/landing_logo_width"
                android:layout_height="@dimen/landing_logo_height"
                android:layout_marginTop="@dimen/landing_logo_margin_top"
                android:adjustViewBounds="true"
                android:contentDescription="@string/common_eventqr_logo"
                android:scaleType="fitCenter"
                android:src="@drawable/splash_logo_w_text_right" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/landing_tagline_margin_top"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="@string/landing_one_qr_code_every_event_instant_acce"
                android:textColor="@color/brand_on_primary"
                android:textSize="@dimen/landing_tagline_size" />

            <Button
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="@dimen/landing_btn_height"
                android:layout_marginTop="@dimen/landing_btn_margin_top"
                android:background="@drawable/bg_white_pill_button"
                android:elevation="3dp"
                android:text="@string/common_sign_in"
                android:textAllCaps="false"
                android:textColor="@color/brand_primary"
                android:textSize="@dimen/landing_btn_text_size"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCreateAccount"
                android:layout_width="match_parent"
                android:layout_height="@dimen/landing_btn_height"
                android:layout_marginTop="@dimen/landing_btn_margin_top"
                android:layout_marginBottom="@dimen/landing_btn_margin_bottom"
                android:background="@drawable/bg_dark_outline_button"
                android:text="@string/common_create_account"
                android:textAllCaps="false"
                android:textColor="@color/brand_on_primary"
                android:textSize="@dimen/landing_btn_text_size"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_alt"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/landing_feature_padding_h"
            android:paddingTop="@dimen/landing_feature_padding_top"
            android:paddingBottom="@dimen/landing_feature_padding_bottom">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/landing_why_choose_eventqr"
                android:textAppearance="@style/TextAppearance.EventQR.SectionTitle"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/landing_card_margin_top"
                android:clickable="true"
                android:focusable="true"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/outline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/landing_card_horizontal_padding"
                    android:paddingTop="@dimen/landing_card_top_padding"
                    android:paddingBottom="@dimen/landing_card_bottom_padding">

                    <ImageView
                        android:layout_width="@dimen/landing_icon_size"
                        android:layout_height="@dimen/landing_icon_size"
                        android:background="@drawable/dark_ic_qr_code"
                        android:padding="@dimen/landing_icon_padding"
                        android:contentDescription="@string/landing_qr_code_icon"
                        android:scaleType="centerInside" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/landing_card_text_margin_start"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/landing_one_qr_all_access"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/landing_card_title_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/landing_register_once_and_use_your_unique_qr"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/landing_card_desc_size" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/landing_card_margin_top"
                android:clickable="true"
                android:focusable="true"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/outline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/landing_card_horizontal_padding"
                    android:paddingTop="@dimen/landing_card_top_padding"
                    android:paddingBottom="@dimen/landing_card_bottom_padding">

                    <ImageView
                        android:layout_width="@dimen/landing_icon_size"
                        android:layout_height="@dimen/landing_icon_size"
                        android:background="@drawable/dark_ic_check_mark"
                        android:padding="@dimen/landing_icon_padding"
                        android:contentDescription="@string/landing_verification_check_icon"
                        android:scaleType="centerInside" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/landing_card_text_margin_start"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/landing_instant_verification"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/landing_card_title_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/landing_quick_identity_verification_and_seam"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/landing_card_desc_size" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/landing_card_margin_top"
                android:clickable="true"
                android:focusable="true"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="@color/surface"
                app:strokeWidth="1dp"
                app:strokeColor="@color/outline">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/landing_card_horizontal_padding"
                    android:paddingTop="@dimen/landing_card_top_padding"
                    android:paddingBottom="@dimen/landing_card_bottom_padding">

                    <ImageView
                        android:layout_width="@dimen/landing_icon_size"
                        android:layout_height="@dimen/landing_icon_size"
                        android:background="@drawable/dark_ic_star"
                        android:padding="@dimen/landing_icon_padding"
                        android:contentDescription="@string/landing_rewards_star_icon"
                        android:scaleType="centerInside" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/landing_card_text_margin_start"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/landing_rewards_benefits"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/landing_card_title_size"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/landing_earn_points_claim_benefits_and_redee"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/landing_card_desc_size" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
