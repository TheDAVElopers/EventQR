<?xml version="1.0" encoding="utf-8"?>
<!--
    Landing (§6.1 of MyFiles/EventQR-Redesign-Plan.md) - retires Gen A.

    A sticky 64dp wordmark bar, a left-aligned display_xl hero on the 20dp gutter, the
    mini-pass (flat ui_primary, full bleed, the only object on the screen that gets to be
    beautiful), one primary and one ghost action, then the three reasons as a numbered list
    with hairlines - no cards, no icons, no centred column.

    The bar is chrome, not content: it stays put while the page scrolls, so the hero and the
    mini-pass can never slide under the status bar.

    Deleted from the previous version: the 315 degree gradient block, the 270x100 centred
    raster wordmark, the centred tagline, the two stacked pills and the three raised cards
    with 40dp PNG icons.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <!-- ═════════ Bar: wordmark left at the gutter, ACCESS PASS overline right ═════════ -->
    <LinearLayout
        android:id="@+id/authTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ui_gutter">

        <!-- Inner row is exactly 64dp; the status-bar inset is added above it as padding,
             so the bar is 64dp of content plus the inset and its fill runs behind it. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_bar_height_landing"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Lockup (§3.1): mark 24dp + 12dp + wordmark, left aligned on the 20dp gutter. The mark
                 is decorative here - the wordmark already announces the brand. -->
            <ImageView
                android:layout_width="@dimen/ui_mark_bar_landing"
                android:layout_height="@dimen/ui_mark_bar_landing"
                android:layout_marginEnd="@dimen/ui_lockup_gap"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mark_on_light" />

            <TextView
                android:id="@+id/txtWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/auth_wordmark"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Wordmark"
                android:textSize="@dimen/ui_wordmark_size_landing"
                android:translationY="@dimen/ui_wordmark_nudge_landing" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtBarEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_access_pass"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline" />

    <ScrollView
        android:id="@+id/authScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═════════ Hero: one left edge, no centring ═════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/ui_gutter"
                android:paddingTop="@dimen/ui_hero_top_gap">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_landing_hero"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.DisplayXl" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/auth_landing_sub"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodyLarge"
                    android:textColor="@color/ui_text_secondary" />
            </LinearLayout>

            <!-- ═════════ Mini-pass: flat fill, square edges, bleeds to both gutters ═════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_minipass_height"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@color/ui_primary"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ui_gutter">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_access_pass"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow"
                        android:textColor="@color/ui_text_on_dark_muted" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/auth_minipass_title"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
                        android:textColor="@color/ui_text_on_dark" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/auth_minipass_serial"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericS"
                        android:textColor="@color/ui_text_on_dark_muted" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="@dimen/ui_minipass_qr_plate"
                    android:layout_height="@dimen/ui_minipass_qr_plate"
                    android:layout_marginStart="@dimen/space_lg"
                    android:background="@drawable/bg_ui_qr_plate"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/ui_minipass_qr_pad">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ui_pass_qr_art" />
                </FrameLayout>
            </LinearLayout>

            <!-- ═════════ Actions: primary then ghost, single column at the gutter ═════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_xl">

                <Button
                    android:id="@+id/btnSignIn"
                    style="@style/Widget.EventQR.Ui.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_button_height"
                    android:text="@string/auth_sign_in" />

                <Button
                    android:id="@+id/btnCreateAccount"
                    style="@style/Widget.EventQR.Ui.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_button_height_inline"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/auth_create_account" />
            </LinearLayout>

            <!-- ═════════ Why EventQR: a numbered list, not three cards ═════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxl"
                android:paddingHorizontal="@dimen/ui_gutter"
                android:paddingBottom="@dimen/space_sm"
                android:text="@string/auth_landing_why"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:background="@color/ui_hairline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/ui_gutter"
                android:paddingVertical="@dimen/space_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/ui_feature_number_width"
                    android:text="@string/auth_feature_number_1"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                    android:textColor="@color/ui_text_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_feature_1_title"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/auth_feature_1_body"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:background="@color/ui_hairline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/ui_gutter"
                android:paddingVertical="@dimen/space_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/ui_feature_number_width"
                    android:text="@string/auth_feature_number_2"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                    android:textColor="@color/ui_text_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_feature_2_title"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/auth_feature_2_body"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:background="@color/ui_hairline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/ui_gutter"
                android:paddingVertical="@dimen/space_lg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/ui_feature_number_width"
                    android:text="@string/auth_feature_number_3"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                    android:textColor="@color/ui_text_secondary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/auth_feature_3_title"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/auth_feature_3_body"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:background="@color/ui_hairline" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_xxl" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
