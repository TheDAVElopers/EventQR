<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eventqr_bg"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="My Event Requests">
        <TextView
            android:id="@+id/btnNewRequest"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:minWidth="78dp"
            android:paddingHorizontal="14dp"
            android:text="＋  New"
            android:textColor="@color/brand_on_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </com.thedavelopers.eventqr.ui.components.EventQrDetailHeader>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshMyEventRequests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMyEventRequests"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp" />

            <include layout="@layout/include_skeleton_cards" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                

                <TextView
                    android:id="@+id/txtMyRequestsError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Unable to load event requests."
                    android:textColor="@color/eventqr_error"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnMyRequestsRetry"
                    android:layout_width="140dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_primary_button"
                    android:text="Retry"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
            android:id="@+id/txtMyRequestsEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:icon="@drawable/ic_event_request"
            app:title="No event requests yet"
            app:subtitle="Requests you submit will show up here." />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
