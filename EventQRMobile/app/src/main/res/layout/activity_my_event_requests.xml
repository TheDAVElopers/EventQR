<?xml version="1.0" encoding="utf-8"?>
<!--
    My event requests (§6.2) - retires Gen A.

        Standard top bar with ONE trailing action ("New")
        EventRequestCard rows (shared component) on the flat page
        Shared skeleton and empty state

    Deleted: the 36dp pill button inside the header, include_skeleton_cards, the centred error
    column and the per-card decoration.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/ui_attendee_my_requests">

        <Button
            android:id="@+id/btnNewRequest"
            style="@style/Widget.EventQR.Ui.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ui_button_height_inline"
            android:minWidth="@dimen/ui_touch_min"
            android:text="@string/ui_attendee_new" />
    </com.thedavelopers.eventqr.ui.components.EventQrDetailHeader>

    <!-- Refresh failure with readable rows: the rows stay and the error is in the flow, directly
         under the header, with Retry beside the sentence (§5.7 line 642). No Snackbar/toast; the
         strip is a polite live region so a repeated failure is announced without a manual call. -->
    <LinearLayout
        android:id="@+id/errorMyRequests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_ui_block_r4"
        android:backgroundTint="@color/ui_error_container"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ui_touch_min"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtMyRequestsError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/my_event_requests_unable_to_load_event_requests"
            android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
            android:textColor="@color/ui_on_error_container" />

        <TextView
            android:id="@+id/btnMyRequestsRetry"
            style="@style/Widget.EventQR.Ui.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:minHeight="@dimen/ui_button_height_inline"
            android:text="@string/ui_attendee_retry"
            android:textColor="@color/ui_on_error_container" />
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshMyEventRequests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/ui_gutter"
            android:paddingEnd="@dimen/ui_gutter">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMyEventRequests"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:paddingTop="@dimen/space_lg"
                android:paddingBottom="@dimen/space_24" />

            <include
                android:id="@+id/skeletonLoading"
                layout="@layout/include_skeleton_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/txtMyRequestsEmpty"
                android:layout_width="@dimen/ui_empty_max_width"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:gutter="false" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

</LinearLayout>
