<?xml version="1.0" encoding="utf-8"?>
<!--
    NEW PASSWORD (§6.1, step 3 of 3) - retires Gen A.

    Same auth shell. Two filled fields, the checklist whose 16dp leading slot holds the
    `ic_ui_check` tick in `accent_deep` as each rule is satisfied, then a 72dp sticky footer so
    `Reset password` never scrolls away.

    Deleted: the 220dp gradient header, the 50dp raster logo, `bg_auth_field`, the elevated
    primary, the full-width ghost under it, the tinted requirement box and the Unicode marks.

    Wiring kept: layoutForm, edtNewPassword, edtConfirmPassword, btnResetPassword, btnBackToCode,
    layoutPasswordRequirements and the five rule TextViews.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/authTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ui_gutter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_bar_height_auth"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Lockup (§3.1): mark 20dp + 12dp + wordmark 21sp, left aligned on the 20dp gutter. -->
            <ImageView
                android:layout_width="@dimen/ui_mark_bar_auth"
                android:layout_height="@dimen/ui_mark_bar_auth"
                android:layout_marginEnd="@dimen/ui_lockup_gap"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mark_on_light" />

            <TextView
                android:id="@+id/txtWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/auth_wordmark"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Wordmark"
                android:textSize="@dimen/ui_wordmark_size_auth"
                android:translationY="@dimen/ui_wordmark_nudge_auth" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline" />

    <ScrollView
        android:id="@+id/authScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layoutForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ui_gutter"
            android:paddingTop="@dimen/ui_auth_top_gap"
            android:paddingBottom="@dimen/space_24">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_auth_step_3_of_3"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/reset_password_new_password"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:text="@string/reset_password_create_a_new_password_for_your_accou"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                android:textColor="@color/ui_text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:labelFor="@id/edtNewPassword"
                android:text="@string/reset_password_new_password"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <com.thedavelopers.eventqr.ui.components.PasswordTextInputLayout
                style="@style/Widget.EventQR.Ui.TextField.Password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <EditText
                    android:id="@+id/edtNewPassword"
                    style="@style/Widget.EventQR.Ui.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoText="false"
                    android:drawableStart="@drawable/ic_ui_lock"
                    android:hint="@string/reset_password_enter_new_password"
                    android:inputType="textPassword"
                    android:maxLength="128"
                    android:maxLines="1" />
            </com.thedavelopers.eventqr.ui.components.PasswordTextInputLayout>

            <TextView
                android:id="@+id/txtNewPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <!-- Rules: five rows, one per Validators rule. The 16dp leading slot is ic_ui_check
                 in accent_deep when met and empty at rest; the mark and the row's "met"/"not met"
                 description carry the state, never colour alone. -->
            <LinearLayout
                android:id="@+id/layoutPasswordRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:accessibilityLiveRegion="polite"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtPasswordLengthRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_length"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordCapitalRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_uppercase"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordLowercaseRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_lowercase"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordNumberRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_number"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordSpecialRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawablePadding="@dimen/space_8"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_special"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:labelFor="@id/edtConfirmPassword"
                android:text="@string/common_confirm_password"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <com.thedavelopers.eventqr.ui.components.PasswordTextInputLayout
                style="@style/Widget.EventQR.Ui.TextField.Password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8">

                <EditText
                    android:id="@+id/edtConfirmPassword"
                    style="@style/Widget.EventQR.Ui.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoText="false"
                    android:drawableStart="@drawable/ic_ui_lock"
                    android:hint="@string/common_confirm_new_password"
                    android:inputType="textPassword"
                    android:maxLength="128"
                    android:maxLines="1" />
            </com.thedavelopers.eventqr.ui.components.PasswordTextInputLayout>

            <TextView
                android:id="@+id/txtConfirmPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnBackToCode"
                style="@style/Widget.EventQR.Ui.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_button_height_inline"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/reset_password_back_to_code" />
        </LinearLayout>
    </ScrollView>

    <!-- §5.16 form failure strip, between the form and the sticky footer so it never scrolls away;
         hidden until a failure, and without Retry (the one-time reset code may be spent). -->
    <include
        android:id="@+id/errorNewPassword"
        layout="@layout/include_error_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:layout_marginBottom="@dimen/space_md" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline" />

    <LinearLayout
        android:id="@+id/authFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:minHeight="@dimen/ui_footer_height"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ui_gutter"
        android:paddingVertical="@dimen/space_md">

        <Button
            android:id="@+id/btnResetPassword"
            style="@style/Widget.EventQR.Ui.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_button_height"
            android:text="@string/reset_password_reset_password" />
    </LinearLayout>
</LinearLayout>
