<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/hero_height_220"
        android:background="@drawable/bg_eventqr_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_20"
            android:paddingTop="@dimen/space_49">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="@string/common_eventqr_logo"
                android:src="@drawable/white_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/reset_password_reset_password"
                android:textColor="@color/on_primary"
                android:textAppearance="@style/TextAppearance.EventQR.AuthTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_11"
                android:gravity="center"
                android:text="@string/reset_password_create_a_new_password_for_your_accou"
                android:textColor="@color/on_primary"
                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_21"
            android:paddingTop="@dimen/space_33"
            android:paddingBottom="@dimen/space_30">

            <!-- Form state -->
            <LinearLayout
                android:id="@+id/layoutForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_14"
                    android:text="@string/reset_password_new_password"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

                <EditText
                    android:id="@+id/edtNewPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/space_6"
                    android:background="@drawable/bg_auth_field"
                    android:drawableStart="@drawable/password_icon"
                    android:drawableEnd="@drawable/ic_visibility_on"
                    android:drawablePadding="@dimen/space_10"
                    android:hint="@string/reset_password_enter_new_password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="@dimen/space_14"
                    android:textColorHint="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

                <LinearLayout
                    android:id="@+id/layoutPasswordRequirements"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_10"
                    android:background="@drawable/bg_password_requirements"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtPasswordLengthRequirement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/password_req_length"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextOverline" />

                    <TextView
                        android:id="@+id/txtPasswordCapitalRequirement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/password_req_uppercase"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextOverline" />

                    <TextView
                        android:id="@+id/txtPasswordLowercaseRequirement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/password_req_lowercase"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextOverline" />

                    <TextView
                        android:id="@+id/txtPasswordNumberRequirement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/password_req_number"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextOverline" />

                    <TextView
                        android:id="@+id/txtPasswordSpecialRequirement"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/password_req_special"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextOverline" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_14"
                    android:text="@string/common_confirm_password"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

                <EditText
                    android:id="@+id/edtConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/space_6"
                    android:background="@drawable/bg_auth_field"
                    android:drawableStart="@drawable/password_icon"
                    android:drawableEnd="@drawable/ic_visibility_on"
                    android:drawablePadding="@dimen/space_10"
                    android:hint="@string/common_confirm_new_password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="@dimen/space_14"
                    android:textColorHint="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

                <Button
                    style="@style/Widget.EventQR.Button.Primary"
                    android:id="@+id/btnResetPassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="@dimen/space_xl"
                    android:elevation="@dimen/elevation_6"
                    android:text="@string/reset_password_reset_password"
                    android:textAppearance="@style/TextAppearance.EventQR.ButtonPlatformBodyMedium.Strong" />

                <Button
                    style="@style/Widget.EventQR.Button.Text"
                    android:id="@+id/btnBackToCode"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/reset_password_back_to_code"
                    android:textAppearance="@style/TextAppearance.EventQR.ButtonPlatformBodyMedium.Strong" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
