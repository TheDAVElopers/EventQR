<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER DASHBOARD (6.4) - retires Gen A.

        Pass head   ORGANIZER tab, title Events, stub APPROVED / REGISTRATIONS / REDEEMED
        THIS WEEK   3 metric rows - no cards, no icon tiles, no 2x2 grid
        NEXT EVENT  one 96dp date row
        ACTIVE      hairline rows on the page (one grouped card at most)

    There is no quick-action chip row: Attendees, Reports and Rewards live in the bottom nav,
    Staff in the event management hub.

    Deleted: the 26sp gradient "Organizer Portal" header, the 2x2 white stat cards with 42dp
    tinted icon tiles, the decorative green star, the bare ">" glyph, the centred empty block and
    the copy-pasted skeleton stack.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <!-- Pass head: identity + tear + stub -->
    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_32">

                <!-- THIS WEEK - secondary metrics as rows -->
                <TextView
                    style="@style/TextAppearance.EventQR.Type.Eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_24"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:text="@string/ui_organizer_this_week" />

                <LinearLayout
                    android:id="@+id/metricRowsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical" />

                <!-- NEXT EVENT - one date row -->
                <TextView
                    style="@style/TextAppearance.EventQR.Type.Eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_32"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:text="@string/ui_organizer_next_event" />

                <FrameLayout
                    android:id="@+id/nextEventHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4" />

                <!-- ACTIVE EVENTS - hairline rows, no per-row cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_32"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_active_events"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <TextView
                        android:id="@+id/btnSeeAllEvents"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/ui_touch_min"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical|end"
                        android:minWidth="@dimen/ui_touch_min"
                        android:text="@string/ui_organizer_see_all"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Label"
                        android:textColor="@color/ui_primary" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/activeEventsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                        android:id="@+id/layoutEventsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:icon="@drawable/ic_ui_event"
                        app:subtitle="@string/ui_organizer_no_events_body"
                        app:title="@string/ui_organizer_no_events" />

                    <include
                        android:id="@+id/skeletonLoading"
                        layout="@layout/include_skeleton_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8" />
                </FrameLayout>

                <!-- Error state: a card with a Retry action, not a centred block. -->
                <LinearLayout
                    android:id="@+id/layoutDashboardError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_8"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:background="@drawable/bg_ui_card"
                    android:orientation="vertical"
                    android:padding="@dimen/ui_card_padding"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtDashboardError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                        android:textColor="@color/ui_text_secondary" />

                    <Button
                        android:id="@+id/btnDashboardRetry"
                        style="@style/Widget.EventQR.Ui.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/ui_button_height_inline"
                        android:layout_marginTop="@dimen/space_8"
                        android:minWidth="@dimen/ui_touch_min"
                        android:text="@string/common_retry" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/layoutBottomNavHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
