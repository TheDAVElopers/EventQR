<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER DASHBOARD (6.4) - retires Gen A.

        Pass head   ORGANIZER tab, title Events,
                    stub REGISTERED / ATTENDED / LIVE NOW
        EVENTS      3 metric rows - Upcoming / Ended / Redeemed; unknown when the load failed
                    eyebrow row also carries the one Request event action
        NEXT EVENT  one 96dp date row
        ACTIVE      hairline rows on the page (one grouped card at most)

    There is no quick-action chip row: Attendees, Reports and Rewards live in the bottom nav,
    Staff in the event management hub.

    Deleted: the 26sp gradient "Organizer Portal" header, the 2x2 white stat cards with 42dp
    tinted icon tiles, the decorative green star, the bare ">" glyph, the centred empty block and
    the copy-pasted skeleton stack.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <!-- Pass head: identity + tear + stub -->
    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_32">

                <!-- ALL EVENTS - secondary metrics as rows; the request action rides this
                     eyebrow row, so it survives populated, empty and failed loads (§6.4). -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_24"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_touch_min"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/ui_organizer_all_events"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <TextView
                        android:id="@+id/btnRequestEvent"
                        style="@style/Widget.EventQR.Ui.SectionAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:gravity="center_vertical|end"
                        android:minHeight="@dimen/ui_touch_min"
                        android:text="@string/ui_organizer_request_event" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/metricRowsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:orientation="vertical" />

                <!-- Failed load: the in-flow error replaces the list area's content, sits under the
                     ALL EVENTS header (not below the fold), and owns the Retry (§5.10 item 6). -->
                <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                    android:id="@+id/layoutDashboardError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:icon="@drawable/ic_ui_warning" />

                <!-- NEXT EVENT - one date row; the eyebrow only exists when the row does. -->
                <TextView
                    android:id="@+id/txtNextEventEyebrow"
                    style="@style/TextAppearance.EventQR.Type.Eyebrow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_32"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:text="@string/ui_organizer_next_event"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/nextEventHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4" />

                <!-- ACTIVE EVENTS - hairline rows, no per-row cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_32"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_active_events"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <TextView
                        android:id="@+id/btnSeeAllEvents"
                        style="@style/Widget.EventQR.Ui.SectionAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical|end"
                        android:text="@string/ui_organizer_see_all" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/activeEventsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                        android:id="@+id/layoutEventsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:icon="@drawable/ic_ui_event"
                        app:subtitle="@string/ui_organizer_no_events_body"
                        app:title="@string/ui_organizer_no_events" />

                    <!-- Loading: the loaded active rows are 96dp date rows on the page, so the
                         skeleton is the same row stack, not a card. -->
                    <LinearLayout
                        android:id="@+id/skeletonLoading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/ui_skeleton_loading"
                        android:focusable="true"
                        android:orientation="vertical">

                        <include
                            layout="@layout/include_skeleton_row"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ui_row_height_date" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/stroke_hairline"
                            android:layout_marginStart="@dimen/ui_divider_inset"
                            android:background="@color/ui_hairline"
                            android:importantForAccessibility="no" />

                        <include
                            layout="@layout/include_skeleton_row"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ui_row_height_date" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/stroke_hairline"
                            android:layout_marginStart="@dimen/ui_divider_inset"
                            android:background="@color/ui_hairline"
                            android:importantForAccessibility="no" />

                        <include
                            layout="@layout/include_skeleton_row"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/ui_row_height_date" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </ScrollView>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/layoutBottomNavHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
