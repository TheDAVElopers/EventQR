<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/headerDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_gradient"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingTop="@dimen/space_20"
        android:paddingBottom="@dimen/space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/organizer_dashboard_organizer_portal"
                    android:textColor="@color/on_primary"
                    android:textAppearance="@style/TextAppearance.EventQR.PageTitle" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtHeaderSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxWidth="160dp"
                        android:maxLines="1"
                        android:text="@string/organizer_dashboard_loading_organizer_profile"
                        android:textColor="@color/deco_on_header_subtitle"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />

                    <TextView
                        android:id="@+id/txtHeaderSubtitleDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/separator_chevron"
                        android:textColor="@color/deco_on_header_subtitle"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/portalSwitcherChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_xs"
                        android:background="@drawable/bg_portal_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_10"
                        android:paddingVertical="@dimen/space_xs"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/txtCurrentPortal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/organizer_dashboard_organizer"
                            android:textColor="@color/on_primary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextOverline.Strong" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_3"
                            android:text="@string/glyph_dropdown_arrow"
                            android:textColor="@color/on_primary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextMicro.Regular" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnOrganizerNotifications"
                android:layout_width="@dimen/icon_tile_lg"
                android:layout_height="@dimen/icon_tile_lg"
                android:layout_marginStart="@dimen/space_md"
                android:background="@drawable/bg_header_icon_circle"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/common_notifications">

                <ImageView
                    android:layout_width="@dimen/icon_22"
                    android:layout_height="@dimen/icon_22"
                    android:layout_gravity="center"
                    android:src="@drawable/notification_bell"
                    android:importantForAccessibility="no"
                    app:tint="@color/on_primary" />

                <TextView
                    android:id="@+id/txtOrganizerNotificationBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/space_xxs"
                    android:layout_marginEnd="@dimen/space_xxs"
                    android:background="@drawable/bg_notification_badge_count"
                    android:gravity="center"
                    android:minWidth="@dimen/badge_count_min_width"
                    android:paddingHorizontal="@dimen/space_xs"
                    android:paddingVertical="1dp"
                    android:text="@string/placeholder_zero"
                    android:textColor="@color/on_primary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextNano"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_xl">

                <LinearLayout
                    android:id="@+id/layoutDashboardError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_20"
                    android:layout_marginTop="@dimen/space_lg"
                    android:background="@drawable/bg_red_warning"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/organizer_dashboard_unable_to_load_organizer_dashboard"
                        android:textColor="@color/error"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium.Strong" />

                    <TextView
                        android:id="@+id/txtDashboardError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/common_please_try_again"
                        android:textColor="@color/error"
                        android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />

                    <Button
                        android:id="@+id/btnDashboardRetry"
                        style="@style/Widget.EventQR.Button.Primary.Regular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:paddingLeft="@dimen/space_lg"
                        android:paddingTop="0dp"
                        android:paddingRight="@dimen/space_lg"
                        android:paddingBottom="0dp"
                        android:text="@string/common_retry" />
                </LinearLayout>

                <GridLayout
                    android:id="@+id/statsGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_14"
                    android:layout_marginTop="@dimen/space_lg"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:visibility="gone">

                    <!-- Total Events Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_6"
                        style="@style/Widget.EventQR.Card">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/space_md">

                            <LinearLayout
                                android:layout_width="@dimen/tile_42"
                                android:layout_height="@dimen/tile_42"
                                style="@style/Widget.EventQR.IconTile.Secondary"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="@dimen/icon_md"
                                    android:layout_height="@dimen/icon_md"
                                    android:contentDescription="@string/organizer_dashboard_total_events"
                                    android:src="@drawable/ic_calendar"
                                    app:tint="@color/primary" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_10"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtStatTotalEvents"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/placeholder_zero"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextHeadline" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xxs"
                                    android:text="@string/organizer_dashboard_total_events"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextOverline" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Total Attendees Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_6"
                        style="@style/Widget.EventQR.Card">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/space_md">

                            <LinearLayout
                                android:layout_width="@dimen/tile_42"
                                android:layout_height="@dimen/tile_42"
                                style="@style/Widget.EventQR.IconTile.Info"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="@dimen/icon_md"
                                    android:layout_height="@dimen/icon_md"
                                    android:contentDescription="@string/organizer_dashboard_total_registrations"
                                    android:src="@drawable/ic_group"
                                    app:tint="@color/info_dark" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_10"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtStatTotalAttendees"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/placeholder_zero"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextHeadline" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xxs"
                                    android:text="@string/organizer_dashboard_total_registrations"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextOverline" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Transactions Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_6"
                        style="@style/Widget.EventQR.Card">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/space_md">

                            <LinearLayout
                                android:layout_width="@dimen/tile_42"
                                android:layout_height="@dimen/tile_42"
                                style="@style/Widget.EventQR.IconTile.Secondary"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="@dimen/icon_md"
                                    android:layout_height="@dimen/icon_md"
                                    android:contentDescription="@string/common_transactions"
                                    android:src="@drawable/ic_credit_card"
                                    app:tint="@color/secondary_light" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_10"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtStatTransactions"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/placeholder_zero"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextHeadline" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xxs"
                                    android:text="@string/common_transactions"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextOverline" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Rewards Given Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="@dimen/space_6"
                        style="@style/Widget.EventQR.Card">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/space_md">

                            <LinearLayout
                                android:layout_width="@dimen/tile_42"
                                android:layout_height="@dimen/tile_42"
                                style="@style/Widget.EventQR.IconTile.Success"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="@dimen/icon_md"
                                    android:layout_height="@dimen/icon_md"
                                    android:contentDescription="@string/organizer_dashboard_rewards_redeemed"
                                    android:src="@drawable/ic_star_filled"
                                    app:tint="@color/success" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_10"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtStatRewardsGiven"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/placeholder_zero"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextHeadline" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/space_xxs"
                                    android:text="@string/organizer_dashboard_rewards_redeemed"
                                    android:textColor="@color/text_secondary"
                                    android:textAppearance="@style/TextAppearance.EventQR.TextOverline" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </GridLayout>

                <!-- Active Events Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_20"
                    android:layout_marginTop="@dimen/space_20"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/icon_22"
                        android:layout_height="@dimen/icon_22"
                        android:contentDescription="@string/organizer_dashboard_live"
                        android:src="@drawable/ic_signal_live" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:text="@string/common_active_events"
                        android:textColor="@color/text_primary"
                        android:textAppearance="@style/TextAppearance.EventQR.TitleMedium" />

                    <TextView
                        android:id="@+id/btnSeeAllEvents"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="40dp"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:text="@string/organizer_dashboard_see_all"
                        android:textColor="@color/primary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium.Strong" />
                </LinearLayout>

                <!-- Empty Active Events Layout -->
                <LinearLayout
                    android:id="@+id/layoutEventsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_20"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingVertical="@dimen/space_xl"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/tile_64"
                        android:layout_height="@dimen/tile_64"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/neutral" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:text="@string/organizer_dashboard_no_active_events"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyLarge.Strong" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/organizer_dashboard_no_events_happening_now"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
                </LinearLayout>

                <!-- Skeleton Loading -->
                <LinearLayout
                    android:id="@+id/skeletonLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_20"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_lg"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:layout_weight="1"
                            android:background="@drawable/bg_staff_skeleton_card"
                            android:orientation="vertical"
                            android:padding="@dimen/space_md">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_staff_skeleton_bar" />

                            <View
                                android:layout_width="80dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="@dimen/space_6"
                                android:background="@drawable/bg_staff_skeleton_bar" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:background="@drawable/bg_staff_skeleton_card"
                            android:orientation="vertical"
                            android:padding="@dimen/space_md">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_staff_skeleton_bar" />

                            <View
                                android:layout_width="80dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="@dimen/space_6"
                                android:background="@drawable/bg_staff_skeleton_bar" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_sm"
                            android:layout_weight="1"
                            android:background="@drawable/bg_staff_skeleton_card"
                            android:orientation="vertical"
                            android:padding="@dimen/space_md">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_staff_skeleton_bar" />

                            <View
                                android:layout_width="80dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="@dimen/space_6"
                                android:background="@drawable/bg_staff_skeleton_bar" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_sm"
                            android:layout_weight="1"
                            android:background="@drawable/bg_staff_skeleton_card"
                            android:orientation="vertical"
                            android:padding="@dimen/space_md">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_staff_skeleton_bar" />

                            <View
                                android:layout_width="80dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="@dimen/space_6"
                                android:background="@drawable/bg_staff_skeleton_bar" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:background="@drawable/bg_staff_skeleton_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_14">

                        <View
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_staff_skeleton_date_block" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_staff_skeleton_bar" />

                            <View
                                android:layout_width="140dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="@dimen/space_sm"
                                android:background="@drawable/bg_staff_skeleton_bar" />
                        </LinearLayout>

                        <View
                            android:layout_width="56dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_staff_skeleton_bar" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_10"
                        android:background="@drawable/bg_staff_skeleton_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_14">

                        <View
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_staff_skeleton_date_block" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_staff_skeleton_bar" />

                            <View
                                android:layout_width="150dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="@dimen/space_sm"
                                android:background="@drawable/bg_staff_skeleton_bar" />
                        </LinearLayout>

                        <View
                            android:layout_width="52dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_staff_skeleton_bar" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_10"
                        android:background="@drawable/bg_staff_skeleton_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_14">

                        <View
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_staff_skeleton_date_block" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_staff_skeleton_bar" />

                            <View
                                android:layout_width="120dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="@dimen/space_sm"
                                android:background="@drawable/bg_staff_skeleton_bar" />
                        </LinearLayout>

                        <View
                            android:layout_width="60dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_staff_skeleton_bar" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Active Events List Container -->
                <LinearLayout
                    android:id="@+id/activeEventsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_20"
