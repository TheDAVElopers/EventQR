<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - EVENT DETAILS, READ-ONLY (§6.4, v1.20).

        Top bar      56dp, back + "Event details"
        Head         include_organizer_event_head: name only, tear - identity only. The badge is the
                     table's STATUS row here, so the head binds with showStatus = false
        Spec table   Status, Location, Event time, Registration window, About, Organizer, Co-organizers.
                     Label left, value right, hairline inset to the gutters; About is the same row block
                     with the body under its label
        Review note  adminRemarks once, error tone for Rejected, warning for Pending review
        Actions      52dp primary "View attendees", 48dp ghost "Open reports" beneath it, 8dp apart
        Skeleton     first load renders the head + seven table rows in their own geometry

    Rules this file encodes:
      * the head states identity, the table states the rest - no block repeats another
      * no stats band: Registered / Capacity / Available are the Manage event hub's stub, and
        repeating them here made two screens state the same numbers (§6.4 v1.18)
      * every band that holds type is wrap_content + minHeight, never a fixed height
      * a blank table value hides its row AND its hairline
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/include_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:id="@+id/oedContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_32">

            <include
                layout="@layout/include_organizer_event_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Spec table: label left, value right, hairline inset to the gutters. The head is identity
                 only, so the venue and the schedule are rows here. About is the same block with the
                 body under its label. space_24 is the head-to-content gap the editor and the attendee
                 event detail use; the removed stats band left this table directly under the tear. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_24">

                <!-- STATUS first: the one fact that used to ride in the head. The badge is the row's
                     trailing value (§5.4 placement), bound through bindEventBadge so it shares the
                     head binder's status -> label/tone mapping. -->
                <LinearLayout
                    android:id="@+id/oedRowStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_detail_status"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/oedStatusValue"
                        style="@style/Widget.EventQR.Ui.StatusBadge.Info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:minHeight="@dimen/ui_badge_height"
                        tools:text="Completed" />
                </LinearLayout>

                <View
                    android:id="@+id/oedDividerStatus"
                    style="@style/Widget.EventQR.Ui.ListRow.Divider"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/oedRowLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_venue"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/oedLocationValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary"
                        tools:text="Iloilo Convention Center, Iloilo City" />
                </LinearLayout>

                <View
                    android:id="@+id/oedDividerLocation"
                    style="@style/Widget.EventQR.Ui.ListRow.Divider"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/oedRowEventTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_event_time"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/oedEventTimeValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericS"
                        android:textColor="@color/ui_text_primary"
                        tools:text="13 Nov 2026, 12:20 AM – 12:20 PM" />
                </LinearLayout>

                <View
                    android:id="@+id/oedDividerEventTime"
                    style="@style/Widget.EventQR.Ui.ListRow.Divider"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/oedRowRegistration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_registration_window"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/oedRegistrationValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericS"
                        android:textColor="@color/ui_text_primary"
                        tools:text="1 May 2026, 9:00 AM –&#160;1 Jun 2026, 11:59 PM" />
                </LinearLayout>

                <View
                    android:id="@+id/oedDividerRegistration"
                    style="@style/Widget.EventQR.Ui.ListRow.Divider"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <!-- About: the registration-window row treatment with the body under the label.
                     Hidden with its hairline when the event has no description. The body is the
                     app's only justified text (inter-word, last line still start-aligned). -->
                <LinearLayout
                    android:id="@+id/oedAboutBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ui_surface"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_organizer_about"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/oedAboutBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:gravity="start"
                        android:justificationMode="inter_word"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary"
                        tools:text="A one-day developer conference for students and professionals." />
                </LinearLayout>

                <View
                    android:id="@+id/oedDividerAbout"
                    style="@style/Widget.EventQR.Ui.ListRow.Divider"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/oedRowOrganizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_organizer"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/oedOrganizerValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary"
                        tools:text="TheDAVElopers" />
                </LinearLayout>

                <View
                    android:id="@+id/oedDividerOrganizer"
                    style="@style/Widget.EventQR.Ui.ListRow.Divider"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/oedRowCoOrganizers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_coorganizers"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/oedCoOrganizersValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary"
                        tools:text="UP Cebu, DevCon Manila" />
                </LinearLayout>

                <View
                    android:id="@+id/oedDividerCoOrganizers"
                    style="@style/Widget.EventQR.Ui.ListRow.Divider"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Review note: the only surface that renders adminRemarks. Tone follows the status,
                 set by the activity (error for Rejected, warning for Pending review). -->
            <LinearLayout
                android:id="@+id/oedReviewNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_ui_card"
                android:backgroundTint="@color/ui_error_container"
                android:orientation="vertical"
                android:padding="@dimen/ui_card_padding"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/oedReviewNoteLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/ui_organizer_review_note"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                    android:textColor="@color/ui_on_error_container" />

                <TextView
                    android:id="@+id/oedReviewNoteBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:importantForAccessibility="no"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                    android:textColor="@color/ui_on_error_container"
                    tools:text="The location certificate is missing. Re-submit with the permit attached." />
            </LinearLayout>

            <!-- Actions: one primary, one ghost, stacked. An equal pair states no priority. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_32"
                android:paddingEnd="@dimen/ui_gutter">

                <Button
                    android:id="@+id/oedActionAttendees"
                    style="@style/Widget.EventQR.Ui.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_button_height"
                    android:text="@string/ui_organizer_view_attendees" />

                <Button
                    android:id="@+id/oedActionReports"
                    style="@style/Widget.EventQR.Ui.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:minHeight="@dimen/ui_button_height_inline"
                    android:text="@string/ui_organizer_open_reports" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- First load: the head plate (the 2-line title band, ui_organizer_head_skeleton_height) plus
         seven table rows in their own geometry (§5.11). The CLOSED container announces "Loading";
         every bar is hidden from TalkBack (§9.5). -->
    <LinearLayout
        android:id="@+id/oedSkeleton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/ui_skeleton_loading"
        android:focusable="true"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_organizer_head_skeleton_height"
            android:importantForAccessibility="noHideDescendants">

            <include
                layout="@layout/include_skeleton_block"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_24">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_metric_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingEnd="@dimen/ui_gutter">

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="@dimen/ui_skeleton_title_width"
                    android:layout_height="@dimen/ui_skeleton_bar_height" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_metric_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingEnd="@dimen/ui_gutter">

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="@dimen/ui_skeleton_title_width"
                    android:layout_height="@dimen/ui_skeleton_bar_height" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_metric_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingEnd="@dimen/ui_gutter">

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="@dimen/ui_skeleton_title_width"
                    android:layout_height="@dimen/ui_skeleton_bar_height" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_metric_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingEnd="@dimen/ui_gutter">

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="@dimen/ui_skeleton_title_width"
                    android:layout_height="@dimen/ui_skeleton_bar_height" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_metric_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingEnd="@dimen/ui_gutter">

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="@dimen/ui_skeleton_title_width"
                    android:layout_height="@dimen/ui_skeleton_bar_height" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_metric_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingEnd="@dimen/ui_gutter">

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="@dimen/ui_skeleton_title_width"
                    android:layout_height="@dimen/ui_skeleton_bar_height" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_metric_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingEnd="@dimen/ui_gutter">

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="@dimen/ui_skeleton_title_width"
                    android:layout_height="@dimen/ui_skeleton_bar_height" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
