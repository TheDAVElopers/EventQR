<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - EVENT DETAILS, READ-ONLY (6.4).

        Top bar      56dp, back + "Event details"
        Identity     pass-head anatomy at per-event scale: event name headline with the status badge
                     as its trailing value, 1dp tear, three stat slots on the ui_pass_stub band
        Spec table   Date, Time, Venue, Registration window, Organizer, Co-organizers
                     overline label left / body value right, 1dp hairlines inset to the gutters
        About        overline title + body paragraph, hidden when the description is blank
        Actions      two equal-width action chips: Attendees, Reports

    This screen is the read-only counterpart of the event editor, so it shows what the event is and
    what the organizer can do next. It never renders editable fields and has no Save action.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/include_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:id="@+id/oedContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_32">

            <!-- Identity: Block A of the pass head (§4.6). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pass_head"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_16"
                android:paddingEnd="@dimen/ui_gutter"
                android:paddingBottom="@dimen/space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/oedTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Headline"
                        android:textColor="@color/ui_on_primary"
                        tools:text="DevFest Manila 2026" />

                    <TextView
                        android:id="@+id/oedStatusBadge"
                        style="@style/Widget.EventQR.Ui.StatusBadge.Info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_marginTop="@dimen/space_4"
                        tools:text="Completed" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tear line: full bleed, 1dp. -->
            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:background="@drawable/divider_perforation_dark"
                android:importantForAccessibility="no" />

            <!-- Block B: stub, three equal slots on the tonal step. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pass_stub"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_pass_head_stub_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_12"
                android:paddingBottom="@dimen/space_12">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/ui_pass_head_stat_cell_pad">

                    <TextView
                        android:id="@+id/oedStatRegistered"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                        android:textColor="@color/ui_on_primary"
                        tools:text="128" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ui_pass_head_stat_label_gap"
                        android:text="@string/event_management_hub_stat_registered"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_on_primary_muted" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/stroke_hairline"
                    android:layout_height="@dimen/ui_pass_head_stub_height"
                    android:layout_gravity="center_vertical"
                    android:background="@color/ui_on_dark_hairline"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ui_pass_head_stat_cell_pad"
                    android:paddingEnd="@dimen/ui_pass_head_stat_cell_pad">

                    <TextView
                        android:id="@+id/oedStatCapacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                        android:textColor="@color/ui_on_primary"
                        tools:text="200" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ui_pass_head_stat_label_gap"
                        android:text="@string/event_management_hub_stat_capacity"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_on_primary_muted" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/stroke_hairline"
                    android:layout_height="@dimen/ui_pass_head_stub_height"
                    android:layout_gravity="center_vertical"
                    android:background="@color/ui_on_dark_hairline"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ui_pass_head_stat_cell_pad"
                    android:paddingEnd="@dimen/ui_gutter">

                    <TextView
                        android:id="@+id/oedStatAvailable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                        android:textColor="@color/ui_on_primary"
                        tools:text="72" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ui_pass_head_stat_label_gap"
                        android:text="@string/event_management_hub_stat_available"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_on_primary_muted" />
                </LinearLayout>
            </LinearLayout>

            <!-- Spec table: label left, value right, hairline under each row. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_8">

                <LinearLayout
                    android:id="@+id/oedRowDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_date"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/oedDateValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary"
                        tools:text="12 Jun 2026" />
                </LinearLayout>

                <View
                    android:id="@+id/oedDividerDate"
                    style="@style/Widget.EventQR.Ui.ListRow.Divider"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/oedRowTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_time"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/oedTimeValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary"
                        tools:text="9:41 AM - 5:00 PM" />
                </LinearLayout>

                <View
                    android:id="@+id/oedDividerTime"
                    style="@style/Widget.EventQR.Ui.ListRow.Divider"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/oedRowVenue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_venue"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/oedVenueValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary"
                        tools:text="SMX Convention Center" />
                </LinearLayout>

                <View
                    android:id="@+id/oedDividerVenue"
                    style="@style/Widget.EventQR.Ui.ListRow.Divider"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/oedRowRegistration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_registration_window"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/oedRegistrationValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary"
                        tools:text="1 May 2026, 9:00 AM - 1 Jun 2026, 11:59 PM" />
                </LinearLayout>

                <View
                    android:id="@+id/oedDividerRegistration"
                    style="@style/Widget.EventQR.Ui.ListRow.Divider"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/oedRowOrganizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_organizer"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/oedOrganizerValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary"
                        tools:text="TheDAVElopers" />
                </LinearLayout>

                <View
                    android:id="@+id/oedDividerOrganizer"
                    style="@style/Widget.EventQR.Ui.ListRow.Divider"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/oedRowCoOrganizers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_coorganizers"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/oedCoOrganizersValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary"
                        tools:text="UP Cebu, DevCon Manila" />
                </LinearLayout>

                <View
                    android:id="@+id/oedDividerCoOrganizers"
                    style="@style/Widget.EventQR.Ui.ListRow.Divider"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- About: hidden when the event has no description. -->
            <LinearLayout
                android:id="@+id/oedAboutBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_24"
                android:paddingEnd="@dimen/ui_gutter"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_organizer_about"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/oedAboutBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                    android:textColor="@color/ui_text_primary"
                    tools:text="A one-day developer conference for students and professionals." />
            </LinearLayout>

            <!-- Actions: two equal-width chips, the only things this screen lets you do. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_24"
                android:paddingEnd="@dimen/ui_gutter">

                <TextView
                    android:id="@+id/oedActionAttendees"
                    style="@style/Widget.EventQR.Ui.Chip.Action"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_ui_group"
                    android:gravity="center"
                    android:minHeight="@dimen/ui_chip_height"
                    android:text="@string/ui_organizer_attendees" />

                <TextView
                    android:id="@+id/oedActionReports"
                    style="@style/Widget.EventQR.Ui.Chip.Action"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_chip_gap"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_ui_assessment"
                    android:gravity="center"
                    android:minHeight="@dimen/ui_chip_height"
                    android:text="@string/ui_organizer_reports" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
