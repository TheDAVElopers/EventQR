<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - EVENT DETAILS, READ-ONLY (§6.4, v1.7).

        Top bar      56dp, back + "Event details"
        Head         include_organizer_event_head: name + StatusBadge, when, where, tear
        Stub         Registered / Capacity / Available on the tonal step, wrap_content + 60dp floor
        Spec table   Registration window, Organizer, Co-organizers only - Date, Time and Venue live
                     in the head, which is where a reader looks for them first
        Review note  adminRemarks once, error tone for Rejected, warning for Pending review
        About        overline + body, hidden when the description is blank
        Actions      52dp primary "View attendees", 48dp ghost "Open reports" beneath it, 8dp apart
        Skeleton     first load renders the head + stub + three table rows in their own geometry

    Rules this file encodes:
      * the head states identity, the stub states the numbers, the table states the rest - no block
        repeats another
      * every band that holds type is wrap_content + minHeight, never a fixed height
      * a blank table value hides its row AND its hairline
      * stat cells are one TalkBack node each ({value} {label}), so the labels are silent
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/include_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:id="@+id/oedContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_32">

            <include
                layout="@layout/include_organizer_event_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Block B: the stub. 60dp is a MINIMUM - value over label grows at large font scale. -->
            <LinearLayout
                android:id="@+id/oedStub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pass_stub"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_pass_head_stub_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/ui_pass_head_stub_pad_v"
                android:paddingEnd="@dimen/ui_gutter"
                android:paddingBottom="@dimen/ui_pass_head_stub_pad_v">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/ui_pass_head_stat_cell_pad">

                    <TextView
                        android:id="@+id/oedStatRegistered"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                        android:textColor="@color/ui_on_primary"
                        tools:text="128" />

                    <TextView
                        android:id="@+id/oedStatRegisteredLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ui_pass_head_stat_label_gap"
                        android:importantForAccessibility="no"
                        android:text="@string/event_management_hub_stat_registered"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_on_primary_muted" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/stroke_hairline"
                    android:layout_height="match_parent"
                    android:background="@color/ui_on_dark_hairline"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ui_pass_head_stat_cell_pad"
                    android:paddingEnd="@dimen/ui_pass_head_stat_cell_pad">

                    <TextView
                        android:id="@+id/oedStatCapacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                        android:textColor="@color/ui_on_primary"
                        tools:text="200" />

                    <TextView
                        android:id="@+id/oedStatCapacityLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ui_pass_head_stat_label_gap"
                        android:importantForAccessibility="no"
                        android:text="@string/event_management_hub_stat_capacity"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_on_primary_muted" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/stroke_hairline"
                    android:layout_height="match_parent"
                    android:background="@color/ui_on_dark_hairline"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ui_pass_head_stat_cell_pad">

                    <TextView
                        android:id="@+id/oedStatAvailable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                        android:textColor="@color/ui_on_primary"
                        tools:text="72" />

                    <TextView
                        android:id="@+id/oedStatAvailableLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ui_pass_head_stat_label_gap"
                        android:importantForAccessibility="no"
                        android:text="@string/event_management_hub_stat_available"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_on_primary_muted" />
                </LinearLayout>
            </LinearLayout>

            <!-- Spec table: exactly three rows. Label left, value right, hairline inset to the gutters. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="@dimen/space_8">

                <LinearLayout
                    android:id="@+id/oedRowRegistration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_registration_window"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/oedRegistrationValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericS"
                        android:textColor="@color/ui_text_primary"
                        tools:text="1 May 2026, 9:00 AM - 1 Jun 2026, 11:59 PM" />
                </LinearLayout>

                <View
                    android:id="@+id/oedDividerRegistration"
                    style="@style/Widget.EventQR.Ui.ListRow.Divider"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/oedRowOrganizer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_organizer"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/oedOrganizerValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary"
                        tools:text="TheDAVElopers" />
                </LinearLayout>

                <View
                    android:id="@+id/oedDividerOrganizer"
                    style="@style/Widget.EventQR.Ui.ListRow.Divider"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/oedRowCoOrganizers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/ui_surface"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingTop="@dimen/space_12"
                    android:paddingEnd="@dimen/ui_gutter"
                    android:paddingBottom="@dimen/space_12"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_coorganizers"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/oedCoOrganizersValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary"
                        tools:text="UP Cebu, DevCon Manila" />
                </LinearLayout>

                <View
                    android:id="@+id/oedDividerCoOrganizers"
                    style="@style/Widget.EventQR.Ui.ListRow.Divider"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Review note: the only surface that renders adminRemarks. Tone follows the status,
                 set by the activity (error for Rejected, warning for Pending review). -->
            <LinearLayout
                android:id="@+id/oedReviewNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_ui_card"
                android:backgroundTint="@color/ui_error_container"
                android:orientation="vertical"
                android:padding="@dimen/ui_card_padding"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/oedReviewNoteLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/ui_organizer_review_note"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                    android:textColor="@color/ui_on_error_container" />

                <TextView
                    android:id="@+id/oedReviewNoteBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:importantForAccessibility="no"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                    android:textColor="@color/ui_on_error_container"
                    tools:text="The venue certificate is missing. Re-submit with the permit attached." />
            </LinearLayout>

            <!-- About: hidden when the event has no description. -->
            <LinearLayout
                android:id="@+id/oedAboutBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_24"
                android:paddingEnd="@dimen/ui_gutter"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ui_organizer_about"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/oedAboutBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                    android:textColor="@color/ui_text_primary"
                    tools:text="A one-day developer conference for students and professionals." />
            </LinearLayout>

            <!-- Actions: one primary, one ghost, stacked. An equal pair states no priority. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_32"
                android:paddingEnd="@dimen/ui_gutter">

                <Button
                    android:id="@+id/oedActionAttendees"
                    style="@style/Widget.EventQR.Ui.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_button_height"
                    android:text="@string/ui_organizer_view_attendees" />

                <Button
                    android:id="@+id/oedActionReports"
                    style="@style/Widget.EventQR.Ui.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:minHeight="@dimen/ui_button_height_inline"
                    android:text="@string/ui_organizer_open_reports" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- First load: the head + stub + three table rows in their own geometry (§5.11). The CLOSED
         container announces "Loading"; every bar is hidden from TalkBack (§9.5). -->
    <LinearLayout
        android:id="@+id/oedSkeleton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/ui_skeleton_loading"
        android:focusable="true"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_organizer_head_skeleton_height"
            android:importantForAccessibility="noHideDescendants">

            <include
                layout="@layout/include_skeleton_block"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_pass_head_stub_height"
            android:importantForAccessibility="noHideDescendants">

            <include
                layout="@layout/include_skeleton_block"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_metric_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingEnd="@dimen/ui_gutter">

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="@dimen/ui_skeleton_title_width"
                    android:layout_height="@dimen/ui_skeleton_bar_height" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_metric_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingEnd="@dimen/ui_gutter">

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="@dimen/ui_skeleton_title_width"
                    android:layout_height="@dimen/ui_skeleton_bar_height" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_metric_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingEnd="@dimen/ui_gutter">

                <include
                    layout="@layout/include_skeleton_block"
                    android:layout_width="@dimen/ui_skeleton_title_width"
                    android:layout_height="@dimen/ui_skeleton_bar_height" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
