<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - EDIT EVENT DETAILS (§6.4 v1.7, editor).

        Top bar       56dp, back + "Edit event"
        Head          include_organizer_event_head: the name only (showStatus = false); the status
                      is the read-only STATUS row that opens the form column
        Form          STATUS row, then five sections headed Widget.EventQR.Ui.SectionHeading on the
                      20dp gutter, 1dp divider_perforation_light between them, in the view page's
                      block order:
                        Event         Title (required), Venue (optional)
                        Schedule      Event dates, locked, + one micro note
                        Registration  Registration window (locked), Capacity (required, >= registered)
                        About         Description, multiline
                        Banner        16:9 preview, "Choose banner", one micro note
        Save bar      ui_surface, hairline on top, space_12 top/bottom, "Unsaved changes" state
                      line, "Save changes" 52dp disabled until dirty

    Field anatomy (§5.2 verbatim): static overline label -> 8dp -> 56dp filled box -> 4dp -> micro.
    Every label carries android:labelFor at its own control.

    Rules this file encodes:
      * the head is full-bleed, so the scroll column carries NO horizontal padding; only the form
        column is inset to the 20dp gutter
      * every container that holds type is wrap_content + minHeight, never a fixed height
      * the save bar is bottom-anchored in normal layout flow, so the state line grows the bar
        upward and the button never moves
      * a locked value is a read-only row (label left, numeric_s value right), never a disabled box
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/eeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/include_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:id="@+id/eeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include
                layout="@layout/include_organizer_event_head"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/eeForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_24"
                android:paddingEnd="@dimen/ui_gutter"
                android:paddingBottom="@dimen/space_32">

                <!-- STATUS first, like the read-only details page (§6.4 v1.20/v1.24): the head is the
                     title alone, so the badge lives in a read-only row and never rides the header.
                     Anatomy is EVENT DATES / REGISTRATION WINDOW's - overline label left, value on
                     the row's trailing edge, ui_metric_row_height floor, hairline under. The badge is
                     wrap_content (it hugs, never a full-width pill) and is bound through
                     bindEventBadge, the head binder's own status -> label/tone mapping. -->
                <LinearLayout
                    android:id="@+id/eeStatusRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_organizer_detail_status"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_text_secondary" />

                    <TextView
                        android:id="@+id/eeStatusValue"
                        style="@style/Widget.EventQR.Ui.StatusBadge.Info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:minHeight="@dimen/ui_badge_height"
                        android:visibility="invisible"
                        tools:text="Upcoming"
                        tools:visibility="visible" />
                </LinearLayout>

                <View
                    android:id="@+id/eeDividerStatus"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <!-- Locked fallback: the ONLY state that survives for Active / Completed (§6.4).
                     The activity also hides the save bar and disables every field. -->
                <TextView
                    android:id="@+id/eeLockedNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_error"
                    android:visibility="gone"
                    tools:text="Editing locked - event is ongoing"
                    tools:visibility="visible" />

                <!-- ═════════════════ EVENT ═════════════════ -->
                <LinearLayout
                    android:id="@+id/eeSectionEvent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_organizer_edit_section_event"
                        style="@style/Widget.EventQR.Ui.SectionHeading" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/eeTitleLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/eeTitleInput"
                            android:text="@string/ui_organizer_edit_label_title"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                        <EditText
                            android:id="@+id/eeTitleInput"
                            style="@style/Widget.EventQR.Ui.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:importantForAutofill="no"
                            android:imeOptions="actionNext"
                            android:inputType="textCapSentences"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/eeTitleError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:accessibilityLiveRegion="polite"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                            android:textColor="@color/ui_error"
                            android:visibility="gone"
                            tools:text="Enter a title."
                            tools:visibility="visible" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/eeVenueLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/eeVenueInput"
                            android:text="@string/ui_organizer_venue"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                        <EditText
                            android:id="@+id/eeVenueInput"
                            style="@style/Widget.EventQR.Ui.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:importantForAutofill="no"
                            android:imeOptions="actionNext"
                            android:inputType="textCapSentences"
                            android:maxLines="1" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginTop="@dimen/space_24"
                    android:background="@drawable/divider_perforation_light"
                    android:importantForAccessibility="no"
                    android:layerType="software" />

                <!-- ═════════════════ SCHEDULE (locked) ═════════════════ -->
                <LinearLayout
                    android:id="@+id/eeSectionSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_organizer_edit_section_schedule"
                        style="@style/Widget.EventQR.Ui.SectionHeading" />

                    <LinearLayout
                        android:id="@+id/eeEventDatesRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/ui_metric_row_height"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_organizer_edit_event_dates"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                            android:textColor="@color/ui_text_secondary" />

                        <TextView
                            android:id="@+id/eeEventDatesValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.NumericS"
                            android:textColor="@color/ui_text_primary"
                            tools:text="12 Jun 2026, 9:00 AM - 5:00 PM" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_hairline"
                        android:background="@color/ui_hairline"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/eeEventDatesNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="@string/ui_organizer_edit_locked_note"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                        android:textColor="@color/ui_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginTop="@dimen/space_24"
                    android:background="@drawable/divider_perforation_light"
                    android:importantForAccessibility="no"
                    android:layerType="software" />

                <!-- ═════════════════ REGISTRATION ═════════════════ -->
                <LinearLayout
                    android:id="@+id/eeSectionRegistration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_organizer_edit_section_registration"
                        style="@style/Widget.EventQR.Ui.SectionHeading" />

                    <LinearLayout
                        android:id="@+id/eeWindowRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/ui_metric_row_height"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ui_organizer_registration_window"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                            android:textColor="@color/ui_text_secondary" />

                        <TextView
                            android:id="@+id/eeWindowValue"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_16"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.NumericS"
                            android:textColor="@color/ui_text_primary"
                            tools:text="1 May 2026, 9:00 AM - 1 Jun 2026, 11:59 PM" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_hairline"
                        android:background="@color/ui_hairline"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_16"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/eeCapacityLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/eeCapacityInput"
                            android:text="@string/ui_organizer_edit_label_capacity"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                        <EditText
                            android:id="@+id/eeCapacityInput"
                            style="@style/Widget.EventQR.Ui.TextField"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:importantForAutofill="no"
                            android:imeOptions="actionDone"
                            android:inputType="number"
                            android:maxLength="6"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/eeCapacityNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_4"
                            android:accessibilityLiveRegion="polite"
                            android:text="@string/ui_organizer_edit_capacity_helper"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                            android:textColor="@color/ui_text_secondary" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginTop="@dimen/space_24"
                    android:background="@drawable/divider_perforation_light"
                    android:importantForAccessibility="no"
                    android:layerType="software" />

                <!-- ═════════════════ ABOUT ═════════════════ -->
                <LinearLayout
                    android:id="@+id/eeSectionAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_organizer_about"
                        style="@style/Widget.EventQR.Ui.SectionHeading" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/eeDescriptionLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:labelFor="@id/eeDescriptionInput"
                            android:text="@string/ui_organizer_edit_label_description"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                        <EditText
                            android:id="@+id/eeDescriptionInput"
                            style="@style/Widget.EventQR.Ui.TextField.Multiline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_8"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences|textMultiLine" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginTop="@dimen/space_24"
                    android:background="@drawable/divider_perforation_light"
                    android:importantForAccessibility="no"
                    android:layerType="software" />

                <!-- ═════════════════ BANNER ═════════════════ -->
                <LinearLayout
                    android:id="@+id/eeSectionBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_organizer_edit_section_banner"
                        style="@style/Widget.EventQR.Ui.SectionHeading" />

                    <!-- 16:9 at a 320dp content width. The sunken fill doubles as the empty plate:
                         the image is never GONE, so "no banner" reads as an empty frame, not a gap. -->
                    <ImageView
                        android:id="@+id/eeBannerPreview"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ui_organizer_event_banner_height"
                        android:layout_marginTop="@dimen/space_12"
                        android:background="@drawable/bg_ui_icon_tile"
                        android:backgroundTint="@color/ui_surface_sunken"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <Button
                        android:id="@+id/eeBannerPick"
                        style="@style/Widget.EventQR.Ui.Button.Secondary.Inline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:minHeight="@dimen/ui_button_height_inline"
                        android:text="@string/ui_organizer_edit_choose_banner" />

                    <TextView
                        android:id="@+id/eeBannerNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:accessibilityLiveRegion="polite"
                        android:text="@string/ui_organizer_edit_banner_note"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                        android:textColor="@color/ui_text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Footer hairline: the bar is bottom-anchored, so this rule and the bar's fill never move. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/eeSaveBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:minHeight="@dimen/ui_footer_height"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/ui_gutter"
        android:paddingBottom="@dimen/space_12">

        <!-- A failed save reports here, above the state line, never in a toast (§6.4). -->
        <TextView
            android:id="@+id/eeSaveError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_ui_card"
            android:backgroundTint="@color/ui_error_container"
            android:padding="@dimen/space_12"
            android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
            android:textColor="@color/ui_on_error_container"
            android:visibility="gone"
            tools:text="Couldn't save your changes. Try again."
            tools:visibility="visible" />

        <!-- §6.6: the form says it holds uncommitted work. The bar grows upward instead of the
             button moving, so the primary action never jumps under the thumb. -->
        <TextView
            android:id="@+id/eeUnsaved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_8"
            android:accessibilityLiveRegion="polite"
            android:text="@string/ui_organizer_edit_unsaved"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
            android:textColor="@color/ui_warning"
            android:visibility="gone"
            tools:visibility="visible" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/eeSaveButton"
                style="@style/Widget.EventQR.Ui.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:minHeight="@dimen/ui_button_height"
                android:text="@string/ui_organizer_edit_save" />

            <!-- Loading state (§5.1): the label hides, the width is held by the match_parent button. -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/eeSaveProgress"
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:visibility="gone"
                app:indicatorColor="@color/ui_on_primary"
                app:indicatorSize="@dimen/icon_md"
                app:trackThickness="@dimen/stroke_focus" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

