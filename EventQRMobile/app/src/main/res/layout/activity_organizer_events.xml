<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - EVENT LIST (§6.4 "Attendees list" pattern applied to events).

        Compact pass head   eyebrow ORGANIZER, title Events, count in the trailing slot
        48dp search         filled field, no label, 20dp leading search icon
        chip row            All / Upcoming / Active / Completed - 36dp, radius 4, no pills
        list head           ALL EVENTS eyebrow + the one Request event action
        rows                96dp date rows on the page, hairline dividers, one badge

    Deleted: bg_organizer_events_screen, the tab header with a radial glow, the 54dp outlined
    search box, the Material ChipGroup pills, the centred empty block and the skeleton stack.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <EditText
        android:id="@+id/inputEventSearch"
        style="@style/Widget.EventQR.Ui.TextField.Search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:drawableStart="@drawable/ic_ui_search"
        android:drawablePadding="@dimen/space_md"
        android:drawableTint="@color/ui_text_secondary"
        android:hint="@string/common_search_events"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text" />

    <!-- §5.6: the filter row wraps on a packed, start-aligned Flow, it never scrolls. Four chips
         share one line at 360dp; 36dp fill inside a 48dp touch target, wrap height so a grown
         label is not clipped. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingEnd="@dimen/ui_gutter">

        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/chipFlow"
            style="@style/Widget.EventQR.Ui.ChipFlow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="chipAll,chipUpcoming,chipActive,chipCompleted"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/chipAll"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/common_all" />

        <TextView
            android:id="@+id/chipUpcoming"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/common_upcoming" />

        <TextView
            android:id="@+id/chipActive"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/common_active" />

        <TextView
            android:id="@+id/chipCompleted"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/common_completed" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ALL EVENTS - list head. The request action lives here and only here, so it is present
         in every state; the empty state carries no second control (§6.4). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ui_touch_min"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/ui_organizer_all_events"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

        <TextView
            android:id="@+id/btnRequestEvent"
            style="@style/Widget.EventQR.Ui.SectionAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:gravity="center_vertical|end"
            android:minHeight="@dimen/ui_touch_min"
            android:text="@string/ui_organizer_request_event" />
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshEvents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_16"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEvents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/space_24" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/layoutEventsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:icon="@drawable/ic_ui_event"
                app:subtitle="@string/common_try_adjusting_your_search_or_filters"
                app:title="@string/organizer_events_no_events_available_for_the_selected" />

            <LinearLayout
                android:id="@+id/skeletonLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:visibility="gone"
                android:contentDescription="@string/ui_skeleton_loading"
                android:orientation="vertical">
                <include layout="@layout/include_skeleton_row" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline" />
                <include layout="@layout/include_skeleton_row" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline" />
                <include layout="@layout/include_skeleton_row" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline" />
                <include layout="@layout/include_skeleton_row" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline" />
                <include layout="@layout/include_skeleton_row" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline" />
                <include layout="@layout/include_skeleton_row" />
            </LinearLayout>
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/layoutOrganizerBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
