<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - EVENT LIST (§6.4 "Attendees list" pattern applied to events).

        Compact pass head   eyebrow ORGANIZER, title Events, count in the trailing slot
        48dp search         filled field, no label, 20dp leading search icon
        chip row            All / Upcoming / Active / Completed - 36dp, radius 4, no pills
        rows                96dp date rows on the page, hairline dividers, one badge

    Deleted: bg_organizer_events_screen, the tab header with a radial glow, the 54dp outlined
    search box, the Material ChipGroup pills, the centred empty block and the skeleton stack.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <EditText
        android:id="@+id/inputEventSearch"
        style="@style/Widget.EventQR.Ui.TextField.Search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_field_search_height"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:drawableStart="@drawable/ic_ui_search"
        android:drawablePadding="@dimen/space_md"
        android:drawableTint="@color/ui_text_secondary"
        android:hint="@string/common_search_events"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:clipToPadding="false"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingEnd="@dimen/ui_gutter"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_touch_min"
                android:text="@string/common_all" />

            <TextView
                android:id="@+id/chipUpcoming"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_touch_min"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:text="@string/common_upcoming" />

            <TextView
                android:id="@+id/chipActive"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_touch_min"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:text="@string/common_active" />

            <TextView
                android:id="@+id/chipCompleted"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_touch_min"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:text="@string/common_completed" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshEvents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_16"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEvents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/space_24" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/layoutEventsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:icon="@drawable/ic_ui_event"
                app:subtitle="@string/common_try_adjusting_your_search_or_filters"
                app:title="@string/organizer_events_no_events_available_for_the_selected" />

            <include
                android:id="@+id/skeletonLoading"
                layout="@layout/include_skeleton_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:visibility="gone" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/layoutOrganizerBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
