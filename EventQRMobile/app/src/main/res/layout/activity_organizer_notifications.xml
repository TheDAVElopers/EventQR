<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - NOTIFICATIONS SHELL (6.5 Notifications, 5.8 top bar).

    The list itself is Compose (NotificationsScreen.kt, another batch). This file owns the shell:
    56dp top bar, one 44dp text action, two filter field rows, the list host, the shared empty
    state, an error card and one skeleton card.

    Deleted: bg_organizer_events_screen, the EventQrDetailHeader slot button, the two raised
    filter cards with a chevron rotation, the centred error block and include_skeleton_cards.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/include_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_touch_min"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtMarkAllRead"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ui_button_height_inline"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="@dimen/ui_touch_min"
            android:paddingStart="@dimen/space_12"
            android:paddingEnd="@dimen/space_12"
            android:text="@string/organizer_notifications_mark_all_read"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Label"
            android:textColor="@color/ui_primary" />
    </LinearLayout>

    <!-- Filter row: two 48dp field rows, not two raised cards. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cardEventFilter"
            android:layout_width="0dp"
            android:layout_height="@dimen/ui_field_search_height"
            android:layout_weight="1"
            android:background="@drawable/bg_ui_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_12">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:layout_marginEnd="@dimen/space_8"
                android:contentDescription="@string/organizer_notifications_calendar"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ui_event"
                android:tint="@color/ui_text_secondary" />

            <TextView
                android:id="@+id/txtEventFilter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/organizer_notifications_all_events"
                android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                android:textColor="@color/ui_text_primary" />

            <ImageView
                android:id="@+id/arrowEventFilter"
                style="@style/Widget.EventQR.Ui.Selector.Caret"
                android:layout_marginStart="@dimen/space_4"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardTypeFilter"
            android:layout_width="0dp"
            android:layout_height="@dimen/ui_field_search_height"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:background="@drawable/bg_ui_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_12">

            <TextView
                android:id="@+id/txtTypeFilter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/organizer_notifications_all_types"
                android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                android:textColor="@color/ui_text_primary" />

            <ImageView
                android:id="@+id/arrowTypeFilter"
                style="@style/Widget.EventQR.Ui.Selector.Caret"
                android:layout_marginStart="@dimen/space_4"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerEventFilter"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinnerTypeFilter"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshNotifications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_8"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerNotifications"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/space_24" />

            <include
                android:id="@+id/skeletonLoading"
                layout="@layout/include_skeleton_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginEnd="@dimen/ui_gutter" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/layoutNotificationEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:icon="@drawable/ic_ui_notifications_none"
                app:subtitle="@string/organizer_notifications_stay_tuned_for_updates_on_your_event"
                app:title="@string/organizer_notifications_no_notifications_yet" />

            <LinearLayout
                android:id="@+id/layoutNotificationError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:background="@drawable/bg_ui_card"
                android:orientation="vertical"
                android:padding="@dimen/ui_card_padding"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/ui_row_tile"
                    android:layout_height="@dimen/ui_row_tile"
                    android:background="@drawable/bg_ui_empty_plate"
                    android:contentDescription="@string/organizer_notifications_error_loading_notifications"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/ic_ui_notifications_none"
                    android:tint="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtNotificationError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />
            </LinearLayout>
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>
</LinearLayout>
