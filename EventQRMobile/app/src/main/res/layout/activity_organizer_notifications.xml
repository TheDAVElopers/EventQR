<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_organizer_events_screen"
    android:orientation="vertical">

    <!-- Header Area -->
    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/common_notifications">
        <TextView
            android:id="@+id/txtMarkAllRead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/space_sm"
            android:paddingVertical="@dimen/space_xs"
            android:text="@string/organizer_notifications_mark_all_read"
            android:textColor="@color/primary"
            android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />
    </com.thedavelopers.eventqr.ui.components.EventQrDetailHeader>

    <!-- Filter row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_20"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="@dimen/space_md">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEventFilter"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginEnd="@dimen/space_6"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            style="@style/Widget.EventQR.Card.Item.Flat">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md">

                <ImageView
                    android:layout_width="@dimen/icon_18"
                    android:layout_height="@dimen/icon_18"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:contentDescription="@string/organizer_notifications_calendar"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/txtEventFilter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/organizer_notifications_all_events"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

                <ImageView
                    android:id="@+id/arrowEventFilter"
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:layout_marginStart="@dimen/space_xs"
                    android:contentDescription="@string/common_dropdown"
                    android:src="@drawable/ic_arrow_drop_down"
                    app:tint="@color/neutral_label" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTypeFilter"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/space_6"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            style="@style/Widget.EventQR.Card.Item.Flat">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_md">

                <ImageView
                    android:layout_width="@dimen/icon_18"
                    android:layout_height="@dimen/icon_18"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:contentDescription="@string/organizer_notifications_type_tag"
                    android:src="@drawable/ic_row_tag"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/txtTypeFilter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/organizer_notifications_all_types"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

                <ImageView
                    android:id="@+id/arrowTypeFilter"
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:layout_marginStart="@dimen/space_xs"
                    android:contentDescription="@string/common_dropdown"
                    android:src="@drawable/ic_arrow_drop_down"
                    app:tint="@color/neutral_label" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Spinner
            android:id="@+id/spinnerEventFilter"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spinnerTypeFilter"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshNotifications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerNotifications"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:paddingHorizontal="@dimen/space_20"
                android:paddingTop="@dimen/space_xs"
                android:paddingBottom="@dimen/space_xl" />

            <!-- Skeleton -->
            <include layout="@layout/include_skeleton_cards" />

            <!-- Empty -->
            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/layoutNotificationEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:icon="@drawable/ic_admin_notification"
                app:title="@string/organizer_notifications_no_notifications_yet"
                app:subtitle="@string/organizer_notifications_stay_tuned_for_updates_on_your_event" />

            <!-- Error -->
            <LinearLayout
                android:id="@+id/layoutNotificationError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_xxl"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/tile_64"
                    android:layout_height="@dimen/tile_64"
                    android:contentDescription="@string/organizer_notifications_error_loading_notifications"
                    android:src="@drawable/ic_error_circle"
                    app:tint="@color/error" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center"
                    android:text="@string/organizer_notifications_failed_to_load_notifications"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyLarge.Strong" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/organizer_notifications_please_check_your_connection_and_try"
                    android:textColor="@color/text_label"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
            </LinearLayout>
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>
</LinearLayout>
