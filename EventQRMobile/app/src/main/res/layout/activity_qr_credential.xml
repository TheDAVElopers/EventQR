<?xml version="1.0" encoding="utf-8"?>
<!--
    QR credential (§5.14, §6.2) - the one screen where the gradient is allowed, because the pass
    is the object the product is about. Everything around it is flat.

        shared include_qr_credential (315deg credential surface, notch perforation, 216dp plate)
        40dp above the pass, spec table for the bound values
        Save pass (secondary 52dp) + the keep-screen-bright switch row
        the hidden plumbing the activity drives (registration id, qr value, loader)

    Deleted: the centred 74dp gradient check circle, the 164dp QR floated with no plate, the 46sp
    centred event name, the three-row icon card with tinted tiles, the dark-gradient download
    button and the 760dp minHeight hack.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <!-- One exit, and it is the standard back action: the pass has nothing to "close". -->
    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/ui_attendee_pass" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layoutQrCredentialContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_gutter"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/ui_gutter"
            android:paddingBottom="@dimen/space_24">

            <include
                android:id="@+id/qrCredential"
                layout="@layout/include_qr_credential"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_attendee_pass_top_gap" />

            <!-- ═════════ Pass details: the values the activity binds ═════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:background="@drawable/bg_ui_card"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_card_padding"
                android:paddingEnd="@dimen/ui_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_row_height_value"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_attendee_attendee"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtQrAttendeeName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:background="@color/ui_hairline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_row_height_value"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_attendee_email"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtQrAttendeeEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:background="@color/ui_hairline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_row_height_value"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_attendee_registration"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtQrCredentialValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericS"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═════════ Save pass ═════════ -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_button_height"
                android:layout_marginTop="@dimen/space_24">

                <Button
                    android:id="@+id/btnMarkQrDownloaded"
                    style="@style/Widget.EventQR.Ui.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_button_height"
                    android:text="@string/ui_attendee_save_pass" />

                <ProgressBar
                    android:id="@+id/progressQrDownload"
                    android:layout_width="@dimen/ui_field_icon"
                    android:layout_height="@dimen/ui_field_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:indeterminateTint="@color/ui_primary"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/imgQrDownloadCheck"
                    android:layout_width="@dimen/ui_field_icon"
                    android:layout_height="@dimen/ui_field_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ui_check_circle"
                    android:tint="@color/ui_success"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- ═════════ Keep screen bright ═════════ -->
            <LinearLayout
                android:id="@+id/rowKeepBright"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_touch_min"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/switchKeepBright"
                    android:text="@string/ui_attendee_keep_screen_bright"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                    android:textColor="@color/ui_text_primary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchKeepBright"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/ui_touch_min"
                    android:minHeight="@dimen/ui_touch_min" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtQrLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/common_loading_credential"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_text_secondary"
                android:visibility="gone" />

            <!-- Hidden plumbing the activity drives; never visible. -->
            <EditText
                android:id="@+id/edtQrRegistrationId"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnLoadQr"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtQrValue"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
