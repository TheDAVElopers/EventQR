<?xml version="1.0" encoding="utf-8"?>
<!--
    QR display (§5.14, §6.2) - the one canonical pass layout. Both entry points use it: the
    post-registration success screen and the pass opened from My passes. It carries the standard
    56dp top bar with a back action titled `Pass`; there is no second variant and no flag.

    Deleted: the centred gradient check circle, the 164dp QR with no plate, the 46sp centred event
    name, the icon-row card, the dark-gradient download button, the duplicate details card that
    repeated attendee/email/serial, and the never-visible registration-id load plumbing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/ui_attendee_pass" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layoutQrPassContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_gutter"
            android:paddingTop="@dimen/space_lg"
            android:paddingEnd="@dimen/ui_gutter"
            android:paddingBottom="@dimen/space_24">

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/emptyQrPassState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:gutter="false"
                app:icon="@drawable/ic_ui_warning" />

            <include
                android:id="@+id/qrCredential"
                layout="@layout/include_qr_credential"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_attendee_pass_top_gap"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtQrSavedCopy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_text_secondary"
                android:visibility="gone"
                tools:text="Saved copy, last updated 12 Oct 2026, 9:41 AM" />

            <!-- One object, one action: the pass, then Save pass and the brightness switch. The
                 duplicated ATTENDEE / EMAIL / REGISTRATION card is gone; the serial lives once,
                 inside the pass (§5.14, §6.2). -->
            <!-- ═════════ Save pass ═════════ -->
            <FrameLayout
                android:id="@+id/groupSavePass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_button_height"
                android:layout_marginTop="@dimen/space_24"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnMarkQrDownloaded"
                    style="@style/Widget.EventQR.Ui.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_button_height"
                    android:text="@string/ui_attendee_save_pass" />

                <ProgressBar
                    android:id="@+id/progressQrDownload"
                    android:layout_width="@dimen/ui_field_icon"
                    android:layout_height="@dimen/ui_field_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:indeterminateTint="@color/ui_primary"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/imgQrDownloadCheck"
                    android:layout_width="@dimen/ui_field_icon"
                    android:layout_height="@dimen/ui_field_icon"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ui_check_circle"
                    android:tint="@color/ui_success"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- §5.16: a save or share failure reports under the save control; the success toast
                 stays. The parent pads the gutter, so the strip carries no side margins. -->
            <include
                android:id="@+id/errorQrPass"
                layout="@layout/include_error_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />

            <!-- ═════════ Keep screen bright ═════════ -->
            <LinearLayout
                android:id="@+id/rowKeepBright"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_touch_min"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/switchKeepBright"
                    android:text="@string/ui_attendee_keep_screen_bright"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                    android:textColor="@color/ui_text_primary" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchKeepBright"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/ui_touch_min"
                    android:minHeight="@dimen/ui_touch_min" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtQrLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/common_loading_credential"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
