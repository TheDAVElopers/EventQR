<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/qr_display_qr_display" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="760dp"
            android:paddingStart="@dimen/space_20"
            android:paddingTop="@dimen/space_18"
            android:paddingEnd="@dimen/space_20"
            android:paddingBottom="@dimen/space_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="74dp"
                    android:layout_height="74dp"
                    android:background="@drawable/bg_check_circle">

                    <ImageView
                        android:layout_width="@dimen/tile_42"
                        android:layout_height="@dimen/tile_42"
                        android:layout_gravity="center"
                        android:contentDescription="@string/qr_display_qr_credential_ready"
                        android:src="@drawable/ic_qr_success_check" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_18"
                    android:text="@string/qr_display_event_access_qr"
                    android:textAppearance="@style/TextAppearance.EventQR.TitleLarge" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:gravity="center"
                    android:lineSpacingExtra="@dimen/line_spacing_2"
                    android:text="@string/qr_display_show_this_qr_at_the_entrance_for_eve"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:background="@drawable/bg_info_card"
                    android:elevation="@dimen/elevation_raised"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_14"
                    android:paddingTop="@dimen/space_14"
                    android:paddingEnd="@dimen/space_14"
                    android:paddingBottom="@dimen/space_14">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/tile_34"
                            android:layout_height="@dimen/tile_34"
                            android:background="@drawable/bg_soft_gray_pill">

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_gravity="center"
                                android:contentDescription="@string/common_attendee"
                                android:src="@drawable/ic_qr_attendee" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_attendee"
                                android:textColor="@color/text_primary"
                                android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Strong" />

                            <TextView
                                android:id="@+id/txtQrAttendeeName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:text="@string/placeholder_dash"
                                android:textColor="@color/text_secondary"
                                android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_14"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/tile_34"
                            android:layout_height="@dimen/tile_34"
                            android:background="@drawable/bg_soft_gray_pill">

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_gravity="center"
                                android:contentDescription="@string/common_email"
                                android:src="@drawable/ic_qr_email" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_email"
                                android:textColor="@color/text_primary"
                                android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Strong" />

                            <TextView
                                android:id="@+id/txtQrAttendeeEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/placeholder_dash"
                                android:textColor="@color/text_secondary"
                                android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_14"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/tile_34"
                            android:layout_height="@dimen/tile_34"
                            android:background="@drawable/bg_soft_gray_pill">

                            <ImageView
                                android:layout_width="@dimen/icon_md"
                                android:layout_height="@dimen/icon_md"
                                android:layout_gravity="center"
                                android:contentDescription="@string/common_attendee_id"
                                android:src="@drawable/ic_hashtag" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_md"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_attendee_id"
                                android:textColor="@color/text_primary"
                                android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Strong" />

                            <TextView
                                android:id="@+id/txtQrCredentialValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:text="@string/placeholder_dash"
                                android:textColor="@color/text_secondary"
                                android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgQrCode"
                    android:layout_width="@dimen/qr_box_164"
                    android:layout_height="@dimen/qr_box_164"
                    android:layout_marginTop="@dimen/space_14"
                    android:adjustViewBounds="true"
                    android:background="@color/surface"
                    android:contentDescription="@string/common_qr_code"
                    android:elevation="@dimen/elevation_raised"
                    android:padding="@dimen/space_6"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/txtQrEventName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center"
                    android:text="@string/placeholder_dash"
                    android:textAppearance="@style/TextAppearance.EventQR.TitleMedium" />

                <FrameLayout
                    android:layout_width="@dimen/tile_128"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/space_14">

                    <Button
                        android:id="@+id/btnMarkQrDownloaded"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        style="@style/Widget.EventQR.Button.Download"
                        android:paddingStart="@dimen/space_md"
                        android:paddingEnd="@dimen/space_md"
                        android:text="@string/common_download_qr" />

                    <ProgressBar
                        android:id="@+id/progressQrDownload"
                        android:layout_width="@dimen/icon_22"
                        android:layout_height="@dimen/icon_22"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:indeterminateTint="@color/on_primary"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/imgQrDownloadCheck"
                        android:layout_width="@dimen/icon_22"
                        android:layout_height="@dimen/icon_22"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_qr_success_check"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtQrLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/common_loading_credential"
                    android:textAppearance="@style/TextAppearance.EventQR.TextCaption"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/edtQrRegistrationId"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnLoadQr"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtQrValue"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
