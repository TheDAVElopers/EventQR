<?xml version="1.0" encoding="utf-8"?>
<!--
    Request event (§6.2, shared form pattern §6.6) - retires Gen A.

        Five sections headed Widget.EventQR.Ui.SectionHeading, separated by 1dp perforations
        56dp filled fields with static overline labels
        Poster picker as a flat media block
        Sticky footer: review caption (txtSubmitReviewNote) above primary Submit request + ghost Cancel
        Field errors: a micro ui_error line under the field (txt*Error) + the activated 2dp error stroke
        Server failure: include_error_strip above the footer (errorRequestEvent)

    Deleted: the per-section CardView, the RequestEventInput 54dp outlined style, the full-width
    dark Cancel button under the submit, the flat black "card" wrapper and the tinted message box.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/ui_attendee_request_event" />

    <ScrollView
        android:id="@+id/formScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_gutter"
            android:paddingTop="@dimen/space_24"
            android:paddingEnd="@dimen/ui_gutter"
            android:paddingBottom="@dimen/space_24">

            <!-- ═════════ Event information ═════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:text="@string/ui_attendee_event_information"
                style="@style/Widget.EventQR.Ui.SectionHeading" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/eventNameInput"
                android:text="@string/request_event_event_name"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/eventNameInput"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/request_event_event_name_2"
                android:inputType="textCapSentences"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtEventNameError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:labelFor="@id/cardEventCategory"
                android:text="@string/request_event_event_category"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <LinearLayout
                android:id="@+id/cardEventCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_ui_field"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:minHeight="@dimen/ui_control_height">

                <LinearLayout
                    android:id="@+id/layoutEventCategoryContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_md">

                    <TextView
                        android:id="@+id/txtSelectedEventCategory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/ui_attendee_select"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary" />

                    <ImageView
                        android:id="@+id/spinnerArrow"
                        style="@style/Widget.EventQR.Ui.Selector.Caret"
                        android:layout_marginStart="@dimen/space_sm"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>

            <Spinner
                android:id="@+id/spinnerEventCategory"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtEventCategoryError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:labelFor="@id/eventDescriptionInput"
                android:text="@string/request_event_event_description"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/eventDescriptionInput"
                style="@style/Widget.EventQR.Ui.TextField.Multiline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/request_event_describe_the_event"
                android:inputType="textMultiLine" />

            <TextView
                android:id="@+id/txtEventDescriptionError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:labelFor="@id/targetAudienceInput"
                android:text="@string/request_event_target_audience"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/targetAudienceInput"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/request_event_students_professionals_community_mem"
                android:inputType="textCapSentences"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtTargetAudienceError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:labelFor="@id/capacityInput"
                android:text="@string/request_event_expected_attendees"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/capacityInput"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/capacity_hint"
                android:inputType="number"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtCapacityError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/divider_perforation_light"
                android:layerType="software" />

            <!-- ═════════ Schedule and location ═════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/ui_attendee_schedule"
                style="@style/Widget.EventQR.Ui.SectionHeading" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/venueInput"
                android:text="@string/request_event_venue_location"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/venueInput"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/request_event_venue_or_address"
                android:inputType="textCapSentences"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtVenueError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:labelFor="@id/startDateTimeInput"
                android:text="@string/request_event_start_date_and_time"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/startDateTimeInput"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:hint="@string/request_event_tap_to_select_date_and_time"
                android:inputType="none"
                android:longClickable="false"
                android:maxLines="1"
                android:textIsSelectable="false" />

            <TextView
                android:id="@+id/txtStartDateTimeError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:labelFor="@id/endDateTimeInput"
                android:text="@string/request_event_end_date_and_time"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/endDateTimeInput"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:hint="@string/request_event_tap_to_select_date_and_time"
                android:inputType="none"
                android:longClickable="false"
                android:maxLines="1"
                android:textIsSelectable="false" />

            <TextView
                android:id="@+id/txtEndDateTimeError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:labelFor="@id/registrationStartDateTimeInput"
                android:text="@string/request_event_registration_start_date_and_time"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/registrationStartDateTimeInput"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:hint="@string/request_event_tap_to_select_date_and_time"
                android:inputType="none"
                android:longClickable="false"
                android:maxLines="1"
                android:textIsSelectable="false" />

            <TextView
                android:id="@+id/txtRegistrationStartDateTimeError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:labelFor="@id/registrationEndDateTimeInput"
                android:text="@string/request_event_registration_end_date_and_time"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/registrationEndDateTimeInput"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:hint="@string/request_event_tap_to_select_date_and_time"
                android:inputType="none"
                android:longClickable="false"
                android:maxLines="1"
                android:textIsSelectable="false" />

            <TextView
                android:id="@+id/txtRegistrationEndDateTimeError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/divider_perforation_light"
                android:layerType="software" />

            <!-- ═════════ Requester ═════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/ui_attendee_requester"
                style="@style/Widget.EventQR.Ui.SectionHeading" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:labelFor="@id/requesterNameInput"
                android:text="@string/request_event_requester_name"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/requesterNameInput"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/common_full_name"
                android:inputType="textPersonName"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtRequesterNameError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:labelFor="@id/contactEmailInput"
                android:text="@string/request_event_contact_email"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/contactEmailInput"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/request_event_name_example_com"
                android:inputType="textEmailAddress"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtContactEmailError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:labelFor="@id/contactNumberInput"
                android:text="@string/request_event_contact_number"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/contactNumberInput"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/phone_hint_example"
                android:inputType="phone"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtContactNumberError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/divider_perforation_light"
                android:layerType="software" />

            <!-- ═════════ Event setup ═════════ -->
            <LinearLayout
                android:id="@+id/layoutPosterSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/ui_attendee_setup"
                style="@style/Widget.EventQR.Ui.SectionHeading" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/request_event_event_poster"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <FrameLayout
                android:id="@+id/eventPosterPicker"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_150"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_ui_field"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/eventPosterPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/request_event_selected_event_poster"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/eventPosterPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="start|center_vertical"
                    android:orientation="vertical"
                    android:padding="@dimen/ui_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/request_event_tap_to_attach_event_poster"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/request_event_recommended_jpg_png_landscape_16_9_a"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                        android:textColor="@color/ui_text_secondary" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/eventPosterStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/request_event_no_poster_selected_the_default_gradi"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_text_secondary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/divider_perforation_light"
                android:layerType="software" />
            </LinearLayout>

            <!-- ═════════ Reason for request ═════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:labelFor="@id/reasonForRequestInput"
                android:text="@string/ui_attendee_reason"
                style="@style/Widget.EventQR.Ui.SectionHeading" />

            <EditText
                android:id="@+id/reasonForRequestInput"
                style="@style/Widget.EventQR.Ui.TextField.Multiline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:hint="@string/request_event_why_should_this_event_be_created"
                android:inputType="textMultiLine" />

            <TextView
                android:id="@+id/txtReasonForRequestError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/submitProgress"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_lg"
                android:importantForAccessibility="no"
                android:indeterminateTint="@color/ui_primary"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- ═════════ Page failure (§5.16, §6.8 row 6): one in-flow strip above the footer with Retry,
         values kept. Field validation never lands here - it renders under its own field. ═════════ -->
    <include
        android:id="@+id/errorRequestEvent"
        layout="@layout/include_error_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:layout_marginBottom="@dimen/space_md" />

    <!-- ═════════ Sticky footer ═════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline" />

    <LinearLayout
        android:id="@+id/layoutSubmitBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingTop="@dimen/space_md"
        android:paddingEnd="@dimen/ui_gutter"
        android:paddingBottom="@dimen/space_md">

        <!-- The review promise sits with the action it qualifies: one Type.Help line above Submit,
             its own TalkBack node, never a tinted box or an icon. -->
        <TextView
            android:id="@+id/txtSubmitReviewNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_sm"
            android:gravity="start"
            android:text="@string/request_event_admin_review_note"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Help" />

        <Button
            android:id="@+id/submitRequestButton"
            style="@style/Widget.EventQR.Ui.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_button_height"
            android:text="@string/ui_attendee_submit_request" />

        <Button
            android:id="@+id/cancelButton"
            style="@style/Widget.EventQR.Ui.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_button_height_inline"
            android:layout_marginTop="@dimen/space_xs"
