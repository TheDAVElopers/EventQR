<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/request_event_request_event_creation" />

    <ScrollView
        android:id="@+id/formScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_20"
            android:paddingTop="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xxl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/request_event_submit_the_event_details_for_admin_r"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.EventQR.TextBody" />

        <TextView
            android:id="@+id/formMessageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/bg_info_card"
            android:padding="@dimen/space_md"
            android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_18"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/request_event_event_details" android:textAppearance="@style/TextAppearance.EventQR.TitleMedium" />
            <TextView style="@style/RequestEventLabel" android:text="@string/request_event_event_name" />
            <EditText android:id="@+id/eventNameInput" style="@style/RequestEventInput" android:hint="@string/request_event_event_name_2" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/request_event_event_category"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.EventQR.TextBody.Medium" />
            <FrameLayout
                android:id="@+id/cardEventCategory"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_rewards_dropdown"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/layoutEventCategoryContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_lg">

                    <TextView
                        android:id="@+id/txtSelectedEventCategory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/common_select_event"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBody" />

                    <ImageView
                        android:id="@+id/spinnerArrow"
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:layout_marginStart="@dimen/space_sm"
                        android:contentDescription="@string/common_dropdown"
                        android:src="@drawable/ic_arrow_drop_down"
                        android:tint="@color/text_secondary" />
                </LinearLayout>
            </FrameLayout>
            <Spinner
                android:id="@+id/spinnerEventCategory"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView style="@style/RequestEventLabel" android:text="@string/request_event_event_description" />
            <EditText android:id="@+id/eventDescriptionInput" style="@style/RequestEventInput.Multi" android:hint="@string/request_event_describe_the_event" android:inputType="textMultiLine" />
            <TextView style="@style/RequestEventLabel" android:text="@string/request_event_target_audience" />
            <EditText android:id="@+id/targetAudienceInput" style="@style/RequestEventInput" android:hint="@string/request_event_students_professionals_community_mem" />
            <TextView style="@style/RequestEventLabel" android:text="@string/request_event_expected_attendees_capacity" />
            <EditText android:id="@+id/capacityInput" style="@style/RequestEventInput" android:hint="@string/capacity_hint" android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_14"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/request_event_schedule_and_venue" android:textAppearance="@style/TextAppearance.EventQR.TitleMedium" />
            <TextView style="@style/RequestEventLabel" android:text="@string/request_event_venue_location" />
            <EditText android:id="@+id/venueInput" style="@style/RequestEventInput" android:hint="@string/request_event_venue_or_address" />
            <TextView style="@style/RequestEventLabel" android:text="@string/request_event_start_date_and_time" />
            <EditText android:id="@+id/startDateTimeInput" style="@style/RequestEventInput" android:hint="@string/request_event_tap_to_select_date_and_time" android:clickable="true" android:cursorVisible="false" android:focusable="false" android:focusableInTouchMode="false" android:inputType="none" android:longClickable="false" android:textIsSelectable="false" />
            <TextView style="@style/RequestEventLabel" android:text="@string/request_event_end_date_and_time" />
            <EditText android:id="@+id/endDateTimeInput" style="@style/RequestEventInput" android:hint="@string/request_event_tap_to_select_date_and_time" android:clickable="true" android:cursorVisible="false" android:focusable="false" android:focusableInTouchMode="false" android:inputType="none" android:longClickable="false" android:textIsSelectable="false" />
            <TextView style="@style/RequestEventLabel" android:text="@string/request_event_registration_start_date_and_time" />
            <EditText android:id="@+id/registrationStartDateTimeInput" style="@style/RequestEventInput" android:hint="@string/request_event_tap_to_select_date_and_time" android:clickable="true" android:cursorVisible="false" android:focusable="false" android:focusableInTouchMode="false" android:inputType="none" android:longClickable="false" android:textIsSelectable="false" />
            <TextView style="@style/RequestEventLabel" android:text="@string/request_event_registration_end_date_and_time" />
            <EditText android:id="@+id/registrationEndDateTimeInput" style="@style/RequestEventInput" android:hint="@string/request_event_tap_to_select_date_and_time" android:clickable="true" android:cursorVisible="false" android:focusable="false" android:focusableInTouchMode="false" android:inputType="none" android:longClickable="false" android:textIsSelectable="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_14"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/request_event_requester_details" android:textAppearance="@style/TextAppearance.EventQR.TitleMedium" />
            <TextView style="@style/RequestEventLabel" android:text="@string/request_event_requester_name" />
            <EditText android:id="@+id/requesterNameInput" style="@style/RequestEventInput" android:hint="@string/common_full_name" />
            <TextView style="@style/RequestEventLabel" android:text="@string/request_event_contact_email" />
            <EditText android:id="@+id/contactEmailInput" style="@style/RequestEventInput" android:hint="@string/request_event_name_example_com" android:inputType="textEmailAddress" />
            <TextView style="@style/RequestEventLabel" android:text="@string/request_event_contact_number" />
            <EditText android:id="@+id/contactNumberInput" style="@style/RequestEventInput" android:hint="@string/phone_hint_example" android:inputType="phone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_14"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/request_event_event_setup" android:textAppearance="@style/TextAppearance.EventQR.TitleMedium" />
            <TextView style="@style/RequestEventLabel" android:text="@string/request_event_event_poster" />

            <FrameLayout
                android:id="@+id/eventPosterPicker"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_150"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_event_poster_picker"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/eventPosterPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/request_event_selected_event_poster"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/eventPosterPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_14">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/request_event_tap_to_attach_event_poster"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium.Strong" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_6"
                        android:gravity="center"
                        android:text="@string/request_event_recommended_jpg_png_landscape_16_9_a"
                        android:textColor="@color/text_hint"
                        android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/eventPosterStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/request_event_no_poster_selected_the_default_gradi"
                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/space_14" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="@dimen/space_lg">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/request_event_reason_for_request" android:textAppearance="@style/TextAppearance.EventQR.TitleMedium" />
            <TextView style="@style/RequestEventLabel" android:text="@string/request_event_reason_for_request_2" />
            <EditText android:id="@+id/reasonForRequestInput" style="@style/RequestEventInput.Multi" android:hint="@string/request_event_why_should_this_event_be_created" android:inputType="textMultiLine" />
        </LinearLayout>

        <ProgressBar android:id="@+id/submitProgress" android:layout_width="@dimen/icon_32" android:layout_height="@dimen/icon_32" android:layout_gravity="center_horizontal" android:layout_marginTop="@dimen/space_18" android:visibility="gone" />
        <Button android:id="@+id/submitRequestButton" android:layout_width="match_parent" android:layout_height="@dimen/button_primary_height" android:layout_marginTop="@dimen/space_18" android:background="@drawable/button_rounded" android:text="@string/request_event_submit_request" android:textAllCaps="false" android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.EventQR.ButtonPlatformBodyLarge.Strong" />
        <Button android:id="@+id/cancelButton" android:layout_width="match_parent" android:layout_height="@dimen/input_height" android:layout_marginTop="@dimen/space_md" android:background="@drawable/bg_logout_button" android:text="@string/request_event_cancel" android:textAllCaps="false" android:textColor="@color/on_primary" android:textAppearance="@style/TextAppearance.EventQR.ButtonPlatformBody" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>