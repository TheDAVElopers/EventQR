<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eventqr_bg"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="Request Event Creation" />

    <ScrollView
        android:id="@+id/formScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Submit the event details for admin review."
            android:textColor="#6B7280"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/formMessageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_info_card"
            android:padding="12dp"
            android:textColor="#111827"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Event Details" android:textColor="#111827" android:textSize="18sp" android:textStyle="bold" />
            <TextView style="@style/RequestEventLabel" android:text="Event Name *" />
            <EditText android:id="@+id/eventNameInput" style="@style/RequestEventInput" android:hint="Event name" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Event Category *"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
            <FrameLayout
                android:id="@+id/cardEventCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_rewards_dropdown"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:id="@+id/layoutEventCategoryContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/txtSelectedEventCategory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Select event"
                        android:textColor="@color/eventqr_text"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/spinnerArrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Dropdown"
                        android:src="@drawable/ic_arrow_drop_down"
                        android:tint="@color/eventqr_muted" />
                </LinearLayout>
            </FrameLayout>
            <Spinner
                android:id="@+id/spinnerEventCategory"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
            <TextView style="@style/RequestEventLabel" android:text="Event Description *" />
            <EditText android:id="@+id/eventDescriptionInput" style="@style/RequestEventInput.Multi" android:hint="Describe the event" android:inputType="textMultiLine" />
            <TextView style="@style/RequestEventLabel" android:text="Target Audience *" />
            <EditText android:id="@+id/targetAudienceInput" style="@style/RequestEventInput" android:hint="Students, professionals, community members" />
            <TextView style="@style/RequestEventLabel" android:text="Expected Attendees / Capacity *" />
            <EditText android:id="@+id/capacityInput" style="@style/RequestEventInput" android:hint="100" android:inputType="number" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Schedule and Venue" android:textColor="#111827" android:textSize="18sp" android:textStyle="bold" />
            <TextView style="@style/RequestEventLabel" android:text="Venue / Location *" />
            <EditText android:id="@+id/venueInput" style="@style/RequestEventInput" android:hint="Venue or address" />
            <TextView style="@style/RequestEventLabel" android:text="Start Date and Time *" />
            <EditText android:id="@+id/startDateTimeInput" style="@style/RequestEventInput" android:hint="Tap to select date and time" android:clickable="true" android:cursorVisible="false" android:focusable="false" android:focusableInTouchMode="false" android:inputType="none" android:longClickable="false" android:textIsSelectable="false" />
            <TextView style="@style/RequestEventLabel" android:text="End Date and Time *" />
            <EditText android:id="@+id/endDateTimeInput" style="@style/RequestEventInput" android:hint="Tap to select date and time" android:clickable="true" android:cursorVisible="false" android:focusable="false" android:focusableInTouchMode="false" android:inputType="none" android:longClickable="false" android:textIsSelectable="false" />
            <TextView style="@style/RequestEventLabel" android:text="Registration Start Date and Time *" />
            <EditText android:id="@+id/registrationStartDateTimeInput" style="@style/RequestEventInput" android:hint="Tap to select date and time" android:clickable="true" android:cursorVisible="false" android:focusable="false" android:focusableInTouchMode="false" android:inputType="none" android:longClickable="false" android:textIsSelectable="false" />
            <TextView style="@style/RequestEventLabel" android:text="Registration End Date and Time *" />
            <EditText android:id="@+id/registrationEndDateTimeInput" style="@style/RequestEventInput" android:hint="Tap to select date and time" android:clickable="true" android:cursorVisible="false" android:focusable="false" android:focusableInTouchMode="false" android:inputType="none" android:longClickable="false" android:textIsSelectable="false" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Requester Details" android:textColor="#111827" android:textSize="18sp" android:textStyle="bold" />
            <TextView style="@style/RequestEventLabel" android:text="Requester Name *" />
            <EditText android:id="@+id/requesterNameInput" style="@style/RequestEventInput" android:hint="Full name" />
            <TextView style="@style/RequestEventLabel" android:text="Contact Email *" />
            <EditText android:id="@+id/contactEmailInput" style="@style/RequestEventInput" android:hint="name@example.com" android:inputType="textEmailAddress" />
            <TextView style="@style/RequestEventLabel" android:text="Contact Number *" />
            <EditText android:id="@+id/contactNumberInput" style="@style/RequestEventInput" android:hint="+63 912 345 6789" android:inputType="phone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Event Setup" android:textColor="#111827" android:textSize="18sp" android:textStyle="bold" />
            <TextView style="@style/RequestEventLabel" android:text="Event Poster" />

            <FrameLayout
                android:id="@+id/eventPosterPicker"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_event_poster_picker"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/eventPosterPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Selected event poster"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/eventPosterPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to attach event poster"
                        android:textColor="#6B7280"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Recommended: JPG/PNG, landscape 16:9, at least 1200 x 675 px"
                        android:textColor="#9CA3AF"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/eventPosterStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="No poster selected. The default gradient will be used."
                android:textColor="#6B7280"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reason for Request" android:textColor="#111827" android:textSize="18sp" android:textStyle="bold" />
            <TextView style="@style/RequestEventLabel" android:text="Reason for Request *" />
            <EditText android:id="@+id/reasonForRequestInput" style="@style/RequestEventInput.Multi" android:hint="Why should this event be created?" android:inputType="textMultiLine" />
        </LinearLayout>

        <ProgressBar android:id="@+id/submitProgress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:layout_marginTop="18dp" android:visibility="gone" />
        <Button android:id="@+id/submitRequestButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="18dp" android:background="@drawable/button_rounded" android:text="Submit Request" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
        <Button android:id="@+id/cancelButton" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:background="@drawable/bg_logout_button" android:text="Cancel" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>