<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/hero_height_220"
        android:background="@drawable/bg_eventqr_gradient">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_20"
            android:paddingTop="@dimen/space_49">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="@string/common_eventqr_logo"
                android:src="@drawable/white_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/reset_password_reset_password"
                android:textColor="@color/on_primary"
                android:textAppearance="@style/TextAppearance.EventQR.AuthTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_11"
                android:gravity="center"
                android:text="@string/reset_password_enter_code_subtitle"
                android:textColor="@color/on_primary"
                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_21"
            android:paddingTop="@dimen/space_33"
            android:paddingBottom="@dimen/space_30">

            <!-- Form state -->
            <LinearLayout
                android:id="@+id/layoutForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtCodeSentTo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/reset_password_code_label"
                    android:textColor="@color/text_primary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

                <EditText
                    android:id="@+id/edtResetCode"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_height"
                    android:layout_marginTop="@dimen/space_6"
                    android:background="@drawable/bg_auth_field"
                    android:hint="@string/reset_password_code_hint"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="6"
                    android:paddingHorizontal="@dimen/space_14"
                    android:textColorHint="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

                <TextView
                    android:id="@+id/txtCodeExpired"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/error"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact"
                    android:visibility="gone" />

                <Button
                    style="@style/Widget.EventQR.Button.Primary"
                    android:id="@+id/btnVerifyCode"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="@dimen/space_20"
                    android:elevation="@dimen/elevation_6"
                    android:text="@string/reset_password_verify"
                    android:textAppearance="@style/TextAppearance.EventQR.ButtonPlatformBodyMedium.Strong" />

                <Button
                    style="@style/Widget.EventQR.Button.Text"
                    android:id="@+id/btnResendCode"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/reset_password_resend_code"
                    android:textAppearance="@style/TextAppearance.EventQR.ButtonPlatformBodyMedium.Strong" />

                <Button
                    android:id="@+id/btnGoToLogin"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_target_min"
                    android:background="@color/transparent"
                    android:text="@string/common_back_to_sign_in"
                    android:textAllCaps="false"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.EventQR.ButtonPlatformBodyMedium" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
