<?xml version="1.0" encoding="utf-8"?>
<!--
    RESET PASSWORD - code step (§6.1, step 2 of 3) - retires Gen A.

    Same auth shell. The 6-character code field is the ONE documented exception to left alignment
    (§4.5): 56dp tall, NumericM 20/24 tabular, 0.3em letter spacing, text centred inside the box.

    Deleted: the 220dp gradient header, the 50dp raster logo, the outlined field on
    `bg_auth_field`, the elevated primary and the full-width ghost buttons that competed with it.

    Wiring kept: layoutForm, txtCodeSentTo, edtResetCode, txtCodeExpired, btnVerifyCode,
    btnResendCode, btnGoToLogin, the 6-digit input filter and the resend cooldown label.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/authTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ui_gutter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_bar_height_auth"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Lockup (§3.1): mark 20dp + 12dp + wordmark 21sp, left aligned on the 20dp gutter. -->
            <ImageView
                android:layout_width="@dimen/ui_mark_bar_auth"
                android:layout_height="@dimen/ui_mark_bar_auth"
                android:layout_marginEnd="@dimen/ui_lockup_gap"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mark_on_light" />

            <TextView
                android:id="@+id/txtWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/auth_wordmark"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Wordmark"
                android:textSize="@dimen/ui_wordmark_size_auth"
                android:translationY="@dimen/ui_wordmark_nudge_auth" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline" />

    <ScrollView
        android:id="@+id/authScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ui_gutter"
            android:paddingTop="@dimen/ui_auth_top_gap"
            android:paddingBottom="@dimen/space_24">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_auth_step_2_of_3"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:text="@string/reset_password_reset_password"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Headline" />

            <TextView
                android:id="@+id/txtCodeSentTo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                android:textColor="@color/ui_text_secondary" />

            <LinearLayout
                android:id="@+id/layoutForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:labelFor="@id/edtResetCode"
                    android:text="@string/reset_password_code_label"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                <!-- The single centred field in the app: a 6-digit code reads as a serial. -->
                <EditText
                    android:id="@+id/edtResetCode"
                    style="@style/Widget.EventQR.Ui.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_control_height"
                    android:layout_marginTop="@dimen/space_8"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:letterSpacing="@dimen/ui_track_code"
                    android:maxLength="6"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM" />

                <TextView
                    android:id="@+id/txtCodeError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                    android:textColor="@color/ui_error"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtCodeExpired"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                    android:textColor="@color/ui_error"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnVerifyCode"
                    style="@style/Widget.EventQR.Ui.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_button_height"
                    android:layout_marginTop="@dimen/space_24"
                    android:text="@string/reset_password_verify" />

                <Button
                    android:id="@+id/btnResendCode"
                    style="@style/Widget.EventQR.Ui.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_button_height_inline"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/reset_password_resend_code" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginTop="@dimen/space_16"
                    android:background="@color/ui_hairline" />

                <Button
                    android:id="@+id/btnGoToLogin"
                    style="@style/Widget.EventQR.Ui.Button.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_button_height_inline"
                    android:layout_marginTop="@dimen/space_8"
                    android:text="@string/common_back_to_sign_in" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

