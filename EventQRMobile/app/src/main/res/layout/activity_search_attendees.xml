<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - SEARCH ATTENDEES (6.4).

        Top bar      56dp, back + title, hairline under
        Search       48dp filled field, 20dp search glyph
        Chips        All / Registered / Checked in / Exited / Cancelled - 36dp, radius 4
        Rows         grouped attendee rows with one status badge
        Empty        the shared left-aligned empty state

    Deleted: the bg_organizer_events_screen gradient, the accent_container event card with a
    MaterialCardView + icon tile, the 54dp TextInputLayout, the 38dp pill filter chips and the
    per-row GradientDrawable badge.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/include_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <EditText
        android:id="@+id/edtSearchAttendees"
        style="@style/Widget.EventQR.Ui.TextField.Search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:drawableStart="@drawable/ic_ui_search"
        android:drawablePadding="@dimen/space_md"
        android:drawableTint="@color/ui_text_secondary"
        android:hint="@string/ui_organizer_attendee_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text" />

    <TextView
        android:id="@+id/txtSearchSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
        android:textColor="@color/ui_text_secondary" />

    <!-- §5.6: five status chips never fit 360dp in one line, so the row wraps on a Flow and never
         scrolls. Three chips per line, 36dp fill inside a 48dp touch target. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingEnd="@dimen/ui_gutter">

        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/chipFlow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="chipAll,chipRegistered,chipCheckedIn,chipExited,chipCancelled"
            app:flow_horizontalGap="@dimen/ui_chip_gap"
            app:flow_maxElementsWrap="3"
            app:flow_verticalGap="@dimen/ui_chip_gap"
            app:flow_wrapMode="chain"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/chipAll"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/common_all" />

        <TextView
            android:id="@+id/chipRegistered"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/common_registered" />

        <TextView
            android:id="@+id/chipCheckedIn"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/common_checked_in" />

        <TextView
            android:id="@+id/chipExited"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/search_attendees_exited" />

        <TextView
            android:id="@+id/chipCancelled"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/search_attendees_cancelled" />
        <!-- "No Show" chip intentionally removed: nothing in the system sets RegistrationStatus.NO_SHOW yet. -->
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_8"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSearchAttendees"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/space_24" />

        <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
            android:id="@+id/txtSearchEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:icon="@drawable/ic_ui_search"
            app:title="@string/common_no_attendees_found" />
    </FrameLayout>
</LinearLayout>
