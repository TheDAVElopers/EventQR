<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - ADD STAFF (6.4).

        Top bar    56dp, back + "Add staff"
        Strip      event glyph + event title; no chip - this screen is the add action
        Search     48dp filled field
        Success    48dp confirmation strip, cleared on the next keystroke
        Rows       72dp account rows; selection is the fill plus one "Selected" badge
        Footer     one 52dp primary action ("Set permissions") + a hairline on top

    Deleted: bg_staff_search_box, the hand-rolled 54dp search row, the per-row card, the inline
    bg_ui_card permission host, the promote dialog and the 0.9 * screenWidth success dialog.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/include_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/eventStrip"
        layout="@layout/include_organizer_event_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <EditText
        android:id="@+id/edtSearchUser"
        style="@style/Widget.EventQR.Ui.TextField.Search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_field_search_height"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:drawablePadding="@dimen/space_12"
        android:drawableStart="@drawable/ic_ui_search"
        android:drawableTint="@color/ui_text_secondary"
        android:hint="@string/staff_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:singleLine="true" />

    <LinearLayout
        android:id="@+id/staffAssignedStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:background="@color/ui_success_container"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ui_touch_min"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingEnd="@dimen/ui_gutter"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/ui_field_icon"
            android:layout_height="@dimen/ui_field_icon"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ui_check_circle"
            android:tint="@color/ui_success" />

        <TextView
            android:id="@+id/txtStaffAssignedStrip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
            android:textColor="@color/ui_on_success_container" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_8"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSearchUsers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/space_16" />

        <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
            android:id="@+id/txtSearchEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:icon="@drawable/ic_ui_search" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_hairline"
            android:background="@color/ui_hairline"
            android:importantForAccessibility="no" />

        <Button
            android:id="@+id/btnAssignStaff"
            style="@style/Widget.EventQR.Ui.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_button_height"
            android:layout_marginStart="@dimen/ui_gutter"
            android:layout_marginTop="@dimen/space_12"
            android:layout_marginEnd="@dimen/ui_gutter"
            android:layout_marginBottom="@dimen/space_16"
            android:enabled="false"
            android:text="@string/ui_staff_set_permissions" />
    </LinearLayout>
</LinearLayout>
