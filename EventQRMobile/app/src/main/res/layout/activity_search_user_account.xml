<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/staff_search_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_md">

        <LinearLayout
            android:id="@+id/layoutSearchInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:background="@drawable/bg_staff_search_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_14">

            <EditText
                android:id="@+id/edtSearchUser"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/staff_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true"
                android:textColorHint="@color/text_hint"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:src="@drawable/ic_search"
                android:tint="@color/neutral" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/space_10">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerSearchUsers"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/space_md" />

            <ProgressBar
                android:id="@+id/progressSearchUsers"
                android:layout_width="@dimen/icon_tile_md"
                android:layout_height="@dimen/icon_tile_md"
                android:layout_gravity="center" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
            android:id="@+id/txtSearchEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:icon="@drawable/ic_search"
            app:title="@string/search_user_account_no_accounts_found" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/layoutPermissionsHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@color/surface"
            android:orientation="vertical"
            android:padding="@dimen/space_md"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnAssignStaff"
            style="@style/Widget.EventQR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_lg"
            android:enabled="false"
            android:text="@string/staff_assign_button"
            android:textAppearance="@style/TextAppearance.EventQR.ButtonPlatformBodyMedium.Strong" />
    </LinearLayout>
</LinearLayout>
