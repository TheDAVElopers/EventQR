<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/auth_header_height_238"
        android:background="@drawable/bg_signin_header"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingTop="@dimen/space_42">

        <ImageView
            android:layout_width="@dimen/tile_96"
            android:layout_height="@dimen/tile_96"
            android:contentDescription="@string/common_eventqr_logo"
            android:src="@drawable/white_logo"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:text="@string/common_sign_in"
            android:textColor="@color/on_primary"
            android:textAppearance="@style/TextAppearance.EventQR.HeadlineXL" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:lineSpacingExtra="@dimen/line_spacing_3"
            android:text="@string/signin_sign_in_to_start_scanning_and_stream"
            android:textColor="@color/accent_container"
            android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xxl"
        android:paddingTop="34dp"
        android:paddingBottom="@dimen/space_xl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/common_email_address"
            android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium.Strong" />

        <EditText
            style="@style/Widget.EventQR.EditText"
            android:id="@+id/edtEmail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height_54"
            android:layout_marginTop="@dimen/space_sm"
            android:autoText="false"
            android:drawableStart="@drawable/email_icon"
            android:drawablePadding="@dimen/space_md"
            android:hint="@string/common_enter_email_address"
            android:inputType="textEmailAddress"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_18"
            android:text="@string/common_password"
            android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium.Strong" />

        <EditText
            style="@style/Widget.EventQR.EditText"
            android:id="@+id/edtPassword"
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height_54"
            android:layout_marginTop="@dimen/space_sm"
            android:autoText="false"
            android:drawableStart="@drawable/password_icon"
            android:drawableEnd="@drawable/ic_visibility_on"
            android:drawablePadding="@dimen/space_md"
            android:hint="@string/common_enter_password"
            android:inputType="textPassword"
            android:maxLength="128"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_lg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/control_height_42"
            android:layout_marginTop="@dimen/space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/chkRememberMe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/primary"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/signin_remember_email"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

            <TextView
                android:id="@+id/txtForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/signin_forgot_password"
                android:textColor="@color/primary"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSignIn"
            style="@style/Widget.EventQR.Button.Auth"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_primary_height"
            android:layout_marginTop="@dimen/space_xl"
            android:elevation="@dimen/elevation_5"
            android:text="@string/common_sign_in" />

        <LinearLayout
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/signin_don_t_have_an_account"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_create_account"
                android:textColor="@color/primary"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>