<?xml version="1.0" encoding="utf-8"?>
<!--
    Sign in (§6.1 of MyFiles/EventQR-Redesign-Plan.md) - retires Gen A.

    56dp wordmark bar, 40dp gap, a left-aligned headline, two filled 56dp fields at radius 4,
    the forgot-password link on the password label row, a 44dp remember row, one 52dp primary
    and the create-account link under a hairline.

    Deleted from the previous version: the 238dp vertical gradient header, the 96dp centred
    raster logo, the raster envelope and padlock, the 54dp outlined Material boxes, the 56dp
    gradient CTA and the indigo focus outline that never changed the fill.

    Wiring kept: edtEmail / edtPassword / btnSignIn / btnRegister / txtForgotPassword /
    chkRememberMe, the compound-drawable password toggle (drawableStart index 0 + the
    compoundPaddingEnd hit zone), maxLength 128 and autoText=false.

    authTopBar carries the status-bar inset (see LoginActivity) so the bar's own fill runs
    behind the status bar instead of pushing the layout down.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/authTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ui_gutter">

        <!-- Inner row is exactly 56dp; the status-bar inset is added above it as padding. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_bar_height_auth"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Lockup (§3.1): mark 20dp + 12dp + wordmark 21sp, left aligned on the 20dp gutter. -->
            <ImageView
                android:layout_width="@dimen/ui_mark_bar_auth"
                android:layout_height="@dimen/ui_mark_bar_auth"
                android:layout_marginEnd="@dimen/ui_lockup_gap"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mark_on_light" />

            <TextView
                android:id="@+id/txtWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/auth_wordmark"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Wordmark"
                android:textSize="@dimen/ui_wordmark_size_auth"
                android:translationY="@dimen/ui_wordmark_nudge_auth" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline" />

    <ScrollView
        android:id="@+id/authScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ui_gutter"
            android:paddingTop="@dimen/ui_auth_top_gap"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_sign_in"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/auth_signin_sub"
                android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall" />

            <!-- ═════════ Email ═════════ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/auth_label_email"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/edtEmail"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:autoText="false"
                android:drawableStart="@drawable/ic_ui_mail"
                android:hint="@string/auth_hint_email"
                android:inputType="textEmailAddress"
                android:maxLines="1" />

            <TextView
                android:id="@+id/txtEmailError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <!-- ═════════ Password, with the ghost link on the label row ═════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/auth_label_password"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                <TextView
                    android:id="@+id/txtForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_touch_min"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_md"
                    android:text="@string/auth_forgot_password"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Link" />
            </LinearLayout>

            <!-- The TextInputLayout is only the end-icon host: the eye is a 48dp target with its
                 own description from Material, and no box is drawn over bg_ui_field. -->
            <com.thedavelopers.eventqr.ui.components.PasswordTextInputLayout
                style="@style/Widget.EventQR.Ui.TextField.Password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <EditText
                    android:id="@+id/edtPassword"
                    style="@style/Widget.EventQR.Ui.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoText="false"
                    android:drawableStart="@drawable/ic_ui_lock"
                    android:hint="@string/common_enter_password"
                    android:inputType="textPassword"
                    android:maxLength="128"
                    android:maxLines="1" />
            </com.thedavelopers.eventqr.ui.components.PasswordTextInputLayout>

            <TextView
                android:id="@+id/txtPasswordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_error"
                android:visibility="gone" />

            <CheckBox
                android:id="@+id/chkRememberMe"
                style="@style/Widget.EventQR.Ui.CheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/signin_remember_email" />

            <!-- §5.16 form failure strip, directly above the primary; hidden until a failure. -->
            <include
                android:id="@+id/errorLogin"
                layout="@layout/include_error_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />

            <Button
                android:id="@+id/btnSignIn"
                style="@style/Widget.EventQR.Ui.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_button_height"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/auth_sign_in" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_marginTop="@dimen/space_xl"
                android:background="@color/ui_hairline" />

            <LinearLayout
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_touch_min"
                android:layout_marginTop="@dimen/space_sm"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_new_here"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="@string/auth_create_account"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
                    android:textColor="@color/ui_primary" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/auth_signin_helper"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Label"
                android:textColor="@color/ui_text_secondary" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
