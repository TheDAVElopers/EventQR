<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/auth_header_height_238"
        android:background="@drawable/bg_signin_header"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingTop="@dimen/space_42">

        <ImageView
            android:layout_width="@dimen/tile_96"
            android:layout_height="@dimen/tile_96"
            android:contentDescription="@string/common_eventqr_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/white_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_10"
            android:text="@string/signup_sign_up"
            android:textColor="@color/on_primary"
            android:textAppearance="@style/TextAppearance.EventQR.HeadlineXL" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:gravity="center"
            android:text="@string/signup_create_your_account_and_simplify_eve"
            android:textColor="@color/accent_container"
            android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_28"
            android:paddingTop="@dimen/space_28"
            android:paddingBottom="@dimen/space_28">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_first_name"
                        android:textColor="@color/text_primary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

                    <EditText
                        style="@style/Widget.EventQR.EditText"
                        android:id="@+id/edtFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/space_6"
                        android:hint="@string/common_john"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/space_14"
                        android:textColorHint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_10"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_last_name"
                        android:textColor="@color/text_primary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

                    <EditText
                        style="@style/Widget.EventQR.EditText"
                        android:id="@+id/edtLastName"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_height"
                        android:layout_marginTop="@dimen/space_6"
                        android:hint="@string/common_doe"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="@dimen/space_14"
                        android:textColorHint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_14"
                android:text="@string/common_email_address"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

            <EditText
                style="@style/Widget.EventQR.EditText"
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/space_6"
                android:drawableStart="@drawable/email_icon"
                android:drawablePadding="@dimen/space_10"
                android:hint="@string/common_johndoe_gmail_com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="@dimen/space_14"
                android:textColorHint="@color/text_secondary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_14"
                android:text="@string/common_phone_number"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

            <LinearLayout
                android:id="@+id/layoutPhoneField"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/space_6"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:drawableStart="@drawable/phone_icon"
                    android:drawablePadding="@dimen/space_10"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_14"
                    android:paddingEnd="@dimen/space_6"
                    android:text="@string/phone_prefix"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium.Strong" />

                <EditText
                    android:id="@+id/edtPhoneNumber"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/phone_hint_digits"
                    android:inputType="number"
                    android:paddingEnd="@dimen/space_14"
                    android:textColorHint="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtPhoneCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="@string/counter_zero_of_ten"
                android:textAlignment="viewEnd"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.EventQR.TextOverline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_14"
                android:text="@string/common_password"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

            <EditText
                style="@style/Widget.EventQR.EditText"
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/space_6"
                android:drawableStart="@drawable/password_icon"
                android:drawableEnd="@drawable/ic_visibility_on"
                android:drawablePadding="@dimen/space_10"
                android:hint="@string/common_enter_password"
                android:inputType="textPassword"
                android:paddingHorizontal="@dimen/space_14"
                android:textColorHint="@color/text_secondary" />

            <LinearLayout
                android:id="@+id/layoutPasswordRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_password_requirements"
                android:orientation="vertical"
                android:padding="@dimen/space_md"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/viewStrength1"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/bar_thin"
                        android:layout_weight="1"
                        android:background="@color/outline" />

                    <View
                        android:id="@+id/viewStrength2"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/bar_thin"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:background="@color/outline" />

                    <View
                        android:id="@+id/viewStrength3"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/bar_thin"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:background="@color/outline" />

                    <View
                        android:id="@+id/viewStrength4"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/bar_thin"
                        android:layout_marginStart="@dimen/space_sm"
                        android:layout_weight="1"
                        android:background="@color/outline" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtPasswordLengthRequirement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/password_req_length"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextOverline" />

                        <TextView
                            android:id="@+id/txtPasswordCapitalRequirement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/password_req_uppercase"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextOverline" />

                        <TextView
                            android:id="@+id/txtPasswordLowercaseRequirement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/password_req_lowercase"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextOverline" />

                        <TextView
                            android:id="@+id/txtPasswordNumberRequirement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/password_req_number"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextOverline" />

                        <TextView
                            android:id="@+id/txtPasswordSpecialRequirement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:text="@string/password_req_special"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextOverline" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtPasswordStrength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Strong" />
                </RelativeLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_14"
                android:text="@string/common_confirm_password"
                android:textColor="@color/text_primary"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />

            <EditText
                style="@style/Widget.EventQR.EditText"
                android:id="@+id/edtConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/space_6"
                android:drawableStart="@drawable/password_icon"
                android:drawableEnd="@drawable/ic_visibility_on"
                android:drawablePadding="@dimen/space_10"
                android:hint="@string/common_confirm_password_2"
                android:inputType="textPassword"
                android:paddingHorizontal="@dimen/space_14"
                android:textColorHint="@color/text_secondary" />

            <CheckBox
                android:id="@+id/chkTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_14"
                android:buttonTint="@color/primary"
                android:text="@string/signup_i_agree_to_the_terms_conditions"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnRegister"
                style="@style/Widget.EventQR.Button.Auth"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_primary_height"
                android:layout_marginTop="@dimen/space_xl"
                android:elevation="@dimen/elevation_4"
                android:text="@string/common_create_account" />

            <LinearLayout
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/signup_already_have_an_account"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_sign_in"
                    android:textColor="@color/primary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>