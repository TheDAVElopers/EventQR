<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="238dp"
        android:background="@drawable/bg_rounded_header"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="42dp">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/common_eventqr_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/white_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/signup_sign_up"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/signup_create_your_account_and_simplify_eve"
            android:textColor="#F4F3FF"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_first_name"
                        android:textColor="#111827"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtFirstName"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_auth_field_focus"
                        android:hint="@string/common_john"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/eventqr_text"
                        android:textColorHint="#71717A"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_last_name"
                        android:textColor="#111827"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edtLastName"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_auth_field_focus"
                        android:hint="@string/common_doe"
                        android:inputType="textPersonName"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/eventqr_text"
                        android:textColorHint="#71717A"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/common_email_address"
                android:textColor="#111827"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_auth_field_focus"
                android:drawableStart="@drawable/email_icon"
                android:drawablePadding="10dp"
                android:hint="@string/common_johndoe_gmail_com"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="14dp"
                android:textColor="@color/eventqr_text"
                android:textColorHint="#71717A"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/common_phone_number"
                android:textColor="#111827"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutPhoneField"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_auth_field_focus"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:drawableStart="@drawable/phone_icon"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="6dp"
                    android:text="+63"
                    android:textColor="@color/eventqr_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/edtPhoneNumber"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="9123456789"
                    android:inputType="number"
                    android:paddingEnd="14dp"
                    android:textColor="@color/eventqr_text"
                    android:textColorHint="#71717A"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtPhoneCounter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="0/10"
                android:textAlignment="viewEnd"
                android:textColor="#71717A"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/common_password"
                android:textColor="#111827"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_auth_field_focus"
                android:drawableStart="@drawable/password_icon"
                android:drawableEnd="@drawable/ic_visibility_on"
                android:drawablePadding="10dp"
                android:hint="@string/common_enter_password"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:textColor="@color/eventqr_text"
                android:textColorHint="#71717A"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/layoutPasswordRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_password_requirements"
                android:orientation="vertical"
                android:padding="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/viewStrength1"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_weight="1"
                        android:background="@color/eventqr_border" />

                    <View
                        android:id="@+id/viewStrength2"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@color/eventqr_border" />

                    <View
                        android:id="@+id/viewStrength3"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@color/eventqr_border" />

                    <View
                        android:id="@+id/viewStrength4"
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@color/eventqr_border" />
                </LinearLayout>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtPasswordLengthRequirement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/password_req_length"
                            android:textColor="@color/eventqr_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtPasswordCapitalRequirement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/password_req_uppercase"
                            android:textColor="@color/eventqr_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtPasswordLowercaseRequirement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/password_req_lowercase"
                            android:textColor="@color/eventqr_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtPasswordNumberRequirement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/password_req_number"
                            android:textColor="@color/eventqr_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtPasswordSpecialRequirement"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/password_req_special"
                            android:textColor="@color/eventqr_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtPasswordStrength"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:textColor="@color/eventqr_muted"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/common_confirm_password"
                android:textColor="#111827"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_auth_field_focus"
                android:drawableStart="@drawable/password_icon"
                android:drawableEnd="@drawable/ic_visibility_on"
                android:drawablePadding="10dp"
                android:hint="@string/common_confirm_password_2"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:textColor="@color/eventqr_text"
                android:textColorHint="#71717A"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/chkTerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:buttonTint="@color/eventqr_indigo"
                android:text="@string/signup_i_agree_to_the_terms_conditions"
                android:textColor="#111827"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_auth_button_press"
                android:elevation="4dp"
                android:stateListAnimator="@null"
                android:text="@string/common_create_account"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/signup_already_have_an_account"
                    android:textColor="#6B7280"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_sign_in"
                    android:textColor="@color/eventqr_indigo"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>