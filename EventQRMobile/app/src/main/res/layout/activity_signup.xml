<?xml version="1.0" encoding="utf-8"?>
<!--
    Sign up (§6.1 of MyFiles/EventQR-Redesign-Plan.md) - retires Gen A.

    Same auth shell as Sign in, then three eyebrowed sections separated by 1dp perforations:
    YOUR DETAILS / CONTACT / SECURITY. Filled 56dp fields at radius 4, a five-rule password
    checklist whose 16dp tick slots turn accent_deep as each rule is satisfied, and a 72dp sticky
    footer whose primary never scrolls away.

    Deleted from the previous version: the 238dp gradient header, the centred raster logo, the
    54dp outlined inputs, the bullet-character password rules, the tinted requirements box, the
    strength meter and label, the phone counter and the gradient submit.

    Wiring kept: every field id, the five rule ids, layoutPasswordRequirements (GONE until the
    user types), the phone prefix field, the terms checkbox with its clickable link, and the
    sign-in link.

    authTopBar carries the status-bar inset and authFooter the navigation-bar inset (see
    RegistrationActivity) so neither fill is clipped by the system bars.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/authTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/ui_gutter">

        <!-- Inner row is exactly 56dp; the status-bar inset is added above it as padding. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_bar_height_auth"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Lockup (§3.1): mark 20dp + 12dp + wordmark 21sp, left aligned on the 20dp gutter. -->
            <ImageView
                android:layout_width="@dimen/ui_mark_bar_auth"
                android:layout_height="@dimen/ui_mark_bar_auth"
                android:layout_marginEnd="@dimen/ui_lockup_gap"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mark_on_light" />

            <TextView
                android:id="@+id/txtWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/auth_wordmark"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Wordmark"
                android:textSize="@dimen/ui_wordmark_size_auth"
                android:translationY="@dimen/ui_wordmark_nudge_auth" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline" />

    <ScrollView
        android:id="@+id/authScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ui_gutter"
            android:paddingTop="@dimen/space_xxl"
            android:paddingBottom="@dimen/space_xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auth_create_account"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Headline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/auth_signup_sub"
                android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall" />

            <!-- ═════════════════ YOUR DETAILS ═════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/auth_section_details"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/edtFirstName"
                        android:text="@string/auth_label_first_name"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                    <EditText
                        android:id="@+id/edtFirstName"
                        style="@style/Widget.EventQR.Ui.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:autoText="false"
                        android:inputType="textPersonName"
                        android:maxLines="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@id/edtLastName"
                        android:text="@string/auth_label_last_name"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                    <EditText
                        android:id="@+id/edtLastName"
                        style="@style/Widget.EventQR.Ui.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:autoText="false"
                        android:inputType="textPersonName"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/divider_perforation_light"
                android:layerType="software" />

            <!-- ═════════════════ CONTACT ═════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/auth_section_contact"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/auth_label_email"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/edtEmail"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:autoText="false"
                android:drawableStart="@drawable/ic_ui_mail"
                android:hint="@string/auth_hint_email"
                android:inputType="textEmailAddress"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/auth_label_phone"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <!-- The prefix and the digits share one filled 56dp box; addStatesFromChildren
                 gives the box the EditText's focus state so the 2dp focus stroke works. -->
            <LinearLayout
                android:id="@+id/layoutPhoneField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:addStatesFromChildren="true"
                android:background="@drawable/bg_ui_field"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:minHeight="@dimen/ui_control_height">

                <TextView
                    android:id="@+id/txtPhonePrefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_ui_call"
                    android:drawablePadding="@dimen/space_md"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_sm"
                    android:text="@string/phone_prefix"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                    android:textColor="@color/ui_text_primary" />

                <EditText
                    android:id="@+id/edtPhoneNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/phone_hint_digits"
                    android:inputType="number"
                    android:maxLines="1"
                    android:paddingEnd="@dimen/space_lg"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                    android:textColor="@color/ui_text_primary"
                    android:textColorHint="@color/ui_text_secondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/divider_perforation_light"
                android:layerType="software" />

            <!-- ═════════════════ SECURITY ═════════════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/auth_section_security"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/auth_label_password"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <com.thedavelopers.eventqr.ui.components.PasswordTextInputLayout
                style="@style/Widget.EventQR.Ui.TextField.Password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <EditText
                    android:id="@+id/edtPassword"
                    style="@style/Widget.EventQR.Ui.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoText="false"
                    android:drawableStart="@drawable/ic_ui_lock"
                    android:hint="@string/common_enter_password"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.thedavelopers.eventqr.ui.components.PasswordTextInputLayout>

            <!-- Rules: five rows, one per Validators rule. The 16dp leading slot is ic_ui_check
                 in accent_deep when met and empty at rest; the mark and the row's "met"/"not met"
                 description carry the state, never colour alone. -->
            <LinearLayout
                android:id="@+id/layoutPasswordRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:accessibilityLiveRegion="polite"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtPasswordLengthRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:drawablePadding="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_length"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordCapitalRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:drawablePadding="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_uppercase"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordLowercaseRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:drawablePadding="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_lowercase"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordNumberRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:drawablePadding="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_number"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <TextView
                    android:id="@+id/txtPasswordSpecialRequirement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:drawablePadding="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:text="@string/password_req_special"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/auth_label_confirm_password"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <com.thedavelopers.eventqr.ui.components.PasswordTextInputLayout
                style="@style/Widget.EventQR.Ui.TextField.Password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm">

                <EditText
                    android:id="@+id/edtConfirmPassword"
                    style="@style/Widget.EventQR.Ui.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoText="false"
                    android:drawableStart="@drawable/ic_ui_lock"
                    android:hint="@string/auth_hint_confirm_password"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.thedavelopers.eventqr.ui.components.PasswordTextInputLayout>

            <CheckBox
                android:id="@+id/chkTerms"
                style="@style/Widget.EventQR.Ui.CheckBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/signup_i_agree_to_the_terms_conditions" />

            <LinearLayout
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_touch_min"
                android:layout_marginTop="@dimen/space_sm"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/auth_already_have"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Body" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="@string/auth_sign_in"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
                    android:textColor="@color/ui_primary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ═════════ Sticky footer: the primary action never scrolls away ═════════ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline" />

    <LinearLayout
        android:id="@+id/authFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="vertical">

        <!-- 52dp button + 12dp either side = the 76dp footer; the navigation-bar inset is added
             below it as padding, so the footer's fill runs behind the gesture bar. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_footer_height"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ui_gutter"
            android:paddingVertical="@dimen/space_md">

            <Button
                android:id="@+id/btnRegister"
                style="@style/Widget.EventQR.Ui.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/ui_button_height"
                android:text="@string/auth_create_account" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
