<?xml version="1.0" encoding="utf-8"?>
<!--
    STAFF ASSIGNED EVENTS (§6.3) - retires Gen A.

        Compact pass head + count, a 48dp chip row (36dp chips, radius 4), then the assigned-event
        rows. No gradient page background, no Material pill chips, no outlined cards around filters.

    The row itself is EventCard (shared Compose component) rendered by StaffAssignedEventAdapter -
    not forked here.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- ═════════ Filters: 36dp chips in a 48dp touch row ═════════ -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_staff_chip_row"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ui_staff_chip_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/ui_gutter"
            android:paddingEnd="@dimen/ui_gutter">

            <TextView
                android:id="@+id/chipAll"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_height"
                android:text="@string/ui_staff_filter_all" />

            <TextView
                android:id="@+id/chipUpcoming"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_height"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:text="@string/ui_staff_filter_upcoming" />

            <TextView
                android:id="@+id/chipActive"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_height"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:text="@string/ui_staff_filter_active" />

            <TextView
                android:id="@+id/chipCompleted"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_height"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:text="@string/ui_staff_filter_completed" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshAssignedEvents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerAssignedEvents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_16"
                android:paddingEnd="@dimen/ui_gutter"
                android:paddingBottom="@dimen/space_24" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/txtAssignedEventsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:icon="@drawable/ic_ui_event"
                app:subtitle="@string/ui_staff_no_assigned_events_body"
                app:title="@string/ui_staff_no_assigned_events" />

            <include
                android:id="@+id/skeletonLoading"
                layout="@layout/include_skeleton_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_16"
                android:layout_marginEnd="@dimen/ui_gutter" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
