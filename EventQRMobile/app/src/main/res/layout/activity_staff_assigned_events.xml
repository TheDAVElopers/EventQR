<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_organizer_events_screen"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrTabHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/staff_assigned_events_my_assigned_events"
        app:subtitle="@string/staff_assigned_events_events_you_are_assigned_to" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupStaffEventFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/common_all"
                android:textColor="@color/brand_on_primary"
                app:chipBackgroundColor="@color/eventqr_indigo"
                app:chipCornerRadius="24dp"
                app:chipMinHeight="40dp"
                app:chipStrokeWidth="0dp"
                app:textStartPadding="12dp"
                app:textEndPadding="12dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUpcoming"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/common_upcoming"
                android:textColor="@color/text_secondary"
                app:chipBackgroundColor="@color/surface"
                app:chipCornerRadius="24dp"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="1dp"
                app:textStartPadding="12dp"
                app:textEndPadding="12dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipActive"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/common_active"
                android:textColor="@color/text_secondary"
                app:chipBackgroundColor="@color/surface"
                app:chipCornerRadius="24dp"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="1dp"
                app:textStartPadding="12dp"
                app:textEndPadding="12dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCompleted"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/common_completed"
                android:textColor="@color/text_secondary"
                app:chipBackgroundColor="@color/surface"
                app:chipCornerRadius="24dp"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="1dp"
                app:textStartPadding="12dp"
                app:textEndPadding="12dp" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshAssignedEvents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerAssignedEvents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="18dp"
                android:paddingBottom="24dp" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
            android:id="@+id/txtAssignedEventsEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:icon="@drawable/ic_calendar"
            app:title="@string/staff_assigned_events_no_assigned_events"
            app:subtitle="@string/staff_assigned_events_events_assigned_to_you_will_show_up" />

            <include
                layout="@layout/include_skeleton_cards"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
