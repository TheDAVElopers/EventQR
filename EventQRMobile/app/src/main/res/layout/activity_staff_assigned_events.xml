<?xml version="1.0" encoding="utf-8"?>
<!--
    STAFF ASSIGNED EVENTS (§6.3) - retires Gen A.

        Compact pass head + count, a 48dp chip row (36dp chips, radius 4), then the assigned-event
        rows. No gradient page background, no Material pill chips, no outlined cards around filters.

    The row is the shared `list_row_date` (§5.5) bound by StaffAssignedEventAdapter - never a card
    with a two-button footer.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- ═════════ Filters: wrapping chip row, never a scroller (§5.6) ═════════ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingEnd="@dimen/ui_gutter">

        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/chipFlow"
            style="@style/Widget.EventQR.Ui.ChipFlow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="chipAll,chipUpcoming,chipActive,chipCompleted"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/chipAll"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/ui_staff_filter_all" />

        <TextView
            android:id="@+id/chipUpcoming"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/ui_staff_filter_upcoming" />

        <TextView
            android:id="@+id/chipActive"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/ui_staff_filter_active" />

        <TextView
            android:id="@+id/chipCompleted"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/ui_staff_filter_completed" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshAssignedEvents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerAssignedEvents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="@dimen/space_16"
                android:paddingBottom="@dimen/space_24" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/txtAssignedEventsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:icon="@drawable/ic_ui_event"
                app:subtitle="@string/ui_staff_no_assigned_events_body"
                app:title="@string/ui_staff_no_assigned_events" />

            <!-- Loading mirrors the loaded rows: flat 96dp date rows, not a card. -->
            <LinearLayout
                android:id="@+id/skeletonLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="vertical">

                <!-- 96dp rows: the include is a 72dp row, the wrapper sets the loaded geometry. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_row_height_date"
                    android:orientation="vertical">

                    <include
                        layout="@layout/include_skeleton_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_row_height_date"
                    android:orientation="vertical">

                    <include
                        layout="@layout/include_skeleton_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_row_height_date"
                    android:orientation="vertical">

                    <include
                        layout="@layout/include_skeleton_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
