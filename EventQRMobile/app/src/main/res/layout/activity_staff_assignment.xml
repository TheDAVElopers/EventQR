<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - STAFF ASSIGNMENT (6.4).

        Top bar    56dp, back + "Staff assignment"
        Strip      event glyph + event title, then the "Add staff" chip (include_organizer_event_strip)
        Rows       72dp person rows: initials plate, name, permission summary, one overflow button
        Empty      shared empty state with the Add staff action
        Error      the same component as an error: warning icon, message, Retry

    Deleted: bg_organizer_events_screen, the EventQrDetailHeader slot button, a whole 48dp row whose
    only content was one right-aligned text action, the per-row card, the two stacked row actions and
    the centred empty block.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/include_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/eventStrip"
        layout="@layout/include_organizer_event_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshStaffAssignment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerStaffAssignment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="@dimen/space_8"
                android:paddingBottom="@dimen/space_24" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/txtEmptyStaff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:icon="@drawable/ic_ui_group" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>
</LinearLayout>
