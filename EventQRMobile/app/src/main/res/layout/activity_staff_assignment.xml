<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_organizer_events_screen"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/staff_assignment_title">
        <Button
            android:id="@+id/btnAddStaff"
            style="@style/Widget.EventQR.Button.Primary.Compact"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/control_height_38"
            android:minWidth="80dp"
            android:paddingLeft="@dimen/space_14"
            android:paddingTop="0dp"
            android:paddingRight="@dimen/space_14"
            android:paddingBottom="0dp"
            android:text="@string/staff_add_button" />
    </com.thedavelopers.eventqr.ui.components.EventQrDetailHeader>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshStaffAssignment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerStaffAssignment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/space_20"
                android:paddingTop="@dimen/space_md"
                android:paddingBottom="@dimen/space_xl" />

            <ProgressBar
                android:id="@+id/progressStaffAssignment"
                android:layout_width="@dimen/icon_tile_md"
                android:layout_height="@dimen/icon_tile_md"
                android:layout_gravity="center"
                android:visibility="gone" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
            android:id="@+id/txtEmptyStaff"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:icon="@drawable/ic_group"
            app:title="@string/staff_assignment_no_staff_assigned_yet"
            app:subtitle="@string/staff_assignment_tap_add_to_assign_staff_to_this_even" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>
</LinearLayout>
