<?xml version="1.0" encoding="utf-8"?>
<!--
    STAFF DASHBOARD (§6.3) - retires Gen A.

        Pass head      role tabs, title Today, stub SCANS / CHECK-INS, bell
        Scan a pass    one 96dp flat ui_primary block - the whole screen's purpose, biggest target
        RECENT         hairline list rows (no per-row cards, no raised cards)

    Deleted: "Welcome back, Staff", the two translucent stat tiles inside the header, the gradient
    header, the portal caret chip, the 40dp translucent bell, the 60%-empty centred empty state
    and the copy-pasted skeleton stack.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <!-- ═════════ Pass head: identity + tear + stub ═════════ -->
    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_24">

                <!-- ═════════ The one primary action ═════════ -->
                <LinearLayout
                    android:id="@+id/btnScanPass"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_staff_scan_block_height"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_24"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:background="@drawable/bg_ui_staff_scan_block"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingEnd="@dimen/space_lg">

                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ui_qr_code_2"
                        android:tint="@color/ui_on_primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ui_staff_scan_a_pass"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
                            android:textColor="@color/ui_on_primary" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ui_staff_scan_sub"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                            android:textColor="@color/ui_on_primary_muted" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:layout_marginStart="@dimen/space_md"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ui_arrow_forward"
                        android:tint="@color/ui_on_primary_muted" />
                </LinearLayout>

                <!-- ═════════ RECENT ═════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_32"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_staff_recent"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <TextView
                        android:id="@+id/txtRecentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                        android:textColor="@color/ui_text_secondary" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerRecentScans"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:visibility="gone" />

                    <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                        android:id="@+id/txtRecentScansEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:icon="@drawable/ic_ui_qr_code_2"
                        app:subtitle="@string/ui_staff_no_scans_body"
                        app:title="@string/ui_staff_no_scans" />

                    <include
                        android:id="@+id/skeletonLoading"
                        layout="@layout/include_skeleton_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ui_gutter"
                        android:layout_marginTop="@dimen/space_sm"
                        android:layout_marginEnd="@dimen/ui_gutter" />
                </FrameLayout>
            </LinearLayout>
        </ScrollView>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
