<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_gradient"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingTop="@dimen/space_22"
        android:paddingBottom="@dimen/space_18">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_14">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/header_action_clearance"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtPortalLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/common_welcome_back"
                    android:textColor="@color/deco_on_primary_greeting"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBody.Light" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtStaffName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="190dp"
                        android:text="@string/staff_dashboard_staff_name"
                        android:textColor="@color/on_primary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextHeadline.Medium" />

                    <TextView
                        android:id="@+id/txtStaffNameDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/separator_dot"
                        android:textColor="@color/info_container"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/portalSwitcherChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_6"
                        android:background="@drawable/bg_portal_chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/space_10"
                        android:paddingVertical="@dimen/space_xs"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/txtCurrentPortal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/staff_dashboard_staff"
                            android:textColor="@color/on_primary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextOverline.Strong" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_xs"
                            android:text="@string/glyph_dropdown_arrow"
                            android:textColor="@color/on_primary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextOverline" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="@dimen/icon_tile_md"
                android:layout_height="@dimen/icon_tile_md"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_header_icon_circle"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:id="@+id/btnNotification"
                    android:layout_width="@dimen/icon_22"
                    android:layout_height="@dimen/icon_22"
                    android:layout_gravity="center"
                    android:contentDescription="@string/common_notifications"
                    android:src="@drawable/notification_bell"
                    app:tint="@color/on_primary" />

                <TextView
                    android:id="@+id/txtNotificationBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/bg_notification_badge_count"
                    android:minWidth="@dimen/badge_count_min_width"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/space_xs"
                    android:paddingVertical="1dp"
                    android:text="@string/placeholder_zero"
                    android:textColor="@color/on_primary"
                    android:visibility="gone"
                    android:textAppearance="@style/TextAppearance.EventQR.TextNano" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_dashboard_stat_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_14">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/staff_dashboard_scanned_today"
                    android:textColor="@color/on_dark_50"
                    android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Medium" />

                <TextView
                    android:id="@+id/txtScansToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/placeholder_zero"
                    android:textColor="@color/on_primary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextHeadline.LegacyBold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:background="@drawable/bg_dashboard_stat_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_14">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/staff_dashboard_successful_check_ins"
                    android:textColor="@color/on_dark_50"
                    android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Medium" />

                <TextView
                    android:id="@+id/txtCheckinsToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:text="@string/placeholder_zero"
                    android:textColor="@color/on_primary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextHeadline.LegacyBold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/space_lg"
                    android:paddingTop="@dimen/space_20"
                    android:paddingEnd="@dimen/space_lg"
                    android:paddingBottom="@dimen/space_20">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/staff_dashboard_today_s_activity"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyLarge.Medium" />

                    <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                        android:id="@+id/txtRecentScansEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:visibility="gone"
                        app:icon="@drawable/ic_qr_scan"
                        app:title="@string/staff_dashboard_no_scans_yet_today"
                        app:subtitle="@string/common_scans_you_perform_will_show_up_here" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerRecentScans"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:visibility="gone" />

                    <!-- Dashboard skeleton: recent activity list -->
                    <LinearLayout
                        android:id="@+id/skeletonLoading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:background="@drawable/bg_staff_skeleton_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/space_14">

                            <View
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_staff_skeleton_date_block" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="14dp"
                                    android:background="@drawable/bg_staff_skeleton_bar" />

                                <View
                                    android:layout_width="140dp"
                                    android:layout_height="10dp"
                                    android:layout_marginTop="@dimen/space_sm"
                                    android:background="@drawable/bg_staff_skeleton_bar" />
                            </LinearLayout>

                            <View
                                android:layout_width="56dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_staff_skeleton_bar" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_10"
                            android:background="@drawable/bg_staff_skeleton_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/space_14">

                            <View
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_staff_skeleton_date_block" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="14dp"
                                    android:background="@drawable/bg_staff_skeleton_bar" />

                                <View
                                    android:layout_width="150dp"
                                    android:layout_height="10dp"
                                    android:layout_marginTop="@dimen/space_sm"
                                    android:background="@drawable/bg_staff_skeleton_bar" />
                            </LinearLayout>

                            <View
                                android:layout_width="52dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_staff_skeleton_bar" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_10"
                            android:background="@drawable/bg_staff_skeleton_card"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/space_14">

                            <View
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_staff_skeleton_date_block" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_md"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="14dp"
                                    android:background="@drawable/bg_staff_skeleton_bar" />

                                <View
                                    android:layout_width="130dp"
                                    android:layout_height="10dp"
                                    android:layout_marginTop="@dimen/space_sm"
                                    android:background="@drawable/bg_staff_skeleton_bar" />
                            </LinearLayout>

                            <View
                                android:layout_width="58dp"
                                android:layout_height="10dp"
                                android:background="@drawable/bg_staff_skeleton_bar" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>