<?xml version="1.0" encoding="utf-8"?>
<!--
    STAFF SCAN RESULT (§6.3) - retires Gen A.

        Semantic block   160dp, FLAT success / error fill, one 24dp icon + the state word in
                         display_m, left aligned at 20dp. No concentric rings, no centred column.
        Spec table       attendee, registration badge, event, purpose, verified at - hairlines only
        Footer           primary Scan next, secondary View attendee, ghost Scan again

    Lime appears nowhere on a rejected result and only inside the Valid badge on a good one.
    Deleted: the 100dp target with rings, the centred 22sp state title, the card of icon rows,
    bg_staff_success_circle, bg_staff_rejected_circle and the raised footer.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical"
    android:fitsSystemWindows="false">

    <include
        android:id="@+id/headerTopBar"
        layout="@layout/include_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═════════ Semantic block: valid ═════════ -->
            <LinearLayout
                android:id="@+id/headerApproved"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_staff_result_block_height"
                android:background="@color/ui_success"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingEnd="@dimen/ui_gutter">

                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ui_check"
                    android:tint="@color/ui_on_primary" />

                <TextView
                    android:id="@+id/txtScanResultState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/ui_staff_result_valid"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.DisplayM"
                    android:textColor="@color/ui_on_primary" />

                <TextView
                    android:id="@+id/txtScanResultStatusHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/ui_staff_result_valid_hint"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_on_primary" />
            </LinearLayout>

            <!-- ═════════ Semantic block: rejected ═════════ -->
            <LinearLayout
                android:id="@+id/headerRejected"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_staff_result_block_height"
                android:background="@color/ui_error"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingEnd="@dimen/ui_gutter"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ui_close"
                    android:tint="@color/ui_on_primary" />

                <TextView
                    android:id="@+id/txtScanResultStateRejected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/ui_staff_result_rejected"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.DisplayM"
                    android:textColor="@color/ui_on_primary" />

                <TextView
                    android:id="@+id/txtScanResultStatusHintRejected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/ui_staff_result_rejected_hint"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_on_primary" />
            </LinearLayout>

            <!-- ═════════ Spec table: attendee + event + purpose ═════════ -->
            <LinearLayout
                android:id="@+id/layoutApprovedDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_24"
                android:paddingEnd="@dimen/ui_gutter">

                <TextView
                    android:id="@+id/txtScanResultAttendeeName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.TitleLarge"
                    android:textColor="@color/ui_text_primary" />

                <TextView
                    android:id="@+id/txtScanResultAttendeeEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_metric_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_staff_result_registration"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtScanResultRegistrationStatus"
                        style="@style/Widget.EventQR.Ui.StatusBadge.Valid"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/ui_badge_height" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_metric_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_staff_result_event"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtScanResultEvent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_metric_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_staff_result_purpose"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtScanResultPurpose"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═════════ Verified at ═════════ -->
            <LinearLayout
                android:id="@+id/cardVerificationDetails"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_metric_row_height"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ui_staff_result_verified_at"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                <TextView
                    android:id="@+id/txtScanResultVerifiedAt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.NumericS"
                    android:textColor="@color/ui_text_primary" />
            </LinearLayout>

            <!-- ═════════ Rejected reason ═════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutRejectedReason"
                style="@style/Widget.EventQR.Ui.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:visibility="gone"
                app:cardBackgroundColor="@color/ui_error_container"
                app:strokeWidth="@dimen/stroke_none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ui_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_staff_result_reason"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_on_error_container" />

                    <TextView
                        android:id="@+id/txtScanResultReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_on_error_container" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- ═════════ Sticky footer: one primary, one secondary, one ghost ═════════ -->
    <LinearLayout
        android:id="@+id/layoutFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/stroke_hairline"
            android:background="@color/ui_hairline"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/btnContinueTransaction"
            style="@style/Widget.EventQR.Ui.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_button_height"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_marginEnd="@dimen/space_lg"
            android:gravity="center"
            android:text="@string/ui_staff_result_log_transaction" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressTransactionInline"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bar_thin"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_lg"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/ui_primary"
            app:trackColor="@color/ui_surface_sunken" />

        <TextView
            android:id="@+id/btnViewAttendeeDetails"
            style="@style/Widget.EventQR.Ui.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_button_height"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_lg"
            android:gravity="center"
            android:text="@string/ui_staff_result_view_attendee" />

        <TextView
            android:id="@+id/btnScanAgain"
            style="@style/Widget.EventQR.Ui.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_button_height_inline"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_lg"
            android:gravity="center"
            android:text="@string/ui_staff_result_scan_again" />
    </LinearLayout>
</LinearLayout>
