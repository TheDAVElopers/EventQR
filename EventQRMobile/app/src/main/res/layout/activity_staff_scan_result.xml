<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top Bar -->
    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/staff_scan_result_verification_result" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_xl">

            <!-- Approved Header -->
            <LinearLayout
                android:id="@+id/headerApproved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_lg">

                <FrameLayout
                    android:layout_width="@dimen/tile_100"
                    android:layout_height="@dimen/tile_100">

                    <View
                        android:layout_width="@dimen/tile_80"
                        android:layout_height="@dimen/tile_80"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_green"
                        android:alpha="@dimen/alpha_wash_10" />

                    <View
                        android:layout_width="@dimen/tile_60"
                        android:layout_height="@dimen/tile_60"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_green" />

                    <ImageView
                        android:layout_width="@dimen/icon_32"
                        android:layout_height="@dimen/icon_32"
                        android:layout_gravity="center"
                        android:contentDescription="@string/common_valid"
                        android:src="@drawable/ic_qr_success_check"
                        app:tint="@color/on_primary" />

                    <!-- Decorative burst lines placeholder (approximate design) -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@android:drawable/ic_menu_add"
                        android:alpha="@dimen/alpha_wash_20"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtScanResultState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:textAppearance="@style/TextAppearance.EventQR.TextHeadline"
                    android:text="@string/staff_scan_result_qr_code_valid"/>

                <TextView
                    android:id="@+id/txtScanResultStatusHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium"
                    android:text="@string/staff_scan_result_attendee_verified_successfully"/>

            </LinearLayout>

            <!-- Rejected Header -->
            <LinearLayout
                android:id="@+id/headerRejected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingVertical="@dimen/space_lg"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="@dimen/tile_100"
                    android:layout_height="@dimen/tile_100">

                    <View
                        android:layout_width="@dimen/tile_80"
                        android:layout_height="@dimen/tile_80"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_staff_rejected_circle"
                        android:alpha="@dimen/alpha_wash_10" />

                    <View
                        android:layout_width="@dimen/tile_60"
                        android:layout_height="@dimen/tile_60"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_staff_rejected_circle" />

                    <ImageView
                        android:layout_width="@dimen/icon_32"
                        android:layout_height="@dimen/icon_32"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_staff_close"
                        app:tint="@color/on_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtScanResultStateRejected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/staff_scan_result_qr_code_invalid"
                    android:textColor="@color/error"
                    android:textAppearance="@style/TextAppearance.EventQR.HeadlineL" />

                <TextView
                    android:id="@+id/txtScanResultStatusHintRejected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/staff_scan_result_this_scan_could_not_be_completed"
                    android:layout_marginTop="@dimen/space_sm"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyLarge" />

            </LinearLayout>

            <!-- Main Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutApprovedDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                app:strokeWidth="@dimen/stroke_none"
                style="@style/Widget.EventQR.Card.Raised">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_20">

                    <!-- Attendee Row -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/imgAvatar"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:padding="@dimen/space_md"
                            android:src="@drawable/ic_row_user"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/primary"
                            style="@style/Widget.EventQR.IconTile.Round.Accent" />

                        <TextView
                            android:id="@+id/txtScanResultAttendeeName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_lg"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.EventQR.TitleMedium"
                            app:layout_constraintEnd_toStartOf="@id/txtScanResultRegistrationStatus"
                            app:layout_constraintStart_toEndOf="@id/imgAvatar"
                            app:layout_constraintTop_toTopOf="@id/imgAvatar" />

                        <TextView
                            android:id="@+id/txtScanResultAttendeeEmail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium"
                            app:layout_constraintEnd_toStartOf="@id/txtScanResultRegistrationStatus"
                            app:layout_constraintStart_toStartOf="@id/txtScanResultAttendeeName"
                            app:layout_constraintTop_toBottomOf="@id/txtScanResultAttendeeName" />

                        <TextView
                            android:id="@+id/txtScanResultRegistrationStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_success_chip"
                            android:backgroundTint="@color/success_container"
                            android:paddingHorizontal="@dimen/space_10"
                            android:paddingVertical="@dimen/space_xs"
                            android:textColor="@color/success_dark"
                            android:textAppearance="@style/TextAppearance.EventQR.TextMicro"
                            app:layout_constraintBottom_toBottomOf="@id/imgAvatar"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/imgAvatar" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:layout_marginVertical="@dimen/space_lg"
                        style="@style/Widget.EventQR.Divider.Muted" />

                    <!-- Event Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_tile_md"
                            android:layout_height="@dimen/icon_tile_md"
                            android:padding="@dimen/space_10"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/primary"
                            style="@style/Widget.EventQR.IconTile.Round.Accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_lg"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/staff_scan_result_event"
                                android:textColor="@color/text_hint"
                                android:textAppearance="@style/TextAppearance.EventQR.TextMicro" />

                            <TextView
                                android:id="@+id/txtScanResultEvent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:textAppearance="@style/TextAppearance.EventQR.TextBodyLarge.Strong" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_marginVertical="@dimen/space_lg"
                        style="@style/Widget.EventQR.Divider.Muted" />

                    <!-- Purpose Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/icon_tile_md"
                            android:layout_height="@dimen/icon_tile_md"
                            android:padding="@dimen/space_10"
                            android:src="@drawable/ic_row_tag"
                            app:tint="@color/primary"
                            style="@style/Widget.EventQR.IconTile.Round.Accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_lg"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/common_scan_purpose"
                                android:textColor="@color/text_hint"
                                android:textAppearance="@style/TextAppearance.EventQR.TextMicro" />

                            <TextView
                                android:id="@+id/txtScanResultPurpose"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_xxs"
                                android:textAppearance="@style/TextAppearance.EventQR.TextBodyLarge.Strong" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardVerificationDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                app:strokeColor="@color/surface_muted"
                style="@style/Widget.EventQR.Card.Compact">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_lg">

                    <ImageView
                        android:layout_width="@dimen/icon_32"
                        android:layout_height="@dimen/icon_32"
                        android:padding="@dimen/space_7"
                        android:src="@drawable/ic_row_clock"
                        app:tint="@color/primary"
                        style="@style/Widget.EventQR.IconTile.Round.Accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/staff_scan_result_verified_at"
                            android:textColor="@color/text_hint"
                            android:textAppearance="@style/TextAppearance.EventQR.TextNano" />

                        <TextView
                            android:id="@+id/txtScanResultVerifiedAt"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Rejected Reason Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutRejectedReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:visibility="gone"
                app:cardBackgroundColor="@color/error_container"
                style="@style/Widget.EventQR.Card.Flat"
                app:strokeColor="@color/error_container">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_lg">

                    <ImageView
                        android:layout_width="@dimen/icon_tile_md"
                        android:layout_height="@dimen/icon_tile_md"
                        android:padding="@dimen/space_10"
                        android:src="@drawable/ic_row_alert"
                        app:tint="@color/error"
                        style="@style/Widget.EventQR.IconTile.Round.Error" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/common_rejection_reason"
                            android:textColor="@color/danger"
                            android:textAppearance="@style/TextAppearance.EventQR.TextMicro" />

                        <TextView
                            android:id="@+id/txtScanResultReason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:textColor="@color/on_error_container"
                            android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Footer Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xl"
        android:paddingTop="@dimen/space_lg"
        android:elevation="@dimen/elevation_overlay">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinueTransaction"
            style="@style/Widget.EventQR.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            app:icon="@drawable/ic_file"
            app:iconGravity="textStart"
            android:text="@string/staff_scan_result_log_transaction"
            app:iconSize="@dimen/icon_lg"
            app:iconTint="@color/on_primary"
            android:textAppearance="@style/TextAppearance.EventQR.ButtonBodyLarge.Strong" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressTransactionInline"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bar_thin"
            android:layout_marginTop="@dimen/space_sm"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/primary"
            app:trackColor="@color/outline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewAttendeeDetails"
            app:icon="@drawable/ic_visibility_on"
            app:iconGravity="textStart"
            app:iconTint="@color/primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/common_view_attendee_details"
            style="@style/Widget.EventQR.Button.Outline.Large"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanAgain"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_md"
            android:textAllCaps="false"
            android:textColor="@color/deco_charcoal_action"
            android:text="@string/staff_scan_result_scan_another"
            app:icon="@drawable/ic_staff_scan"
            app:iconPadding="@dimen/space_sm"
            app:iconSize="30dp"
            app:iconTint="@color/deco_charcoal_action"
            android:textAppearance="@style/TextAppearance.EventQR.ButtonTitle.Strong" />

    </LinearLayout>

</LinearLayout>
