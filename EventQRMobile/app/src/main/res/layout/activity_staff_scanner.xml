<?xml version="1.0" encoding="utf-8"?>
<!--
    STAFF SCANNER (§6.3, §5.13) - the signature screen. Retires Gen A + Gen B.

    Order: compact pass head (title Scan) -> context bar 48dp -> flat 320x256 camera panel ->
    one guidance line -> manual entry (normal field + primary button, radius 4) -> inline error
    strip -> bottom nav.

    The panel, brackets, torch and guidance come from include_scan_viewport - one dark surface,
    flat, no gradient, no glow, no translucent cards. ScannerActivity injects the TextureView into
    scanPreview (ui_staff_scan_preview.xml) so the shared viewport is used as-is.

    Deleted: the radial glow background, the two stacked white cards ("SCANNING FOR" / "SCAN
    PURPOSE"), the gradient camera well, the #C4B5FD brackets, the status pill, the permanent
    manual-entry card, the glyph chevrons and the floating nav card.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <!-- ═════════ Pass head (compact): eyebrow + title + tear ═════════ -->
    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_24">

            <!-- ═════════ Context bar + flat camera panel + guidance ═════════ -->
            <include
                android:id="@+id/scanViewport"
                layout="@layout/include_scan_viewport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16" />

            <!-- Purpose detail (+10 pts, "one claim only", ...) under the guidance line. -->
            <TextView
                android:id="@+id/txtSelectedPurposePoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_4"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_text_secondary"
                android:visibility="gone" />

            <!-- ═════════ Manual entry: label, field, primary button ═════════ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:text="@string/ui_staff_scan_label"
                android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

            <EditText
                android:id="@+id/edtScannerQr"
                style="@style/Widget.EventQR.Ui.TextField"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_control_height"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_8"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:hint="@string/ui_staff_scan_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:singleLine="true" />

            <TextView
                android:id="@+id/btnSubmitScan"
                style="@style/Widget.EventQR.Ui.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:gravity="center"
                android:text="@string/ui_staff_verify" />

            <!-- No assigned events: says what to do next, never a red banner. Below the manual entry
                 so the field and its primary button stay above the fold. -->
            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/txtScannerEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:icon="@drawable/ic_ui_event"
                app:subtitle="@string/ui_staff_no_events_body"
                app:title="@string/ui_staff_no_events" />

            <!-- Decode / submission failure: an inline 56dp strip, never a toast (§5.13). -->
            <TextView
                android:id="@+id/txtScannerResult"
                style="@style/Widget.EventQR.Ui.Scan.StatusStrip"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_scan_status_height"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:visibility="gone" />

            <!-- ── Off-screen plumbing kept for behaviour parity ── -->
            <Spinner
                android:id="@+id/spnScannerEvent"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <Spinner
                android:id="@+id/spnScannerPurpose"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutPurposeDropdown"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <EditText
                android:id="@+id/edtScannerNotes"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerScannerResults"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
