<?xml version="1.0" encoding="utf-8"?>
<!--
    STAFF SCANNER (§6.3, §5.13) - the signature screen. Retires Gen A + Gen B.

    Order: compact pass head (title Scan) -> context bar 48dp -> flat 320x256 camera panel ->
    one guidance line -> manual entry (normal field + primary button, radius 4) -> inline error
    strip -> bottom nav.

    ONE screen per scan (Slice 1). A decode logs the scan through the same endpoint the plan's
    result screen used, and the result is the inline group below (groupScanResult): the same 160dp
    minimum semantic block, attendee, registration badge, points row and one primary. While it is
    visible the viewport and manual entry are hidden and the camera is released, so the result is
    never a screen of its own and the camera restarts on "Scan next".

    The panel, brackets, torch and guidance come from include_scan_viewport - one dark surface,
    flat, no gradient, no glow, no translucent cards. ScannerActivity injects the TextureView into
    scanPreview (ui_staff_scan_preview.xml) so the shared viewport is used as-is.

    Deleted: the radial glow background, the two stacked white cards ("SCANNING FOR" / "SCAN
    PURPOSE"), the gradient camera well, the #C4B5FD brackets, the status pill, the permanent
    manual-entry card, the glyph chevrons and the floating nav card.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <!-- ═════════ Pass head (compact): eyebrow + title + tear ═════════ -->
    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:id="@+id/scrollScanner"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_24">

            <!-- ═════════ Context bar + flat camera panel + guidance ═════════ -->
            <include
                android:id="@+id/scanViewport"
                layout="@layout/include_scan_viewport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16" />

            <!-- Decode / submission failure: an inline strip under the panel, never a toast (§5.13),
                 with its Retry beside the sentence (§9.6:18). minHeight, not a fixed height, so a
                 long server reason grows instead of clipping. -->
            <LinearLayout
                android:id="@+id/scanErrorGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_12"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/txtScannerResult"
                    style="@style/Widget.EventQR.Ui.Scan.StatusStrip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/ui_scan_status_height" />

                <TextView
                    android:id="@+id/btnScanRetry"
                    style="@style/Widget.EventQR.Ui.Button.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_8"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/ui_staff_result_try_again" />
            </LinearLayout>

            <!-- Purpose detail (+10 pts, "one claim only", ...) under the guidance line. -->
            <TextView
                android:id="@+id/txtSelectedPurposePoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_4"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_text_secondary"
                android:visibility="gone" />

            <!-- ═════════ Manual entry: label, field, primary button ═════════ -->
            <!-- groupManualEntry is hidden with the camera when the staff has no selectable event
                 (§5.13): the empty state below is then the only directed state on the screen. -->
            <LinearLayout
                android:id="@+id/groupManualEntry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_24"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:text="@string/ui_staff_scan_label"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                <EditText
                    android:id="@+id/edtScannerQr"
                    style="@style/Widget.EventQR.Ui.TextField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_8"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:hint="@string/ui_staff_scan_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/btnSubmitScan"
                    style="@style/Widget.EventQR.Ui.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_12"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/ui_staff_verify" />
            </LinearLayout>

            <!-- Nothing scannable: the shared empty state (§5.10), in the scroll content, so the
                 screen says why the list is empty instead of offering a dead panel. -->
            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/txtScannerEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:icon="@drawable/ic_ui_event"
                app:subtitle="@string/ui_staff_no_active_events_body"
                app:title="@string/ui_staff_no_active_events" />

            <!-- ═════════ Inline scan result (§6.3) ═════════
                 The plan's result screen, folded into the scanner: 160dp flat semantic block,
                 attendee, registration badge, points row when credited, the server reason as a
                 detail line. Its one action is pinned in resultActionBar below. -->
            <LinearLayout
                android:id="@+id/groupScanResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/scanResultBlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_staff_result_block_height"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/space_24"
                    android:paddingBottom="@dimen/space_24"
                    android:paddingStart="@dimen/ui_gutter"
                    android:paddingEnd="@dimen/ui_gutter">

                    <ImageView
                        android:id="@+id/scanResultIcon"
                        android:layout_width="@dimen/icon_lg"
                        android:layout_height="@dimen/icon_lg"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ui_check_circle"
                        android:tint="@color/ui_on_primary" />

                    <TextView
                        android:id="@+id/scanResultState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.DisplayM"
                        android:textColor="@color/ui_on_primary"
                        tools:text="@string/ui_staff_result_valid" />

                    <TextView
                        android:id="@+id/scanResultHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:ellipsize="end"
                        android:importantForAccessibility="no"
                        android:maxLines="3"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                        android:textColor="@color/ui_on_primary"
                        tools:text="@string/ui_staff_result_valid_hint" />
                </LinearLayout>

                <!-- The captured scan scope (§6.3 v1.11): two metric rows - label left / value right,
                     on the page surface directly under the block edge. The app's label/value row
                     pattern, not a control: no fill, no divider, no tap target. Read from the values
                     captured when the scan was submitted, so a later context change or a rotation
                     cannot relabel a finished scan. Each row is GONE when its captured value is
                     blank; the container is GONE when nothing was captured. -->
                <LinearLayout
                    android:id="@+id/scanResultScope"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/scanResultScopeEventRow"
                        style="@style/Widget.EventQR.Ui.MetricRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/ui_metric_row_height"
                        android:screenReaderFocusable="true"
                        tools:targetApi="28">

                        <TextView
                            android:id="@+id/scanResultScopeEventLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:importantForAccessibility="no"
                            android:text="@string/ui_staff_scope_event"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                        <TextView
                            android:id="@+id/scanResultScopeEvent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="2"
                            android:importantForAccessibility="no"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                            android:textColor="@color/ui_text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/scanResultScopePurposeRow"
                        style="@style/Widget.EventQR.Ui.MetricRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/ui_metric_row_height"
                        android:screenReaderFocusable="true"
                        tools:targetApi="28">

                        <TextView
                            android:id="@+id/scanResultScopePurposeLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:importantForAccessibility="no"
                            android:text="@string/ui_staff_scope_purpose"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                        <TextView
                            android:id="@+id/scanResultScopePurpose"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:gravity="end"
                            android:maxLines="1"
                            android:importantForAccessibility="no"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                            android:textColor="@color/ui_text_primary" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/scanResultAttendee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_24"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.TitleLarge"
                    android:textColor="@color/ui_text_primary"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/scanResultRegistrationRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_staff_result_registration"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <!-- wrap_content + minHeight: an 11sp label at fontScale 2.0 grows the badge
                         instead of clipping (§5.4, §9.3). Neutral by default: the tone is chosen by
                         the binder from the status, so nothing is lime before it decides. -->
                    <TextView
                        android:id="@+id/scanResultRegistrationBadge"
                        style="@style/Widget.EventQR.Ui.StatusBadge.Neutral"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/ui_badge_height" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/scanResultPointsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/ui_metric_row_height"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_staff_tx_points"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/scanResultPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericL"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <!-- The server reason, verbatim: it is a detail line, never pattern-matched. -->
                <TextView
                    android:id="@+id/scanResultDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ui_gutter"
                    android:layout_marginTop="@dimen/space_12"
                    android:layout_marginEnd="@dimen/ui_gutter"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                    android:textColor="@color/ui_text_secondary"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ═════════ Pinned result action (§6.3 v1.9) ═════════
         The one action that leaves the result never requires a scroll. VISIBLE only while the
         result panel owns an action (result, retry, ID print); GONE on the neutral replay panel
         and the live camera. Full-bleed rule, ui_surface fill, no minHeight on the bar and no
         navigation-bar inset: the bottom nav already consumes the navigation bar. -->
    <View
        android:id="@+id/resultActionRule"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/resultActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingTop="@dimen/space_12"
        android:paddingEnd="@dimen/ui_gutter"
        android:paddingBottom="@dimen/space_12"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnScanResultPrimary"
            style="@style/Widget.EventQR.Ui.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:gravity="center"
            tools:text="@string/ui_staff_result_scan_next" />
    </LinearLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
