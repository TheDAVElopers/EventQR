<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_organizer_events_screen"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrTabHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/staff_transaction_logs_transaction_logs"
        app:subtitle="@string/staff_transaction_logs_review_scans_and_transactions" />

    <LinearLayout
        android:id="@+id/cardStaffTransactionsEvent"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_staff_filter_card_neutral"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <View
            android:id="@+id/viewEventDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_staff_filter_status_dot_neutral" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtStaffTransactionsEventLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/staff_transaction_logs_logs_for"
                android:textColor="@color/filter_label"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtStaffTransactionsEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/common_assigned_event"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStaffTransactionsEventDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/filter_label"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtStaffTransactionsEventChevron"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="▾"
            android:textColor="#6B7280"
            android:textSize="18sp"
            android:translationY="-1dp" />
    </LinearLayout>

    <Spinner
        android:id="@+id/spnStaffTransactionsEvent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/cardStaffTransactionsPurpose"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_staff_filter_card_neutral"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <View
            android:id="@+id/viewPurposeDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_staff_filter_status_dot_neutral" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtStaffTransactionsPurposeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/staff_transaction_logs_purpose_filter"
                android:textColor="@color/filter_label"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtStaffTransactionsPurposeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/staff_transaction_logs_all_purposes"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStaffTransactionsPurposeChevron"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="▾"
            android:textColor="#6B7280"
            android:textSize="18sp"
            android:translationY="-1dp" />
    </LinearLayout>

    <Spinner
        android:id="@+id/spnStaffTransactionsPurpose"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:elevation="2dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_tile_indigo"
                android:padding="10dp"
                android:src="@drawable/ic_file"
                app:tint="#4F46E5" />

            <TextView
                android:id="@+id/txtTotalScans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0"
                android:textColor="#111827"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/staff_transaction_logs_total_scans"
                android:textColor="#6B7280"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="12dp"
            android:background="#E5E7EB" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_tile_green"
                android:padding="10dp"
                android:src="@drawable/ic_staff_check"
                app:tint="#10B981" />

            <TextView
                android:id="@+id/txtSuccessfulScans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0"
                android:textColor="#111827"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/staff_transaction_logs_successful"
                android:textColor="#6B7280"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="12dp"
            android:background="#E5E7EB" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_tile_red"
                android:padding="10dp"
                android:src="@drawable/ic_staff_close"
                app:tint="#EF4444" />

            <TextView
                android:id="@+id/txtRejectedScans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0"
                android:textColor="#111827"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_rejected"
                android:textColor="#6B7280"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout android:id="@+id/swipeRefreshStaffTransactions" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="16dp">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerStaffTransactions" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="8dp" android:paddingBottom="12dp" />
            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
            android:id="@+id/txtStaffTransactionsEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:icon="@drawable/ic_history"
            app:title="@string/staff_transaction_logs_no_transactions_logged"
            app:subtitle="@string/common_scans_you_perform_will_show_up_here" />
            <ProgressBar android:id="@+id/pbStaffTransactionsLoadMore" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="8dp" android:visibility="gone" />
            <include
                layout="@layout/include_skeleton_cards"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <EditText android:id="@+id/edtStaffTransactionsEventId" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <Button android:id="@+id/btnLoadStaffTransactions" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
