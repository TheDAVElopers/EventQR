<?xml version="1.0" encoding="utf-8"?>
<!--
    STAFF TRANSACTION LOGS (§6.3, §5.9) - retires Gen C's banner-and-cards body.

        Compact pass head, two 56dp filter rows (event, purpose) with a 16dp chevron, a 56dp
        three-cell count strip, then the shared transaction rows. No card per filter, no 60dp
        bar, no raised summary card, no stat cards.

    ids stay stable - the presenter/contract and the two off-screen plumbing fields are untouched.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- ═════════ Event filter ═════════ -->
    <LinearLayout
        android:id="@+id/cardStaffTransactionsEvent"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_staff_filter_row"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingEnd="@dimen/ui_gutter">

        <TextView
            android:id="@+id/txtStaffTransactionsEventLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ui_staff_filter_event"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

        <TextView
            android:id="@+id/txtStaffTransactionsEventTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="2"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/ui_staff_select_event"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
            android:textColor="@color/ui_text_secondary" />

        <ImageView
            android:id="@+id/txtStaffTransactionsEventChevron"
            android:layout_width="@dimen/ui_chevron"
            android:layout_height="@dimen/ui_chevron"
            android:layout_marginStart="@dimen/space_sm"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ui_expand_more"
            android:tint="@color/ui_text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:background="@color/ui_hairline"
        android:importantForAccessibility="no" />

    <!-- ═════════ Purpose filter ═════════ -->
    <LinearLayout
        android:id="@+id/cardStaffTransactionsPurpose"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_staff_filter_row"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingEnd="@dimen/ui_gutter">

        <TextView
            android:id="@+id/txtStaffTransactionsPurposeLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ui_staff_filter_purpose"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

        <TextView
            android:id="@+id/txtStaffTransactionsPurposeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="2"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/ui_staff_all_purposes"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
            android:textColor="@color/ui_text_secondary" />

        <ImageView
            android:id="@+id/txtStaffTransactionsPurposeChevron"
            android:layout_width="@dimen/ui_chevron"
            android:layout_height="@dimen/ui_chevron"
            android:layout_marginStart="@dimen/space_sm"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_ui_expand_more"
            android:tint="@color/ui_text_secondary" />
    </LinearLayout>

    <!-- ═════════ Three counts, 56dp, one hairline card ═════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ui_metric_row_height"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_12"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:background="@drawable/bg_ui_card"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_md">

            <TextView
                android:id="@+id/txtTotalScans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/placeholder_zero"
                android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                android:textColor="@color/ui_text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/staff_transaction_logs_total_scans"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />
        </LinearLayout>

        <View
            android:layout_width="@dimen/stroke_hairline"
            android:layout_height="match_parent"
            android:background="@color/ui_hairline"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md">

            <TextView
                android:id="@+id/txtSuccessfulScans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/placeholder_zero"
                android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                android:textColor="@color/ui_text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/ui_staff_successful"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />
        </LinearLayout>

        <View
            android:layout_width="@dimen/stroke_hairline"
            android:layout_height="match_parent"
            android:background="@color/ui_hairline"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md">

            <TextView
                android:id="@+id/txtRejectedScans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/placeholder_zero"
                android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                android:textColor="@color/ui_text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/ui_staff_rejected"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═════════ Off-screen plumbing kept for parity ═════════ -->
    <Spinner
        android:id="@+id/spnStaffTransactionsEvent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <Spinner
        android:id="@+id/spnStaffTransactionsPurpose"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <!-- Failure reports in the flow with Retry; loaded rows stay (§5.7). -->
    <LinearLayout
        android:id="@+id/errorStaffTransactions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_ui_block_r4"
        android:backgroundTint="@color/ui_error_container"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ui_touch_min"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtStaffTransactionsError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
            android:textColor="@color/ui_on_error_container" />

        <TextView
            android:id="@+id/btnStaffTransactionsRetry"
            style="@style/Widget.EventQR.Ui.Button.Ghost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:minHeight="@dimen/ui_button_height_inline"
            android:text="@string/common_retry"
            android:textColor="@color/ui_on_error_container" />
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshStaffTransactions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerStaffTransactions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/space_8" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/txtStaffTransactionsEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:icon="@drawable/ic_ui_receipt_long"
                app:subtitle="@string/ui_staff_no_logs_body"
                app:title="@string/ui_staff_no_logs" />

            <LinearLayout
                android:id="@+id/skeletonLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:contentDescription="@string/ui_skeleton_loading"
                android:orientation="vertical">
                <include layout="@layout/include_skeleton_row" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline" />
                <include layout="@layout/include_skeleton_row" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline" />
                <include layout="@layout/include_skeleton_row" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline" />
                <include layout="@layout/include_skeleton_row" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline" />
                <include layout="@layout/include_skeleton_row" />
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline" />
                <include layout="@layout/include_skeleton_row" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pbStaffTransactionsLoadMore"
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="@dimen/space_8"
                android:visibility="gone" />

            <EditText
                android:id="@+id/edtStaffTransactionsEventId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnLoadStaffTransactions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
