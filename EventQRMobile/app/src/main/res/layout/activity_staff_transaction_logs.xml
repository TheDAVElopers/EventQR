<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_organizer_events_screen"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrTabHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/staff_transaction_logs_transaction_logs"
        app:subtitle="@string/staff_transaction_logs_review_scans_and_transactions" />

    <LinearLayout
        android:id="@+id/cardStaffTransactionsEvent"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_18"
        android:background="@drawable/bg_staff_filter_card_neutral"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_lg">

        <View
            android:id="@+id/viewEventDot"
            android:layout_width="@dimen/dot_sm"
            android:layout_height="@dimen/dot_sm"
            android:background="@drawable/bg_staff_filter_status_dot_neutral" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_10"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtStaffTransactionsEventLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/staff_transaction_logs_logs_for"
                android:textColor="@color/filter_label"
                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />

            <TextView
                android:id="@+id/txtStaffTransactionsEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/common_assigned_event"
                android:textAppearance="@style/TextAppearance.EventQR.TextBody.Strong" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStaffTransactionsEventDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/filter_label"
            android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />

        <TextView
            android:id="@+id/txtStaffTransactionsEventChevron"
            android:layout_width="@dimen/icon_32"
            android:layout_height="@dimen/icon_32"
            android:layout_marginStart="@dimen/space_sm"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/glyph_dropdown_arrow"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.EventQR.TitleRegular"
            android:translationY="@dimen/glyph_nudge_y" />
    </LinearLayout>

    <Spinner
        android:id="@+id/spnStaffTransactionsEvent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/cardStaffTransactionsPurpose"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_10"
        android:background="@drawable/bg_staff_filter_card_neutral"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_lg">

        <View
            android:id="@+id/viewPurposeDot"
            android:layout_width="@dimen/dot_sm"
            android:layout_height="@dimen/dot_sm"
            android:background="@drawable/bg_staff_filter_status_dot_neutral" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_10"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtStaffTransactionsPurposeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/staff_transaction_logs_purpose_filter"
                android:textColor="@color/filter_label"
                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />

            <TextView
                android:id="@+id/txtStaffTransactionsPurposeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/staff_transaction_logs_all_purposes"
                android:textAppearance="@style/TextAppearance.EventQR.TextBody.Strong" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtStaffTransactionsPurposeChevron"
            android:layout_width="@dimen/icon_32"
            android:layout_height="@dimen/icon_32"
            android:layout_marginStart="@dimen/space_sm"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/glyph_dropdown_arrow"
            android:textColor="@color/text_secondary"
            android:textAppearance="@style/TextAppearance.EventQR.TitleRegular"
            android:translationY="@dimen/glyph_nudge_y" />
    </LinearLayout>

    <Spinner
        android:id="@+id/spnStaffTransactionsPurpose"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_md"
        android:background="@drawable/bg_card"
        android:elevation="@dimen/elevation_raised"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_md">

            <ImageView
                android:layout_width="@dimen/icon_tile_md"
                android:layout_height="@dimen/icon_tile_md"
                android:padding="@dimen/space_10"
                android:src="@drawable/ic_file"
                app:tint="@color/primary"
                style="@style/Widget.EventQR.IconTile.Round.Accent" />

            <TextView
                android:id="@+id/txtTotalScans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/placeholder_zero"
                android:textAppearance="@style/TextAppearance.EventQR.PageTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/staff_transaction_logs_total_scans"
                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
        </LinearLayout>

        <View
            android:layout_marginVertical="@dimen/space_md"
            style="@style/Widget.EventQR.Divider.Vertical" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_md">

            <ImageView
                android:layout_width="@dimen/icon_tile_md"
                android:layout_height="@dimen/icon_tile_md"
                android:padding="@dimen/space_10"
                android:src="@drawable/ic_staff_check"
                app:tint="@color/success"
                style="@style/Widget.EventQR.IconTile.Round.Success" />

            <TextView
                android:id="@+id/txtSuccessfulScans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/placeholder_zero"
                android:textAppearance="@style/TextAppearance.EventQR.PageTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/staff_transaction_logs_successful"
                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
        </LinearLayout>

        <View
            android:layout_marginVertical="@dimen/space_md"
            style="@style/Widget.EventQR.Divider.Vertical" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/space_md">

            <ImageView
                android:layout_width="@dimen/icon_tile_md"
                android:layout_height="@dimen/icon_tile_md"
                android:padding="@dimen/space_10"
                android:src="@drawable/ic_staff_close"
                app:tint="@color/danger"
                style="@style/Widget.EventQR.IconTile.Round.Error" />

            <TextView
                android:id="@+id/txtRejectedScans"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/placeholder_zero"
                android:textAppearance="@style/TextAppearance.EventQR.PageTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_rejected"
                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
        </LinearLayout>
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout android:id="@+id/swipeRefreshStaffTransactions" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="@dimen/space_lg">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerStaffTransactions" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="@dimen/space_sm" android:paddingBottom="@dimen/space_md" />
            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
            android:id="@+id/txtStaffTransactionsEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:icon="@drawable/ic_history"
            app:title="@string/staff_transaction_logs_no_transactions_logged"
            app:subtitle="@string/common_scans_you_perform_will_show_up_here" />
            <ProgressBar android:id="@+id/pbStaffTransactionsLoadMore" android:layout_width="@dimen/icon_tile_sm" android:layout_height="@dimen/icon_tile_sm" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="@dimen/space_sm" android:visibility="gone" />
            <include
                layout="@layout/include_skeleton_cards"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            <EditText android:id="@+id/edtStaffTransactionsEventId" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <Button android:id="@+id/btnLoadStaffTransactions" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
