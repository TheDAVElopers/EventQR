<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/staff_transaction_result_transaction_result" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_20">

            <!-- Approved status header -->
            <LinearLayout
                android:id="@+id/headerApproved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_xl">

                <FrameLayout
                    android:layout_width="@dimen/tile_100"
                    android:layout_height="@dimen/tile_100">

                    <View
                        android:layout_width="@dimen/tile_80"
                        android:layout_height="@dimen/tile_80"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_green"
                        android:alpha="@dimen/alpha_wash_10" />

                    <View
                        android:layout_width="@dimen/tile_60"
                        android:layout_height="@dimen/tile_60"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_circle_green" />

                    <ImageView
                        android:layout_width="@dimen/icon_32"
                        android:layout_height="@dimen/icon_32"
                        android:layout_gravity="center"
                        android:contentDescription="@string/common_valid"
                        android:src="@drawable/ic_qr_success_check"
                        app:tint="@color/on_primary" />

                    <!-- Decorative burst lines placeholder (approximate design) -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:src="@android:drawable/ic_menu_add"
                        android:alpha="@dimen/alpha_wash_20"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtTransactionState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/staff_transaction_result_transaction_successful"
                    android:textAppearance="@style/TextAppearance.EventQR.TextHeadline" />

                <TextView
                    android:id="@+id/txtTransactionStateHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:gravity="center"
                    android:text="@string/staff_transaction_result_points_awarded_to_attendee"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
            </LinearLayout>

            <!-- Rejected status header -->
            <LinearLayout
                android:id="@+id/headerRejected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="@dimen/space_xl"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="@dimen/tile_100"
                    android:layout_height="@dimen/tile_100">

                    <View
                        android:layout_width="@dimen/tile_80"
                        android:layout_height="@dimen/tile_80"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_staff_rejected_circle"
                        android:alpha="@dimen/alpha_wash_10" />

                    <View
                        android:layout_width="@dimen/tile_60"
                        android:layout_height="@dimen/tile_60"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_staff_rejected_circle" />

                    <ImageView
                        android:layout_width="@dimen/icon_32"
                        android:layout_height="@dimen/icon_32"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_staff_close"
                        app:tint="@color/on_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txtTransactionStateRejected"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:text="@string/staff_transaction_result_transaction_rejected"
                    android:textAppearance="@style/TextAppearance.EventQR.TextHeadline" />

                <TextView
                    android:id="@+id/txtTransactionStateHintRejected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_6"
                    android:gravity="center"
                    android:text="@string/staff_transaction_result_scan_rejected_and_logged"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
            </LinearLayout>

            <!-- Transaction info card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="@dimen/tile_42"
                        android:layout_height="@dimen/tile_42"
                        android:gravity="center"
                        style="@style/Widget.EventQR.IconTile.Round.Accent">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:contentDescription="@string/staff_transaction_result_type"
                            android:src="@drawable/ic_row_tag" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_14"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/staff_transaction_result_scan_type"
                            android:textColor="@color/text_hint"
                            android:textAppearance="@style/TextAppearance.EventQR.TextOverline.Strong" />

                        <TextView
                            android:id="@+id/txtTransactionType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:textAppearance="@style/TextAppearance.EventQR.TextBody.Strong" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_marginVertical="@dimen/space_14"
                    style="@style/Widget.EventQR.Divider.Muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="@dimen/tile_42"
                        android:layout_height="@dimen/tile_42"
                        android:gravity="center"
                        style="@style/Widget.EventQR.IconTile.Round.Accent">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:contentDescription="@string/common_attendee"
                            android:src="@drawable/ic_row_user"
                            app:tint="@color/primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_14"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/staff_transaction_result_attendee"
                            android:textColor="@color/text_hint"
                            android:textAppearance="@style/TextAppearance.EventQR.TextOverline.Strong" />

                        <TextView
                            android:id="@+id/txtTransactionAttendee"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:textAppearance="@style/TextAppearance.EventQR.TextBody" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_marginVertical="@dimen/space_14"
                    style="@style/Widget.EventQR.Divider.Muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="@dimen/tile_42"
                        android:layout_height="@dimen/tile_42"
                        android:gravity="center"
                        style="@style/Widget.EventQR.IconTile.Round.Accent">

                        <ImageView
                            android:layout_width="@dimen/icon_md"
                            android:layout_height="@dimen/icon_md"
                            android:contentDescription="@string/staff_transaction_result_time"
                            android:src="@drawable/ic_row_clock"
                            app:tint="@color/primary"  />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_14"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/staff_transaction_result_scanned_at"
                            android:textColor="@color/text_hint"
                            android:textAppearance="@style/TextAppearance.EventQR.TextOverline.Strong" />

                        <TextView
                            android:id="@+id/txtTransactionTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xxs"
                            android:textAppearance="@style/TextAppearance.EventQR.TextBody"
                            />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Approved: points card -->
            <LinearLayout
                android:id="@+id/layoutTransactionApproved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_reward_points"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_14"
                android:paddingVertical="@dimen/space_md"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="@dimen/icon_tile_md"
                    android:layout_height="@dimen/icon_tile_md"
                    android:gravity="center"
                    style="@style/Widget.EventQR.IconTile.Round.Muted">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@string/staff_transaction_result_points"
                        android:src="@drawable/ic_row_star" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/staff_transaction_result_points_awarded"
                        android:textColor="@color/accent_outline"
                        android:textAppearance="@style/TextAppearance.EventQR.TextMicro" />

                    <TextView
                        android:id="@+id/txtTransactionPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/on_primary"
                        android:textAppearance="@style/TextAppearance.EventQR.TitleLarge" />
                </LinearLayout>
            </LinearLayout>

            <!-- Rejected: reason card -->
            <LinearLayout
                android:id="@+id/layoutTransactionRejected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_red_warning"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_lg"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="@dimen/tile_42"
                    android:layout_height="@dimen/tile_42"
                    android:gravity="center"
                    style="@style/Widget.EventQR.IconTile.Round.Error">

                    <ImageView
                        android:layout_width="@dimen/icon_md"
                        android:layout_height="@dimen/icon_md"
                        android:contentDescription="@string/common_reason"
                        android:src="@drawable/ic_row_alert" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_14"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_rejection_reason"
                        android:textColor="@color/error"
                        android:textAppearance="@style/TextAppearance.EventQR.TextOverline.Strong" />

                    <TextView
                        android:id="@+id/txtTransactionReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:textColor="@color/on_error_container"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewTransactionAttendee"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_54"
                android:layout_marginTop="@dimen/space_20"
                android:text="@string/common_view_attendee_details"
                app:icon="@drawable/ic_visibility_on"
                app:iconGravity="textStart"
                app:iconTint="@color/primary"
                style="@style/Widget.EventQR.Button.Outline.Large"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTransactionScanAgain"
                style="@style/Widget.EventQR.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height_54"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/staff_transaction_result_scan_next_attendee"
                app:icon="@drawable/ic_staff_scan"
                app:iconPadding="@dimen/space_sm"
                app:iconSize="35dp"
                app:iconTint="@color/on_primary"
                app:iconGravity="textStart"
                android:textAppearance="@style/TextAppearance.EventQR.ButtonBodyLarge.Strong"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTransactionDashboard"
                style="@style/Widget.EventQR.Button.Text.Material"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/control_height_54"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/common_back_to_dashboard"
                app:icon="@drawable/ic_back_chevron"
                app:iconPadding="@dimen/space_sm"
                app:iconSize="@dimen/size_26"
                app:iconTint="@color/primary"
                app:iconGravity="textStart"
                android:textAppearance="@style/TextAppearance.EventQR.ButtonBody.Strong"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
