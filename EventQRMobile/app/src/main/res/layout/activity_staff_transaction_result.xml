<?xml version="1.0" encoding="utf-8"?>
<!--
    STAFF TRANSACTION RESULT (§6.3) - retires Gen A.

        Semantic block   160dp flat success / error, one 24dp icon + state word (display_m)
        Spec table       scan type, attendee, scanned at - hairlines only, no icon rows
        Points           numeric value + a Valid badge; lime lives only in that badge
        Actions          primary Scan next, secondary View attendee, ghost Back to dashboard

    Deleted: the concentric success rings, the centred state title, the 42dp tinted icon tiles,
    bg_reward_points, bg_red_warning and the raised card stack.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/headerTopBar"
        layout="@layout/include_top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:id="@+id/scrollResult"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/space_24">

            <!-- ═════════ Semantic block: approved ═════════ -->
            <LinearLayout
                android:id="@+id/headerApproved"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_staff_result_block_height"
                android:background="@color/ui_success"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingEnd="@dimen/ui_gutter">

                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ui_check"
                    android:tint="@color/ui_on_primary" />

                <TextView
                    android:id="@+id/txtTransactionState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/ui_staff_tx_approved"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.DisplayM"
                    android:textColor="@color/ui_on_primary" />

                <TextView
                    android:id="@+id/txtTransactionStateHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/ui_staff_tx_approved_hint"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_on_primary" />
            </LinearLayout>

            <!-- ═════════ Semantic block: rejected ═════════ -->
            <LinearLayout
                android:id="@+id/headerRejected"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_staff_result_block_height"
                android:background="@color/ui_error"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingEnd="@dimen/ui_gutter"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ui_close"
                    android:tint="@color/ui_on_primary" />

                <TextView
                    android:id="@+id/txtTransactionStateRejected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/ui_staff_tx_rejected"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.DisplayM"
                    android:textColor="@color/ui_on_primary" />

                <TextView
                    android:id="@+id/txtTransactionStateHintRejected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/ui_staff_tx_rejected_hint"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_on_primary" />
            </LinearLayout>

            <!-- ═════════ Spec table ═════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_24"
                android:paddingEnd="@dimen/ui_gutter">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_metric_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_staff_tx_type"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtTransactionType"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_metric_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_staff_tx_attendee"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtTransactionAttendee"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_metric_row_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/ui_staff_tx_time"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                    <TextView
                        android:id="@+id/txtTransactionTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.NumericS"
                        android:textColor="@color/ui_text_primary" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═════════ Points (approved only) ═════════ -->
            <LinearLayout
                android:id="@+id/layoutTransactionApproved"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:background="@drawable/bg_ui_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ui_card_padding"
                android:paddingTop="@dimen/space_md"
                android:paddingEnd="@dimen/ui_card_padding"
                android:paddingBottom="@dimen/space_md"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ui_staff_tx_points"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.Overline" />

                <TextView
                    android:id="@+id/txtTransactionPoints"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.NumericL"
                    android:textColor="@color/ui_text_primary" />

                <TextView
                    style="@style/Widget.EventQR.Ui.StatusBadge.Valid"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ui_badge_height"
                    android:layout_marginStart="@dimen/space_md"
                    android:text="@string/ui_staff_tx_credited" />
            </LinearLayout>

            <!-- ═════════ Rejection reason ═════════ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutTransactionRejected"
                style="@style/Widget.EventQR.Ui.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_24"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:visibility="gone"
                app:cardBackgroundColor="@color/ui_error_container"
                app:strokeWidth="@dimen/stroke_none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ui_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_staff_result_reason"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_on_error_container" />

                    <TextView
                        android:id="@+id/txtTransactionReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                        android:textColor="@color/ui_on_error_container" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ═════════ Actions ═════════ -->
            <TextView
                android:id="@+id/btnTransactionScanAgain"
                style="@style/Widget.EventQR.Ui.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_button_height"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_32"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:gravity="center"
                android:text="@string/ui_staff_tx_scan_next" />

            <TextView
                android:id="@+id/btnViewTransactionAttendee"
                style="@style/Widget.EventQR.Ui.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_button_height"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:gravity="center"
                android:text="@string/ui_staff_result_view_attendee" />

            <TextView
                android:id="@+id/btnTransactionDashboard"
                style="@style/Widget.EventQR.Ui.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ui_button_height_inline"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginEnd="@dimen/ui_gutter"
                android:gravity="center"
                android:text="@string/ui_staff_tx_dashboard" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
