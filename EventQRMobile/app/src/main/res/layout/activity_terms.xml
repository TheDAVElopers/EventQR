<?xml version="1.0" encoding="utf-8"?>
<!--
    TERMS (§6.1) - the static legal page.

        Shared top bar, then the intro paragraph and one section per heading. Sections are
        numbered rows on the page, separated by hairlines - no cards, no badge bubbles.

    Deleted: `Widget.EventQR.Card.Compact.Flat` per section, `bg_terms_number` and the
    `TextAppearance.EventQR.Terms*` one-offs.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/terms_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layoutTermsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/ui_gutter"
            android:paddingTop="@dimen/space_24"
            android:paddingBottom="@dimen/space_24">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/terms_intro"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                android:textColor="@color/ui_text_secondary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
