<?xml version="1.0" encoding="utf-8"?>
<!--
    Attendee dashboard (§6.2 of MyFiles/EventQR-Redesign-Plan.md) - retires Gen A.

        Pass head        role tab, first name, stub POINTS / EVENTS / CHECK-INS, bell
        NEXT UP          one list_row_date (96dp) for the next registered event
        DISCOVER         up to three list_row_icon rows
        QUICK ACTIONS    eyebrow + hug-width chip strip (My passes / History / Request); My passes is
                         the only entry point to the registered-events screen - the Registered tab it
                         replaced is gone. Discover stays the Events tab in the bottom nav. Chips wrap
                         onto a second line at large font and the row never scrolls.

    Deleted: the 135-degree gradient header, the translucent "Attendee" caret chip, the 40dp
    translucent bell, the three translucent stat tiles inside the header, the "Quick Actions"
    card with icon columns, the bare angle-glyph "See All", and the copy-pasted skeleton stack.

    Structure kept because DashboardActivity binds it: layoutUpcomingEvents and
    layoutDiscoverEvents each hold their eyebrow at index 0 so replaceRows() can swap every child
    after it, skeletonLoading is the one loading block, and the two navigation targets keep their
    ids (btnTransactionHistory, btnRequestEventCard).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <!-- ═════════ Pass head: identity + tear + stub ═════════ -->
    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- §5.16: a partial failure over readable rows reports here, not in a toast. One sentence for
         all four dashboard sources; Retry re-runs the whole load. -->
    <include
        android:id="@+id/errorDashboard"
        layout="@layout/include_error_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/ui_gutter" />

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_24">

                <!-- ═════════ NEXT UP ═════════ -->
                <LinearLayout
                    android:id="@+id/layoutUpcomingEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ui_gutter"
                        android:layout_marginTop="@dimen/space_24"
                        android:layout_marginEnd="@dimen/ui_gutter"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="@string/user_dashboard_next_event"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />
                </LinearLayout>

                <!-- ═════════ DISCOVER (three rows max) ═════════ -->
                <LinearLayout
                    android:id="@+id/layoutDiscoverEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ui_gutter"
                        android:layout_marginTop="@dimen/space_32"
                        android:layout_marginEnd="@dimen/ui_gutter"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="@string/user_dashboard_discover_events"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />
                </LinearLayout>

                <!-- ═════════ Loading: the loaded row geometry (one 96dp date row, then three
                     72dp icon rows on the page), never a card the loaded list does not use ═════════ -->
                <LinearLayout
                    android:id="@+id/skeletonLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_24"
                    android:contentDescription="@string/ui_skeleton_loading"
                    android:focusable="true"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include
                        layout="@layout/include_skeleton_row"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ui_row_height_date" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_hairline"
                        android:layout_marginStart="@dimen/ui_divider_inset"
                        android:background="@color/ui_hairline"
                        android:importantForAccessibility="no" />

                    <include
                        layout="@layout/include_skeleton_row"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ui_row_height" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_hairline"
                        android:layout_marginStart="@dimen/ui_divider_inset"
                        android:background="@color/ui_hairline"
                        android:importantForAccessibility="no" />

                    <include
                        layout="@layout/include_skeleton_row"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ui_row_height" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/stroke_hairline"
                        android:layout_marginStart="@dimen/ui_divider_inset"
                        android:background="@color/ui_hairline"
                        android:importantForAccessibility="no" />

                    <include
                        layout="@layout/include_skeleton_row"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ui_row_height" />
                </LinearLayout>

                <!-- ═════════ QUICK ACTIONS: eyebrow + equal-width chips filling the gutter ═════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_32"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ui_gutter"
                        android:layout_marginEnd="@dimen/ui_gutter"
                        android:text="@string/ui_attendee_quick_actions"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <!-- Hug-width chips in a Flow: 8dp gaps, wraps to a second line instead of
                         clipping when fontScale grows. Left-packed so the strip starts on the
                         gutter, never a scroller and never equal-width columns. -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:minHeight="@dimen/ui_attendee_chip_row"
                        android:paddingStart="@dimen/ui_gutter"
                        android:paddingEnd="@dimen/ui_gutter">

                        <androidx.constraintlayout.helper.widget.Flow
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="btnMyPasses,btnTransactionHistory,btnRequestEventCard"
                            app:flow_horizontalBias="0"
                            app:flow_horizontalGap="@dimen/space_8"
                            app:flow_horizontalStyle="packed"
                            app:flow_verticalGap="@dimen/space_8"
                            app:flow_wrapMode="aligned"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <TextView
                            android:id="@+id/btnMyPasses"
                            style="@style/Widget.EventQR.Ui.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/ui_touch_min"
                            android:drawableStart="@drawable/ic_ui_confirmation_number"
                            android:text="@string/ui_attendee_quick_passes" />

                        <TextView
                            android:id="@+id/btnTransactionHistory"
                            style="@style/Widget.EventQR.Ui.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/ui_touch_min"
                            android:drawableStart="@drawable/ic_ui_receipt_long"
                            android:text="@string/ui_attendee_quick_history" />

                        <TextView
                            android:id="@+id/btnRequestEventCard"
                            style="@style/Widget.EventQR.Ui.Chip.Action"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/ui_touch_min"
                            android:drawableStart="@drawable/ic_ui_pending_actions"
                            android:text="@string/ui_attendee_quick_request" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
