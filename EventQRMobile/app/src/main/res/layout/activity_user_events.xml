<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_alt"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarDiscoverEvents"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="0dp"
        app:title="Discover Events"
        app:titleTextColor="@color/text_primary"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:boxBackgroundColor="@color/surface"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/outline"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_action_search"
            app:startIconTint="@color/text_disabled">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputEventSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Search events..."
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_disabled"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All"
                android:textColor="@color/brand_on_primary"
                app:chipBackgroundColor="@color/eventqr_indigo"
                app:chipCornerRadius="24dp"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="0dp"
                app:textStartPadding="12dp"
                app:textEndPadding="12dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUpcoming"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Upcoming"
                android:textColor="@color/text_secondary"
                app:chipBackgroundColor="@color/surface"
                app:chipCornerRadius="24dp"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="1dp"
                app:textStartPadding="12dp"
                app:textEndPadding="12dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipActive"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Active"
                android:textColor="@color/text_secondary"
                app:chipBackgroundColor="@color/surface"
                app:chipCornerRadius="24dp"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="1dp"
                app:textStartPadding="12dp"
                app:textEndPadding="12dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCompleted"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Completed"
                android:textColor="@color/text_secondary"
                app:chipBackgroundColor="@color/surface"
                app:chipCornerRadius="24dp"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="1dp"
                app:textStartPadding="12dp"
                app:textEndPadding="12dp" />

        </com.google.android.material.chip.ChipGroup>

    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshEvents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEvents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="24dp" />

            <include layout="@layout/include_skeleton_cards" />

            <LinearLayout
                android:id="@+id/layoutStates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="32dp">

                <ImageView
                    android:id="@+id/imgEmptyIcon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="No events"
                    android:src="@drawable/ic_calendar"
                    android:tint="@color/text_disabled"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtEventsEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="No events found"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtEventsEmptySub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Try adjusting your search or filters"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnRefreshEvents"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:minWidth="120dp"
                    android:text="Retry"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_primary"
                    app:strokeColor="@color/brand_primary"
                    app:cornerRadius="8dp"
                    android:visibility="gone" />

            </LinearLayout>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
