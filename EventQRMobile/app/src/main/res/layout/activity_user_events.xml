<?xml version="1.0" encoding="utf-8"?>
<!--
    Discover (§6.2 of MyFiles/EventQR-Redesign-Plan.md) - retires Gen B.

        Compact pass head (Block A + tear) - "Discover" with the result count in the end slot
        48dp filled search field, no label
        36dp chips in a 48dp row: All / Upcoming / Active / Completed
        EventCard rows on the flat page background

    Deleted: the 280dp radial purple glow, the 26sp + 13sp tab header, the 54dp outlined search
    box, the 38dp pill chips, the per-card status + progress + coloured date-badge stack, and the
    copy-pasted skeleton block.

    Empty/error state is the shared EventQrEmptyState (left aligned, one action).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <EditText
        android:id="@+id/inputEventSearch"
        style="@style/Widget.EventQR.Ui.TextField.Search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_field_search_height"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_marginEnd="@dimen/ui_gutter"
        android:drawableStart="@drawable/ic_ui_search"
        android:drawablePadding="@dimen/space_md"
        android:drawableTint="@color/ui_text_secondary"
        android:hint="@string/common_search_events"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:textColorHint="@color/ui_text_secondary" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:clipToPadding="false"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingEnd="@dimen/ui_gutter"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ui_attendee_chip_row"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_height"
                android:text="@string/ui_attendee_all" />

            <TextView
                android:id="@+id/chipUpcoming"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_height"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:text="@string/ui_attendee_upcoming" />

            <TextView
                android:id="@+id/chipActive"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_height"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:text="@string/ui_attendee_active" />

            <TextView
                android:id="@+id/chipCompleted"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_height"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:text="@string/ui_attendee_completed" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshEvents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_16"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEvents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingEnd="@dimen/ui_gutter"
                android:paddingBottom="@dimen/space_24" />

            <include
                android:id="@+id/skeletonLoading"
                layout="@layout/include_skeleton_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginEnd="@dimen/ui_gutter" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/txtEventsEmpty"
                android:layout_width="@dimen/ui_empty_max_width"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
