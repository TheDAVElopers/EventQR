<?xml version="1.0" encoding="utf-8"?>
<!--
    Discover (§6.2 of MyFiles/EventQR-Redesign-Plan.md) - retires Gen B.

        Compact pass head (Block A + tear) - "Discover" with the result count in the end slot
        48dp filled search field, no label, with the optional date-filter chip trailing it
        36dp chips in a 48dp row: All / This week / Registered
        list_row_date rows at 96dp on the flat page: one badge trailing, hairline dividers

    Deleted: the 280dp radial purple glow, the 26sp + 13sp tab header, the 54dp outlined search
    box, the 38dp pill chips, the per-card status + progress + coloured date-badge stack, and the
    card skeleton.

    Empty/error state is the shared EventQrEmptyState (left aligned, one action).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Search + optional date filter. One row below fontScale 1.3; at that scale and above
         the row is vertical and the chip drops under the full-width field, so neither label can
         collapse or truncate (§9.2, §9.3). The reflow is applied in AttendeeEventsActivity. -->
    <LinearLayout
        android:id="@+id/searchRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingEnd="@dimen/ui_gutter">

        <EditText
            android:id="@+id/inputEventSearch"
            style="@style/Widget.EventQR.Ui.TextField.Search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_ui_search"
            android:drawablePadding="@dimen/space_md"
            android:drawableTint="@color/ui_text_secondary"
            android:hint="@string/common_search_events"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColorHint="@color/ui_text_secondary" />

        <!-- Optional date filter: the label is the value ("Date", "Nov 2026", "12 Nov 2026"),
             the fill is the applied state, and the trailing glyph says it opens a choice. -->
        <TextView
            android:id="@+id/chipDateFilter"
            style="@style/Widget.EventQR.Ui.Chip.Selector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ui_chip_gap"
            android:drawableEnd="@drawable/ic_ui_expand_more"
            android:text="@string/ui_attendee_date" />
    </LinearLayout>

    <!-- §5.6: the filter row wraps on a Flow, it never scrolls. Three chips per line; the inset
         background keeps the 36dp fill inside a 48dp touch target, and wrap_content height lets
         the label grow instead of clipping at fontScale 2.0. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingEnd="@dimen/ui_gutter">

        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/chipFlow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="chipAll,chipThisWeek,chipRegistered"
            app:flow_horizontalGap="@dimen/ui_chip_gap"
            app:flow_maxElementsWrap="3"
            app:flow_verticalGap="@dimen/ui_chip_gap"
            app:flow_wrapMode="chain"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/chipAll"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/ui_attendee_all" />

        <TextView
            android:id="@+id/chipThisWeek"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/ui_attendee_this_week" />

        <TextView
            android:id="@+id/chipRegistered"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_sm"
            android:paddingBottom="@dimen/space_sm"
            android:text="@string/ui_attendee_registered" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshEvents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_16"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Rows carry the 20dp gutter themselves, like every other list_row_* host. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEvents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:paddingBottom="@dimen/space_24" />

            <!-- First load: six rows at the loaded 96dp geometry (§5.11, §9.6 #13). The CLOSED
                 container announces "Loading"; every bar is hidden from TalkBack (§9.5). -->
            <LinearLayout
                android:id="@+id/skeletonLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/ui_skeleton_loading"
                android:focusable="true"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_date" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_date" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_date" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_date" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_date" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_date" />
            </LinearLayout>

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/txtEventsEmpty"
                android:layout_width="@dimen/ui_empty_max_width"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
