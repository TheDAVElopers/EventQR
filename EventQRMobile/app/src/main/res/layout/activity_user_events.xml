<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_organizer_events_screen"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrTabHeader
        android:id="@+id/toolbarDiscoverEvents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/user_dashboard_discover_events"
        app:subtitle="@string/user_events_find_and_register_for_upcoming_event" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_lg">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearch"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            app:boxBackgroundColor="@color/surface"
            app:boxCornerRadiusBottomEnd="@dimen/radius_md"
            app:boxCornerRadiusBottomStart="@dimen/radius_md"
            app:boxCornerRadiusTopEnd="@dimen/radius_md"
            app:boxCornerRadiusTopStart="@dimen/radius_md"
            app:boxStrokeColor="@color/outline"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/ic_action_search"
            app:startIconTint="@color/neutral">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputEventSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/common_search_events"
                android:inputType="text"
                android:textColorHint="@color/text_disabled"
                android:textAppearance="@style/TextAppearance.EventQR.InputBodyMedium" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_lg"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_lg"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/common_all"
                android:textColor="@color/on_primary"
                app:chipBackgroundColor="@color/primary"
                app:chipCornerRadius="@dimen/radius_xl"
                app:chipMinHeight="@dimen/chip_min_height_lg"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="@dimen/stroke_none"
                app:textStartPadding="@dimen/space_md"
                app:textEndPadding="@dimen/space_md" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipUpcoming"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/common_upcoming"
                android:textColor="@color/text_secondary"
                app:chipBackgroundColor="@color/surface"
                app:chipCornerRadius="@dimen/radius_xl"
                app:chipMinHeight="@dimen/chip_min_height_lg"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="@dimen/stroke_hairline"
                app:textStartPadding="@dimen/space_md"
                app:textEndPadding="@dimen/space_md" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipActive"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/common_active"
                android:textColor="@color/text_secondary"
                app:chipBackgroundColor="@color/surface"
                app:chipCornerRadius="@dimen/radius_xl"
                app:chipMinHeight="@dimen/chip_min_height_lg"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="@dimen/stroke_hairline"
                app:textStartPadding="@dimen/space_md"
                app:textEndPadding="@dimen/space_md" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCompleted"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:text="@string/common_completed"
                android:textColor="@color/text_secondary"
                app:chipBackgroundColor="@color/surface"
                app:chipCornerRadius="@dimen/radius_xl"
                app:chipMinHeight="@dimen/chip_min_height_lg"
                app:chipStrokeColor="@color/outline"
                app:chipStrokeWidth="@dimen/stroke_hairline"
                app:textStartPadding="@dimen/space_md"
                app:textEndPadding="@dimen/space_md" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshEvents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerEvents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingTop="@dimen/space_md"
                android:paddingBottom="@dimen/space_xl" />

            <include layout="@layout/include_skeleton_cards" />

            <LinearLayout
                android:id="@+id/layoutStates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/space_xxl">

                <ImageView
                    android:id="@+id/imgEmptyIcon"
                    android:layout_width="@dimen/tile_64"
                    android:layout_height="@dimen/tile_64"
                    android:contentDescription="@string/common_no_events"
                    android:src="@drawable/ic_calendar"
                    android:tint="@color/neutral"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtEventsEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_md"
                    android:gravity="center"
                    android:text="@string/user_events_no_events_found"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyLarge.Strong"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtEventsEmptySub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:gravity="center"
                    android:text="@string/common_try_adjusting_your_search_or_filters"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnRefreshEvents"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/touch_target_min"
                    android:layout_marginTop="@dimen/space_lg"
                    android:minWidth="@dimen/size_120"
                    android:text="@string/common_retry"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    app:strokeColor="@color/primary"
                    app:cornerRadius="@dimen/radius_sm"
                    android:visibility="gone" />

            </LinearLayout>
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
