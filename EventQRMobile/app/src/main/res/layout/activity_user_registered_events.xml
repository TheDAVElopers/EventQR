<?xml version="1.0" encoding="utf-8"?>
<!--
    Registered events (§6.2) - retires Gen B's tab header and Gen A's pill chips.

        Compact pass head ("My passes")
        Chip row: All / Upcoming / Active / Completed
        EventCard rows (shared component) on the flat page
        Shared skeleton and empty state
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:clipToPadding="false"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingEnd="@dimen/ui_gutter"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ui_attendee_chip_row"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_height"
                android:text="@string/ui_attendee_all" />

            <TextView
                android:id="@+id/chipUpcoming"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_height"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:text="@string/ui_attendee_upcoming" />

            <TextView
                android:id="@+id/chipActive"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_height"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:text="@string/ui_attendee_active" />

            <TextView
                android:id="@+id/chipCompleted"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_height"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:text="@string/ui_attendee_completed" />
        </LinearLayout>
    </HorizontalScrollView>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshRegisteredEvents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRegisteredEvents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_2"
                android:paddingEnd="@dimen/ui_gutter"
                android:paddingBottom="@dimen/space_24" />

            <include
                android:id="@+id/skeletonLoading"
                layout="@layout/include_skeleton_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_gutter"
                android:layout_marginTop="@dimen/space_sm"
                android:layout_marginEnd="@dimen/ui_gutter" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/txtRegisteredEventsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="gone" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
