<?xml version="1.0" encoding="utf-8"?>
<!--
    Registered events (§6.2) - retires Gen B's tab header and Gen A's pill chips.

        Compact pass head ("My passes")
        Chip row: All / Upcoming / Active / Completed
        list_row_date rows at 96dp on the flat page: one badge trailing, hairline dividers
        Flat row skeleton and the shared empty state
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- The filter row wraps on a Flow: it never scrolls (§5.6). Three chips per line, the inset
         background keeps the 36dp fill inside a 48dp touch target, and wrap_content height lets a
         grown label take a second line instead of clipping. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chipRowRegisteredEvents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingEnd="@dimen/ui_gutter">

        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/chipFlow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="chipAll,chipUpcoming,chipActive,chipCompleted"
            app:flow_horizontalGap="@dimen/ui_chip_gap"
            app:flow_maxElementsWrap="3"
            app:flow_verticalGap="@dimen/ui_chip_gap"
            app:flow_wrapMode="chain"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/chipAll"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_8"
            android:text="@string/ui_attendee_all" />

        <TextView
            android:id="@+id/chipUpcoming"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_8"
            android:text="@string/ui_attendee_upcoming" />

        <TextView
            android:id="@+id/chipActive"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_8"
            android:text="@string/ui_attendee_active" />

        <TextView
            android:id="@+id/chipCompleted"
            style="@style/Widget.EventQR.Ui.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ui_chip_inset"
            android:minHeight="@dimen/ui_touch_min"
            android:paddingTop="@dimen/space_8"
            android:paddingBottom="@dimen/space_8"
            android:text="@string/ui_attendee_completed" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- §5.16: a failed refresh over readable passes reports here, under the filter row so the
         filters stay reachable. Retry re-runs the presenter's load for the current filter. -->
    <include
        android:id="@+id/errorRegisteredEvents"
        layout="@layout/include_error_strip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_gutter"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginEnd="@dimen/ui_gutter" />

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshRegisteredEvents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Rows carry the 20dp gutter themselves, like every other list_row_* host. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRegisteredEvents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:paddingBottom="@dimen/space_24" />

            <!-- First load: six rows at the loaded 96dp geometry (§5.11, §9.6 #13). The CLOSED
                 container announces "Loading"; every bar is hidden from TalkBack (§9.5). -->
            <LinearLayout
                android:id="@+id/skeletonLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/ui_skeleton_loading"
                android:focusable="true"
                android:orientation="vertical"
                android:visibility="gone">

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_date" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_date" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_date" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_date" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_date" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/stroke_hairline"
                    android:layout_marginStart="@dimen/ui_divider_inset"
                    android:background="@color/ui_hairline"
                    android:importantForAccessibility="no" />

                <include
                    layout="@layout/include_skeleton_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/ui_row_height_date" />
            </LinearLayout>

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/txtRegisteredEventsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="gone" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
