<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_organizer_events_screen">

    <com.thedavelopers.eventqr.ui.components.EventQrTabHeader
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/user_registered_events_my_registered_events"
        app:subtitle="@string/user_registered_events_events_you_have_signed_up_for" />

    <LinearLayout
        android:id="@+id/layoutFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTopBar">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRegisteredFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/common_all"
                    android:textColor="@color/brand_on_primary"
                    app:chipBackgroundColor="@color/eventqr_indigo"
                    app:chipCornerRadius="24dp"
                    app:chipMinHeight="40dp"
                    app:chipStrokeColor="@color/outline"
                    app:chipStrokeWidth="0dp"
                    app:textStartPadding="12dp"
                    app:textEndPadding="12dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipUpcoming"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/common_upcoming"
                    android:textColor="@color/text_secondary"
                    app:chipBackgroundColor="@color/surface"
                    app:chipCornerRadius="24dp"
                    app:chipMinHeight="40dp"
                    app:chipStrokeColor="@color/outline"
                    app:chipStrokeWidth="1dp"
                    app:textStartPadding="12dp"
                    app:textEndPadding="12dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipActive"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/common_active"
                    android:textColor="@color/text_secondary"
                    app:chipBackgroundColor="@color/surface"
                    app:chipCornerRadius="24dp"
                    app:chipMinHeight="40dp"
                    app:chipStrokeColor="@color/outline"
                    app:chipStrokeWidth="1dp"
                    app:textStartPadding="12dp"
                    app:textEndPadding="12dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCompleted"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/common_completed"
                    android:textColor="@color/text_secondary"
                    app:chipBackgroundColor="@color/surface"
                    app:chipCornerRadius="24dp"
                    app:chipMinHeight="40dp"
                    app:chipStrokeColor="@color/outline"
                    app:chipStrokeWidth="1dp"
                    app:textStartPadding="12dp"
                    app:textEndPadding="12dp" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </LinearLayout>

    <View
        android:id="@+id/filterDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.3"
        android:background="@color/eventqr_border"
        app:layout_constraintTop_toBottomOf="@id/layoutFilter" />

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshRegisteredEvents"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/composeBottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/filterDivider">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerRegisteredEvents"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="16dp" />

            <include layout="@layout/include_skeleton_cards" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
            android:id="@+id/txtRegisteredEventsEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:icon="@drawable/ic_nav_registered"
            app:title="@string/common_no_registered_events_yet"
            app:subtitle="@string/user_registered_events_events_you_register_for_will_show_up" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <!-- ── Bottom Navigation ─────────────────────────────────── -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>