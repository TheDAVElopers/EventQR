<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/user_reward_details_reward_details" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_xl">

            <!-- Card 1: summary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="@dimen/icon_tile_lg"
                        android:layout_height="@dimen/icon_tile_lg"
                        style="@style/Widget.EventQR.IconTile">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/user_reward_details_reward"
                            android:padding="@dimen/space_md"
                            android:src="@drawable/ic_nav_gift"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txtRewardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_lg"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="start|center_vertical"
                        android:maxLines="2"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/user_reward_details_reward_title"
                        android:textAppearance="@style/TextAppearance.EventQR.TitleLarge" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_20"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtPointsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="@color/primary"
                        android:textAppearance="@style/TextAppearance.EventQR.Display"
                        tools:text="100" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_sm"
                        android:includeFontPadding="false"
                        android:text="@string/user_reward_details_pts_required"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtRewardStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_lg"
                    android:background="@drawable/bg_reward_status_available"
                    android:drawableStart="@drawable/ic_reward_status_available"
                    android:drawablePadding="@dimen/space_6"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/control_height_32"
                    android:paddingHorizontal="@dimen/space_md"
                    android:paddingVertical="@dimen/space_6"
                    android:text="@string/user_reward_details_available"
                    android:textColor="@color/badge_entered_text"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />
            </LinearLayout>

            <TextView
                android:id="@+id/warningBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_reward_notice_amber"
                android:drawableStart="@drawable/ic_qr_warning"
                android:drawablePadding="@dimen/space_md"
                android:drawableTint="@color/badge_pending_text"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_lg"
                android:paddingVertical="@dimen/space_14"
                android:text="@string/user_reward_details_you_need_more_points_to_redeem_this"
                android:textColor="@color/badge_pending_text"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtWarningMessage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Card 2: progress -->
            <LinearLayout
                android:id="@+id/cardProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/space_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/touch_target_min"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/user_reward_details_your_points"
                        android:textColor="@color/text_secondary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

                    <TextView
                        android:id="@+id/txtUserPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_0_pts"
                        android:textColor="@color/primary"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyLarge.Strong" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressAffordability"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="@dimen/space_md"
                    android:importantForAccessibility="no"
                    android:max="100"
                    android:progressDrawable="@drawable/pb_reward_affordability" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtPointsProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong"
                        tools:text="40 / 100 pts" />

                    <TextView
                        android:id="@+id/txtPointsGap"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_md"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium.Strong"
                        tools:text="60 more pts to unlock"
                        tools:textColor="@color/error" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        style="@style/Widget.EventQR.Divider"
                        android:layout_marginTop="@dimen/space_lg" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="@dimen/touch_target_min"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/user_reward_details_remaining"
                            android:textColor="@color/text_secondary"
                            android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

                        <TextView
                            android:id="@+id/txtRewardRemaining"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium.Strong"
                            tools:text="12 left" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Card 3: how to redeem -->
            <LinearLayout
                android:id="@+id/cardHowToRedeem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:background="@drawable/bg_reward_hint"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="@dimen/space_lg">

                <ImageView
                    android:layout_width="@dimen/icon_lg"
                    android:layout_height="@dimen/icon_lg"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_qr_scan"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="@dimen/line_multiplier_12"
                    android:text="@string/user_reward_details_how_to_redeem"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
