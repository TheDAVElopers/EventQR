<?xml version="1.0" encoding="utf-8"?>
<!--
    Rewards (§6.2 of MyFiles/EventQR-Redesign-Plan.md) - retires Gen A.

        Compact pass head ("Rewards")
        Event field (48dp, filled) - the reward list is per event, so the event comes first
        Balance: a prominent tabular number on the flat page, never a gradient card. It carries
        lime only through the status badge on a reward, never as decoration.
        Chip row: Available / Claimed / History
        88dp reward rows with hairline dividers (no per-row card)

    Deleted: the 315-degree gradient balance card with the 46sp number, the violet text action,
    bg_reward_points, bg_reward_dark_card, per-reward raised cards, and the copy-pasted skeletons.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head_compact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshRewards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/ui_gutter"
                android:paddingTop="@dimen/space_lg"
                android:paddingEnd="@dimen/ui_gutter"
                android:paddingBottom="@dimen/space_24">

                <TextView
                    android:id="@+id/txtRewardsError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_error"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/errorRewardsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btnRewardsRetry"
                        style="@style/Widget.EventQR.Ui.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_attendee_retry"
                        android:visibility="gone" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                        android:id="@+id/layoutNoRegisteredEvents"
                        android:layout_width="@dimen/ui_empty_max_width"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:gutter="false" />

                    <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                        android:id="@+id/layoutNotRegisteredForEvent"
                        android:layout_width="@dimen/ui_empty_max_width"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        app:gutter="false" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/layoutRewardsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ═════════ Event field ═════════ -->
                    <TextView
                        android:id="@+id/txtSelectEventLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ui_attendee_registered_event"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

                    <LinearLayout
                        android:id="@+id/cardSelectedEvent"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ui_field_search_height"
                        android:layout_marginTop="@dimen/space_sm"
                        android:background="@drawable/bg_ui_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/layoutDropdownContent"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/space_lg"
                            android:paddingEnd="@dimen/space_md">

                            <TextView
                                android:id="@+id/txtSelectedEventTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/common_select_event"
                                android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                                android:textColor="@color/ui_text_primary" />

                            <ImageView
                                android:id="@+id/spinnerArrow"
                                style="@style/Widget.EventQR.Ui.Selector.Caret"
                                android:layout_marginStart="@dimen/space_sm"
                                android:importantForAccessibility="no" />
                        </LinearLayout>

                        <View
                            android:id="@+id/skeletonDropdown"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_ui_skeleton"
                            android:visibility="gone" />
                    </LinearLayout>

                    <Spinner
                        android:id="@+id/spinnerRegisteredEvents"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <!-- ═════════ Balance: the number is the content ═════════ -->
                    <LinearLayout
                        android:id="@+id/cardRewardsBalance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_32"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ui_attendee_balance"
                            android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs">

                            <TextView
                                android:id="@+id/txtRewardsBalance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:textAppearance="@style/TextAppearance.EventQR.Type.NumericL"
                                android:textColor="@color/ui_text_primary" />

                            <View
                                android:id="@+id/skeletonEventName"
                                android:layout_width="@dimen/ui_skeleton_meta_width"
                                android:layout_height="@dimen/ui_skeleton_bar_height"
                                android:layout_gravity="center_vertical"
                                android:background="@drawable/bg_ui_skeleton"
                                android:visibility="gone" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- ═════════ Available / Claimed / History: wrapping chips (§5.6) ═════════ -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_24">

                        <androidx.constraintlayout.helper.widget.Flow
                            android:id="@+id/chipFlow"
                            style="@style/Widget.EventQR.Ui.ChipFlow"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:constraint_referenced_ids="chipAvailable,txtMyClaims,txtRewardsHistory"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/chipAvailable"
                            style="@style/Widget.EventQR.Ui.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_ui_chip_inset"
                            android:minHeight="@dimen/ui_touch_min"
                            android:paddingTop="@dimen/space_sm"
                            android:paddingBottom="@dimen/space_sm"
                            android:text="@string/ui_attendee_available" />

                        <TextView
                            android:id="@+id/txtMyClaims"
                            style="@style/Widget.EventQR.Ui.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_ui_chip_inset"
                            android:minHeight="@dimen/ui_touch_min"
                            android:paddingTop="@dimen/space_sm"
                            android:paddingBottom="@dimen/space_sm"
                            android:text="@string/ui_attendee_claimed" />

                        <TextView
                            android:id="@+id/txtRewardsHistory"
                            style="@style/Widget.EventQR.Ui.Chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_ui_chip_inset"
                            android:minHeight="@dimen/ui_touch_min"
                            android:paddingTop="@dimen/space_sm"
                            android:paddingBottom="@dimen/space_sm"
                            android:text="@string/ui_attendee_history" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/txtRewardsSectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_24"
                        android:layout_marginBottom="@dimen/space_sm"
                        android:text="@string/ui_attendee_available_rewards"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                            android:id="@+id/layoutRewardsEmpty"
                            android:layout_width="@dimen/ui_empty_max_width"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:gutter="false" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/layoutRewardsSkeleton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:contentDescription="@string/ui_skeleton_loading"
                        android:orientation="vertical">
                        <include layout="@layout/include_skeleton_row" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/stroke_hairline"
                            android:layout_marginStart="@dimen/ui_divider_inset"
                            android:background="@color/ui_hairline" />
                        <include layout="@layout/include_skeleton_row" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/stroke_hairline"
                            android:layout_marginStart="@dimen/ui_divider_inset"
                            android:background="@color/ui_hairline" />
                        <include layout="@layout/include_skeleton_row" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/stroke_hairline"
                            android:layout_marginStart="@dimen/ui_divider_inset"
                            android:background="@color/ui_hairline" />
                        <include layout="@layout/include_skeleton_row" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/stroke_hairline"
                            android:layout_marginStart="@dimen/ui_divider_inset"
                            android:background="@color/ui_hairline" />
                        <include layout="@layout/include_skeleton_row" />
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/stroke_hairline"
                            android:layout_marginStart="@dimen/ui_divider_inset"
                            android:background="@color/ui_hairline" />
                        <include layout="@layout/include_skeleton_row" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerRewards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
