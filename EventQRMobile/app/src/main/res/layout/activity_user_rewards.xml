<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eventqr_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/txtRewardsHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Rewards"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/txtMyClaims"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp"
            android:text="My Claims"
            android:textColor="@color/purple"
            android:textSize="16sp" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshRewards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <!-- Error state -->
                <LinearLayout
                    android:id="@+id/errorRewardsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="16dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/txtRewardsError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/eventqr_error"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnRewardsRetry"
                        android:layout_width="140dp"
                        android:layout_height="44dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_primary_button"
                        android:text="Retry"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Empty events state -->
                <LinearLayout
                    android:id="@+id/layoutNoRegisteredEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="32dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/imgEmptyRewardsIcon"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="No registered events"
                        android:src="@drawable/ic_nav_gift"
                        android:tint="@color/text_disabled" />

                    <TextView
                        android:id="@+id/txtEmptyRewardsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="No registered events yet"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtEmptyRewardsSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:text="Register for an event to start earning rewards"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Main content wrapper -->
                <LinearLayout
                    android:id="@+id/layoutRewardsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- "Select Registered Event" label (always visible) -->
                    <TextView
                        android:id="@+id/txtSelectEventLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Select Registered Event"
                        android:textColor="@color/text_secondary"
                        android:textSize="15sp" />

                    <!-- Dropdown card (always visible, contains text + skeleton bar) -->
                    <FrameLayout
                        android:id="@+id/cardSelectedEvent"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_rewards_dropdown"
                        android:clickable="true"
                        android:focusable="true">

                        <!-- Actual dropdown text -->
                        <LinearLayout
                            android:id="@+id/layoutDropdownContent"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <TextView
                                android:id="@+id/txtSelectedEventTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="Select event"
                                android:textColor="@color/eventqr_text"
                                android:textSize="15sp" />

                            <ImageView
                                android:id="@+id/spinnerArrow"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="Dropdown"
                                android:src="@drawable/ic_arrow_drop_down"
                                android:tint="#6B7280" />
                        </LinearLayout>

                        <!-- Dropdown skeleton bar -->
                        <View
                            android:id="@+id/skeletonDropdown"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />
                    </FrameLayout>

                    <Spinner
                        android:id="@+id/spinnerRegisteredEvents"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutEventDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:visibility="gone" />

                    <!-- Purple points balance card (always visible) -->
                    <LinearLayout
                        android:id="@+id/cardRewardsBalance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:background="@drawable/bg_reward_points"
                        android:elevation="5dp"
                        android:orientation="vertical"
                        android:paddingHorizontal="24dp"
                        android:paddingTop="22dp"
                        android:paddingBottom="20dp">

                        <!-- Event name (toggle between text and skeleton) -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/txtRewardsEventTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="#DDD6FE"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <View
                                android:id="@+id/skeletonEventName"
                                android:layout_width="160dp"
                                android:layout_height="12dp"
                                android:background="@drawable/bg_staff_skeleton_bar_light"
                                android:visibility="gone" />
                        </FrameLayout>

                        <!-- "Event Points Balance" label (always visible) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-bold"
                            android:text="Event Points Balance"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />

                        <!-- Points value (toggle between text and skeleton) -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:id="@+id/txtRewardsBalance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-bold"
                                android:text="0"
                                android:textColor="#FFFFFF"
                                android:textSize="46sp" />
                        </FrameLayout>

                        <!-- "points available" subtitle (always visible) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="points available for this event"
                            android:textColor="#EDE9FE"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <!-- "Available Rewards" section header (always visible) -->
                    <TextView
                        android:id="@+id/txtRewardsSectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:fontFamily="sans-serif-bold"
                        android:text="Available Rewards"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp" />

                    <!-- Rewards empty state -->
                    <LinearLayout
                        android:id="@+id/layoutRewardsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingTop="24dp"
                        android:paddingBottom="24dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:contentDescription="No rewards"
                            android:src="@drawable/ic_nav_gift"
                            android:tint="@color/text_disabled" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="No rewards available yet"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Check back later for rewards for this event"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Rewards list skeleton (shown during loading) -->
                    <LinearLayout
                        android:id="@+id/layoutRewardsSkeleton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Reward card skeleton 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:background="@drawable/bg_staff_skeleton_card"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_staff_skeleton_bar" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="80dp"
                                    android:layout_height="28dp"
                                    android:background="@drawable/bg_staff_skeleton_date_block" />

                                <View
                                    android:layout_width="60dp"
                                    android:layout_height="10dp"
                                    android:layout_marginStart="12dp"
                                    android:background="@drawable/bg_staff_skeleton_bar" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Reward card skeleton 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_staff_skeleton_card"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="14dp"
                                android:background="@drawable/bg_staff_skeleton_bar" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <View
                                    android:layout_width="80dp"
                                    android:layout_height="28dp"
                                    android:background="@drawable/bg_staff_skeleton_date_block" />

                                <View
                                    android:layout_width="60dp"
                                    android:layout_height="10dp"
                                    android:layout_marginStart="12dp"
                                    android:background="@drawable/bg_staff_skeleton_bar" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Actual rewards recycler -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerRewards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
