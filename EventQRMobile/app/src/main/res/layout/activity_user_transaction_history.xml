<?xml version="1.0" encoding="utf-8"?>
<!--
    Transaction history (§6.2, list language §5.5) - retires Gen A.

        Top bar, then the event filter as a filled 48dp field (not a spinner inside a card)
        The count as one quiet line, not a summary card
        Transaction rows on the flat page with the shared skeleton and empty state

    Deleted: bg_history_summary_card, the selected-event card wrapping a hidden spinner, the
    three copy-pasted skeleton cards and the centred empty block.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_background"
    android:orientation="vertical">

    <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/ui_attendee_transaction_history" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingTop="@dimen/space_lg"
        android:paddingEnd="@dimen/ui_gutter">

        <TextView
            android:id="@+id/txtFilterEventLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/cardSelectedEvent"
            android:text="@string/ui_attendee_registered_event"
            android:textAppearance="@style/TextAppearance.EventQR.Type.FieldLabel" />

        <LinearLayout
            android:id="@+id/cardSelectedEvent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_field_search_height"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_ui_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_lg"
            android:paddingEnd="@dimen/space_md">

            <TextView
                android:id="@+id/txtSelectedEventTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/user_transaction_history_all_events"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Body"
                android:textColor="@color/ui_text_primary" />

            <ImageView
                android:id="@+id/spinnerArrow"
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:layout_marginStart="@dimen/space_sm"
                android:contentDescription="@string/common_dropdown"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ui_expand_more"
                android:tint="@color/ui_text_secondary" />
        </LinearLayout>

        <Spinner
            android:id="@+id/spinnerEventFilter"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtHistoryTransactionCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
            android:textColor="@color/ui_text_secondary" />
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshTransactions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/ui_gutter"
            android:paddingEnd="@dimen/ui_gutter">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTransactions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:paddingBottom="@dimen/space_sm" />

            <include
                android:id="@+id/skeletonLoading"
                layout="@layout/include_skeleton_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
                android:id="@+id/txtTransactionsEmpty"
                android:layout_width="@dimen/ui_empty_max_width"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:gutter="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTransactionsError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/user_transaction_history_unable_to_load_transactions"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                    android:textColor="@color/ui_error"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/btnTransactionsRetry"
                    style="@style/Widget.EventQR.Ui.Button.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ui_button_height_inline"
                    android:text="@string/ui_attendee_retry"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
