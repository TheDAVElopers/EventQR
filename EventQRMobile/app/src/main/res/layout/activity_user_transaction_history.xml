<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.thedavelopers.eventqr.ui.components.EventQrDetailHeader
        android:id="@+id/headerTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/common_transaction_history" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingTop="@dimen/space_md"
            android:paddingBottom="@dimen/space_10">

            <TextView
                android:id="@+id/txtFilterEventLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/user_transaction_history_select_event"
                android:textColor="@color/text_secondary"
                android:textAppearance="@style/TextAppearance.EventQR.TextBody.Medium" />

            <LinearLayout
                android:id="@+id/cardSelectedEvent"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="@dimen/space_10"
                android:background="@drawable/bg_rewards_dropdown"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_lg">

                <TextView
                    android:id="@+id/txtSelectedEventTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/user_transaction_history_all_events"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBody" />

                <ImageView
                    android:id="@+id/spinnerArrow"
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:layout_marginStart="@dimen/space_sm"
                    android:contentDescription="@string/common_dropdown"
                    android:src="@drawable/ic_arrow_drop_down"
                    android:tint="@color/text_secondary" />
            </LinearLayout>

            <Spinner
                android:id="@+id/spinnerEventFilter"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_history_summary_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_14"
                android:paddingVertical="@dimen/space_14">

                <TextView
                    android:id="@+id/txtHistoryTransactionCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/user_transaction_history_0_transactions"
                    android:textColor="@color/text_secondary"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout
        android:id="@+id/swipeRefreshTransactions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingBottom="@dimen/space_sm">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTransactions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:paddingBottom="@dimen/space_sm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/skeletonLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_lg"
                    android:visibility="visible">

                    <!-- Skeleton row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_staff_skeleton_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_lg"
                        android:layout_marginBottom="@dimen/space_md">

                        <View
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_staff_skeleton_date_block" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_md"
                            android:orientation="vertical">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:background="@drawable/bg_staff_skeleton_bar" />

                            <View
                                android:layout_width="140dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="@dimen/space_sm"
                                android:background="@drawable/bg_staff_skeleton_bar" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Skeleton row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_staff_skeleton_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_lg"
                        android:layout_marginBottom="@dimen/space_md">

                        <View
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_staff_skeleton_date_block" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_md"
                            android:orientation="vertical">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:background="@drawable/bg_staff_skeleton_bar" />

                            <View
                                android:layout_width="120dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="@dimen/space_sm"
                                android:background="@drawable/bg_staff_skeleton_bar" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Skeleton row 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_staff_skeleton_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/space_lg"
                        android:layout_marginBottom="@dimen/space_md">

                        <View
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_staff_skeleton_date_block" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/space_md"
                            android:orientation="vertical">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="12dp"
                                android:background="@drawable/bg_staff_skeleton_bar" />

                            <View
                                android:layout_width="100dp"
                                android:layout_height="10dp"
                                android:layout_marginTop="@dimen/space_sm"
                                android:background="@drawable/bg_staff_skeleton_bar" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                

                <TextView
                    android:id="@+id/txtTransactionsError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/user_transaction_history_unable_to_load_transactions"
                    android:textColor="@color/danger"
                    android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnTransactionsRetry"
                    style="@style/Widget.EventQR.Button.Primary.Retry"
                    android:layout_width="@dimen/button_width_retry"
                    android:layout_height="@dimen/control_height_44"
                    android:layout_marginTop="@dimen/space_md"
                    android:text="@string/common_retry"
                    android:visibility="gone" />
            </LinearLayout>
            <com.thedavelopers.eventqr.ui.components.EventQrEmptyState
            android:id="@+id/txtTransactionsEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:icon="@drawable/ic_history"
            app:title="@string/attendee_details_no_transactions_yet"
            app:subtitle="@string/user_transaction_history_points_you_earn_and_spend_will_show" />
        </FrameLayout>
    </com.thedavelopers.eventqr.ui.components.EventQrSwipeRefreshLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/composeBottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>