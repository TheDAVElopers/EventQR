<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_20"
    android:paddingEnd="@dimen/space_20"
    android:paddingTop="@dimen/space_md"
    android:paddingBottom="@dimen/space_xl"
    android:background="@drawable/bg_card">

    <View
        android:layout_width="40dp"
        android:layout_height="@dimen/bar_thin"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/space_20"
        android:background="@color/outline" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bottom_sheet_portal_switcher_switch_portal"
        android:textAppearance="@style/TextAppearance.EventQR.TitleRegular.Medium" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/bottom_sheet_portal_switcher_choose_which_eventqr_workspace_to_op"
        android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />

    <LinearLayout
        android:id="@+id/portalOptionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/btnPortalSignOut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:background="@drawable/bg_sign_out_button"
        android:clickable="true"
        android:contentDescription="@string/bottom_sheet_portal_switcher_sign_out"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_14">

        <FrameLayout
            android:layout_width="@dimen/icon_tile_md"
            android:layout_height="@dimen/icon_tile_md"
            android:background="@drawable/bg_circle_error_container">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_logout"
                app:tint="@color/error" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_14"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/common_sign_out"
                android:textColor="@color/error"
                android:textAppearance="@style/TextAppearance.EventQR.TextBody.Medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:text="@string/bottom_sheet_portal_switcher_end_your_session_on_this_device"
                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
