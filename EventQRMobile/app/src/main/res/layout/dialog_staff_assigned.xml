<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_28"
    android:background="@drawable/bg_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_xl"
    android:paddingTop="@dimen/space_xl"
    android:paddingBottom="@dimen/space_20">

    <FrameLayout
        android:layout_width="@dimen/tile_72"
        android:layout_height="@dimen/tile_72"
        android:background="@drawable/bg_staff_success_circle"
        android:foregroundGravity="center">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_staff_check_white" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_14"
        android:text="@string/staff_assigned_title"
        android:textColor="@color/text_primary"
        android:textAppearance="@style/TextAppearance.EventQR.TitleMedium" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center"
        android:text="@string/staff_assigned_message"
        android:textColor="@color/text_secondary"
        android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium" />

    <Button
        android:id="@+id/btnDoneAssigned"
        style="@style/Widget.EventQR.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="@dimen/control_height_50"
        android:layout_marginTop="@dimen/space_20"
        android:text="@string/staff_assigned_done"
        android:textAppearance="@style/TextAppearance.EventQR.ButtonPlatformBodyLarge.Strong" />
</LinearLayout>
