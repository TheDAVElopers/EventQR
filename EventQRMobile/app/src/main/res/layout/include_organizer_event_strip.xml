<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - EVENT STRIP (6.4).

    The one line that says which event a per-event screen belongs to: 20dp event glyph, the event
    title in body_s secondary (one line, ellipsize end), then the screen's action chip. 48dp minimum
    so the chip keeps a touch target; no fill, no hairline - the top bar keeps the only rule.

    The chip is optional: a screen whose own task is "add staff" hides it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/ui_touch_min"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ui_gutter"
    android:paddingEnd="@dimen/ui_gutter">

    <ImageView
        android:layout_width="@dimen/ui_field_icon"
        android:layout_height="@dimen/ui_field_icon"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_ui_event"
        android:tint="@color/ui_text_secondary" />

    <TextView
        android:id="@+id/eventStripTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
        android:textColor="@color/ui_text_secondary"
        tools:text="DevFest Manila 2026" />

    <TextView
        android:id="@+id/eventStripAction"
        style="@style/Widget.EventQR.Ui.Chip.Action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:minHeight="@dimen/ui_touch_min"
        android:text="@string/ui_organizer_add_staff"
        app:drawableStartCompat="@drawable/ic_ui_add" />
</LinearLayout>
