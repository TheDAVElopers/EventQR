<?xml version="1.0" encoding="utf-8"?>
<!--
    THE PASS HEAD (§4.6) - the header archetype for all four role dashboards.

        Block A  identity  116dp min   flat ui_primary, 20dp gutter
                 row0   56dp          role tabs  OR  eyebrow  OR  portal chip, + bell
                 row1   44dp min      title, Archivo 700 28/34, on_primary, max 2 lines
                 row2   optional      subtitle, body_s, on_primary_muted
        Tear    1dp          full bleed divider_perforation_dark
        Block B stub 56dp    flat ui_pass_stub, 3 equal cells, 1dp on_dark_hairline dividers

    HOW TO USE
    ══════════
    <include
        android:id="@+id/passHead"
        layout="@layout/include_pass_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    Then bind once (recommended - it also applies the status-bar inset):

        PassHeadBinder.bind(
            findViewById(R.id.passHead),
            PassHeadModel(
                eyebrow = "ATTENDEE",
                title = "Juan",
                subtitle = null,
                stats = listOf(PassStat("1 240", "Points"), PassStat("6", "Events")),
                bellCount = 3,
            ),
        )

    or drive it by hand - the ids below are stable:
        passHeadIdentity     applyEventQrTopInsetPadding() here (it owns the status bar)
        passHeadTabs         LinearLayout of passHeadTab1..4 (TextView + underline bg)
        passHeadEyebrow      overline shown when there are no tabs and no chip
        passHeadChip         portal chip, 12% white
        passHeadBell         FrameLayout 44dp; passHeadBellBadge is the 18dp count
        passHeadTitle        headline
        passHeadSubtitle     body_s, GONE when empty
        passHeadStub         Block B; passHeadStat{1,2,3}{Value,Label}, dividers 2 and 3

    Cell 3 (and its divider) GONE = two stats. Max three stats, ever (§5.9).

    Compose parity: PassHead(...) in ui/components/EventQrHeaders.kt renders the same anatomy
    from the same tokens.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/passHead"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ═════════════════ Block A: identity ═════════════════ -->
    <LinearLayout
        android:id="@+id/passHeadIdentity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ui_pass_head_identity_height"
        android:background="@drawable/bg_pass_head"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingEnd="@dimen/ui_gutter">

        <!-- row0: tabs / eyebrow / chip on the left, bell on the right -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_pass_head_row_tabs">

            <LinearLayout
                android:id="@+id/passHeadTabs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="start|center_vertical"
                android:layout_marginEnd="@dimen/ui_bell_size"
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Tab = 44dp touch wrapper + a label whose own width carries the underline. -->
                <LinearLayout
                    android:id="@+id/passHeadTabWrap1"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ui_pass_head_tab_height"
                    android:minWidth="@dimen/ui_touch_min"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/passHeadTab1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ui_pass_tab_underline"
                        android:paddingBottom="@dimen/ui_pass_head_tab_underline_gap"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_pass_tab_text"
                        tools:text="Attendee" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/passHeadTabWrap2"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ui_pass_head_tab_height"
                    android:layout_marginStart="@dimen/ui_pass_head_tab_gap"
                    android:minWidth="@dimen/ui_touch_min"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/passHeadTab2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ui_pass_tab_underline"
                        android:paddingBottom="@dimen/ui_pass_head_tab_underline_gap"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_pass_tab_text"
                        tools:text="Staff" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/passHeadTabWrap3"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ui_pass_head_tab_height"
                    android:layout_marginStart="@dimen/ui_pass_head_tab_gap"
                    android:minWidth="@dimen/ui_touch_min"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/passHeadTab3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ui_pass_tab_underline"
                        android:paddingBottom="@dimen/ui_pass_head_tab_underline_gap"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_pass_tab_text"
                        tools:text="Organizer" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/passHeadTabWrap4"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ui_pass_head_tab_height"
                    android:layout_marginStart="@dimen/ui_pass_head_tab_gap"
                    android:minWidth="@dimen/ui_touch_min"
                    android:gravity="center_horizontal|center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/passHeadTab4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/ui_pass_tab_underline"
                        android:paddingBottom="@dimen/ui_pass_head_tab_underline_gap"
                        android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                        android:textColor="@color/ui_pass_tab_text"
                        tools:text="Admin" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/passHeadEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Eyebrow"
                android:textColor="@color/ui_on_primary_muted"
                tools:text="ATTENDEE" />

            <TextView
                android:id="@+id/passHeadChip"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_chip_dark_height"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_ui_pass_chip"
                android:gravity="center"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                android:textColor="@color/ui_on_primary"
                android:visibility="gone"
                tools:text="Attendee"
                tools:visibility="visible" />

            <FrameLayout
                android:id="@+id/passHeadBell"
                android:layout_width="@dimen/ui_bell_size"
                android:layout_height="@dimen/ui_bell_size"
                android:layout_gravity="end|center_vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageButton
                    android:id="@+id/passHeadBellButton"
                    android:layout_width="@dimen/ui_bell_size"
                    android:layout_height="@dimen/ui_bell_size"
                    android:background="@drawable/bg_ui_button_icon"
                    android:contentDescription="@string/ui_pass_head_bell"
                    android:padding="@dimen/space_md"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ui_notifications_none"
                    android:tint="@color/ui_on_primary" />

                <TextView
                    android:id="@+id/passHeadBellBadge"
                    android:layout_width="@dimen/ui_count_badge_size"
                    android:layout_height="@dimen/ui_count_badge_size"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="@dimen/ui_count_badge_offset"
                    android:layout_marginEnd="@dimen/ui_count_badge_offset"
                    android:background="@drawable/bg_ui_count_badge"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.EventQR.Type.NumericS"
                    android:textColor="@color/ui_primary"
                    android:textSize="@dimen/ui_type_overline"
                    android:visibility="gone"
                    tools:text="3"
                    tools:visibility="visible" />
            </FrameLayout>
        </FrameLayout>

        <!-- row1: the title. minHeight 44, max 2 lines: the block grows at large font scale. -->
        <TextView
            android:id="@+id/passHeadTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_pass_head_title_min"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Headline"
            android:textColor="@color/ui_on_primary"
            tools:text="Today" />

        <!-- row2: optional subtitle -->
        <TextView
            android:id="@+id/passHeadSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ui_pass_head_stat_label_gap"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
            android:textColor="@color/ui_on_primary_muted"
            android:visibility="gone"
            tools:text="3 events this week"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- ═════════════════ Tear line: full bleed, 1dp ═════════════════ -->
    <View
        android:id="@+id/passHeadTear"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@drawable/divider_perforation_dark"
        android:importantForAccessibility="no" />

    <!-- ═════════════════ Block B: stub, max three stats ═════════════════ -->
    <LinearLayout
        android:id="@+id/passHeadStub"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ui_pass_head_stub_height"
        android:background="@drawable/bg_pass_stub"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_gutter">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="@dimen/ui_pass_head_stat_cell_pad">

            <TextView
                android:id="@+id/passHeadStat1Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                android:textColor="@color/ui_on_primary"
                tools:text="1 240" />

            <TextView
                android:id="@+id/passHeadStat1Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_pass_head_stat_label_gap"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                android:textColor="@color/ui_on_primary_muted"
                tools:text="Points" />
        </LinearLayout>

        <View
            android:id="@+id/passHeadDivider2"
            android:layout_width="@dimen/stroke_hairline"
            android:layout_height="match_parent"
            android:background="@color/ui_on_dark_hairline"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/passHeadCell2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_pass_head_stat_cell_pad"
            android:paddingEnd="@dimen/ui_pass_head_stat_cell_pad">

            <TextView
                android:id="@+id/passHeadStat2Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                android:textColor="@color/ui_on_primary"
                tools:text="6" />

            <TextView
                android:id="@+id/passHeadStat2Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_pass_head_stat_label_gap"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                android:textColor="@color/ui_on_primary_muted"
                tools:text="Events" />
        </LinearLayout>

        <View
            android:id="@+id/passHeadDivider3"
            android:layout_width="@dimen/stroke_hairline"
            android:layout_height="match_parent"
            android:background="@color/ui_on_dark_hairline"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/passHeadCell3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_pass_head_stat_cell_pad">

            <TextView
                android:id="@+id/passHeadStat3Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                android:textColor="@color/ui_on_primary"
                tools:text="12" />

            <TextView
                android:id="@+id/passHeadStat3Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_pass_head_stat_label_gap"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                android:textColor="@color/ui_on_primary_muted"
                tools:text="Check-ins" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
