<?xml version="1.0" encoding="utf-8"?>
<!--
    QR CREDENTIAL SURFACE (§5.14) - the only beautiful object in the app, and the only gradient.

        320dp wide, 440dp min (grows for a 2-line event name / large font)
        bg_credential_surface: 315deg, #2D2A7C -> #5B25C9, 16dp radius, 1dp 12% white hairline
        20dp padding inside, 20dp around the perforation
        perforation 1dp dashed 24% white, full bleed, with two 24dp notches punched out
        216dp white QR plate (radius 4) holding a 184dp module, 16dp quiet zone
        serial numeric_s white left, VALID badge (accent / on_accent) right

    Identical anatomy for activity_qr_credential, activity_qr_display, the PDF/print ID and the
    96dp mini-pass on scan result (QR omitted there).

    TalkBack (§9.5): set contentDescription on qrCredentialCard from
    @string/ui_credential_description, and mark qrPlate importantForAccessibility=no so the pass
    is read once.

    ids: qrCredentialRoot, qrCredentialCard, qrBrand, qrRole, qrEventName, qrMeta,
         qrPerforation, qrNotchStart, qrNotchEnd, qrPlate, qrImage, qrSerial, qrValidBadge.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/qrCredentialRoot"
    style="@style/Widget.EventQR.Ui.Credential"
    android:layout_width="@dimen/ui_credential_width"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingTop="@dimen/ui_credential_pad"
        android:paddingBottom="@dimen/ui_credential_pad">

        <!-- Top block: brand + role overlines, event name, meta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_credential_pad"
            android:paddingEnd="@dimen/ui_credential_pad">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/qrBrand"
                    style="@style/Widget.EventQR.Ui.Credential.Overline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ui_credential_brand" />

                <TextView
                    android:id="@+id/qrRole"
                    style="@style/Widget.EventQR.Ui.Credential.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Attendee" />
            </LinearLayout>

            <TextView
                android:id="@+id/qrEventName"
                style="@style/Widget.EventQR.Ui.Credential.EventName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_credential_pad"
                tools:text="DevFest Manila 2026" />

            <TextView
                android:id="@+id/qrMeta"
                style="@style/Widget.EventQR.Ui.Credential.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                tools:text="12 Oct 2026 - PICC, Pasay" />
        </LinearLayout>

        <!-- Perforation: full bleed, notches punched out of both edges -->
        <LinearLayout
            android:id="@+id/qrPerforation"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ui_notch"
            android:layout_marginTop="@dimen/ui_credential_pad"
            android:layout_marginBottom="@dimen/ui_credential_pad"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/qrNotchStart"
                style="@style/Widget.EventQR.Ui.Credential.Notch"
                android:layout_width="@dimen/ui_notch"
                android:layout_height="@dimen/ui_notch"
                android:translationX="@dimen/ui_notch_offset" />

            <View
                android:layout_width="0dp"
                android:layout_height="@dimen/stroke_hairline"
                android:layout_weight="1"
                android:background="@drawable/divider_perforation_dark"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/qrNotchEnd"
                style="@style/Widget.EventQR.Ui.Credential.Notch"
                android:layout_width="@dimen/ui_notch"
                android:layout_height="@dimen/ui_notch"
                android:translationX="@dimen/ui_notch_positive_offset" />
        </LinearLayout>

        <!-- QR plate + serial -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/ui_credential_pad"
            android:paddingEnd="@dimen/ui_credential_pad">

            <FrameLayout
                android:id="@+id/qrPlate"
                style="@style/Widget.EventQR.Ui.Credential.Plate"
                android:layout_width="@dimen/ui_qr_plate"
                android:layout_height="@dimen/ui_qr_plate"
                android:importantForAccessibility="no">

                <ImageView
                    android:id="@+id/qrImage"
                    android:layout_width="@dimen/ui_qr_module"
                    android:layout_height="@dimen/ui_qr_module"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ui_pass_qr_art" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_credential_pad"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/qrSerial"
                    style="@style/Widget.EventQR.Ui.Credential.Serial"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="R-000123" />

                <TextView
                    android:id="@+id/qrValidBadge"
                    style="@style/Widget.EventQR.Ui.StatusBadge.Valid"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/ui_badge_height"
                    android:text="@string/ui_credential_valid" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
