<?xml version="1.0" encoding="utf-8"?>
<!--
    SCANNER VIEWPORT (§5.13) - the camera is the only large dark surface in the app, and it is
    FLAT. No gradient, no glow, no translucent cards.

        48dp context field  one control: event name (title) over scan purpose (label), caret
        320x256dp panel    flat ui_scan_panel, radius 16
        240x240dp preview  1px ui_scan_frame + four 24dp brackets at 3dp, white 80%
        torch              48dp target, 20dp icon ink, in the guidance row below the panel
        guidance           one body_s line under the panel - no pill, no chip

    The preview is the bracket square: the camera view is centre-cropped inside scanPreview and the
    overhang is clipped there, so no preview pixel can land outside the brackets.

    Prerequisites the screen owns:
      * panel.contentDescription = "Camera preview. Point at the attendee's pass." (§9.5);
        brackets are importantForAccessibility=no
      * a decode failure is an inline 56dp strip (Widget.EventQR.Ui.Scan.StatusStrip,
        bg_ui_scan_strip) under the panel - NEVER a toast
      * brackets tint to ui_accent only while a decode is confirmed; that is the only lime here

    Permission off: the panel keeps its dark surface and states the block in place - lock glyph,
         one body_s line and the 52dp "Open settings" primary. The preview, torch and guidance
         row leave; manual entry stays usable, so the screen still has a way to check a pass.

    ids: scanRoot, scanContext, scanContextEvent, scanContextPurpose, scanContextCaret, scanPanel,
         scanPreview, scanBracketTl/Tr/Bl/Br, scanPermissionState, scanPermissionMessage,
         btnOpenCameraSettings, scanTorch, scanGuidance.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scanRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/ui_gutter"
    android:paddingEnd="@dimen/ui_gutter">

    <!-- Context field (§5.13): ONE control, not two labels. Event name over scan purpose, one
         caret. A tap opens the scan context sheet (event group, then purpose group).
         minHeight, never a fixed height, so title + label grow at fontScale 2.0 (§9.3, §9.6:17).
         ScannerActivity owns clickability, the caret's visibility and the combined description. -->
    <LinearLayout
        android:id="@+id/scanContext"
        style="@style/Widget.EventQR.Ui.Scan.Context"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/scanContextEvent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
                android:textColor="@color/ui_text_primary"
                tools:text="DevFest Manila 2026" />

            <TextView
                android:id="@+id/scanContextPurpose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Label"
                android:textColor="@color/ui_text_secondary"
                tools:text="Entry" />
        </LinearLayout>

        <ImageView
            android:id="@+id/scanContextCaret"
            style="@style/Widget.EventQR.Ui.Selector.Caret"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/space_8"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/scanPanel"
        style="@style/Widget.EventQR.Ui.Scan.Panel"
        android:layout_width="@dimen/ui_scan_panel_width"
        android:layout_height="@dimen/ui_scan_panel_height"
        android:layout_marginTop="@dimen/space_16"
        android:contentDescription="@string/ui_scan_panel_description">

        <FrameLayout
            android:id="@+id/scanPreview"
            android:layout_width="@dimen/ui_scan_preview"
            android:layout_height="@dimen/ui_scan_preview"
            android:layout_gravity="center"
            android:clipChildren="false">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ui_scan_frame"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/scanBracketTl"
                style="@style/Widget.EventQR.Ui.Scan.Bracket"
                android:layout_width="@dimen/ui_scan_bracket_arm"
                android:layout_height="@dimen/ui_scan_bracket_arm"
                android:layout_gravity="top|start"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/scanBracketTr"
                style="@style/Widget.EventQR.Ui.Scan.Bracket"
                android:layout_width="@dimen/ui_scan_bracket_arm"
                android:layout_height="@dimen/ui_scan_bracket_arm"
                android:layout_gravity="top|end"
                android:importantForAccessibility="no"
                android:scaleX="-1" />

            <ImageView
                android:id="@+id/scanBracketBl"
                style="@style/Widget.EventQR.Ui.Scan.Bracket"
                android:layout_width="@dimen/ui_scan_bracket_arm"
                android:layout_height="@dimen/ui_scan_bracket_arm"
                android:layout_gravity="bottom|start"
                android:importantForAccessibility="no"
                android:scaleY="-1" />

            <ImageView
                android:id="@+id/scanBracketBr"
                style="@style/Widget.EventQR.Ui.Scan.Bracket"
                android:layout_width="@dimen/ui_scan_bracket_arm"
                android:layout_height="@dimen/ui_scan_bracket_arm"
                android:layout_gravity="bottom|end"
                android:importantForAccessibility="no"
                android:scaleX="-1"
                android:scaleY="-1" />
        </FrameLayout>

        <!-- Camera permission off: same dark panel, no preview. ScannerActivity owns visibility:
             it hides the preview, torch and guidance row and clears scanPanel's description. -->
        <LinearLayout
            android:id="@+id/scanPermissionState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/ui_gutter"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ui_lock"
                android:tint="@color/ui_on_primary" />

            <TextView
                android:id="@+id/scanPermissionMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/ui_scan_permission_blocked"
                android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                android:textColor="@color/ui_on_primary" />

            <TextView
                android:id="@+id/btnOpenCameraSettings"
                style="@style/Widget.EventQR.Ui.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/scanner_camera_permission_open_settings" />
        </LinearLayout>

    </FrameLayout>

    <!-- Torch lives in the guidance row, 48dp at the row's end: a target inside the panel corner
         overlapped the 24dp bottom-right bracket, so it moved out of the bracket's zone. -->
    <LinearLayout
        android:id="@+id/scanGuidanceRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ui_touch_min"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/scanGuidance"
            style="@style/Widget.EventQR.Ui.Scan.Guidance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ui_scan_guidance" />

        <ImageButton
            android:id="@+id/scanTorch"
            style="@style/Widget.EventQR.Ui.Scan.Torch"
            android:layout_width="@dimen/ui_scan_torch"
            android:layout_height="@dimen/ui_scan_torch"
            android:layout_marginStart="@dimen/space_12"
            android:contentDescription="@string/ui_scan_torch" />
    </LinearLayout>

</LinearLayout>
