<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/skeletonLoading"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_lg"
    android:paddingTop="@dimen/space_18"
    android:paddingBottom="@dimen/space_xl"
    android:visibility="visible">

    <!-- Skeleton card 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_md"
        android:background="@drawable/bg_staff_skeleton_card">

        <View
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_staff_skeleton_date_block" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_md"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:background="@drawable/bg_staff_skeleton_bar" />

            <View
                android:layout_width="140dp"
                android:layout_height="10dp"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_staff_skeleton_bar" />

            <View
                android:layout_width="100dp"
                android:layout_height="10dp"
                android:layout_marginTop="@dimen/space_6"
                android:background="@drawable/bg_staff_skeleton_bar" />
        </LinearLayout>
    </LinearLayout>

    <!-- Skeleton card 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_md"
        android:background="@drawable/bg_staff_skeleton_card">

        <View
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_staff_skeleton_date_block" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_md"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:background="@drawable/bg_staff_skeleton_bar" />

            <View
                android:layout_width="130dp"
                android:layout_height="10dp"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_staff_skeleton_bar" />

            <View
                android:layout_width="80dp"
                android:layout_height="10dp"
                android:layout_marginTop="@dimen/space_6"
                android:background="@drawable/bg_staff_skeleton_bar" />
        </LinearLayout>
    </LinearLayout>

    <!-- Skeleton card 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_md"
        android:background="@drawable/bg_staff_skeleton_card">

        <View
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_staff_skeleton_date_block" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_md"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:background="@drawable/bg_staff_skeleton_bar" />

            <View
                android:layout_width="160dp"
                android:layout_height="10dp"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_staff_skeleton_bar" />

            <View
                android:layout_width="90dp"
                android:layout_height="10dp"
                android:layout_marginTop="@dimen/space_6"
                android:background="@drawable/bg_staff_skeleton_bar" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
