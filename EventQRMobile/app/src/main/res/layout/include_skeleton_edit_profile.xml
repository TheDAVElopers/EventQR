<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/skeletonLoading"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <View
        android:layout_width="120dp"
        android:layout_height="12dp"
        android:layout_marginBottom="@dimen/space_sm"
        android:background="@drawable/bg_skeleton_block" />

    <View
        android:layout_width="72dp"
        android:layout_height="12dp"
        android:layout_marginBottom="@dimen/space_xs"
        android:background="@drawable/bg_skeleton_block" />
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:layout_marginBottom="@dimen/space_sm"
        android:background="@drawable/bg_skeleton_block" />

    <View
        android:layout_width="64dp"
        android:layout_height="12dp"
        android:layout_marginBottom="@dimen/space_xs"
        android:background="@drawable/bg_skeleton_block" />
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:layout_marginBottom="@dimen/space_sm"
        android:background="@drawable/bg_skeleton_block" />

    <View
        android:layout_width="80dp"
        android:layout_height="12dp"
        android:layout_marginBottom="@dimen/space_xs"
        android:background="@drawable/bg_skeleton_block" />
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/input_height"
        android:background="@drawable/bg_skeleton_block" />

    <View
        android:layout_width="88dp"
        android:layout_height="12dp"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_sm"
        android:background="@drawable/bg_skeleton_block" />
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_xxl"
        android:background="@drawable/bg_skeleton_block" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_primary_height"
        android:layout_marginTop="@dimen/space_xl"
        android:background="@drawable/bg_skeleton_block" />
</LinearLayout>
