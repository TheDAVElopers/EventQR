<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/skeletonLoading"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- Section 1 Label Placeholder ("Personal Information") -->
    <View
        android:layout_width="160dp"
        android:layout_height="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_staff_skeleton_bar" />

    <!-- Personal Information Card Skeleton (1:1 with Real Form Card) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_staff_skeleton_card"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Input 1 Placeholder (Full Name: 56dp Outlined Box) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_staff_skeleton_bar" />

        <!-- Input 2 Placeholder (Email: 56dp Outlined Box) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_staff_skeleton_bar" />

        <!-- Input 3 Placeholder (Phone: 56dp Outlined Box) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_staff_skeleton_bar" />

        <!-- Phone Helper/Counter Text Placeholder -->
        <View
            android:layout_width="180dp"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_staff_skeleton_bar" />
    </LinearLayout>

    <!-- Section 2 Label Placeholder ("Security") -->
    <View
        android:layout_width="80dp"
        android:layout_height="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_staff_skeleton_bar" />

    <!-- Security Navigation Card Skeleton (56dp Row) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_staff_skeleton_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Icon Block Placeholder (36dp x 36dp) -->
        <View
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_staff_skeleton_date_block" />

        <!-- Row Title Placeholder ("Change Password") -->
        <View
            android:layout_width="130dp"
            android:layout_height="14dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_staff_skeleton_bar" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Chevron Placeholder -->
        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_staff_skeleton_bar" />
    </LinearLayout>

    <!-- Save Changes Button Placeholder (48dp Button) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_staff_skeleton_bar" />
</LinearLayout>
