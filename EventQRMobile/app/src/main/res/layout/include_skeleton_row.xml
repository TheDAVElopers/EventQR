<?xml version="1.0" encoding="utf-8"?>
<!--
    SKELETON ROW (§5.11) - the same geometry as list_row_icon: 72dp, 40dp circle, two bars
    (title 12dp, meta 12dp at 60% width). No divider, so a stack of them reads as one block.

    Reduced motion / TalkBack contract is on the container, as in include_skeleton_block.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ui_skeleton_row_height"
    android:gravity="center_vertical"
    android:importantForAccessibility="noHideDescendants"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ui_row_start"
    android:paddingEnd="@dimen/ui_row_end">

    <View
        android:layout_width="@dimen/ui_skeleton_avatar"
        android:layout_height="@dimen/ui_skeleton_avatar"
        android:background="@drawable/bg_ui_skeleton_circle"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_weight="1"
        android:orientation="vertical">

        <View
            android:layout_width="@dimen/ui_skeleton_title_width"
            android:layout_height="@dimen/ui_skeleton_bar_height"
            android:background="@drawable/bg_ui_skeleton"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="@dimen/ui_skeleton_meta_width"
            android:layout_height="@dimen/ui_skeleton_bar_height"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_ui_skeleton"
            android:importantForAccessibility="no" />
    </LinearLayout>
</LinearLayout>
