<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_10"
    android:background="@drawable/bg_admin_surface_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_14"
    android:paddingVertical="@dimen/space_md">

    <TextView
        android:id="@+id/textAccountAvatar"
        android:layout_width="@dimen/tile_42"
        android:layout_height="@dimen/tile_42"
        android:background="@drawable/bg_rounded_purple_soft"
        android:gravity="center"
        android:text="@string/placeholder_initial_a"
        android:textColor="@color/on_primary"
        android:textAppearance="@style/TextAppearance.EventQR.TitleMedium" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_md"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textAccountName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/item_admin_account_juan_dela_cruz"
            android:textAppearance="@style/TextAppearance.EventQR.TextBody.Strong" />

        <TextView
            android:id="@+id/textAccountEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/item_admin_account_juan_email_com"
            android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textAccountRoleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_admin_role_badge_purple"
            android:paddingHorizontal="@dimen/space_10"
            android:paddingVertical="@dimen/space_3"
            android:text="@string/common_attendee"
            android:textColor="@color/accent_dark"
            android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Strong" />

        <TextView
            android:id="@+id/textAccountStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_6"
            android:background="@drawable/bg_admin_status_active_badge"
            android:paddingHorizontal="@dimen/space_10"
            android:paddingVertical="@dimen/space_3"
            android:text="@string/common_active"
            android:textColor="@color/on_success_container"
            android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Strong" />

        <ImageView
            android:id="@+id/actionMenu"
            android:layout_width="@dimen/icon_lg"
            android:layout_height="@dimen/icon_lg"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/space_6"
            android:contentDescription="@string/item_admin_account_more_actions"
            android:padding="@dimen/space_xs"
            android:src="@drawable/ic_filter_list" />
    </LinearLayout>
</LinearLayout>
