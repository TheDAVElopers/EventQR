<?xml version="1.0" encoding="utf-8"?>
<!--
    ADMIN ACCOUNT ROW (§5.5 list-row language, §5.4 one badge).

        88dp row on the page - no per-row card, no shadow, 1dp hairline divider inset 76dp.
        40dp neutral tile with the account initial; name in `title`; email in `body_s`.
        ONE badge (account status) sits beside the name; the overflow button is the row's only
        trailing control, so the row never grows two competing affordances.

    Deleted: the role badge (role is not a state), `bg_admin_surface_card`, the 42dp violet
    avatar raster, `bg_admin_role_badge_*`, `bg_admin_status_*_badge` and the bare
    `ic_filter_list` glyph used as an overflow menu.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ui_row_height_tall"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_row_start"
        android:paddingTop="@dimen/ui_row_padding_vertical"
        android:paddingEnd="@dimen/ui_row_end"
        android:paddingBottom="@dimen/ui_row_padding_vertical">

        <TextView
            android:id="@+id/textAccountAvatar"
            android:layout_width="@dimen/ui_row_tile"
            android:layout_height="@dimen/ui_row_tile"
            android:background="@drawable/bg_ui_icon_tile"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
            android:textColor="@color/ui_primary"
            tools:text="J" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textAccountName"
                    style="@style/Widget.EventQR.Ui.ListRow.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Juan Dela Cruz" />

                <TextView
                    android:id="@+id/textAccountStatusBadge"
                    style="@style/Widget.EventQR.Ui.StatusBadge.Neutral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/ui_badge_height"
                    android:layout_marginStart="@dimen/space_8"
                    tools:text="Active" />
            </LinearLayout>

            <TextView
                android:id="@+id/textAccountEmail"
                style="@style/Widget.EventQR.Ui.ListRow.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="juan@example.com" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/actionMenu"
            style="@style/Widget.EventQR.Ui.Button.Icon"
            android:layout_width="@dimen/ui_touch_min"
            android:layout_height="@dimen/ui_touch_min"
            android:layout_marginStart="@dimen/space_4"
            android:contentDescription="@string/ui_admin_accounts_more"
            android:src="@drawable/ic_ui_more_horiz"
            android:tint="@color/ui_text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:layout_marginStart="@dimen/ui_divider_inset"
        android:background="@color/ui_hairline"
        android:importantForAccessibility="no" />
</LinearLayout>
