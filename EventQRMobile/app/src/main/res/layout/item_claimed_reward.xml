<?xml version="1.0" encoding="utf-8"?>
<!--
    Claimed reward row (§6.2) - no card, 88dp minimum and 112dp once the event name wraps: 40dp
    icon tile, reward name, event, date, the ONE trailing stack (the points spent in numeric_s over
    the status badge) and, for a rejected claim, the note after it. Above 1.3 fontScale that stack
    moves under the date, into trailingHostLarge, and the note stays last. Divider inset to the
    text edge.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/claimedRewardRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/claimedRewardRowContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ui_attendee_reward_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_row_start"
        android:paddingTop="@dimen/ui_row_padding_vertical"
        android:paddingEnd="@dimen/ui_row_end"
        android:paddingBottom="@dimen/ui_row_padding_vertical">

        <FrameLayout
            android:layout_width="@dimen/ui_row_tile"
            android:layout_height="@dimen/ui_row_tile"
            android:background="@drawable/bg_ui_icon_tile">

            <ImageView
                android:id="@+id/imgClaimedGift"
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_ui_redeem"
                android:tint="@color/ui_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtClaimedTitle"
                style="@style/Widget.EventQR.Ui.ListRow.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Event shirt" />

            <TextView
                android:id="@+id/txtClaimedEvent"
                style="@style/Widget.EventQR.Ui.ListRow.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                tools:text="DevFest Manila" />

            <TextView
                android:id="@+id/txtClaimedDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_text_secondary"
                tools:text="12 Oct 2026, 9:41 AM" />

            <!-- > 1.3 fontScale host (§4.6 reflow): the trailing value + badge move under the
                 date here, so they stop taking a third of the row from the title. It stays ahead
                 of the rejection note so the reflowed row reads date, amount, badge, then note. -->
            <LinearLayout
                android:id="@+id/trailingHostLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="end"
                android:orientation="horizontal"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtClaimedReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                android:textColor="@color/ui_error"
                android:visibility="gone"
                tools:text="Already claimed this reward" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/claimedTrailingStack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtClaimedPoints"
                style="@style/Widget.EventQR.Ui.ListRow.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="-120 pts" />

            <TextView
                android:id="@+id/txtClaimedStatus"
                style="@style/Widget.EventQR.Ui.StatusBadge.Success"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:minHeight="@dimen/ui_badge_height"
                tools:text="Approved" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/claimedRewardDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:layout_marginStart="@dimen/ui_divider_inset"
        android:background="@color/ui_hairline"
        android:importantForAccessibility="no" />
</LinearLayout>
