<?xml version="1.0" encoding="utf-8"?>
<!--
    REWARD ROW (§6.4 manage rewards, §5.3 card + §5.4 one badge).

        Hairline card: 44dp icon tile, name, cost in numeric_s, claimed line in micro,
        ONE status badge on the right, then the edit (secondary) and remove (destructive-outline)
        actions at 44dp. No gradient, no per-status drawable, no elevation.

    Ids mrw_reward_name / _points / _stock / _edit / _remove are unchanged.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.EventQR.Ui.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_8"
    android:orientation="vertical"
    android:padding="@dimen/ui_card_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="@dimen/ui_row_tile"
            android:layout_height="@dimen/ui_row_tile"
            android:background="@drawable/bg_ui_icon_tile"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/imgRewardIcon"
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_ui_redeem"
                android:tint="@color/ui_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/mrw_reward_name"
                style="@style/Widget.EventQR.Ui.ListRow.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Free shirt" />

            <TextView
                android:id="@+id/mrw_reward_points"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.EventQR.Type.NumericS"
                android:textColor="@color/ui_text_secondary"
                tools:text="1,250 pts" />

            <TextView
                android:id="@+id/mrw_reward_stock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_text_secondary"
                tools:text="3 of 10 claimed" />
        </LinearLayout>

        <TextView
            android:id="@+id/mrw_reward_badge"
            style="@style/Widget.EventQR.Ui.StatusBadge.Neutral"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ui_badge_height"
            android:layout_marginStart="@dimen/space_8"
            tools:text="Available" />
    </LinearLayout>

    <TextView
        android:id="@+id/mrw_reward_duplicate_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/manage_rewards_duplicate_claims_note"
        android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
        android:textColor="@color/ui_text_secondary"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:orientation="horizontal">

        <Button
            android:id="@+id/mrw_reward_edit"
            style="@style/Widget.EventQR.Ui.Button.Secondary.Inline"
            android:layout_width="0dp"
            android:layout_height="@dimen/ui_button_height_inline"
            android:layout_weight="1"
            android:text="@string/manage_rewards_edit" />

        <Button
            android:id="@+id/mrw_reward_remove"
            style="@style/Widget.EventQR.Ui.Button.Destructive.Inline"
            android:layout_width="0dp"
            android:layout_height="@dimen/ui_button_height_inline"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:text="@string/manage_rewards_remove" />
    </LinearLayout>
</LinearLayout>
