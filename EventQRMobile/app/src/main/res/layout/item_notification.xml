<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md">

    <LinearLayout
        android:id="@+id/layoutNotificationCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_notification_card_read"
        android:baselineAligned="false"
        android:elevation="@dimen/elevation_none"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_lg">

        <LinearLayout
            android:id="@+id/layoutNotificationIcon"
            android:layout_width="@dimen/tile_42"
            android:layout_height="@dimen/tile_42"
            android:layout_gravity="top"
            android:background="@drawable/bg_circle_success_container"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgNotificationIcon"
                android:layout_width="@dimen/icon_22"
                android:layout_height="@dimen/icon_22"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle_purple"
                app:tint="@color/success" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_14"
            android:layout_marginEnd="@dimen/space_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNotificationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EventQR.TextBody.Strong" />

            <TextView
                android:id="@+id/txtNotificationMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3"
                android:textColor="@color/text_body"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/icon_14"
                    android:layout_height="@dimen/icon_14"
                    android:layout_marginEnd="@dimen/space_xs"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/neutral_label" />

                <TextView
                    android:id="@+id/txtNotificationDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_label"
                    android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="end|top"
            android:orientation="vertical">

            <View
                android:id="@+id/viewUnreadDot"
                android:layout_width="@dimen/dot_sm"
                android:layout_height="@dimen/dot_sm"
                android:layout_marginTop="@dimen/space_xxs"
                android:layout_marginBottom="@dimen/space_lg"
                android:background="@drawable/bg_notification_unread_dot"
                android:visibility="gone" />

            <ImageView
                android:layout_width="@dimen/icon_sm"
                android:layout_height="@dimen/icon_sm"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/neutral_label" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
