<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    style="@style/Widget.EventQR.Card.Raised"
    app:cardUseCompatPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/list_item_tall_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_14"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_14">

        <TextView
            android:id="@+id/txtAttendeeInitial"
            android:layout_width="@dimen/icon_tile_lg"
            android:layout_height="@dimen/icon_tile_lg"
            android:background="@drawable/bg_circle_primary"
            android:gravity="center"
            android:text="@string/placeholder_initial_j"
            android:textColor="@color/on_primary"
            android:textAppearance="@style/TextAppearance.EventQR.TitleMedium" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_14"
            android:layout_marginEnd="@dimen/space_10"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtAttendeeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventQR.TextBody.Strong" />

            <TextView
                android:id="@+id/txtAttendeeEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />

            <TextView
                android:id="@+id/txtAttendeePoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:textColor="@color/primary"
                android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Strong" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtAttendeeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:minWidth="0dp"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_6"
            android:text="@string/common_registered"
            android:textColor="@color/primary"
            android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Strong" />

        <ImageView
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:layout_marginStart="@dimen/space_sm"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/neutral" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
