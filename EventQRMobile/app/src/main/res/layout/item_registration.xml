<?xml version="1.0" encoding="utf-8"?>
<!--
    Registration row (§5.3 Card, §5.5 row language). One hairline card per row is acceptable here
    because the row IS the selectable object in the staff attendee list; it carries the shared
    card style, a flat 40dp avatar tile, the ONE status badge and the points in numeric_s.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    style="@style/Widget.EventQR.Ui.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ui_row_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_card_padding"
        android:paddingTop="@dimen/ui_row_padding_vertical"
        android:paddingEnd="@dimen/ui_card_padding"
        android:paddingBottom="@dimen/ui_row_padding_vertical">

        <CheckBox
            android:id="@+id/chkRegistrationSelect"
            style="@style/Widget.EventQR.Ui.CheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_md"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/txtRegistrationAvatar"
            android:layout_width="@dimen/ui_row_tile"
            android:layout_height="@dimen/ui_row_tile"
            android:background="@drawable/bg_ui_icon_tile"
            android:gravity="center"
            android:text="@string/placeholder_initial_a"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
            android:textColor="@color/ui_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtRegistrationTitle"
                style="@style/Widget.EventQR.Ui.ListRow.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Juan Dela Cruz" />

            <TextView
                android:id="@+id/txtRegistrationDetails"
                style="@style/Widget.EventQR.Ui.ListRow.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                tools:text="juan@example.com" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtRegistrationStatus"
                style="@style/Widget.EventQR.Ui.StatusBadge.Neutral"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ui_badge_height"
                tools:text="Registered" />

            <TextView
                android:id="@+id/txtRegistrationPoints"
                style="@style/Widget.EventQR.Ui.ListRow.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:textColor="@color/ui_text_secondary"
                tools:text="10 pts" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
