<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_14"
    app:cardElevation="@dimen/elevation_raised">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_14"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_14">

        <CheckBox
            android:id="@+id/chkRegistrationSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_md"
            android:visibility="gone"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/txtRegistrationAvatar"
            android:layout_width="@dimen/tile_44"
            android:layout_height="@dimen/tile_44"
            android:background="@drawable/bg_profile_button"
            android:gravity="center"
            android:text="@string/placeholder_initial_a"
            android:textColor="@color/on_primary"
            android:textAppearance="@style/TextAppearance.EventQR.TitleLarge" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtRegistrationTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyLarge.Strong" />

            <TextView
                android:id="@+id/txtRegistrationDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtRegistrationStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_default"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="24dp"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingVertical="@dimen/space_5"
                android:textColor="@color/badge_default_text"
                android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Strong" />

            <TextView
                android:id="@+id/txtRegistrationPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/common_0_pts"
                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>