<?xml version="1.0" encoding="utf-8"?>
<!--
    Registration row (§6.3 amendment v1.13). A registration is a page row, not a card: 72dp
    `minHeight`, initials plate leading, title + meta, one trailing StatusBadge, hairline inset
    `ui_divider_inset`. The MaterialCardView wrapper is deleted - a card holding one row exists
    only to draw a border.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/registrationRowContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ui_row_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_row_start"
        android:paddingTop="@dimen/ui_row_padding_vertical"
        android:paddingEnd="@dimen/ui_row_end"
        android:paddingBottom="@dimen/ui_row_padding_vertical">

        <CheckBox
            android:id="@+id/chkRegistrationSelect"
            style="@style/Widget.EventQR.Ui.CheckBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_md"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/txtRegistrationAvatar"
            android:layout_width="@dimen/ui_row_tile"
            android:layout_height="@dimen/ui_row_tile"
            android:background="@drawable/bg_ui_icon_tile"
            android:gravity="center"
            android:text="@string/placeholder_initial_a"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
            android:textColor="@color/ui_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtRegistrationTitle"
                style="@style/Widget.EventQR.Ui.ListRow.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Juan Dela Cruz" />

            <TextView
                android:id="@+id/txtRegistrationDetails"
                style="@style/Widget.EventQR.Ui.ListRow.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                tools:text="juan@example.com" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtRegistrationStatus"
            style="@style/Widget.EventQR.Ui.StatusBadge.Neutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:minHeight="@dimen/ui_badge_height"
            tools:text="Registered" />
    </LinearLayout>

    <View
        android:id="@+id/registrationRowDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:layout_marginStart="@dimen/ui_divider_inset"
        android:background="@color/ui_hairline"
        android:importantForAccessibility="no" />
</LinearLayout>
