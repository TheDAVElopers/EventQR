<?xml version="1.0" encoding="utf-8"?>
<!--
    REPORT CHART (§6.4): one hairline card with a title, a count pill, a subtitle, the chart host
    and the legend host. Chart shapes are drawn by the two View classes; nothing about this
    container is built in Kotlin any more.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.EventQR.Ui.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_8"
    android:orientation="vertical"
    android:padding="@dimen/ui_card_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtChartTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
            tools:text="Checked in" />

        <TextView
            android:id="@+id/txtChartTotal"
            style="@style/Widget.EventQR.Ui.StatusBadge.Info"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/ui_badge_height"
            android:layout_marginStart="@dimen/space_8"
            tools:text="24 total" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtChartSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
        android:textColor="@color/ui_text_secondary"
        tools:text="Distribution of attendance status" />

    <FrameLayout
        android:id="@+id/chartHost"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12" />

    <LinearLayout
        android:id="@+id/chartLegend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
