<?xml version="1.0" encoding="utf-8"?>
<!--
    REPORT TABLE (§6.4): hairline card, title + count, a column header row, hairline, rows.

    Header cells and row cells are created in Kotlin because the column set is data-driven; they
    use only `Widget.EventQR.Ui.*` text styles and get their colours from `ui_*` roles.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bg_ui_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_8"
    android:orientation="vertical"
    android:padding="@dimen/ui_card_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/report_preview_detailed_records"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Title" />

        <TextView
            android:id="@+id/txtTableCount"
            style="@style/Widget.EventQR.Ui.StatusBadge.Neutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_badge_height"
            android:layout_marginStart="@dimen/space_8"
            tools:text="24 records" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tableHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:background="@color/ui_hairline"
        android:importantForAccessibility="no" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tableRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never" />
</LinearLayout>
