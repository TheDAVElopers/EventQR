<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - SEARCH RESULT ROW (5.5 list_row_icon geometry).

        72dp, 40dp initials avatar, name 18/600, email 14/20 secondary, one status badge,
        hairline divider inset 76dp. No per-row card and no GradientDrawable pill.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/searchAttendeeRowContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ui_organizer_attendee_row_height"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_row_start"
        android:paddingEnd="@dimen/ui_row_end"
        android:paddingTop="@dimen/ui_row_padding_vertical"
        android:paddingBottom="@dimen/ui_row_padding_vertical">

        <TextView
            android:id="@+id/txtSearchAttendeeInitial"
            android:layout_width="@dimen/ui_row_tile"
            android:layout_height="@dimen/ui_row_tile"
            android:background="@drawable/bg_ui_icon_tile"
            android:gravity="center"
            android:textColor="@color/ui_primary"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
            tools:text="JD" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtSearchAttendeeName"
                style="@style/Widget.EventQR.Ui.ListRow.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Juan Dela Cruz" />

            <TextView
                android:id="@+id/txtSearchAttendeeEmail"
                style="@style/Widget.EventQR.Ui.ListRow.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:maxLines="1"
                tools:text="juan@example.com" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtSearchAttendeeStatus"
            style="@style/Widget.EventQR.Ui.StatusBadge.Neutral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_badge_height"
            android:layout_marginStart="@dimen/space_8"
            tools:text="Checked in" />
    </LinearLayout>

    <View
        android:id="@+id/searchAttendeeDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:layout_marginStart="@dimen/ui_divider_inset"
        android:background="@color/ui_hairline"
        android:importantForAccessibility="no" />
</LinearLayout>
