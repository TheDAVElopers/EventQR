<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md"
    style="@style/Widget.EventQR.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/list_item_min_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_lg"
        android:paddingVertical="@dimen/space_md">

        <FrameLayout
            android:layout_width="@dimen/tile_44"
            android:layout_height="@dimen/tile_44"
            android:layout_marginEnd="@dimen/space_md"
            style="@style/Widget.EventQR.IconTile.Secondary">

            <ImageView
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_profile_person"
                app:tint="@color/primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtSearchAttendeeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.EventQR.TextBody.Strong" />

            <TextView
                android:id="@+id/txtSearchAttendeeEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_label"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtSearchAttendeeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_6"
            android:textColor="@color/success_dark"
            android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Strong" />

        <ImageView
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:layout_marginStart="@dimen/space_6"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/neutral" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
