<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSearchUser"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_sm"
    android:foreground="?attr/selectableItemBackground"
    style="@style/Widget.EventQR.Card.Raised"
    app:strokeColor="@color/transparent"
    app:strokeWidth="@dimen/stroke_none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/list_item_min_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_14"
        android:paddingVertical="@dimen/space_md">

        <TextView
            android:id="@+id/txtUserAvatarInitial"
            android:layout_width="@dimen/tile_44"
            android:layout_height="@dimen/tile_44"
            android:background="@drawable/bg_staff_avatar_square"
            android:gravity="center"
            android:text="@string/placeholder_initial_r"
            android:textColor="@color/on_primary"
            android:textAppearance="@style/TextAppearance.EventQR.TitleMedium" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtSearchUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium.Strong" />

            <TextView
                android:id="@+id/txtSearchUserEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />
        </LinearLayout>

        <ImageView
            android:id="@+id/imgSelectedCheck"
            android:layout_width="@dimen/icon_22"
            android:layout_height="@dimen/icon_22"
            android:src="@drawable/ic_check_circle_purple"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
