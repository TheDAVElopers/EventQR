<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - SEARCH USER ROW (5.5).

        72dp, 40dp initials plate, name, email in 14/20 secondary. Selection is the fill
        (@color/ui_row_selectable) plus one "Selected" badge in the valid tone (5.4).
        No card stroke, no check icon alone, no adapter-set background colour.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/userRowContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ui_row_selectable"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ui_row_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_row_start"
        android:paddingTop="@dimen/ui_row_padding_vertical"
        android:paddingEnd="@dimen/ui_row_end"
        android:paddingBottom="@dimen/ui_row_padding_vertical">

        <TextView
            android:id="@+id/txtUserAvatarInitial"
            android:layout_width="@dimen/ui_row_tile"
            android:layout_height="@dimen/ui_row_tile"
            android:background="@drawable/bg_ui_icon_tile"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
            android:textColor="@color/ui_primary"
            tools:text="R" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtSearchUserName"
                style="@style/Widget.EventQR.Ui.ListRow.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Rina Cruz" />

            <TextView
                android:id="@+id/txtSearchUserEmail"
                style="@style/Widget.EventQR.Ui.ListRow.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:maxLines="1"
                tools:text="rina@example.com" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtUserSelected"
            style="@style/Widget.EventQR.Ui.StatusBadge.Valid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_8"
            android:minHeight="@dimen/ui_badge_height"
            android:text="@string/ui_organizer_selected"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/userRowDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:layout_marginStart="@dimen/ui_divider_inset"
        android:background="@color/ui_hairline"
        android:importantForAccessibility="no" />
</LinearLayout>
