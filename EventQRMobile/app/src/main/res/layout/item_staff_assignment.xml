<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_10"
    android:foreground="?attr/selectableItemBackground"
    style="@style/Widget.EventQR.Card.Raised"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/list_item_min_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_14"
        android:paddingVertical="@dimen/space_md">

        <TextView
            android:id="@+id/txtStaffAvatarInitial"
            android:layout_width="@dimen/tile_44"
            android:layout_height="@dimen/tile_44"
            android:background="@drawable/bg_staff_avatar_square"
            android:gravity="center"
            android:text="@string/placeholder_initial_a"
            android:textColor="@color/on_primary"
            android:textAppearance="@style/TextAppearance.EventQR.TitleMedium" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtStaffName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyMedium.Strong" />

            <TextView
                android:id="@+id/txtStaffEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />

            <TextView
                android:id="@+id/txtStaffPermissions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textColor="@color/text_body"
                android:textAppearance="@style/TextAppearance.EventQR.TextCaption" />

            <TextView
                android:id="@+id/txtEditStaffPermissions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/control_height_32"
                android:text="@string/staff_edit_permissions"
                android:textColor="@color/primary"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact.Strong" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtRemoveStaff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="@dimen/space_6"
            android:text="@string/staff_remove"
            android:textColor="@color/danger"
            android:textAppearance="@style/TextAppearance.EventQR.TextBody" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
