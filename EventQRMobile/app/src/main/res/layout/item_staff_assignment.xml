<?xml version="1.0" encoding="utf-8"?>
<!--
    ORGANIZER - STAFF ROW (5.5).

        72dp minimum, 40dp initials plate, name, permission summary in 14/20 secondary, and exactly
        ONE trailing element: a 48dp borderless overflow button. Hairline divider inset 76dp.
        No card per row, no shadow, no pill avatar, never two trailing actions.

    The row is not clickable: the destructive action lives behind the menu, so it is never one tap
    away from a row press.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ui_row_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_row_start"
        android:paddingTop="@dimen/ui_row_padding_vertical"
        android:paddingEnd="@dimen/ui_row_end"
        android:paddingBottom="@dimen/ui_row_padding_vertical">

        <TextView
            android:id="@+id/txtStaffAvatarInitial"
            android:layout_width="@dimen/ui_row_tile"
            android:layout_height="@dimen/ui_row_tile"
            android:background="@drawable/bg_ui_icon_tile"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textAppearance="@style/TextAppearance.EventQR.Type.Title"
            android:textColor="@color/ui_primary"
            tools:text="A" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtStaffName"
                style="@style/Widget.EventQR.Ui.ListRow.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Ana Reyes" />

            <TextView
                android:id="@+id/txtStaffPermissions"
                style="@style/Widget.EventQR.Ui.ListRow.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                tools:text="Scan, Print IDs" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnStaffRowActions"
            android:layout_width="@dimen/ui_touch_min"
            android:layout_height="@dimen/ui_touch_min"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/space_12"
            android:scaleType="centerInside"
            android:src="@drawable/ic_ui_more_horiz"
            android:tint="@color/ui_text_primary"
            tools:contentDescription="Actions for Ana Reyes" />
    </LinearLayout>

    <View
        android:id="@+id/staffRowDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:layout_marginStart="@dimen/ui_divider_inset"
        android:background="@color/ui_hairline"
        android:importantForAccessibility="no" />
</LinearLayout>
