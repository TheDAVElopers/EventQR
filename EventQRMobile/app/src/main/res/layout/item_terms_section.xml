<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.EventQR.Card.Compact.Flat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <LinearLayout
            android:id="@+id/layoutTermsTitleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTermsNumber"
                style="@style/TextAppearance.EventQR.TermsBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_terms_number"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:minWidth="28dp"
                android:minHeight="28dp"
                android:padding="@dimen/space_xs" />

            <TextView
                android:id="@+id/txtTermsSectionTitle"
                style="@style/TextAppearance.EventQR.TermsSectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:lineSpacingMultiplier="@dimen/line_multiplier_11" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtTermsSectionBody"
            style="@style/TextAppearance.EventQR.TextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_40"
            android:layout_marginTop="@dimen/space_10"
            android:lineSpacingMultiplier="@dimen/line_multiplier_13"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
