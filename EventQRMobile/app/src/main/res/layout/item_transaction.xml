<?xml version="1.0" encoding="utf-8"?>
<!--
    TRANSACTION ROW (§5.5) - the attendee transaction history row, also handed to the scanner's
    (hidden) results list.

    The host supplies the 20dp gutter on this one (activity_user_transaction_history pads its
    list), so the row starts at x = 0 and the divider is inset 56dp (40 tile + 16 gap) - which
    lands on the same 76dp absolute text edge as the staff rows.

        40dp primary_container tile + 20dp icon
        title / meta / micro
        trailing numeric_s points (semantic colour only when negative)

    Deleted: the CardView wrapper, the elevation, the green "Success" pill and the tinted
    per-type icon backgrounds.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ui_row_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/radius_none"
        android:paddingTop="@dimen/ui_row_padding_vertical"
        android:paddingEnd="@dimen/ui_row_end"
        android:paddingBottom="@dimen/ui_row_padding_vertical">

        <FrameLayout
            android:id="@+id/layoutTransactionIcon"
            android:layout_width="@dimen/ui_row_tile"
            android:layout_height="@dimen/ui_row_tile"
            android:background="@drawable/bg_ui_icon_tile"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/imgTransactionTrend"
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_ui_qr_code_2"
                android:tint="@color/ui_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTransactionTitle"
                style="@style/Widget.EventQR.Ui.ListRow.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Event entry" />

            <TextView
                android:id="@+id/txtTransactionEvent"
                style="@style/Widget.EventQR.Ui.ListRow.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                tools:text="Northgate Design Week" />

            <TextView
                android:id="@+id/txtTransactionTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_text_secondary"
                tools:text="12 Oct 2026, 9:41 AM" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtTransactionPoints"
            style="@style/Widget.EventQR.Ui.ListRow.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            tools:text="+10 pts" />
    </LinearLayout>

    <View
        style="@style/Widget.EventQR.Ui.ListRow.Divider"
        android:layout_marginStart="@dimen/ui_staff_divider_inset_compact" />
</LinearLayout>
