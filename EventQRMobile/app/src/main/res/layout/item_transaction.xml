<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_10"
    app:cardCornerRadius="@dimen/radius_14"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_14">

        <FrameLayout
            android:id="@+id/layoutTransactionIcon"
            android:layout_width="@dimen/tile_42"
            android:layout_height="@dimen/tile_42"
            android:background="@drawable/bg_circle_success_container">

            <ImageView
                android:id="@+id/imgTransactionTrend"
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:layout_gravity="center"
                android:src="@drawable/ic_trend_up" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTransactionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EventQR.TextBody.Strong" />

            <TextView
                android:id="@+id/txtTransactionEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textColor="@color/text_hint"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />

            <TextView
                android:id="@+id/txtTransactionTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xxs"
                android:textColor="@color/text_hint"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyCompact" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTransactionPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/success_dark"
                android:textAppearance="@style/TextAppearance.EventQR.TextBodyLarge.Strong" />

            <TextView
                android:id="@+id/txtTransactionTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_green_pill"
                android:paddingHorizontal="@dimen/space_10"
                android:paddingVertical="@dimen/space_xs"
                android:text="@string/common_success"
                android:textColor="@color/on_success_container"
                android:textAppearance="@style/TextAppearance.EventQR.TextCaption.Strong" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
