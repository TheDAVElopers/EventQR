<?xml version="1.0" encoding="utf-8"?>
<!--
    TRANSACTION LOG ROW (§5.5) - replaces the raised per-row card.

        40dp primary_container tile + 20dp icon
        title  18/600  attendee name
        meta   14/20   transaction type
        micro  relative time (tap = exact time, the one disclosure on the row)
        trail  numeric_s points, right aligned - one trailing element, never a badge too
        1dp hairline inset 76dp so it aligns to the text edge, not the icon

    Used by the staff dashboard, transaction logs, attendee details and the attendee history.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/listRowContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="@dimen/ui_row_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_row_start"
        android:paddingTop="@dimen/ui_row_padding_vertical"
        android:paddingEnd="@dimen/ui_row_end"
        android:paddingBottom="@dimen/ui_row_padding_vertical">

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="@dimen/ui_row_tile"
            android:layout_height="@dimen/ui_row_tile"
            android:background="@drawable/bg_ui_icon_tile"
            android:importantForAccessibility="no">

            <ImageView
                android:id="@+id/imgTypeIcon"
                android:layout_width="@dimen/icon_md"
                android:layout_height="@dimen/icon_md"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_ui_qr_code_2"
                android:tint="@color/ui_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtAttendeeName"
                style="@style/Widget.EventQR.Ui.ListRow.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Ines Marchetti" />

            <TextView
                android:id="@+id/txtTransactionType"
                style="@style/Widget.EventQR.Ui.ListRow.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                tools:text="Event entry" />

            <TextView
                android:id="@+id/txtRelativeTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_text_secondary"
                tools:text="5m ago" />

            <TextView
                android:id="@+id/txtExactTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Micro"
                android:textColor="@color/ui_text_secondary"
                android:visibility="gone"
                tools:text="10 Sep 2026, 2:30 PM" />

            <TextView
                android:id="@+id/txtReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.EventQR.Type.BodySmall"
                android:textColor="@color/ui_error"
                android:visibility="gone"
                tools:text="Already checked in" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtPointsBadge"
            style="@style/Widget.EventQR.Ui.ListRow.Value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            tools:text="+10 pts" />
    </LinearLayout>

    <View
        android:id="@+id/listRowDivider"
        style="@style/Widget.EventQR.Ui.ListRow.Divider" />
</LinearLayout>
