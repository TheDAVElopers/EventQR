<?xml version="1.0" encoding="utf-8"?>
<!--
    LIST ROW - date (§5.5). 96dp. The primary object row: a 44dp-min date block (day numeric_m over
    month overline, surface_sunken, 10dp radius; grows at large font scales so neither line clips),
    title + meta, one badge on the right.

    Replaces the per-card "coloured date badge + badge + progress bar" stack: the date block is
    neutral here, because colour is meaning and a date has none.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/listRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/listRowContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ui_row_height_date"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_row_start"
        android:paddingEnd="@dimen/ui_row_end"
        android:paddingTop="@dimen/ui_row_padding_vertical"
        android:paddingBottom="@dimen/ui_row_padding_vertical">

        <LinearLayout
            android:id="@+id/listRowDateBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/ui_row_date_block"
            android:minHeight="@dimen/ui_row_date_block"
            android:background="@drawable/bg_ui_date_block"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="@dimen/space_2"
            android:paddingEnd="@dimen/space_2">

            <TextView
                android:id="@+id/listRowDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EventQR.Type.NumericM"
                android:textColor="@color/ui_text_primary"
                tools:text="12" />

            <TextView
                android:id="@+id/listRowMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.EventQR.Type.Overline"
                android:textColor="@color/ui_text_secondary"
                tools:text="Oct" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_lg"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Two lines so a real event name fits beside the badge at 360dp; maxLines keeps a
                 long title from growing the row without bound (§5.5 amendment). -->
            <TextView
                android:id="@+id/listRowTitle"
                style="@style/Widget.EventQR.Ui.ListRow.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                tools:text="DevFest Manila 2026" />

            <TextView
                android:id="@+id/listRowMeta"
                style="@style/Widget.EventQR.Ui.ListRow.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                tools:text="9:00 AM - PICC, Pasay" />
        </LinearLayout>

        <!-- wrap_content + minHeight, never a fixed height: an 11sp label at fontScale 2.0
             grows the badge instead of clipping (§5.4). -->
        <TextView
            android:id="@+id/listRowBadge"
            style="@style/Widget.EventQR.Ui.StatusBadge.Info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:minHeight="@dimen/ui_badge_height"
            tools:text="Upcoming" />
    </LinearLayout>

    <View
        android:id="@+id/listRowDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/stroke_hairline"
        android:layout_marginStart="@dimen/ui_divider_inset"
        android:background="@color/ui_hairline"
        android:importantForAccessibility="no" />

</LinearLayout>
