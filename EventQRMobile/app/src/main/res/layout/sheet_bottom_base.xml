<?xml version="1.0" encoding="utf-8"?>
<!--
    BOTTOM SHEET BASE (§5.12). 16dp top radius, ui_surface, drag handle 32x4 at 8dp, title_l at
    the 20dp gutter, a content slot and an action stack (primary 52dp then ghost 48dp).

    Host it in a BottomSheetDialogFragment / BottomSheetDialog; the sheet window owns the 8dp
    elevation, the scrim (@color/ui_scrim) and the 90% max height. Nothing here casts.

    ids: sheetRoot, sheetHandle, sheetTitle, sheetContent, sheetActions, sheetPrimaryAction,
         sheetSecondaryAction.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sheetRoot"
    style="@style/Widget.EventQR.Ui.Sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:id="@+id/sheetHandle"
        style="@style/Widget.EventQR.Ui.Sheet.Handle"
        android:layout_width="@dimen/ui_sheet_handle_width"
        android:layout_height="@dimen/ui_sheet_handle_height" />

    <TextView
        android:id="@+id/sheetTitle"
        style="@style/Widget.EventQR.Ui.Sheet.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="Filter events" />

    <!-- Content slot: fields, chips, rows. Already inside the 20dp gutter via the title; this
         slot adds its own gutter so callers only lay out their content. -->
    <FrameLayout
        android:id="@+id/sheetContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingEnd="@dimen/ui_gutter"
        android:paddingTop="@dimen/space_lg" />

    <LinearLayout
        android:id="@+id/sheetActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ui_gutter"
        android:paddingEnd="@dimen/ui_gutter"
        android:paddingTop="@dimen/space_lg">

        <Button
            android:id="@+id/sheetPrimaryAction"
            style="@style/Widget.EventQR.Ui.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/ui_button_height"
            tools:text="Apply" />

        <Button
            android:id="@+id/sheetSecondaryAction"
            style="@style/Widget.EventQR.Ui.Button.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:minHeight="@dimen/ui_button_height_inline"
            tools:text="Reset" />
    </LinearLayout>

</LinearLayout>
