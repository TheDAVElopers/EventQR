<?xml version="1.0" encoding="utf-8"?>
<!--
    Date filter, content slot of `sheet_bottom_base` (§6.2 Discover amendment).

        mode chips        Any date / Month / Exact day, three equal widths in a 48dp row
        month + year      a 3x4 month grid and a scrolling year row, 48dp touch targets whose
                          inset fill keeps the chip at its 36dp visual height (§9.2)
        exact day         a secondary inline button that opens the platform DatePickerDialog

    Nothing here commits: the sheet's Apply is the only write, Reset only rewinds the draft, and
    a dismiss throws the draft away. Pickers default to GONE and the sheet toggles them by mode.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/ui_touch_min"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipModeAny"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_chip_inset"
                android:minHeight="@dimen/ui_touch_min"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:text="@string/ui_attendee_filter_any_date" />

            <TextView
                android:id="@+id/chipModeMonth"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_chip_inset"
                android:minHeight="@dimen/ui_touch_min"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:text="@string/ui_attendee_month" />

            <TextView
                android:id="@+id/chipModeDay"
                style="@style/Widget.EventQR.Ui.Chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_chip_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_ui_chip_inset"
                android:minHeight="@dimen/ui_touch_min"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:text="@string/ui_attendee_filter_exact_day" />
        </LinearLayout>

        <TextView
            android:id="@+id/lblMonth"
            style="@style/Widget.EventQR.Ui.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/ui_attendee_month"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/monthChipGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lblYear"
            style="@style/Widget.EventQR.Ui.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/ui_attendee_year"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/yearScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:clipToPadding="false"
            android:minHeight="@dimen/ui_touch_min"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/yearChipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/ui_touch_min"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/lblDay"
            style="@style/Widget.EventQR.Ui.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:labelFor="@id/btnPickDay"
            android:text="@string/ui_attendee_date"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnPickDay"
            style="@style/Widget.EventQR.Ui.Button.Secondary.Inline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:minHeight="@dimen/ui_button_height_inline"
            android:text="@string/ui_attendee_filter_pick_day"
            android:visibility="gone" />
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
