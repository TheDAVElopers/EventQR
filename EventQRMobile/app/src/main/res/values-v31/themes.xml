<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Starting theme for Android 12+ (API 31+): flat indigo with the mark alone. The system splash is
        icon-only - it cannot render the wordmark, so it shows the same 96dp mark the in-app splash and the
        launcher do (04-logo-direction.md §4). The icon is sized inside the 288dp canvas so its corners clear
        the system's circular mask. No animation duration, so the splash is dismissed as soon as
        LandingActivity draws.
    -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_logo</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="windowSplashScreenBackground">@color/primary</item>
        <item name="postSplashScreenTheme">@style/Theme.EventQR</item>
    </style>

</resources>
