<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Starting theme for Android 12+ (API 31+): solid indigo with the full wordmark from the first frame.
        The icon (splash_icon_logo) is sized to fit inside the system's circular mask. No animation duration, so
        the splash is dismissed as soon as LandingActivity draws.
    -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_logo</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="windowSplashScreenBackground">@color/eventqr_indigo</item>
        <item name="postSplashScreenTheme">@style/Theme.EventQR</item>
    </style>

</resources>
