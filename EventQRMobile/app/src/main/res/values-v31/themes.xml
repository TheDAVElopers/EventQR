<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Starting theme for Android 12+ (API 31+).

        The OS always draws a system splash before the first frame, and its background can only be one
        opaque solid color (no gradient). We do not want users to see it, only the branded splash
        (activity_splash_modern.xml: gradient + logo with the EventQR wordmark). So the icon is
        intentionally empty and the background is the gradient's center color (eventqr_indigo), which
        makes the system splash read as a plain purple screen that LandingActivity then replaces
        immediately (it also skips the system fade-out). postSplashScreenTheme restores the normal app theme.
    -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_empty</item>
        <item name="windowSplashScreenBackground">@color/eventqr_indigo</item>
        <item name="postSplashScreenTheme">@style/Theme.EventQR</item>
    </style>

</resources>
