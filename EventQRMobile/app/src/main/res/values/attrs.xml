<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- EventQrDetailHeader / EventQrTabHeader (ui/components/EventQrHeaders.kt) -->
    <declare-styleable name="EventQrHeader">
        <attr name="title" format="string" />
        <attr name="subtitle" format="string" />
        <attr name="showBack" format="boolean" />
    </declare-styleable>

    <!-- EventQrEmptyState (ui/components/EventQrEmptyState.kt) -->
    <declare-styleable name="EventQrEmptyState">
        <attr name="icon" format="reference" />
        <attr name="title" />
        <attr name="subtitle" />
        <!-- true (default): this block applies the 20dp screen gutter itself.
             false: the host container already applies it, so the block sits flush inside it. -->
        <attr name="gutter" format="boolean" />
    </declare-styleable>
</resources>
