    <!-- The wordmark is a lockup, not content text: it is sized in sp from its cap height (Archivo cap
         = 0.68 em) so it steps down with the user's font size, and capped by the compact rule in
         core/util/Wordmark.kt instead of clipping. Values live in dimens_ui_shared.xml. -->

    <!-- Perforation dash pattern. -->
    <dimen name="ui_dash_width">6dp</dimen>
    <dimen name="ui_dash_gap">4dp</dimen>

    <!-- Type: leading. IBM Plex's default leading (1.30em) is too loose for row rhythm and
         Archivo's (1.09em) too tight; these are the extras that land on the plan's line
         heights, measured off the bundled hhea metrics. Declared in sp so they scale with
         the user's font size instead of collapsing at fontScale 2.0. -->
    <dimen name="ui_leading_none">0sp</dimen>
    <dimen name="ui_leading_half">0.5sp</dimen>
    <dimen name="ui_leading_1">1sp</dimen>
    <dimen name="ui_leading_2">2sp</dimen>
    <dimen name="ui_leading_2_5">2.5sp</dimen>
    <dimen name="ui_leading_3">3sp</dimen>
    <dimen name="ui_leading_3_5">3.5sp</dimen>

