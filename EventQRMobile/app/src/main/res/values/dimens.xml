    <!--  V2 TOKENS  -  EventQR visual redesign (§4 of MyFiles/EventQR-Redesign-Plan).-->
    <!--  Additive: the legacy space_*/radius_*/type_* scales above stay for the       -->
    <!--  screens that are not migrated yet. ui_* is the vocabulary the redesigned     -->
    <!--  screens use; Phase 6 folds the two together.                                 -->
    <!-- ═══════════════════════════════════════════════════════════════════════════ -->

    <!-- Spacing: 4dp grid, closed 11-value scale (aliases repointed, §4.2) -->
    <dimen name="space_64">64dp</dimen>

    <!-- Edges: exactly two per screen (§4.5) -->
    <dimen name="ui_gutter">20dp</dimen>          <!-- screen-level text and card outer edge -->

    <!-- Radius: three values plus full (§4.3). Buttons sharper than cards, on purpose. -->
    <dimen name="ui_radius_button">4dp</dimen>    <!-- buttons, inputs, chips, checkbox -->
    <dimen name="ui_radius_card">10dp</dimen>     <!-- cards, list rows, icon tiles -->
    <dimen name="ui_radius_sheet">16dp</dimen>    <!-- sheets, dialogs, credential -->
    <dimen name="ui_radius_badge">999dp</dimen>   <!-- status badges, dots -->

    <!-- Elevation: hairline only. Nothing on these screens floats. -->
    <dimen name="ui_elevation_none">0dp</dimen>

    <!-- Controls (§5.1, §5.2) -->
    <dimen name="ui_control_height">56dp</dimen>        <!-- filled field -->
