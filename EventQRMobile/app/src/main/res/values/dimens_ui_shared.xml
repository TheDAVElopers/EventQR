    <dimen name="ui_notch_positive_offset">12dp</dimen>

    <!-- ═════════ Type: line heights (sp), the plan's §3.5 table ═════════ -->
    <dimen name="ui_lh_display_xl">52sp</dimen>
    <dimen name="ui_lh_display_m">38sp</dimen>
    <dimen name="ui_lh_headline">34sp</dimen>
    <dimen name="ui_lh_title_l">26sp</dimen>
