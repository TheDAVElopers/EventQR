    <item name="ui_track_micro" format="float" type="dimen">0</item>
    <item name="ui_track_numeric_l" format="float" type="dimen">-0.02</item>
    <item name="ui_track_numeric_m" format="float" type="dimen">0</item>
    <item name="ui_track_numeric_s" format="float" type="dimen">0</item>
