    <item name="ui_track_display_xl" format="float" type="dimen">-0.03</item>
    <item name="ui_track_display_m" format="float" type="dimen">-0.02</item>
    <item name="ui_track_headline" format="float" type="dimen">-0.015</item>
    <item name="ui_track_title_l" format="float" type="dimen">-0.01</item>
    <item name="ui_track_title" format="float" type="dimen">0</item>
    <item name="ui_track_body" format="float" type="dimen">0</item>
