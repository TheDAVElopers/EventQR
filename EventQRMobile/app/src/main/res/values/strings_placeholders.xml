<?xml version="1.0" encoding="utf-8"?>
<!--
    Non-translatable placeholder / glyph / separator strings that used to be literals in layouts.
    Layouts must reference these (android:text="@string/placeholder_zero") instead of hard-coding the value.
    Whitespace that is part of the value is protected with quotes.
-->
<resources>
    <!-- Initial numeric / empty-value placeholders shown before data loads -->
    <string name="placeholder_zero" translatable="false">0</string>
    <string name="counter_zero_of_ten" translatable="false">0/10</string>

    <!-- Glyphs and separators -->

    <!-- Phone / capacity input examples -->
    <string name="phone_prefix" translatable="false">+63</string>
    <string name="phone_hint_digits" translatable="false">9123456789</string>
    <string name="phone_hint_example" translatable="false">9XX XXX XXXX</string>
    <string name="capacity_hint" translatable="false">100</string>

    <!-- Avatar initials shown before the row is bound (RecyclerView items overwrite them in code) -->
    <string name="placeholder_initial_a" translatable="false">A</string>
</resources>

