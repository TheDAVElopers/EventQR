<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        App theme. Colour roles (colors.xml) are wired into the Material attributes here so stock widgets pick the
        brand up automatically. Light only. materialButtonStyle / chipStyle are intentionally NOT set globally:
        layouts opt in with style="@style/Widget.EventQR.Button.Primary" / Widget.EventQR.Chip.Filter etc.
        (see styles_components.xml). Type scale lives in styles_text.xml.
    -->
    <style name="Theme.EventQR" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <item name="android:windowAnimationStyle">@style/NoAnimation</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Brand. colorSecondary is the BRAND colour on purpose: Material CheckBox / RadioButton / Switch checked tints and
             other stock widgets read it, and they must follow p_brand. Gradients that need the violet reference @color/secondary directly. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryVariant">@color/primary_dark</item>
        <item name="colorOnSecondary">@color/on_primary</item>

        <!-- Surfaces -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_primary</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textColorLink">@color/text_link</item>

        <!-- Controls -->
        <item name="colorControlActivated">@color/primary</item>
        <item name="colorControlHighlight">@color/primary_ripple</item>

        <!-- Shared component defaults (all existing cards / text-input layouts set their own attributes explicitly) -->
        <item name="materialCardViewStyle">@style/Widget.EventQR.Card</item>
        <item name="textInputStyle">@style/Widget.EventQR.TextInputLayout</item>
    </style>

    <style name="NoAnimation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.EventQR">
        <!-- Legacy starting theme (API < 31): solid brand colour + centered logo, matching the Android 12+ splash. -->
        <item name="android:windowBackground">@drawable/bg_splash_legacy</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

</resources>
