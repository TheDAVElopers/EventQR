<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 11 and lower (Android 12+ reads data_extraction_rules.xml). allowBackup is
    false, but session tokens and encrypted prefs, databases, and cached files are excluded explicitly too.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
